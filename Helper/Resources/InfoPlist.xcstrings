        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Copyright © 2026 Contributorii Vespertine. Software liber distribuit sub licența GNU GPL, versiunea 3 sau ulterioară."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Copyright © 2026 Vespertines bidragsgivare. Fri programvara under GNU GPL, version 3 eller senare."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Copyright © 2026 Wachangiaji wa Vespertine. Programu huru chini ya GNU GPL, toleo la 3 au la baadaye."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Copyright © 2026 Vespertine பங்களிப்பாளர்கள். GNU GPL, பதிப்பு 3 அல்லது அதற்குப் பிந்தைய பதிப்பின் கீழ் உள்ள கட்டற்ற மென்பொருள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Copyright © 2026 Vespertine కంట్రిబ్యూటర్‌లు. GNU GPL, వెర్షన్ 3 లేదా తదుపరి వెర్షన్ కింద స్వేచ్ఛా సాఫ్ట్‌వేర్."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Copyright © 2026 ผู้ร่วมพัฒนา Vespertine ซอฟต์แวร์เสรีภายใต้ GNU GPL เวอร์ชัน 3 ขึ้นไป"
          }
        },
        "tr": {

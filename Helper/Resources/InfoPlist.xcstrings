            "state": "translated",
            "value": "Copyright © 2026 Współtwórcy Vespertine. Wolne oprogramowanie na licencji GNU GPL w wersji 3 lub nowszej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Copyright © 2026 Colaboradores do Vespertine. Software livre sob a GNU GPL, versão 3 ou posterior."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Copyright © 2026 Colaboradores do Vespertine. Software livre ao abrigo da GNU GPL, versão 3 ou posterior."
          }

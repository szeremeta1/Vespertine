---
import '../styles/global.css';
import { readFileSync } from 'node:fs';
import { createHash } from 'node:crypto';
import { join } from 'node:path';
import romanFont from '../assets/fonts/newsreader-roman.woff2?url';
import interFont from '../assets/fonts/inter.woff2?url';
import { HEAD_CLASSES, LANG_REDIRECT } from '../inline-scripts.mjs';
import { app } from '../data/app';
import { CODES, DEFAULT_LOCALE, dir, ogLocale, pagePath, type Lang, type Page } from '../i18n';

interface Props {
  lang: Lang;
  /** Which page this is, for the canonical URL, og:url and the other languages' URLs. */
  page: Page;
  title: string;
  description: string;
  /** Name of the social card in public/og/ (made by scripts/make-og.mjs). */
  og: string;
  ogAlt: string;
  /** schema.org graph for this page. */
  jsonLd?: object;
  noindex?: boolean;
}

const { lang, page, title, description, og, ogAlt, jsonLd, noindex = false } = Astro.props;
const site = Astro.site ?? new URL('https://vespertineapp.com');
const canonical = new URL(pagePath(lang, page), site).href;
// Every language's version of this page (the 404 page has none: GitHub Pages serves one 404.html for every path).
const alternates = page === '404' ? [] : CODES.map((c) => ({ lang: c, href: new URL(pagePath(c, page), site).href }));
// The card's content hash in the URL, so a redesigned card isn't hidden behind a scraper's cached copy.
const card = readFileSync(join(process.cwd(), 'public/og', `${og}.jpg`));
const ogImage = new URL(`/og/${og}.jpg?v=${createHash('sha256').update(card).digest('hex').slice(0, 8)}`, site).href;
const robots = noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';
---
<!doctype html>
<html lang={lang} dir={dir(lang)}>
<head>
<meta charset="utf-8">
{page === 'home' && lang === DEFAULT_LOCALE && <script is:inline set:html={LANG_REDIRECT} />}
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
{alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href}>)}
{alternates.length > 0 && <link rel="alternate" hreflang="x-default" href={alternates[0].href}>}
<meta name="robots" content={robots}>
<meta name="author" content={app.author.name}>
<meta name="application-name" content="Vespertine">
<meta name="theme-color" content="#09090a">
<meta name="color-scheme" content="dark">
<link rel="icon" href="/favicon.ico" sizes="48x48">
<link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="manifest" href="/site.webmanifest">
<link rel="sitemap" type="application/xml" href="/sitemap.xml">
<meta property="og:type" content="website">
<meta property="og:site_name" content="Vespertine">
<meta property="og:locale" content={ogLocale(lang)}>
{alternates.filter((a) => a.lang !== lang).map((a) => <meta property="og:locale:alternate" content={ogLocale(a.lang)}>)}
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:image" content={ogImage}>
<meta property="og:image:secure_url" content={ogImage}>
<meta property="og:image:type" content="image/jpeg">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content={ogAlt}>
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={ogImage}>
<meta name="twitter:image:alt" content={ogAlt}>
<script is:inline set:html={HEAD_CLASSES} />
<link rel="preload" as="font" type="font/woff2" crossorigin href={romanFont}>
<link rel="preload" as="font" type="font/woff2" crossorigin href={interFont}>
<script defer src="https://stats.szeremeta.org/howl.js" data-website-id="a4b69e33-e989-45bd-bbc2-4d6b1036aa63" data-domains="vespertineapp.com,www.vespertineapp.com" data-do-not-track="true"></script>
<script defer src="/track.js?v=2026-10-23a"></script>
<slot name="head" />
{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />}
</head>
<body>
<slot />
</body>
</html>

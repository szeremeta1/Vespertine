---
import '../styles/global.css';
import { readFileSync } from 'node:fs';
import { createHash } from 'node:crypto';
import { join } from 'node:path';
import romanFont from '../assets/fonts/newsreader-roman.woff2?url';
import interFont from '../assets/fonts/inter.woff2?url';
import { HEAD_CLASSES } from '../inline-scripts.mjs';
import { app } from '../data/app';

interface Props {
  title: string;
  description: string;
  /** Path of this page (/, /press.html …), for the canonical URL and og:url. */
  path: string;
  /** Name of the social card in public/og/ (made by scripts/make-og.mjs). */
  og: string;
  ogAlt: string;
  /** schema.org graph for this page. */
  jsonLd?: object;
  noindex?: boolean;
}

const { title, description, path, og, ogAlt, jsonLd, noindex = false } = Astro.props;
const site = Astro.site ?? new URL('https://vespertineapp.com');
const canonical = new URL(path, site).href;
// The card's content hash in the URL, so a redesigned card isn't hidden behind a scraper's cached copy.
const card = readFileSync(join(process.cwd(), 'public/og', `${og}.jpg`));
const ogImage = new URL(`/og/${og}.jpg?v=${createHash('sha256').update(card).digest('hex').slice(0, 8)}`, site).href;
const robots = noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
<meta name="robots" content={robots}>
<meta name="author" content={app.author.name}>
<meta name="application-name" content="Vespertine">
<meta name="theme-color" content="#09090a">
<meta name="color-scheme" content="dark">
<link rel="icon" href="/favicon.ico" sizes="48x48">
<link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="manifest" href="/site.webmanifest">
<link rel="sitemap" type="application/xml" href="/sitemap.xml">
<meta property="og:type" content="website">
<meta property="og:site_name" content="Vespertine">
<meta property="og:locale" content="en_US">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:image" content={ogImage}>
<meta property="og:image:secure_url" content={ogImage}>
<meta property="og:image:type" content="image/jpeg">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content={ogAlt}>
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={ogImage}>
<meta name="twitter:image:alt" content={ogAlt}>
<script is:inline set:html={HEAD_CLASSES} />
<link rel="preload" as="font" type="font/woff2" crossorigin href={romanFont}>
<link rel="preload" as="font" type="font/woff2" crossorigin href={interFont}>
<slot name="head" />
{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />}
</head>
<body>
<slot />
</body>
</html>

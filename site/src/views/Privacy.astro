---
import Doc from '../components/Doc.astro';
import { vars } from '../data/content';
import { t, fill, longDate, type Lang } from '../i18n';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const p = t(lang).privacy;
const f = (s: string) => fill(s, vars(lang));
// Effective date of the policy (0.14: room correction's microphone), and the dates of the earlier changes.
const updated = fill(p.updated, { effective: longDate(lang, '2026-10-29T12:00:00-04:00'), discordUpdated: longDate(lang, '2026-10-18T12:00:00-04:00'), statsUpdated: longDate(lang, '2026-10-23T12:00:00-04:00'), langUpdated: longDate(lang, '2026-10-29T12:00:00-04:00') });
---
<Doc
  lang={lang}
  page="privacy"
  title={p.title}
  description={p.description}
  og="privacy"
  ogAlt={p.ogAlt}
  eyebrow={p.eyebrow}
  type="AboutPage"
  date="2026-10-29"
>
  <h1 slot="title" class="page-title">{p.heading} <span class="brass-italic">{p.headingBrass}</span></h1>
  <p slot="updated" class="updated">{updated}</p>

  <p>{p.intro}</p>

  <h2>{p.staysTitle}</h2>
  <p>{p.stays}</p>

  <h2>{p.onlineTitle}</h2>
  <ul>
    {p.online.map((li) => <li set:html={li} />)}
  </ul>

  <h2>{p.websiteTitle}</h2>
  {p.website.map((x) => <p set:html={x} />)}

  <h2>{p.changesTitle}</h2>
  <p set:html={f(p.changes)} />
</Doc>

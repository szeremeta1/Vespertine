---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import DownloadButton from '../components/DownloadButton.astro';
import { t, pagePath, DEFAULT_LOCALE, type Lang } from '../i18n';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const s = t(lang);
const p = s.notFound;
---
<Base lang={lang} page="404" title={p.title} description={p.description} og="home" ogAlt={p.ogAlt} noindex>
<a class="skip" href="#main">{s.common.skip}</a>
<Nav lang={lang} page="404" />
<main id="main" tabindex="-1" class="plain">
  <div class="grain" aria-hidden="true"></div>
  <div class="hero__glow" aria-hidden="true"></div>
  <div class="wrap">
    <p class="eyebrow">{p.eyebrow}</p>
    <h1 class="page-title">{p.heading} <span class="brass-italic">{p.headingBrass}</span></h1>
    <p class="page-lede">{p.lede}</p>
    <div class="hero__cta" style="margin-top:32px">
      <a class="btn btn--ghost" href={pagePath(lang, 'home')}>{p.home}</a>
      <DownloadButton lang={lang} />
    </div>
  </div>
</main>
<Footer lang={lang} page="404" />
{lang === DEFAULT_LOCALE ? <script>
  import '../scripts/notfound';
</script> : <script>
  import '../scripts/main';
</script>}
</Base>

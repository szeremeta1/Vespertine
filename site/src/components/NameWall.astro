---
// Vespertine written in every interface language, at mixed sizes and faces. Live text, so it stays sharp and each
// name is set in its own script's font (lang picks it). The same data draws the press art and the trailer scene.
import data from '../data/names.json';
const { label = 'Vespertine in each of its languages' } = Astro.props;
const rtl = new Set(['ar', 'fa', 'he', 'ur']);
---
<ul class="namewall" aria-label={label} data-reveal>
  {data.names.map((n, i) => (
    <li class:list={['nw', `nw--${n.size}`, `nw--${n.face}`, `nw--tone${i % 4}`]} lang={n.lang} dir={rtl.has(n.lang) ? 'rtl' : 'ltr'}>
      <span class="nw__name">{n.name}</span>
      <span class="nw__lang mono">{n.native}</span>
    </li>
  ))}
</ul>

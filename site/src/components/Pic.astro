---
// <picture> with AVIF and WebP width variants. Astro's <Picture> uses one quality for every
// format, and AVIF needs a lower number than WebP for the same look, so this calls getImage per format.
//
// Below-the-fold images are "deferred": their srcset is only attached once the page has loaded and
// painted (DEFER_IMAGES in src/inline-scripts.mjs), then native lazy loading takes over. That keeps the
// first screen's bandwidth for the hero. Without JS the <noscript> copy loads normally.
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  widths: number[];
  sizes: string;
  class?: string;
  /** Above the fold: load eagerly with high fetch priority. */
  priority?: boolean;
  avifQuality?: number;
  webpQuality?: number;
}
const { src, alt, widths, sizes, class: className, priority = false, avifQuality = 52, webpQuality = 76 } = Astro.props;
const usable = widths.filter((w) => w <= src.width);
const avif = await getImage({ src, widths: usable, format: 'avif', quality: avifQuality });
const webp = await getImage({ src, widths: usable, format: 'webp', quality: webpQuality });
// Same aspect ratio as the real image, so the box doesn't change size when the real source arrives.
const placeholder = `data:image/svg+xml,${encodeURIComponent(`<svg xmlns="http://www.w3.org/2000/svg" width="${src.width}" height="${src.height}" viewBox="0 0 ${src.width} ${src.height}"/>`)}`;
---
{priority ? (
  <picture>
    <source type="image/avif" srcset={avif.srcSet.attribute} sizes={sizes} />
    <img src={webp.src} srcset={webp.srcSet.attribute} sizes={sizes} width={src.width} height={src.height} alt={alt} class={className} loading="eager" fetchpriority="high" />
  </picture>
) : (
  <Fragment>
    <picture data-defer>
      <source type="image/avif" data-srcset={avif.srcSet.attribute} sizes={sizes} />
      <img src={placeholder} data-src={webp.src} data-srcset={webp.srcSet.attribute} sizes={sizes} width={src.width} height={src.height} alt={alt} class={className} loading="lazy" decoding="async" />
    </picture>
    <noscript>
      <picture>
        <source type="image/avif" srcset={avif.srcSet.attribute} sizes={sizes} />
        <img src={webp.src} srcset={webp.srcSet.attribute} sizes={sizes} width={src.width} height={src.height} alt={alt} class={className} loading="lazy" decoding="async" />
      </picture>
    </noscript>
  </Fragment>
)}

---
import logo from '../assets/brand/logo.svg';
import { app, latest, links, trademarks } from '../data/app';
interface Props { home?: boolean; }
const { home = false } = Astro.props;
const base = home ? '' : '/';
const year = new Date().getFullYear();
const cols = [
  { title: 'Vespertine', items: [
    { href: `${base}#features`, text: 'Features' }, { href: `${base}#formats`, text: 'Formats' }, { href: `${base}#compare`, text: 'Compare' },
    { href: `${base}#whats-new`, text: 'What’s new' }, { href: `${base}#faq`, text: 'FAQ' }, { href: latest.dmg.url, text: `Download ${latest.version}` },
  ] },
  { title: 'Project', items: [
    { href: links.repo, text: 'Source on GitHub' }, { href: links.releases, text: 'Release notes' }, { href: links.sponsors, text: 'Sponsor' },
    { href: links.newIssue, text: 'Report an issue' }, { href: links.discussions, text: 'Discussions' }, { href: links.architecture, text: 'Architecture' },
  ] },
  { title: 'About', items: [
    { href: '/press.html', text: 'Press kit' }, { href: '/privacy.html', text: 'Privacy' }, { href: '/terms.html', text: 'Terms' },
    { href: links.license, text: 'License (GPL-3.0)' }, { href: links.notices, text: 'Third-party notices' }, { href: '/llms.txt', text: 'llms.txt' },
  ] },
];
---
<footer class="footer">
  <div class="wrap">
    <div class="footer__grid">
      <div class="footer__brand">
        <img src={logo.src} width="1321" height="391" alt="Vespertine" loading="lazy" decoding="async">
        <p>{app.tagline} {`macOS ${app.minMacOS} or later.`}</p>
      </div>
      <div class="footer__cols">
        {cols.map((c) => (
          <nav aria-label={c.title}>
            <h2>{c.title}</h2>
            <ul>{c.items.map((i) => <li><a href={i.href}>{i.text}</a></li>)}</ul>
          </nav>
        ))}
      </div>
    </div>
    <p class="footer__ukraine"><strong>Vespertine stands with Ukraine.</strong> Please donate through {links.ukraine.map((u, i) => <Fragment>{i === links.ukraine.length - 1 ? ' or ' : i ? ', ' : ''}<a href={u.url}>{u.name}</a></Fragment>)}.</p>
    <p class="footer__legal">{trademarks}</p>
    <div class="footer__row">
      <p>© {year} Vespertine contributors <span aria-hidden="true">·</span> Free software under the GPL <span aria-hidden="true">·</span> Made in Boston by <a href={app.author.url}>{app.author.name}</a></p>
      <p class="mono">{home ? <a href="#top">Back to top <span aria-hidden="true">↑</span></a> : <a href="/">Home</a>}</p>
    </div>
  </div>
</footer>

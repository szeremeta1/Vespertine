---
import { latest } from '../data/app';
interface Props { label?: string; }
const { label = 'Download for Mac' } = Astro.props;
---
<a class="btn btn--brass magnetic" href={latest.dmg.url}><span><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 2v8.5M4.5 7.5 8 11l3.5-3.5M3 13.5h10"/></svg>{label}</span></a>

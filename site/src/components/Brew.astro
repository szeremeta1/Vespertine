---
import { app } from '../data/app';
import { t, type Lang } from '../i18n';
interface Props { lang: Lang; }
const s = t(Astro.props.lang).common;
---
<p class="brew"><span>{s.brewLead}</span> <span class="brew__cmd"><code dir="ltr">{app.brew}</code><button class="copy" type="button" data-copy={app.brew} data-copied={s.copied} data-failed={s.copyFailed} aria-label={s.copyLabel}>{s.copy}</button></span></p>

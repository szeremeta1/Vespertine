---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import posterSrc from '../assets/shots/trailer-poster.jpg';
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Pic from '../components/Pic.astro';
import DownloadButton from '../components/DownloadButton.astro';
import { DEFER_IMAGES } from '../inline-scripts.mjs';
import logo from '../assets/brand/logo.svg';
import logoStacked from '../assets/brand/logo-stacked.svg';
import { SITE, app, latest, links, longDate, megabytes, isoDay } from '../data/app';
import { innerGraph } from '../lib/seo';
import { sceneShots, TRAILER } from '../lib/shots';

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/press/*.jpg', { eager: true });
const img = (name: string) => {
  const f = files[`../assets/press/${name}.jpg`];
  if (!f) throw new Error(`no src/assets/press/${name}.jpg`);
  return f.default;
};

const path = '/press.html';
const title = 'Press kit: Vespertine, the surround and hi-res music player for Mac';
const description = 'Facts, logos, key art, real screenshots and the trailer for Vespertine, the free, open-source Mac player for surround and hi-res music collections.';
const raw = links.raw;

const keyArt = [
  ['bit-perfect', 'Bit-perfect when the conditions are met'],
  ['fake-hi-res', 'Fake hi-res detection'],
  ['spatial-audio', 'Surround as Spatial Audio on AirPods'],
  ['native-dsd', 'Native DSD over DoP'],
  ['stereo-and-surround', 'Stereo and surround versions'],
  ['sacd-iso', 'SACD images, played directly'],
  ['languages', `${app.languages} languages`],
];
const screenshots = [
  ['bit-perfect-fiio-24-96', '24-bit / 96 kHz, bit-perfect on a FiiO K11: Lazar Berman, Liszt’s Les jeux d’eaux à la Villa d’Este'],
  ['multichannel-albums', 'Albums filtered to multichannel'],
  ['stereo-and-surround-versions', 'Extracted SACD tracks with stereo and 5.1 versions'],
  ['spatial-audio-airpods-max', 'A 24/88.2 5.1 album (Elton John, Goodbye Yellow Brick Road) as Spatial Audio on AirPods Max'],
  ['fake-hi-res-detection', 'A 24/192 “remaster” that stops at 16 kHz (a deliberate fake: the trailer’s own music, encoded to MP3 and upsampled, under a made-up band name)'],
  ['dsd-native-dop', 'DSD128 over DoP at 352.8 kHz on a FiiO K11: Claudja Barry, Love for the Sake of Love'],
  ['sacd-iso', 'An SACD .iso, played from the image: Dire Straits, Brothers In Arms'],
  ['genres', 'Genres'],
  ['search', 'Search'],
  ['smart-playlist', 'A smart playlist, bit-perfect on AirPods Max over USB-C'],
  ['loopback-test', 'The loopback test: a software check of the output path, sample by sample'],
  ['setup-welcome', 'First-run setup: welcome'],
  ['setup-output', 'First-run setup: choosing the output to remember'],
  ['output-settings', 'Output settings: remembered output, fallback, 16-bit matching'],
  ['equalizer', 'The parametric EQ with an AutoEQ preset'],
];
const poster = await getImage({ src: posterSrc, width: 1280, format: 'webp', quality: 70 });
const jsonLd = innerGraph({ path, title, crumb: 'Press kit', description, dateModified: isoDay(latest.date), image: `${SITE}/og/press.jpg`, screenshots: await sceneShots(), trailer: { url: SITE + TRAILER, poster: SITE + poster.src } });
---
<Base title={title} description={description} path={path} og="press" ogAlt="Vespertine press kit: fact sheet, logos, key art, real screenshots and the trailer, over three real screenshots of the app." jsonLd={jsonLd}>
<a class="skip" href="#main">Skip to content</a>
<Nav current="/press.html" />
<main id="main" tabindex="-1" class="press">
  <header class="page-head">
    <div class="grain" aria-hidden="true"></div>
    <div class="hero__glow" aria-hidden="true"></div>
    <div class="wrap">
      <p class="eyebrow">Press kit</p>
      <h1 class="page-title">Everything you need to write about <span class="brass-italic">Vespertine.</span></h1>
      <p class="page-lede">Vespertine is the free, open-source Mac player for surround and hi-res music collections. SACD and DVD-Video disc images, extracted SACD 5.1 tracks, DTS CDs, DTS-HD MA, TrueHD and Atmos files share one library, with head-tracked Spatial Audio on AirPods. The signal path shows each step from file to output, with conditions and tests in GPL source anyone can audit.</p>
      <p class="fine">Channel-for-channel output and receiver bitstream are experimental, untested on real receivers/multichannel DACs; reports wanted. Dolby Digital Plus Atmos objects are rendered by macOS; TrueHD Atmos and DTS:X play their channel bed.</p>
    </div>
  </header>

  <div class="wrap">
    <section class="press-block" aria-labelledby="facts-title">
      <p class="eyebrow">Fact sheet</p>
      <h2 id="facts-title">The facts.</h2>
      <dl class="facts">
        <div><dt>Name</dt><dd>Vespertine <span class="fine">(called {app.formerName} until version 0.6.0)</span></dd></div>
        <div><dt>Developer</dt><dd>{app.author.short}, independent developer</dd></div>
        <div><dt>Price</dt><dd>Free. Open source under the GPL-3.0; no account, subscription, ads or telemetry</dd></div>
        <div><dt>Platform</dt><dd>macOS {app.minMacOS} {app.minMacOSName} or later, {app.arch}</dd></div>
        <div><dt>Current version</dt><dd>{latest.version}, released {longDate(latest.date)} <span class="fine">Signed and notarized DMG ({megabytes(latest.dmg.size)}), updates itself</span></dd></div>
        <div><dt>First release</dt><dd>27 September 2026 <span class="fine">(as {app.formerName} 0.1.0)</span></dd></div>
        <div><dt>Languages</dt><dd>English and {app.languages} more, including Ukrainian, Arabic, Hebrew, Japanese and three kinds of Chinese</dd></div>
        <div><dt>Install</dt><dd><a href={latest.dmg.url}>Download the DMG</a> or <code>{app.brew}</code></dd></div>
        <div><dt>Tested with</dt><dd>{app.tested.join(', ')}</dd></div>
        <div><dt>Links</dt><dd><a href="/">Website</a> · <a href={links.repo}>Source code</a> · <a href={links.releases}>Release notes</a> · <a href={links.verification}>How to verify bit-perfect playback</a></dd></div>
      </dl>
    </section>

    <section class="press-block" aria-labelledby="focus-title">
      <p class="eyebrow">Angle</p>
      <h2 id="focus-title">What it focuses on.</h2>
      <ul class="ticks">
        <li>Surround music in one Mac library, from SACD and DVD-Video images, rips and DTS CDs to TrueHD and DD+ Atmos, with Spatial Audio on AirPods.</li>
        <li>Free GPL-3.0 source anyone can read, build and change.</li>
        <li>A signal path showing rate, word length, gain and channel processing. Bit-perfect conditions live in code, with tests, a built-in loopback test and a <a href={links.verification}>verification guide</a>.</li>
      </ul>
      <p>Hi-res file analysis is also included. Zero-padding detection is exact; spectral verdicts are estimates with limits. VeraVox and Audirvana AudioScan offer analysis too. <a href={links.comparison}>Comparison sources</a>.</p>
    </section>

    <section class="press-block" aria-labelledby="trailer-title">
      <p class="eyebrow">Video</p>
      <h2 id="trailer-title">Trailer.</h2>
      <p>44 seconds, 16:9, 1080p at 60 fps, with sound. <a href="/assets/trailer/vespertine-trailer-1080p.mp4" download>Download the MP4</a> (27 MB). A 4K master is available on request.</p>
      <figure class="video">
        <video controls playsinline preload="none" poster={poster.src} width="1920" height="1080" aria-label="Vespertine trailer, 44 seconds">
          <source src="/assets/trailer/vespertine-trailer.mp4" type="video/mp4">
          <a href="/assets/trailer/vespertine-trailer-1080p.mp4">Download the trailer (MP4)</a>
        </video>
      </figure>
    </section>

    <section class="press-block" aria-labelledby="logo-title">
      <p class="eyebrow">Brand</p>
      <h2 id="logo-title">Logo.</h2>
      <p>Always lowercase, the crescent always in brass. Please don’t recolor, stretch or re-set it. <a href={links.brandGuide}>Brand guide (PDF)</a>.</p>
      <div class="grid grid--2">
        <figure>
          <div class="logo-tile"><img src={logo.src} width="1321" height="391" alt="The Vespertine lockup: a brass crescent and the word vespertine" loading="lazy" decoding="async"></div>
          <figcaption>Primary · <a href={`${raw}/docs/brand/logo.svg`}>SVG</a> · <a href={`${raw}/docs/brand/logo.png`}>PNG</a> · on light: <a href={`${raw}/docs/brand/logo-on-light.svg`}>SVG</a> · <a href={`${raw}/docs/brand/logo-on-light.png`}>PNG</a></figcaption>
        </figure>
        <figure>
          <div class="logo-tile"><img class="stacked" src={logoStacked.src} width={logoStacked.width} height={logoStacked.height} alt="The stacked Vespertine lockup" loading="lazy" decoding="async"></div>
          <figcaption>Stacked · <a href={`${raw}/docs/brand/logo-stacked.svg`}>SVG</a> · <a href={`${raw}/docs/brand/logo-stacked.png`}>PNG</a> · crescent alone: <a href={`${raw}/docs/brand/mark.svg`}>SVG</a> · <a href={`${raw}/docs/brand/mark.png`}>PNG</a></figcaption>
        </figure>
      </div>
    </section>

    <section class="press-block" aria-labelledby="art-title">
      <p class="eyebrow">Key art</p>
      <h2 id="art-title">One image per feature.</h2>
      <p>In three sizes: 2400×1350, 1600×900 and 1270×760.</p>
      <div class="grid grid--2 grid--key">
        {keyArt.map(([k, t], i) => (
          <figure>
            <a href={`${raw}/docs/press/${k}-hero.png`}><Pic src={img(k)} alt={t} widths={[450, 900]} sizes={i === 0 ? '(max-width: 900px) calc(100vw - 52px), 1240px' : '(max-width: 600px) calc(100vw - 52px), 600px'} /></a>
            <figcaption>{t} · <a href={`${raw}/docs/press/${k}-hero.png`}>2400</a> · <a href={`${raw}/docs/press/${k}-x.png`}>1600</a> · <a href={`${raw}/docs/press/${k}-producthunt.png`}>1270</a></figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section class="press-block" aria-labelledby="shots-title">
      <p class="eyebrow">Screenshots</p>
      <h2 id="shots-title">The real app.</h2>
      <p>On the developer’s own library, 2400×1500. Album art belongs to its owners.</p>
      <div class="grid grid--3">
        {screenshots.map(([k, t]) => (
          <figure>
            <a href={`${raw}/docs/screenshots/${k}.png`}><Pic src={img(`shot-${k}`)} alt={t} widths={[360, 720]} sizes="(max-width: 600px) calc(100vw - 52px), (max-width: 1000px) 45vw, 400px" /></a>
            <figcaption>{t}</figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section class="press-block" aria-labelledby="contact-title">
      <p class="eyebrow">Contact</p>
      <h2 id="contact-title">Get in touch.</h2>
      <div class="contact-card">
        <p>Press, questions and interview requests: <a href={`mailto:${app.pressEmail}`}>{app.pressEmail}</a>. Community questions: <a href={links.discussions}>GitHub Discussions</a>. Bugs and device reports: <a href={links.issues}>GitHub issues</a>.</p>
        <DownloadButton />
      </div>
    </section>
  </div>
</main>
<Footer />
<script>
  import '../scripts/main';
</script>
<script is:inline set:html={DEFER_IMAGES} />
</Base>

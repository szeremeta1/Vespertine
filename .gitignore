# macOS and editors
.DS_Store
*.swp
.vscode/
.idea/

# Build products
.build/
.build-x86/
.swiftpm/
DerivedData/
build/
*.dmg
*.xcodeproj/
*.xcworkspace/xcuserdata/
xcuserdata/
Packages/VespertineKit/Package.resolved.bak

# Secrets and local settings (never commit keys, tokens or passwords)
.env
.env.*
*.p12
*.p8
*.cer
*.pem
*.key
*.keychain
*.keychain-db
*.provisionprofile
*.xcarchive
vespertine-sparkle-key.txt

# Local notes and tool folders at the top level stay out of git: any new Markdown file or hidden file or folder there
# (machine-specific or private on purpose). Tracked ones (README.md, .github/, ...) are unaffected; add a new one with
# `git add -f`.
/*.md
/.*
!/.github/
nocturne-sparkle-key.txt
*sparkle-private-key*

# Verification: the local copy of the specifications (paywalled text must never be committed; see verification/README.md)
verification/spec-cache/
# Oracle sources, fetched at pinned versions by verification/tools/fetch_oracles.py rather than vendored
verification/oracles/fetched/

# Python bytecode from the verification tools
verification/**/__pycache__/

# TIDAL client credentials built into local app builds (never committed; see TidalConfig.bundledResourceName)
App/Resources/TidalClient.json

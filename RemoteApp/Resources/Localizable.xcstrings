    "The rest is fetched when the Mac is connected.": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ቀሪው Mac ሲገናኝ ይመጣል።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم جلب الباقي عند اتصال الـ Mac."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac সংযুক্ত হলে বাকিগুলো আনা হবে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zbytek se stáhne, až bude Mac připojený."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Resten hentes, når der er forbindelse til Mac’en."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Rest wird geladen, sobald der Mac verbunden ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα υπόλοιπα θα ληφθούν όταν συνδεθεί το Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El resto se descargará cuando el Mac esté conectado."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بقیه وقتی Mac وصل باشد دریافت می‌شود."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Loput haetaan, kun Mac on yhdistetty."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kukunin ang iba pa kapag nakakonekta ang Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le reste sera récupéré lorsque le Mac sera connecté."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "બાકીનાં ગીતો Mac કનેક્ટ થાય ત્યારે મેળવવામાં આવશે."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Za a ɗauko sauran idan an haɗa Mac ɗin."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השאר יורד כשה־Mac מחובר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बाक़ी गीत Mac के कनेक्ट होने पर लाए जाएँगे।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A többi akkor töltődik le, amikor a Mac csatlakoztatva van."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sisanya akan diambil saat Mac terhubung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il resto verrà scaricato quando il Mac sarà connesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残りは、Macに接続したときに取得されます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac ಸಂಪರ್ಕಗೊಂಡಾಗ ಉಳಿದವುಗಳನ್ನು ತರಲಾಗುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나머지는 Mac이 연결되면 가져옵니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac കണക്റ്റ് ആകുമ്പോൾ ബാക്കിയുള്ളവ എടുക്കും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "उरलेली गाणी Mac कनेक्ट झाल्यावर आणली जातील."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Selebihnya diambil apabila Mac disambungkan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Resten hentes når Macen er tilkoblet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De rest wordt opgehaald zodra de Mac verbonden is."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਬਾਕੀ ਗੀਤ Mac ਦੇ ਕਨੈਕਟ ਹੋਣ ’ਤੇ ਲਿਆਂਦੇ ਜਾਣਗੇ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Reszta zostanie pobrana, gdy Mac będzie połączony."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O restante será baixado quando o Mac estiver conectado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O resto é descarregado quando o Mac estiver ligado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Restul se preia când Mac-ul este conectat."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Resten hämtas när Macen är ansluten."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Zilizosalia huletwa Mac inapounganishwa."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac இணைக்கப்பட்டதும் மீதமுள்ளவை பெறப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac కనెక్ట్ అయినప్పుడు మిగిలినవి తీసుకురాబడతాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่วนที่เหลือจะถูกดึงมาเมื่อ Mac เชื่อมต่ออยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalanı, Mac bağlandığında indirilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Решта завантажиться, коли Mac буде під’єднано."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "باقی تب حاصل ہوگا جب Mac منسلک ہو۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phần còn lại sẽ được tải khi máy Mac được kết nối."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "其餘歌曲會在連接 Mac 時取得。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其余歌曲会在连接 Mac 后获取。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "其餘歌曲會在與 Mac 連線時取得。"
          }
        }
      }
    },
    "There’s no more room for kept music. Remove something, or give it more room in Settings.": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ለተቀመጠ ሙዚቃ ተጨማሪ ቦታ የለም። የሆነ ነገር ያስወግዱ፣ ወይም በቅንብሮች ውስጥ ተጨማሪ ቦታ ይስጡት።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تعد هناك مساحة للموسيقى المحفوظة. أزِل شيئًا، أو خصّص لها مساحة أكبر في الإعدادات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রাখা মিউজিকের জন্য আর জায়গা নেই। কিছু সরান, অথবা সেটিংসে এর জন্য আরও জায়গা দিন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro uchovanou hudbu už není místo. Něco odstraňte, nebo jí v Nastavení přidělte více místa."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der er ikke mere plads til beholdt musik. Fjern noget, eller giv den mere plads i Indstillinger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für behaltene Musik ist kein Platz mehr. Entferne etwas oder gib ihr in den Einstellungen mehr Platz."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν υπάρχει άλλος χώρος για τη μουσική που διατηρείτε. Αφαιρέστε κάτι ή δώστε περισσότερο χώρο στις Ρυθμίσεις."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No queda espacio para la música conservada. Elimina algo o dale más espacio en Ajustes."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دیگر جایی برای موسیقی نگه‌داشته‌شده نمانده است. چیزی را حذف کنید یا در «تنظیمات» فضای بیشتری به آن بدهید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Säilytettävälle musiikille ei ole enää tilaa. Poista jotain tai anna sille lisää tilaa Asetuksissa."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Wala nang espasyo para sa nakatabing musika. Mag-alis ng anuman, o dagdagan ang espasyo nito sa Settings."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n’y a plus de place pour la musique conservée. Supprimez quelque chose, ou accordez-lui plus de place dans Réglages."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "રાખેલા સંગીત માટે હવે જગ્યા નથી. કંઈક દૂર કરો, અથવા સેટિંગ્સમાં તેને વધુ જગ્યા આપો."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Babu sauran sarari don waƙoƙin da aka ajiye. Cire wani abu, ko ku ƙara masa sarari a Saituna."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא נשאר מקום למוזיקה שמורה. הסר משהו, או הקצה לה יותר מקום ב״הגדרות״."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रखे गए संगीत के लिए और जगह नहीं है। कुछ हटाएँ, या सेटिंग्ज़ में इसे और जगह दें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nincs több hely a megtartott zenének. Távolítson el valamit, vagy adjon neki több helyet a Beállításokban."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada ruang lagi untuk musik yang disimpan. Hapus sesuatu, atau beri lebih banyak ruang di Pengaturan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non c’è più spazio per la musica mantenuta. Rimuovi qualcosa, oppure assegnale più spazio in Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存した音楽用の空き容量がなくなりました。何かを削除するか、「設定」で容量を増やしてください。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇರಿಸಿದ ಸಂಗೀತಕ್ಕೆ ಇನ್ನು ಸ್ಥಳವಿಲ್ಲ. ಏನನ್ನಾದರೂ ತೆಗೆದುಹಾಕಿ, ಅಥವಾ ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ ಅದಕ್ಕೆ ಹೆಚ್ಚು ಸ್ಥಳ ನೀಡಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보관한 음악을 위한 공간이 더 이상 없습니다. 항목을 제거하거나 설정에서 공간을 늘리십시오."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സൂക്ഷിച്ച സംഗീതത്തിന് ഇനി ഇടമില്ല. എന്തെങ്കിലും നീക്കം ചെയ്യുക, അല്ലെങ്കിൽ ക്രമീകരണത്തിൽ അതിന് കൂടുതൽ ഇടം നൽകുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ठेवलेल्या संगीतासाठी आणखी जागा नाही. काहीतरी काढा, किंवा सेटिंग्जमध्ये त्याला अधिक जागा द्या."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada lagi ruang untuk muzik yang disimpan. Buang sesuatu, atau beri lebih banyak ruang dalam Seting."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er ikke mer plass til beholdt musikk. Fjern noe, eller gi den mer plass i Innstillinger."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is geen ruimte meer voor bewaarde muziek. Verwijder iets of geef in Instellingen meer ruimte."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਰੱਖੇ ਗਏ ਸੰਗੀਤ ਲਈ ਹੋਰ ਥਾਂ ਨਹੀਂ ਹੈ। ਕੁਝ ਹਟਾਓ, ਜਾਂ ਸੈਟਿੰਗਾਂ ਵਿੱਚ ਇਸਨੂੰ ਹੋਰ ਥਾਂ ਦਿਓ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ma już miejsca na zachowaną muzykę. Usuń coś lub przydziel jej więcej miejsca w Ustawieniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há mais espaço para músicas mantidas. Remova algo ou dê mais espaço a elas nos Ajustes."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Já não há espaço para música mantida. Remova alguma coisa ou dê-lhe mais espaço nas Definições."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu mai este loc pentru muzica păstrată. Eliminați ceva sau acordați-i mai mult spațiu în Configurări."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det finns inte mer utrymme för behållen musik. Ta bort något eller ge den mer utrymme i Inställningar."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hakuna nafasi zaidi kwa muziki uliohifadhiwa. Ondoa kitu, au uuongezee nafasi kwenye Mipangilio."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வைத்திருக்கும் இசைக்கு இனி இடமில்லை. எதையாவது அகற்றவும், அல்லது அமைப்புகளில் அதற்குக் கூடுதல் இடம் கொடுக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఉంచిన సంగీతానికి ఇక స్థలం లేదు. ఏదైనా తీసివేయండి, లేదా సెట్టింగ్‌లలో దానికి మరింత స్థలం ఇవ్వండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีพื้นที่สำหรับเพลงที่เก็บไว้แล้ว ให้เอาบางรายการออก หรือเพิ่มพื้นที่ในการตั้งค่า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutulan müzikler için yer kalmadı. Bir şeyleri kaldırın veya Ayarlar’dan daha fazla yer ayırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для збереженої музики більше немає місця. Вилучіть щось або виділіть більше місця в Параметрах."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "رکھی ہوئی موسیقی کے لیے مزید جگہ نہیں۔ کچھ ہٹائیں، یا سیٹنگز میں اس کے لیے مزید جگہ دیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không còn chỗ cho nhạc đã lưu. Hãy xóa bớt hoặc tăng dung lượng trong Cài đặt."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "已沒有空間存放保留的音樂。請移除部份內容，或在「設定」中給予更多空間。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已没有空间存放保留的音乐。请移除一些内容，或在“设置”中为它分配更多空间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已沒有空間可存放保留的音樂。請移除一些內容，或在「設定」中提供更多空間。"
          }
        }
      }
    },
    "This device has no motion sensors, so Cover Flow doesn’t follow it.": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ይህ መሣሪያ የእንቅስቃሴ ዳሳሾች ስለሌሉት Cover Flow አይከተለውም።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يحتوي هذا الجهاز على مستشعرات حركة، لذلك لا يتبع Cover Flow حركته."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ডিভাইসে মোশন সেন্সর নেই, তাই Cover Flow এর নড়াচড়া অনুসরণ করে না।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto zařízení nemá pohybové senzory, takže Cover Flow jeho pohyb nesleduje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne enhed har ingen bevægelsessensorer, så Cover Flow følger den ikke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät hat keine Bewegungssensoren, daher folgt Cover Flow ihm nicht."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτή η συσκευή δεν έχει αισθητήρες κίνησης, γι’ αυτό το Cover Flow δεν την ακολουθεί."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo no tiene sensores de movimiento, así que Cover Flow no lo sigue."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این دستگاه حسگر حرکتی ندارد، بنابراین Cover Flow حرکت آن را دنبال نمی‌کند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tässä laitteessa ei ole liikeantureita, joten Cover Flow ei seuraa sitä."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang motion sensor ang device na ito, kaya hindi ito sinusundan ng Cover Flow."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil n’a pas de capteurs de mouvement ; Cover Flow ne le suit donc pas."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ ડિવાઇસમાં મોશન સેન્સર નથી, તેથી Cover Flow તેની હિલચાલને અનુસરતું નથી."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Wannan na'ura ba ta da na'urorin gano motsi, don haka Cover Flow ba ya bin ta."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "במכשיר זה אין חיישני תנועה, ולכן Cover Flow אינו עוקב אחריו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस डिवाइस में मोशन सेंसर नहीं हैं, इसलिए Cover Flow इसकी गति के साथ नहीं चलता।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ebben az eszközben nincsenek mozgásérzékelők, ezért a Cover Flow nem követi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perangkat ini tidak memiliki sensor gerak, sehingga Cover Flow tidak mengikutinya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo dispositivo non ha sensori di movimento, quindi Cover Flow non lo segue."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスにはモーションセンサーがないため、Cover Flowはデバイスの動きに追従しません。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಸಾಧನದಲ್ಲಿ ಚಲನೆ ಸೆನ್ಸರ್‌ಗಳಿಲ್ಲ, ಆದ್ದರಿಂದ Cover Flow ಅದನ್ನು ಅನುಸರಿಸುವುದಿಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에는 동작 센서가 없으므로 Cover Flow가 기기의 움직임을 따라가지 않습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ ഉപകരണത്തിൽ മോഷൻ സെൻസറുകളില്ല, അതിനാൽ Cover Flow അതിനെ പിന്തുടരില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या डिव्हाइसमध्ये मोशन सेन्सर नाहीत, त्यामुळे Cover Flow त्याच्या हालचालीनुसार बदलत नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Peranti ini tiada penderia gerakan, jadi Cover Flow tidak mengikutnya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne enheten har ingen bevegelsessensorer, så Cover Flow følger den ikke."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit apparaat heeft geen bewegingssensoren, dus Cover Flow volgt het niet."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ ਡਿਵਾਈਸ ਵਿੱਚ ਮੋਸ਼ਨ ਸੈਂਸਰ ਨਹੀਂ ਹਨ, ਇਸ ਲਈ Cover Flow ਇਸਦੀ ਹਿਲਜੁਲ ਨਾਲ ਨਹੀਂ ਬਦਲਦਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To urządzenie nie ma czujników ruchu, więc Cover Flow za nim nie podąża."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo não tem sensores de movimento; por isso, o Cover Flow não o acompanha."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo não tem sensores de movimento; por isso, o Cover Flow não o acompanha."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest dispozitiv nu are senzori de mișcare, așa că Cover Flow nu îl urmărește."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här enheten saknar rörelsesensorer, så Cover Flow följer den inte."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kifaa hiki hakina vitambuzi vya mwendo, kwa hivyo Cover Flow haikifuati."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தச் சாதனத்தில் மோஷன் சென்சார்கள் இல்லை, எனவே Cover Flow அதைப் பின்தொடராது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ పరికరంలో మోషన్ సెన్సార్‌లు లేవు, కాబట్టి Cover Flow దాన్ని అనుసరించదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อุปกรณ์เครื่องนี้ไม่มีเซ็นเซอร์ตรวจจับการเคลื่อนไหว Cover Flow จึงไม่เคลื่อนตามอุปกรณ์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu aygıtta hareket sensörü olmadığından Cover Flow aygıtı izlemez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей пристрій не має датчиків руху, тому Cover Flow не реагує на його рухи."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس ڈیوائس میں موشن سینسرز نہیں ہیں، اس لیے Cover Flow اس کی حرکت کو فالو نہیں کرتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thiết bị này không có cảm biến chuyển động, nên Cover Flow không chuyển động theo thiết bị."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "此裝置沒有動作感應器，因此 Cover Flow 不會跟隨裝置移動。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备没有运动传感器，因此 Cover Flow 不会跟随设备移动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此裝置沒有動作感測器，因此 Cover Flow 不會隨裝置移動。"
          }
        }
      }
    },
    "This device is offline. Vespertine connects again when the network is back.": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ይህ መሣሪያ ከመስመር ውጭ ነው። አውታረ መረቡ ሲመለስ Vespertine እንደገና ይገናኛል።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الجهاز غير متصل بالإنترنت. سيعاود Vespertine الاتصال عند عودة الشبكة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ডিভাইসটি অফলাইনে আছে। নেটওয়ার্ক ফিরে এলে Vespertine আবার সংযোগ করবে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto zařízení je offline. Vespertine se znovu připojí, až bude síť opět dostupná."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne enhed er offline. Vespertine opretter forbindelse igen, når netværket er tilbage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät ist offline. Vespertine verbindet sich wieder, sobald das Netzwerk zurück ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτή η συσκευή είναι εκτός σύνδεσης. Το Vespertine θα συνδεθεί ξανά όταν επανέλθει το δίκτυο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo no tiene conexión. Vespertine volverá a conectarse cuando la red esté disponible."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این دستگاه آفلاین است. وقتی شبکه برگردد، Vespertine دوباره وصل می‌شود."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä laite on offline-tilassa. Vespertine yhdistää uudelleen, kun verkko palaa."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline ang device na ito. Kokonekta ulit ang Vespertine kapag bumalik ang network."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil est hors ligne. Vespertine se reconnectera au retour du réseau."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ ડિવાઇસ ઑફલાઇન છે. નેટવર્ક પાછું આવે ત્યારે Vespertine ફરીથી કનેક્ટ થશે."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Wannan na'ura ba ta kan layi. Vespertine zai sake haɗuwa idan cibiyar sadarwa ta dawo."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מכשיר זה אינו מקוון. Vespertine יתחבר שוב כשהרשת תחזור."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह डिवाइस ऑफ़लाइन है। नेटवर्क वापस आने पर Vespertine फिर से कनेक्ट हो जाएगा।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez az eszköz offline állapotban van. A Vespertine újra csatlakozik, amint a hálózat visszatér."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perangkat ini sedang offline. Vespertine akan terhubung lagi saat jaringan kembali tersedia."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo dispositivo è offline. Vespertine si riconnetterà quando la rete sarà di nuovo disponibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスはオフラインです。ネットワークが回復すると、Vespertineは再接続します。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಸಾಧನ ಆಫ್‌ಲೈನ್‌ನಲ್ಲಿದೆ. ನೆಟ್‌ವರ್ಕ್ ಮರಳಿದಾಗ Vespertine ಮತ್ತೆ ಸಂಪರ್ಕಿಸುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기가 오프라인 상태입니다. 네트워크가 복구되면 Vespertine이 다시 연결합니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ ഉപകരണം ഓഫ്‌ലൈനാണ്. നെറ്റ്‌വർക്ക് തിരികെ വരുമ്പോൾ Vespertine വീണ്ടും കണക്റ്റ് ചെയ്യും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हे डिव्हाइस ऑफलाइन आहे. नेटवर्क परत आल्यावर Vespertine पुन्हा कनेक्ट होईल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Peranti ini berada di luar talian. Vespertine akan menyambung semula apabila rangkaian kembali."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne enheten er frakoblet. Vespertine kobler til igjen når nettverket er tilbake."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit apparaat is offline. Vespertine maakt weer verbinding zodra het netwerk terug is."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਹ ਡਿਵਾਈਸ ਔਫ਼ਲਾਈਨ ਹੈ। ਨੈੱਟਵਰਕ ਵਾਪਸ ਆਉਣ ’ਤੇ Vespertine ਦੁਬਾਰਾ ਕਨੈਕਟ ਹੋ ਜਾਵੇਗਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To urządzenie jest offline. Vespertine połączy się ponownie, gdy sieć wróci."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo está offline. O Vespertine se reconectará quando a rede voltar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo está offline. O Vespertine volta a ligar-se quando a rede regressar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest dispozitiv este offline. Vespertine se reconectează când rețeaua revine."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här enheten är offline. Vespertine ansluter igen när nätverket är tillbaka."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kifaa hiki kiko nje ya mtandao. Vespertine itaunganisha tena mtandao utakaporejea."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தச் சாதனம் ஆஃப்லைனில் உள்ளது. நெட்வொர்க் திரும்பியதும் Vespertine மீண்டும் இணையும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ పరికరం ఆఫ్‌లైన్‌లో ఉంది. నెట్‌వర్క్ తిరిగి వచ్చినప్పుడు Vespertine మళ్లీ కనెక్ట్ అవుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อุปกรณ์เครื่องนี้ออฟไลน์อยู่ Vespertine จะเชื่อมต่ออีกครั้งเมื่อเครือข่ายกลับมา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu aygıt çevrimdışı. Ağ geri geldiğinde Vespertine yeniden bağlanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей пристрій офлайн. Vespertine під’єднається знову, щойно мережа відновиться."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ ڈیوائس آف لائن ہے۔ نیٹ ورک واپس آنے پر Vespertine دوبارہ منسلک ہو جاتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thiết bị này đang ngoại tuyến. Vespertine sẽ kết nối lại khi có mạng trở lại."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "此裝置現時離線。網絡恢復後，Vespertine 會重新連接。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备处于离线状态。网络恢复后，Vespertine 会重新连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此裝置目前離線。網路恢復後，Vespertine 會重新連線。"
          }
        }
      }
    },

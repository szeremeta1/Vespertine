    "Demo: a made-up library, with sound the app makes itself.": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ማሳያ፦ የፈጠራ ቤተ-መጻሕፍት፣ መተግበሪያው ራሱ ከሚፈጥረው ድምፅ ጋር።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عرض تجريبي: مكتبة وهمية، بصوت يولّده التطبيق نفسه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ডেমো: একটি বানানো লাইব্রেরি, যার শব্দ অ্যাপ নিজেই তৈরি করে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Demo: smyšlená knihovna se zvukem, který si aplikace vytváří sama."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Demo: et opdigtet bibliotek med lyd, som appen selv laver."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Demo: eine erfundene Mediathek, mit Ton, den die App selbst erzeugt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επίδειξη: μια φανταστική βιβλιοθήκη, με ήχο που παράγει η ίδια η εφαρμογή."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Demo: una biblioteca inventada, con sonido que genera la propia app."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نسخهٔ نمایشی: یک کتابخانهٔ ساختگی، با صدایی که خودِ برنامه می‌سازد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Demo: keksitty kirjasto, jonka äänen appi tuottaa itse."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Demo: gawa-gawang library, na may tunog na ang app mismo ang gumagawa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démo : une bibliothèque fictive, avec un son produit par l’app elle-même."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ડેમો: એક કાલ્પનિક લાઇબ્રેરી, જેનો અવાજ ઍપ પોતે બનાવે છે."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Gwaji: ƙirƙirarren laburare, da sautin da manhajar ke yi da kanta."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הדגמה: ספריה בדויה, עם צליל שהיישום מפיק בעצמו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डेमो: एक काल्पनिक लाइब्रेरी, जिसकी ध्वनि ऐप ख़ुद बनाता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Demó: kitalált könyvtár, az app által előállított hanggal."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Demo: perpustakaan rekaan, dengan suara yang dibuat sendiri oleh app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Demo: una libreria inventata, con l’audio generato dall’app stessa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デモ: 架空のライブラリです。音はアプリ自身が生成します。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಡೆಮೊ: ಕಾಲ್ಪನಿಕ ಲೈಬ್ರರಿ, ಆ್ಯಪ್ ತಾನೇ ಸೃಷ್ಟಿಸುವ ಧ್ವನಿಯೊಂದಿಗೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데모: 가상의 보관함이며, 소리는 앱이 직접 만들어 냅니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഡെമോ: ഒരു സാങ്കൽപ്പിക ലൈബ്രറി, ആപ്പ് സ്വയം ഉണ്ടാക്കുന്ന ശബ്ദത്തോടെ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "डेमो: एक काल्पनिक लायब्ररी, जिचा आवाज ॲप स्वतः तयार करते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Demo: pustaka rekaan, dengan bunyi yang dihasilkan oleh app sendiri."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Demo: et oppdiktet bibliotek, med lyd appen lager selv."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Demo: een verzonnen bibliotheek, met geluid dat de app zelf maakt."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਡੈਮੋ: ਇੱਕ ਬਣਾਉਟੀ ਲਾਇਬ੍ਰੇਰੀ, ਜਿਸਦੀ ਆਵਾਜ਼ ਐਪ ਆਪ ਬਣਾਉਂਦੀ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Demo: zmyślona biblioteka z dźwiękiem, który aplikacja tworzy sama."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Demonstração: uma biblioteca fictícia, com som gerado pelo próprio app."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Demonstração: uma biblioteca fictícia, com som gerado pela própria app."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Demonstrație: o bibliotecă inventată, cu sunet generat de aplicație."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Demo: ett påhittat bibliotek, med ljud som appen skapar själv."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Onyesho: maktaba ya kubuni, yenye sauti inayotengenezwa na programu yenyewe."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "டெமோ: ஒரு கற்பனை லைப்ரரி, ஆப் தானே உருவாக்கும் ஒலியுடன்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "డెమో: ఒక కల్పిత లైబ్రరీ, యాప్ తానే సృష్టించే ధ్వనితో."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สาธิต: คลังสมมติ พร้อมเสียงที่แอปสร้างขึ้นเอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demo: sesini uygulamanın kendisinin ürettiği uydurma bir arşiv."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Демо: вигадана медіатека зі звуком, який програма створює сама."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ڈیمو: ایک فرضی لائبریری، جس کی آواز ایپ خود بناتی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Demo: một thư viện giả lập, với âm thanh do ứng dụng tự tạo."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "示範：虛構的資料庫，聲音由 App 自行產生。"
          }
        },
        "zh-Hans": {
          "stringUnit": {

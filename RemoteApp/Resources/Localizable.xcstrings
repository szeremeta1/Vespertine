          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hàng đợi"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "待播清單"
          }
        },
        "zh-Hans": {

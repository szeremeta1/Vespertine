    "Playing over cellular data is off. Connect to Wi-Fi, or turn it on in Settings.": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "በሞባይል ውሂብ ማጫወት ጠፍቷል። ከWi-Fi ጋር ይገናኙ፣ ወይም በቅንብሮች ውስጥ ያብሩት።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التشغيل عبر البيانات الخلوية متوقف. اتصل بشبكة Wi-Fi، أو شغّل هذا الخيار من الإعدادات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সেলুলার ডেটায় চালানো বন্ধ আছে। Wi-Fi-তে সংযোগ করুন, অথবা সেটিংসে এটি চালু করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přehrávání přes mobilní data je vypnuté. Připojte se k Wi-Fi, nebo ho zapněte v Nastavení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Afspilning via mobildata er slået fra. Opret forbindelse til Wi-Fi, eller slå det til i Indstillinger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Wiedergabe über mobile Daten ist deaktiviert. Verbinde dich mit einem WLAN oder aktiviere sie in den Einstellungen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η αναπαραγωγή μέσω δεδομένων κινητής τηλεφωνίας είναι ανενεργή. Συνδεθείτε σε Wi-Fi ή ενεργοποιήστε την στις Ρυθμίσεις."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La reproducción con datos móviles está desactivada. Conéctate a una red Wi-Fi o actívala en Ajustes."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پخش با دادهٔ تلفن همراه خاموش است. به Wi-Fi وصل شوید یا این گزینه را در «تنظیمات» روشن کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Toisto mobiilidatalla on pois päältä. Yhdistä Wi-Fi-verkkoon tai laita se päälle Asetuksissa."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naka-off ang pag-play gamit ang cellular data. Kumonekta sa Wi-Fi, o i-on ito sa Settings."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La lecture via les données cellulaires est désactivée. Connectez-vous à un réseau Wi-Fi, ou activez-la dans Réglages."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સેલ્યુલર ડેટા પર વગાડવાનું બંધ છે. Wi-Fi સાથે કનેક્ટ કરો, અથવા સેટિંગ્સમાં તેને ચાલુ કરો."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunnawa ta datar wayar salula a kashe take. Haɗu da Wi-Fi, ko ku kunna ta a Saituna."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניגון דרך נתונים סלולריים כבוי. התחבר ל־Wi-Fi, או הפעל זאת ב״הגדרות״."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सेल्युलर डेटा पर चलाना बंद है। Wi-Fi से कनेक्ट करें, या सेटिंग्ज़ में इसे चालू करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A mobil adatokkal történő lejátszás ki van kapcsolva. Csatlakozzon Wi-Fi-hez, vagy kapcsolja be a Beállításokban."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemutaran melalui data seluler mati. Hubungkan ke Wi-Fi, atau nyalakan di Pengaturan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La riproduzione con i dati cellulare è disattivata. Connettiti al Wi-Fi oppure attivala in Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モバイルデータ通信での再生はオフになっています。Wi-Fiに接続するか、「設定」でオンにしてください。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಮೊಬೈಲ್ ಡೇಟಾ ಮೂಲಕ ಪ್ಲೇ ಮಾಡುವುದು ಆಫ್ ಆಗಿದೆ. Wi-Fi ಗೆ ಸಂಪರ್ಕಿಸಿ, ಅಥವಾ ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ ಅದನ್ನು ಆನ್ ಮಾಡಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "셀룰러 데이터로 재생이 꺼져 있습니다. Wi-Fi에 연결하거나 설정에서 켜십시오."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മൊബൈൽ ഡാറ്റ വഴി പ്ലേ ചെയ്യുന്നത് ഓഫ് ആണ്. Wi-Fi-യിലേക്ക് കണക്റ്റ് ചെയ്യുക, അല്ലെങ്കിൽ ക്രമീകരണത്തിൽ അത് ഓൺ ചെയ്യുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सेल्युलर डेटावर वाजवणे बंद आहे. Wi-Fi शी कनेक्ट करा, किंवा सेटिंग्जमध्ये ते चालू करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Main melalui data selular dimatikan. Sambung ke Wi-Fi, atau hidupkannya dalam Seting."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Avspilling over mobildata er av. Koble til Wi-Fi, eller slå det på i Innstillinger."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Afspelen via mobiele data staat uit. Maak verbinding met wifi of zet het aan in Instellingen."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸੈਲੂਲਰ ਡੇਟਾ ’ਤੇ ਚਲਾਉਣਾ ਬੰਦ ਹੈ। Wi-Fi ਨਾਲ ਕਨੈਕਟ ਕਰੋ, ਜਾਂ ਸੈਟਿੰਗਾਂ ਵਿੱਚ ਇਸਨੂੰ ਚਾਲੂ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odtwarzanie przez sieć komórkową jest wyłączone. Połącz się z Wi-Fi lub włącz je w Ustawieniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A reprodução por dados celulares está desativada. Conecte-se a uma rede Wi-Fi ou ative-a nos Ajustes."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A reprodução através de dados móveis está desativada. Ligue-se a uma rede Wi-Fi ou ative-a nas Definições."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Redarea prin date celulare este dezactivată. Conectați-vă la Wi-Fi sau activați-o în Configurări."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Uppspelning via mobildata är avstängd. Anslut till Wi-Fi eller slå på det i Inställningar."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kucheza kupitia data ya simu kumezimwa. Unganisha kwenye Wi-Fi, au uiwashe kwenye Mipangilio."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மொபைல் டேட்டா வழியாக இயக்குவது ஆஃப் ஆக உள்ளது. Wi-Fi-உடன் இணைக்கவும், அல்லது அமைப்புகளில் அதை ஆன் செய்யவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మొబైల్ డేటా ద్వారా ప్లే చేయడం ఆఫ్‌లో ఉంది. Wi-Fiకి కనెక్ట్ చేయండి, లేదా సెట్టింగ్‌లలో దాన్ని ఆన్ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเล่นผ่านข้อมูลเซลลูลาร์ปิดอยู่ ให้เชื่อมต่อ Wi-Fi หรือเปิดใช้ในการตั้งค่า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hücresel veriyle çalma kapalı. Wi-Fi’ye bağlanın veya bunu Ayarlar’dan açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відтворення через стільникові дані вимкнено. Під’єднайтеся до Wi-Fi або ввімкніть цю можливість у Параметрах."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سیلولر ڈیٹا پر چلانا بند ہے۔ Wi-Fi سے منسلک ہوں، یا سیٹنگز میں یہ اختیار آن کریں۔"
          }
        },

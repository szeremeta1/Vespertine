        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac ఇంకా “%@”ను మారుస్తోంది. కాసేపటి తర్వాత మళ్లీ ప్రయత్నించండి."
          }
        },
        "th": {
          "stringUnit": {

    "“%@” can’t be played on this device.": {
      "comment": "Phone player: the Mac refused to send a song and gave no reason.",
      "extractionState": "manual",
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» በዚህ መሣሪያ ላይ ሊጫወት አይችልም።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتعذّر تشغيل “%@” على هذا الجهاز."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” এই ডিভাইসে চালানো যাচ্ছে না।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Skladbu „%@“ nelze v tomto zařízení přehrát."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” kan ikke afspilles på denne enhed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ kann auf diesem Gerät nicht abgespielt werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το «%@» δεν μπορεί να αναπαραχθεί σε αυτήν τη συσκευή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” can’t be played on this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” no se puede reproducir en este dispositivo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» را نمی‌توان در این دستگاه پخش کرد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kappaletta ”%@” ei voi toistaa tässä laitteessa."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi mape-play ang “%@” sa device na ito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » ne peut pas être lu sur cet appareil."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” આ ડિવાઇસ પર વગાડી શકાતું નથી."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ba za a iya kunna “%@” a wannan na'ura ba."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לנגן את “%@” במכשיר זה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” इस डिवाइस पर नहीं चलाया जा सकता।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) „%@” nem játszható le ezen az eszközön."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” tidak dapat diputar di perangkat ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile riprodurre “%@” su questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」はこのデバイスで再生できません。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” ಅನ್ನು ಈ ಸಾಧನದಲ್ಲಿ ಪ್ಲೇ ಮಾಡಲು ಸಾಧ್ಯವಿಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%@’은(는) 이 기기에서 재생할 수 없습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” ഈ ഉപകരണത്തിൽ പ്ലേ ചെയ്യാനാവില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",

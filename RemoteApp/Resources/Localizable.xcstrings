        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "這看來不是地址。請輸入名稱或 IP 地址；如你知道連接埠，請在後面加上「:連接埠」。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这看起来不像地址。请输入名称或 IP 地址；如果知道端口，请在后面加上“:端口”。"

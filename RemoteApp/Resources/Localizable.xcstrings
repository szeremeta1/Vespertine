        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac ابھی “%@” کو تبدیل کر رہا ہے۔ تھوڑی دیر میں دوبارہ کوشش کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy Mac vẫn đang chuyển đổi “%@”. Hãy thử lại sau giây lát."

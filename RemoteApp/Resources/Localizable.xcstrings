        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תוקף קוד הקישור הזה פג. ב־Mac, בחר שוב ״צמד טלפון״ וסרוק את הקוד החדש."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उस पेयरिंग कोड की अवधि समाप्त हो गई है। Mac पर फिर से “फ़ोन पेयर करें” चुनें और नया कोड स्कैन करें।"
          }
        },
        "hu": {
          "stringUnit": {

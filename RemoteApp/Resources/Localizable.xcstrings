    "The Mac is still converting “%@”. Try again in a moment.": {
      "comment": "Phone player: a conversion on the Mac took longer than the phone waits.",
      "extractionState": "manual",
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac «%@»ን አሁንም በመቀየር ላይ ነው። ከአፍታ በኋላ እንደገና ይሞክሩ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما زال الـ Mac يحوّل “%@”. حاول مرة أخرى بعد لحظات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac এখনো “%@” রূপান্তর করছে। একটু পরে আবার চেষ্টা করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac ještě převádí skladbu „%@“. Zkuste to za chvíli znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac’en er stadig ved at konvertere “%@”. Prøv igen om et øjeblik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Mac konvertiert „%@“ noch. Versuche es gleich noch einmal."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Mac μετατρέπει ακόμη το «%@». Δοκιμάστε ξανά σε λίγο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Mac is still converting “%@”. Try again in a moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Mac aún está convirtiendo “%@”. Vuelve a intentarlo dentro de un momento."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac هنوز در حال تبدیل «%@» است. چند لحظهٔ دیگر دوباره امتحان کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac muuntaa yhä kappaletta ”%@”. Yritä hetken kuluttua uudelleen."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kino-convert pa ng Mac ang “%@”. Subukan ulit maya-maya."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Mac est encore en train de convertir « %@ ». Réessayez dans un instant."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac હજી “%@” રૂપાંતરિત કરી રહ્યું છે. થોડી વારમાં ફરી પ્રયાસ કરો."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac ɗin tana kan canza “%@” har yanzu. Sake gwadawa nan da ɗan lokaci."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ה־Mac עדיין ממיר את “%@”. נסה שוב בעוד רגע."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac अभी “%@” को रूपांतरित कर रहा है। थोड़ी देर में फिर से कोशिश करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Mac még alakítja át a(z) „%@” dalt. Próbálja újra egy pillanat múlva."

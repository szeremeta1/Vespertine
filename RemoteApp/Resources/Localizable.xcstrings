    "Use the volume buttons on this device.": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "በዚህ መሣሪያ ላይ ያሉትን የድምፅ መጠን አዝራሮች ይጠቀሙ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم زرَّي مستوى الصوت على هذا الجهاز."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ডিভাইসের ভলিউম বোতাম ব্যবহার করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Použijte tlačítka hlasitosti na tomto zařízení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug lydstyrkeknapperne på denne enhed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende die Lautstärketasten an diesem Gerät."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χρησιμοποιήστε τα κουμπιά έντασης ήχου αυτής της συσκευής."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa los botones de volumen de este dispositivo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "از دکمه‌های بلندی صدای این دستگاه استفاده کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käytä tämän laitteen äänenvoimakkuuspainikkeita."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Gamitin ang mga volume button sa device na ito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez les boutons de volume de cet appareil."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ ડિવાઇસનાં વૉલ્યૂમ બટનનો ઉપયોગ કરો."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Yi amfani da maɓallan ƙara na wannan na'ura."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השתמש בכפתורי עוצמת הקול של מכשיר זה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस डिवाइस के वॉल्यूम बटन का उपयोग करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Használja az eszköz hangerőgombjait."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan tombol volume di perangkat ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa i tasti del volume di questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスの音量ボタンを使用してください。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಸಾಧನದ ವಾಲ್ಯೂಮ್ ಬಟನ್‌ಗಳನ್ನು ಬಳಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기의 음량 버튼을 사용하십시오."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ ഉപകരണത്തിലെ വോളിയം ബട്ടണുകൾ ഉപയോഗിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या डिव्हाइसवरील व्हॉल्यूम बटणे वापरा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan butang kelantangan pada peranti ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruk volumknappene på denne enheten."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik de volumeknoppen van dit apparaat."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ ਡਿਵਾਈਸ ਦੇ ਵੌਲਿਊਮ ਬਟਨ ਵਰਤੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj przycisków głośności na tym urządzeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use os botões de volume deste dispositivo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Use os botões de volume deste dispositivo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilizați butoanele de volum ale acestui dispozitiv."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Använd volymknapparna på den här enheten."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Tumia vitufe vya sauti kwenye kifaa hiki."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தச் சாதனத்தின் ஒலியளவு பட்டன்களைப் பயன்படுத்தவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ పరికరంలోని వాల్యూమ్ బటన్‌లను ఉపయోగించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ปุ่มปรับระดับเสียงบนอุปกรณ์เครื่องนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu aygıttaki ses düğmelerini kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Користуйтеся кнопками гучності на цьому пристрої."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس ڈیوائس کے والیوم بٹن استعمال کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy dùng các nút âm lượng trên thiết bị này."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "請使用此裝置的音量按鈕。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请使用此设备的音量按钮。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請使用此裝置的音量按鈕。"
          }
        }
      }
    },
    "Usually not needed: with Tailscale on both the Mac and this device, Vespertine finds the Mac by itself once they have connected at home. Type an address only for a way the Mac can’t tell on its own, such as a forwarded port. The Mac must be awake with Vespertine open; Settings › Remote on the Mac can keep it awake.": {
      "comment": "Shown on the iPhone or iPad. Footer under the field where an address for the Mac can be typed by hand. “Settings › Remote” is a path in the Mac app: use the Mac app's established names.",
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ብዙውን ጊዜ አያስፈልግም፦ Tailscale በMac እና በዚህ መሣሪያ ላይ ካለ፣ አንድ ጊዜ በቤት ውስጥ ከተገናኙ በኋላ Vespertine Macን በራሱ ያገኘዋል። አድራሻ የሚተይቡት Mac በራሱ ሊያውቀው ለማይችል መንገድ ብቻ ነው፣ ለምሳሌ ፎርዋርድ የተደረገ ፖርት። Mac ንቁ እና Vespertine በእሱ ላይ የተከፈተ መሆን አለበት፤ በMac ላይ ቅንብሮች › ሪሞት ንቁ አድርጎ ሊያቆየው ይችላል።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا حاجة إليه في العادة: عند تشغيل Tailscale على الـ Mac وعلى هذا الجهاز، يعثر Vespertine على الـ Mac تلقائيًا بعد أن يتصلا مرة واحدة في المنزل. اكتب عنوانًا فقط لطريقة لا يستطيع الـ Mac معرفتها بنفسه، مثل منفذ مُعاد توجيهه. يجب أن يكون الـ Mac في وضع الاستيقاظ و Vespertine مفتوحًا عليه؛ ويمكن إبقاؤه مستيقظًا من الإعدادات › التحكم عن بُعد على الـ Mac."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সাধারণত এর দরকার হয় না: Mac ও এই ডিভাইস দুটিতেই Tailscale থাকলে, বাড়িতে একবার সংযুক্ত হওয়ার পর Vespertine নিজে থেকেই Mac খুঁজে নেয়। শুধু এমন পথের জন্য ঠিকানা টাইপ করুন যা Mac নিজে জানাতে পারে না, যেমন ফরওয়ার্ড করা পোর্ট। Mac-কে জেগে থাকতে হবে এবং তাতে Vespertine খোলা থাকতে হবে; Mac-এর সেটিংস › রিমোট সেটিকে জাগিয়ে রাখতে পারে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Obvykle není potřeba: je-li Tailscale zapnutý na Macu i v tomto zařízení, Vespertine najde Mac sám, jakmile se jednou spojili doma. Adresu zadejte jen pro cestu, kterou Mac sám zjistit nedokáže, například přesměrovaný port. Mac musí být probuzený a Vespertine na něm otevřený; v Nastavení › Dálkové ovládání na Macu lze zajistit, aby neusnul."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Normalt ikke nødvendigt: Med Tailscale på både Mac’en og denne enhed finder Vespertine selv Mac’en, når de har haft forbindelse derhjemme. Skriv kun en adresse til en vej, som Mac’en ikke selv kan oplyse, f.eks. en videresendt port. Mac’en skal være vågen og have Vespertine åben; Indstillinger › Fjernbetjening på Mac’en kan holde den vågen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Normalerweise nicht nötig: Wenn Tailscale auf dem Mac und auf diesem Gerät aktiv ist, findet Vespertine den Mac von selbst, sobald sich beide einmal zu Hause verbunden haben. Gib eine Adresse nur für einen Weg ein, den der Mac nicht selbst mitteilen kann, etwa einen weitergeleiteten Port. Der Mac darf nicht im Ruhezustand sein und Vespertine muss geöffnet sein; unter „Einstellungen › Fernbedienung“ auf dem Mac kannst du ihn wach halten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συνήθως δεν χρειάζεται: με το Tailscale ενεργό τόσο στο Mac όσο και σε αυτήν τη συσκευή, το Vespertine βρίσκει μόνο του το Mac, αφού συνδεθούν μία φορά στο σπίτι. Πληκτρολογήστε διεύθυνση μόνο για τρόπο σύνδεσης που το Mac δεν μπορεί να γνωστοποιήσει μόνο του, όπως μια προωθημένη θύρα. Το Mac πρέπει να είναι σε αφύπνιση με το Vespertine ανοιχτό· από τις «Ρυθμίσεις» › «Τηλεχειρισμός» στο Mac μπορείτε να το διατηρείτε σε αφύπνιση."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Normalmente no hace falta: con Tailscale en el Mac y en este dispositivo, Vespertine encuentra el Mac por sí solo una vez que se han conectado en casa. Escribe una dirección solo para una vía que el Mac no pueda indicar por sí mismo, como un puerto redirigido. El Mac no debe estar en reposo y Vespertine debe estar abierto; en Ajustes › Control remoto, en el Mac, puedes evitar que entre en reposo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "معمولاً لازم نیست: اگر Tailscale هم در Mac و هم در این دستگاه روشن باشد، Vespertine پس از یک بار اتصال در خانه، خودش Mac را پیدا می‌کند. فقط برای راهی نشانی تایپ کنید که Mac خودش نمی‌تواند آن را تشخیص دهد، مثل درگاه هدایت‌شده. Mac باید بیدار و Vespertine در آن باز باشد؛ «تنظیمات» › «کنترل از راه دور» در Mac می‌تواند آن را بیدار نگه دارد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yleensä tätä ei tarvita: kun Tailscale on käytössä sekä Macissa että tässä laitteessa, Vespertine löytää Macin itse, kunhan ne ovat kerran yhdistäneet kotona. Kirjoita osoite vain sellaista reittiä varten, jota Mac ei voi itse kertoa, esimerkiksi edelleenohjattua porttia varten. Macin on oltava hereillä ja Vespertinen avoinna; Macin kohdassa Asetukset › Kaukosäädin voit pitää Macin hereillä."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kadalasang hindi kailangan: kapag may Tailscale sa Mac at sa device na ito, kusang nahahanap ng Vespertine ang Mac kapag nakakonekta na ang mga ito nang isang beses sa bahay. Mag-type lang ng address para sa paraang hindi kayang sabihin ng Mac nang mag-isa, gaya ng naka-forward na port. Dapat gising ang Mac at nakabukas ang Vespertine; kaya itong panatilihing gising ng Settings › Remote sa Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Généralement inutile : si Tailscale est actif sur le Mac et sur cet appareil, Vespertine trouve le Mac de lui-même une fois qu’ils se sont connectés chez vous. Ne saisissez une adresse que pour un moyen que le Mac ne peut pas indiquer lui-même, par exemple un port redirigé. Le Mac ne doit pas être en veille et Vespertine doit y être ouvert ; Réglages › Télécommande sur le Mac permet d’empêcher la mise en veille."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સામાન્ય રીતે આની જરૂર પડતી નથી: Mac અને આ ડિવાઇસ બંને પર Tailscale હોય, તો ઘરે એક વાર કનેક્ટ થયા પછી Vespertine આપમેળે Mac ને શોધી લે છે. સરનામું ફક્ત એવી રીત માટે ટાઇપ કરો જે Mac પોતે જણાવી શકતું નથી, જેમ કે ફૉરવર્ડ કરેલો પોર્ટ. Mac જાગતું હોવું જોઈએ અને તેમાં Vespertine ખુલ્લું હોવું જોઈએ; Mac પર સેટિંગ્સ › રિમોટ તેને જાગતું રાખી શકે છે."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Galibi ba a buƙata: idan Tailscale na kunne a kan Mac ɗin da kuma wannan na'ura, Vespertine yana nemo Mac ɗin da kansa da zarar sun haɗu a gida. Rubuta adireshi kawai don hanyar da Mac ɗin ba za ta iya ganowa da kanta ba, kamar port da aka tura. Dole ne Mac ɗin ta kasance a farke kuma Vespertine a buɗe; Saituna › Rimot a kan Mac na iya riƙe ta a farke."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בדרך כלל אין בכך צורך: כאשר Tailscale פועל גם ב־Mac וגם במכשיר זה, Vespertine מוצא את ה־Mac בעצמו לאחר שהתחברו פעם אחת בבית. הקלד כתובת רק עבור דרך שה־Mac אינו יכול לזהות בעצמו, כגון יציאה מועברת. ה־Mac צריך להיות ער ו־Vespertine פתוח בו; ״הגדרות״ › ״שלט רחוק״ ב־Mac יכול להשאיר אותו ער."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आम तौर पर इसकी ज़रूरत नहीं पड़ती: Mac और इस डिवाइस दोनों पर Tailscale हो, तो घर पर एक बार कनेक्ट होने के बाद Vespertine Mac को अपने आप ढूँढ लेता है। पता केवल उस रास्ते के लिए टाइप करें जिसे Mac ख़ुद नहीं बता सकता, जैसे फ़ॉरवर्ड किया गया पोर्ट। Mac जागा हुआ होना चाहिए और उस पर Vespertine खुला होना चाहिए; Mac पर सेटिंग्ज़ › रिमोट उसे जगाए रख सकता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Általában nincs rá szükség: ha a Tailscale a Macen és ezen az eszközön is be van kapcsolva, a Vespertine magától megtalálja a Macet, miután otthon egyszer csatlakoztak. Csak olyan elérési módhoz írjon be címet, amelyet a Mac magától nem tud megadni, például továbbított porthoz. A Macnek ébren kell lennie, és a Vespertine-nek nyitva kell lennie rajta; a Macen a Beállítások › Távirányító alatt megadható, hogy ébren maradjon."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Biasanya tidak diperlukan: dengan Tailscale di Mac dan di perangkat ini, Vespertine menemukan Mac dengan sendirinya setelah keduanya pernah terhubung di rumah. Ketik alamat hanya untuk cara yang tidak dapat diberitahukan sendiri oleh Mac, misalnya port yang diteruskan. Mac harus terjaga dengan Vespertine terbuka; Pengaturan › Kendali Jauh di Mac dapat membuatnya tetap terjaga."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Di solito non serve: con Tailscale sia sul Mac sia su questo dispositivo, Vespertine trova il Mac da solo dopo che si sono connessi a casa. Inserisci un indirizzo solo per un percorso che il Mac non può indicare da sé, ad esempio una porta inoltrata. Il Mac non deve essere in stop e Vespertine deve essere aperto; da Impostazioni › Telecomando sul Mac puoi impedire che vada in stop."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通常は必要ありません。Macとこのデバイスの両方でTailscaleを使っている場合は、自宅で一度接続すれば、VespertineがMacを自動的に見つけます。アドレスを入力するのは、転送されたポートなど、Macが自分では伝えられない経路の場合だけです。Macがスリープしておらず、Vespertineが開いている必要があります。Macの「設定」›「リモート」で、Macがスリープしないようにできます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸಾಮಾನ್ಯವಾಗಿ ಇದರ ಅಗತ್ಯವಿಲ್ಲ: Mac ಮತ್ತು ಈ ಸಾಧನ ಎರಡರಲ್ಲೂ Tailscale ಇದ್ದರೆ, ಮನೆಯಲ್ಲಿ ಒಮ್ಮೆ ಸಂಪರ್ಕಗೊಂಡ ನಂತರ Vespertine ತಾನಾಗಿಯೇ Mac ಅನ್ನು ಹುಡುಕುತ್ತದೆ. Mac ತಾನಾಗಿ ತಿಳಿಸಲಾಗದ ಮಾರ್ಗಕ್ಕೆ ಮಾತ್ರ ವಿಳಾಸವನ್ನು ಟೈಪ್ ಮಾಡಿ, ಉದಾಹರಣೆಗೆ ಫಾರ್ವರ್ಡ್ ಮಾಡಿದ ಪೋರ್ಟ್. Mac ಎಚ್ಚರವಾಗಿರಬೇಕು ಮತ್ತು ಅದರಲ್ಲಿ Vespertine ತೆರೆದಿರಬೇಕು; Mac ನ ಸೆಟ್ಟಿಂಗ್‌ಗಳು › ರಿಮೋಟ್ ಅದನ್ನು ಎಚ್ಚರವಾಗಿರಿಸಬಲ್ಲದು."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대개는 필요하지 않습니다. Mac과 이 기기 모두에서 Tailscale을 사용 중이라면, 집에서 한 번 연결한 후에는 Vespertine이 Mac을 자동으로 찾습니다. 포워딩된 포트처럼 Mac이 스스로 알려 줄 수 없는 경로인 경우에만 주소를 입력하십시오. Mac이 깨어 있고 Vespertine이 열려 있어야 합니다. Mac의 설정 › 리모트에서 Mac을 깨어 있는 상태로 유지할 수 있습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സാധാരണയായി ആവശ്യമില്ല: Mac-ലും ഈ ഉപകരണത്തിലും Tailscale ഉണ്ടെങ്കിൽ, വീട്ടിൽ വെച്ച് ഒരിക്കൽ കണക്റ്റ് ചെയ്തുകഴിഞ്ഞാൽ Vespertine തനിയെ Mac കണ്ടെത്തും. ഫോർവേഡ് ചെയ്ത പോർട്ട് പോലെ, Mac-ന് സ്വയം അറിയിക്കാനാവാത്ത വഴിക്ക് മാത്രം ഒരു വിലാസം ടൈപ്പ് ചെയ്യുക. Mac ഉണർന്നിരിക്കുകയും അതിൽ Vespertine തുറന്നിരിക്കുകയും വേണം; Mac-ലെ ക്രമീകരണം › റിമോട്ട് എന്നതിൽ അതിനെ ഉണർത്തി നിർത്താനാകും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सहसा याची गरज नसते: Mac आणि हे डिव्हाइस दोन्हींवर Tailscale असल्यास, घरी एकदा कनेक्ट झाल्यानंतर Vespertine आपोआप Mac शोधते. पत्ता फक्त अशा मार्गासाठी टाइप करा जो Mac स्वतः कळवू शकत नाही, जसे की फॉरवर्ड केलेला पोर्ट. Mac जागा असावा आणि त्यावर Vespertine उघडे असावे; Mac वरील सेटिंग्ज › रिमोट त्याला जागे ठेवू शकते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Biasanya tidak diperlukan: dengan Tailscale pada Mac dan peranti ini, Vespertine mencari Mac dengan sendirinya selepas kedua-duanya pernah bersambung di rumah. Taip alamat hanya untuk cara yang tidak dapat diberitahu sendiri oleh Mac, seperti port yang dimajukan. Mac mesti berjaga dengan Vespertine dibuka; Seting › Kawalan Jauh pada Mac boleh memastikannya terus berjaga."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vanligvis ikke nødvendig: Med Tailscale på både Macen og denne enheten finner Vespertine Macen av seg selv når de først har koblet til hjemme. Skriv inn en adresse bare for en vei Macen ikke kan oppgi selv, for eksempel en videresendt port. Macen må være våken og ha Vespertine åpen; Innstillinger › Fjernkontroll på Macen kan holde den våken."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meestal niet nodig: met Tailscale op zowel de Mac als dit apparaat vindt Vespertine de Mac vanzelf zodra ze thuis één keer verbinding hebben gemaakt. Typ alleen een adres voor een manier die de Mac niet zelf kan doorgeven, zoals een doorgestuurde poort. De Mac moet uit de sluimerstand zijn met Vespertine geopend; via ‘Instellingen › Afstandsbediening’ op de Mac kun je hem wakker houden."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਆਮ ਤੌਰ ’ਤੇ ਇਸਦੀ ਲੋੜ ਨਹੀਂ ਪੈਂਦੀ: Mac ਅਤੇ ਇਸ ਡਿਵਾਈਸ ਦੋਵਾਂ ’ਤੇ Tailscale ਹੋਵੇ, ਤਾਂ ਘਰ ਵਿੱਚ ਇੱਕ ਵਾਰ ਕਨੈਕਟ ਹੋਣ ਤੋਂ ਬਾਅਦ Vespertine ਆਪਣੇ ਆਪ Mac ਨੂੰ ਲੱਭ ਲੈਂਦਾ ਹੈ। ਪਤਾ ਸਿਰਫ਼ ਉਸ ਰਾਹ ਲਈ ਟਾਈਪ ਕਰੋ ਜਿਹੜਾ Mac ਆਪ ਨਹੀਂ ਦੱਸ ਸਕਦਾ, ਜਿਵੇਂ ਕਿ ਫ਼ਾਰਵਰਡ ਕੀਤਾ ਪੋਰਟ। Mac ਜਾਗਦਾ ਹੋਣਾ ਚਾਹੀਦਾ ਹੈ ਅਤੇ ਉਸ ’ਤੇ Vespertine ਖੁੱਲ੍ਹਾ ਹੋਣਾ ਚਾਹੀਦਾ ਹੈ; Mac ’ਤੇ ਸੈਟਿੰਗਾਂ › ਰਿਮੋਟ ਉਸਨੂੰ ਜਾਗਦਾ ਰੱਖ ਸਕਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwykle niepotrzebne: gdy Tailscale działa na Macu i na tym urządzeniu, Vespertine samo znajduje Maca, o ile wcześniej połączyły się w domu. Wpisz adres tylko dla drogi, której Mac nie potrafi wskazać sam, na przykład przekierowanego portu. Mac nie może być uśpiony, a Vespertine musi być na nim otwarte; Ustawienia › Pilot na Macu pozwalają zapobiec jego usypianiu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Normalmente não é necessário: com o Tailscale no Mac e neste dispositivo, o Vespertine encontra o Mac sozinho depois que eles se conectam em casa. Digite um endereço apenas para um caminho que o Mac não consiga informar por conta própria, como uma porta redirecionada. O Mac não pode estar em repouso e o Vespertine precisa estar aberto; em Ajustes › Controle Remoto, no Mac, você pode impedir o repouso."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Normalmente não é necessário: com o Tailscale no Mac e neste dispositivo, o Vespertine encontra o Mac sozinho depois de se terem ligado em casa. Escreva um endereço apenas para uma via que o Mac não consiga indicar por si próprio, como uma porta reencaminhada. O Mac tem de estar ativo, com o Vespertine aberto; em Definições › Controlo remoto, no Mac, é possível mantê-lo ativo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "De obicei nu este necesar: cu Tailscale atât pe Mac, cât și pe acest dispozitiv, Vespertine găsește singur Mac-ul după ce s-au conectat o dată acasă. Introduceți o adresă doar pentru o cale pe care Mac-ul nu o poate indica singur, cum ar fi un port redirecționat. Mac-ul trebuie să fie activ, cu Vespertine deschis; Configurări › Telecomandă pe Mac îl poate menține activ."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Behövs oftast inte: med Tailscale på både Macen och den här enheten hittar Vespertine Macen av sig självt när de väl har anslutit hemma. Skriv bara en adress för en väg som Macen inte kan tala om själv, till exempel en vidarebefordrad port. Macen måste vara vaken och ha Vespertine öppet; Inställningar › Fjärrkontroll på Macen kan hålla den vaken."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kwa kawaida haihitajiki: Tailscale ikiwa imewashwa kwenye Mac na kwenye kifaa hiki, Vespertine huipata Mac yenyewe baada ya vyote viwili kuunganishwa nyumbani mara moja. Andika anwani tu kwa njia ambayo Mac haiwezi kuitambua yenyewe, kama vile port iliyoelekezwa. Lazima Mac iwe macho na Vespertine iwe wazi; Mipangilio › Rimoti kwenye Mac inaweza kuifanya ibaki macho."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பொதுவாகத் தேவைப்படாது: Mac-இலும் இந்தச் சாதனத்திலும் Tailscale இருந்தால், வீட்டில் ஒருமுறை இணைந்த பிறகு Vespertine தானாகவே Mac-ஐக் கண்டறியும். ஃபார்வர்டு செய்யப்பட்ட போர்ட் போன்று, Mac தானாகத் தெரிவிக்க முடியாத வழிக்கு மட்டும் ஒரு முகவரியை டைப் செய்யவும். Mac விழிப்பில் இருக்க வேண்டும், அதில் Vespertine திறந்திருக்க வேண்டும்; Mac-இல் அமைப்புகள் › ரிமோட் என்பதில் அதை விழிப்பில் வைத்திருக்கலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సాధారణంగా అవసరం ఉండదు: Macలో, ఈ పరికరంలో Tailscale ఉంటే, ఇంట్లో ఒకసారి కనెక్ట్ అయిన తర్వాత Vespertine తానే Macను కనుగొంటుంది. ఫార్వర్డ్ చేసిన పోర్ట్ వంటి, Mac తనంతట తాను తెలియజేయలేని మార్గానికి మాత్రమే చిరునామాను టైప్ చేయండి. Mac మేల్కొని ఉండాలి, అందులో Vespertine తెరిచి ఉండాలి; Macలోని సెట్టింగ్‌లు › రిమోట్‌లో దాన్ని మేల్కొని ఉంచవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โดยปกติไม่จำเป็นต้องใช้ หากมี Tailscale ทั้งบน Mac และอุปกรณ์เครื่องนี้ Vespertine จะค้นหา Mac เองหลังจากที่ทั้งสองเครื่องเคยเชื่อมต่อกันที่บ้านแล้ว ให้ป้อนที่อยู่เฉพาะสำหรับวิธีที่ Mac แจ้งเองไม่ได้ เช่น พอร์ตที่ส่งต่อ Mac ต้องไม่ได้พักเครื่องและเปิด Vespertine ไว้ โดยการตั้งค่า › รีโมตบน Mac ช่วยไม่ให้ Mac พักเครื่องได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Genellikle gerekmez: Tailscale hem Mac’te hem bu aygıtta açıksa, evde bir kez bağlandıktan sonra Vespertine Mac’i kendiliğinden bulur. Yalnızca Mac’in kendi başına bildiremeyeceği bir yol (örneğin yönlendirilmiş bir kapı) için adres yazın. Mac uyanık, Vespertine de açık olmalıdır; Mac’teki Ayarlar › Uzaktan Kumanda bölümü Mac’i uyanık tutabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зазвичай це не потрібно: якщо Tailscale увімкнено і на Mac, і на цьому пристрої, Vespertine сам знаходить Mac після того, як вони з’єдналися вдома. Вводьте адресу лише для способу, про який Mac не може дізнатися сам, наприклад для переадресованого порту. Mac має не спати, а Vespertine має бути відкрито на ньому; у меню «Параметри» › «Пульт» на Mac можна заборонити йому засинати."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "عام طور پر اس کی ضرورت نہیں: اگر Mac اور اس ڈیوائس دونوں پر Tailscale ہو تو گھر پر ایک بار منسلک ہونے کے بعد Vespertine خود ہی Mac کو ڈھونڈ لیتا ہے۔ پتہ صرف اس راستے کے لیے ٹائپ کریں جسے Mac خود معلوم نہیں کر سکتا، جیسے فارورڈ کیا گیا پورٹ۔ ضروری ہے کہ Mac جاگ رہا ہو اور اس پر Vespertine کھلا ہو؛ Mac پر سیٹنگز › ریموٹ سے اسے جگائے رکھا جا سکتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thường không cần đến: khi có Tailscale trên cả máy Mac và thiết bị này, Vespertine tự tìm thấy máy Mac sau khi hai thiết bị đã kết nối với nhau ở nhà. Chỉ nhập địa chỉ cho cách kết nối mà máy Mac không thể tự báo, chẳng hạn như một cổng được chuyển tiếp. Máy Mac phải đang thức và đang mở Vespertine; Cài đặt › Điều khiển từ xa trên máy Mac có thể giữ cho máy luôn thức."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "通常無需使用：如 Mac 和此裝置都使用 Tailscale，在家中連接過一次後，Vespertine 便能自動找到 Mac。只有 Mac 無法自行告知的方式（例如轉發的連接埠）才需要輸入地址。Mac 必須處於喚醒狀態並已開啟 Vespertine；你可以在 Mac 上的「設定」›「遙控」中讓它保持喚醒。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通常不需要：如果 Mac 和此设备都在使用 Tailscale，在家中连接过一次后，Vespertine 就能自动找到 Mac。只有 Mac 无法自行告知的方式（例如转发的端口）才需要输入地址。Mac 必须处于唤醒状态且已打开 Vespertine；可在 Mac 上的“设置”›“遥控”中让它保持唤醒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "通常不需要：如果 Mac 和此裝置都使用 Tailscale，在家中連線過一次後，Vespertine 就能自動找到 Mac。只有 Mac 無法自行告知的方式（例如轉送的連接埠）才需要輸入位址。Mac 必須處於喚醒狀態且已打開 Vespertine；你可以在 Mac 上的「設定」›「遙控」中讓它保持喚醒。"
          }
        }
      }
    },

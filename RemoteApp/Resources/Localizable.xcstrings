    "Fixed volume: set the level on your amplifier or DAC": {
      "comment": "Web remote: the output's volume can't be changed from Vespertine.",
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ቋሚ የድምፅ መጠን፦ ደረጃውን በአምፕሊፋየርዎ ወይም በDACዎ ላይ ያዘጋጁ"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مستوى صوت ثابت: اضبط المستوى على المضخم أو DAC"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নির্দিষ্ট ভলিউম: আপনার অ্যামপ্লিফায়ার বা DAC-এ লেভেল ঠিক করুন"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pevná hlasitost: nastavte úroveň na zesilovači nebo DAC"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fast lydstyrke: Indstil niveauet på din forstærker eller DAC"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Feste Lautstärke: Stelle den Pegel an deinem Verstärker oder DAC ein"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σταθερή ένταση: ρυθμίστε τη στάθμη στον ενισχυτή ή στο DAC σας"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Volumen fijo: ajusta el nivel en tu amplificador o DAC"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "صدای ثابت: سطح صدا را روی تقویت‌کننده یا DAC خود تنظیم کنید"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiinteä äänenvoimakkuus: säädä tasoa vahvistimesta tai DAC:sta"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nakapirming volume: itakda ang level sa amplifier o DAC mo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Volume fixe : réglez le niveau sur votre amplificateur ou votre DAC"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "નિશ્ચિત વૉલ્યૂમ: તમારા ઍમ્પ્લિફાયર અથવા DAC પર લેવલ સેટ કરો"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ƙarar tsayayyiya: saita matakin a amplifier ko DAC ɗinku"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עוצמת קול קבועה: כוונן את הרמה במגבר או ב־DAC"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "निश्चित वॉल्यूम: लेवल अपने एम्प्लिफ़ायर या DAC पर सेट करें"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Rögzített hangerő: állítsa be a szintet az erősítőn vagy a DAC-on"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Volume tetap: atur levelnya di amplifier atau DAC Anda"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Volume fisso: regola il livello sull’amplificatore o sul DAC"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "固定音量：アンプまたはDACで音量を調整してください"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸ್ಥಿರ ವಾಲ್ಯೂಮ್: ನಿಮ್ಮ ಆಂಪ್ಲಿಫೈಯರ್ ಅಥವಾ DAC ನಲ್ಲಿ ಮಟ್ಟವನ್ನು ಹೊಂದಿಸಿ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고정 음량: 앰프 또는 DAC에서 음량을 설정하십시오"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സ്ഥിരമായ വോളിയം: നിങ്ങളുടെ ആംപ്ലിഫയറിലോ DAC-ലോ ലെവൽ സജ്ജമാക്കുക"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "निश्चित व्हॉल्यूम: तुमच्या ॲम्प्लिफायर किंवा DAC वर लेव्हल सेट करा"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelantangan tetap: tetapkan tahapnya pada penguat atau DAC anda"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fast volum: Still inn nivået på forsterkeren eller DAC-en"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vast volume: stel het niveau in op je versterker of DAC"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਥਿਰ ਵੌਲਿਊਮ: ਆਪਣੇ ਐਂਪਲੀਫ਼ਾਇਰ ਜਾਂ DAC ’ਤੇ ਲੈਵਲ ਸੈੱਟ ਕਰੋ"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stała głośność: ustaw poziom na wzmacniaczu lub przetworniku DAC"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Volume fixo: ajuste o nível no seu amplificador ou DAC"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Volume fixo: ajuste o nível no amplificador ou no DAC"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Volum fix: setați nivelul de pe amplificator sau DAC"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fast volym: ställ in nivån på din förstärkare eller DAC"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiwango cha sauti kisichobadilika: weka kiwango kwenye amplifaya au DAC yako"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நிலையான ஒலியளவு: உங்கள் ஆம்ப்ளிஃபையர் அல்லது DAC-இல் அளவை அமைக்கவும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "స్థిర వాల్యూమ్: మీ యాంప్లిఫైయర్ లేదా DACలో స్థాయిని సెట్ చేయండి"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระดับเสียงคงที่: ตั้งระดับเสียงที่แอมป์หรือ DAC ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sabit ses düzeyi: Düzeyi amfinizden veya DAC’nizden ayarlayın"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Фіксована гучність: установіть рівень на підсилювачі або ЦАП"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مقررہ والیوم: لیول اپنے ایمپلیفائر یا DAC پر سیٹ کریں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Âm lượng cố định: hãy đặt mức âm lượng trên bộ khuếch đại hoặc DAC của bạn"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "固定音量：請在擴音機或 DAC 上設定音量"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",

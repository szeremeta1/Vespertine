          }
        }
      }
    },
    "Reduce Motion is on in the system’s Accessibility settings, so Cover Flow stays flat and doesn’t follow the device, and the record doesn’t turn.": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "«እንቅስቃሴን ቀንስ» በሥርዓቱ የተደራሽነት ቅንብሮች ውስጥ በርቷል፤ ስለዚህ Cover Flow ጠፍጣፋ ሆኖ ይቆያል፣ መሣሪያውን አይከተልም፣ ሸክላውም አይሽከረከርም።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خيار “تقليل الحركة” مشغَّل في إعدادات تسهيلات الاستخدام في النظام، لذلك يبقى Cover Flow مسطحًا ولا يتبع حركة الجهاز، ولا تدور الأسطوانة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সিস্টেমের অ্যাক্সেসিবিলিটি সেটিংসে “মোশন কমান” চালু আছে, তাই Cover Flow সমতল থাকে ও ডিভাইসের নড়াচড়া অনুসরণ করে না, আর রেকর্ডটি ঘোরে না।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V systémovém nastavení Zpřístupnění je zapnutá volba Omezit pohyb, takže Cover Flow zůstává plochý a nesleduje pohyb zařízení a deska se neotáčí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Reducer bevægelse er slået til i systemets indstillinger til Tilgængelighed, så Cover Flow forbliver fladt og følger ikke enheden, og pladen drejer ikke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Bewegung reduzieren“ ist in den Bedienungshilfen des Systems aktiviert. Daher bleibt Cover Flow flach und folgt dem Gerät nicht, und die Schallplatte dreht sich nicht."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η «Μείωση κίνησης» είναι ενεργή στις ρυθμίσεις Προσβασιμότητας του συστήματος, γι’ αυτό το Cover Flow μένει επίπεδο και δεν ακολουθεί τη συσκευή, και ο δίσκος δεν γυρίζει."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“Reducir movimiento” está activado en los ajustes de accesibilidad del sistema, así que Cover Flow permanece plano y no sigue al dispositivo, y el disco no gira."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "«کاهش حرکت» در تنظیمات «دسترسی‌پذیری» سیستم روشن است، بنابراین Cover Flow تخت می‌ماند و حرکت دستگاه را دنبال نمی‌کند و صفحه هم نمی‌چرخد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vähennä liikettä on päällä järjestelmän Käyttöapu-asetuksissa, joten Cover Flow pysyy litteänä eikä seuraa laitetta, eikä levy pyöri."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naka-on ang Reduce Motion sa Accessibility settings ng system, kaya nananatiling flat ang Cover Flow at hindi nito sinusundan ang device, at hindi umiikot ang plaka."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réduire les animations est activé dans les réglages Accessibilité du système : Cover Flow reste donc à plat et ne suit pas l’appareil, et le vinyle ne tourne pas."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સિસ્ટમના ઍક્સેસિબિલિટી સેટિંગ્સમાં “મોશન ઘટાડો” ચાલુ છે, તેથી Cover Flow સપાટ રહે છે અને ડિવાઇસની હિલચાલને અનુસરતું નથી, અને રેકોર્ડ ફરતો નથી."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Rage Motsi a kunne yake a saitunan Samun Dama na tsarin, don haka Cover Flow yana zama a kwance ba ya bin na'urar, faifan kuma ba ya juyawa."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האפשרות ״הפחת תנועה״ מופעלת בהגדרות הנגישות של המערכת, ולכן Cover Flow נשאר שטוח ואינו עוקב אחר המכשיר, והתקליט אינו מסתובב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिस्टम की ऐक्सेसिबिलिटी सेटिंग्ज़ में “मोशन कम करें” चालू है, इसलिए Cover Flow सपाट रहता है और डिवाइस की गति के साथ नहीं चलता, और रिकॉर्ड नहीं घूमता।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A rendszer Kisegítő lehetőségek beállításaiban be van kapcsolva a Mozgás csökkentése, ezért a Cover Flow lapos marad, és nem követi az eszközt, a lemez pedig nem forog."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurangi Gerakan menyala di pengaturan Aksesibilitas sistem, sehingga Cover Flow tetap datar dan tidak mengikuti perangkat, dan piringan hitam tidak berputar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“Riduci movimento” è attivo nelle impostazioni di accessibilità del sistema, quindi Cover Flow resta piatto e non segue il dispositivo, e il disco non gira."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムの「アクセシビリティ」設定で「視差効果を減らす」がオンになっているため、Cover Flowは平面のままでデバイスの動きに追従せず、レコードも回りません。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸಿಸ್ಟಂನ ಆ್ಯಕ್ಸೆಸಿಬಿಲಿಟಿ ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ “ಚಲನೆ ಕಡಿಮೆ ಮಾಡಿ” ಆನ್ ಆಗಿದೆ, ಆದ್ದರಿಂದ Cover Flow ಸಮತಟ್ಟಾಗಿಯೇ ಇರುತ್ತದೆ ಮತ್ತು ಸಾಧನವನ್ನು ಅನುಸರಿಸುವುದಿಲ್ಲ, ರೆಕಾರ್ಡ್ ಕೂಡ ತಿರುಗುವುದಿಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템의 손쉬운 사용 설정에서 ‘동작 줄이기’가 켜져 있으므로 Cover Flow는 평평하게 유지되어 기기의 움직임을 따라가지 않고, 레코드도 돌지 않습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സിസ്റ്റത്തിന്റെ ആക്‌സസബിലിറ്റി ക്രമീകരണത്തിൽ “ചലനം കുറയ്ക്കുക” ഓൺ ആണ്; അതിനാൽ Cover Flow പരന്നുതന്നെ നിൽക്കും, ഉപകരണത്തെ പിന്തുടരില്ല, റെക്കോർഡ് കറങ്ങുകയുമില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सिस्टमच्या ॲक्सेसिबिलिटी सेटिंग्जमध्ये “मोशन कमी करा” चालू आहे, त्यामुळे Cover Flow सपाट राहते व डिव्हाइसच्या हालचालीनुसार बदलत नाही, आणि रेकॉर्ड फिरत नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurangkan Gerakan dihidupkan dalam seting Kebolehcapaian sistem, jadi Cover Flow kekal rata dan tidak mengikut peranti, dan piring hitam tidak berputar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduser bevegelse er på i systemets Tilgjengelighet-innstillinger, så Cover Flow forblir flatt og følger ikke enheten, og platen snurrer ikke."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "‘Verminder beweging’ staat aan in de toegankelijkheidsinstellingen van het systeem. Daarom blijft Cover Flow vlak en volgt het het apparaat niet, en draait de plaat niet."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਿਸਟਮ ਦੀਆਂ ਐਕਸੈਸਬਿਲਟੀ ਸੈਟਿੰਗਾਂ ਵਿੱਚ “ਮੋਸ਼ਨ ਘਟਾਓ” ਚਾਲੂ ਹੈ, ਇਸ ਲਈ Cover Flow ਸਪਾਟ ਰਹਿੰਦਾ ਹੈ ਅਤੇ ਡਿਵਾਈਸ ਦੀ ਹਿਲਜੁਲ ਨਾਲ ਨਹੀਂ ਬਦਲਦਾ, ਅਤੇ ਰਿਕਾਰਡ ਨਹੀਂ ਘੁੰਮਦਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W systemowych ustawieniach Dostępności włączona jest opcja Redukuj ruch, więc Cover Flow pozostaje płaski i nie podąża za urządzeniem, a płyta się nie obraca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduzir Movimento está ativado nos ajustes de Acessibilidade do sistema; por isso, o Cover Flow fica plano e não acompanha o dispositivo, e o disco não gira."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduzir movimento está ativado nas definições de acessibilidade do sistema; por isso, o Cover Flow fica plano e não acompanha o dispositivo, e o disco não roda."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Opțiunea Reducere mișcare este activată în configurările de accesibilitate ale sistemului, așa că Cover Flow rămâne plat și nu urmărește dispozitivul, iar discul nu se învârte."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Minska rörelser är på i systemets hjälpmedelsinställningar, så Cover Flow förblir platt och följer inte enheten, och skivan snurrar inte."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Punguza Mwendo imewashwa kwenye mipangilio ya Ufikivu ya mfumo, kwa hivyo Cover Flow hubaki bapa na haifuati kifaa, na santuri haizunguki."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சிஸ்டத்தின் அணுகல்தன்மை அமைப்புகளில் “அசைவைக் குறை” ஆன் ஆக உள்ளது; எனவே Cover Flow தட்டையாகவே இருக்கும், சாதனத்தைப் பின்தொடராது, ரெக்கார்டும் சுழலாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సిస్టమ్ యాక్సెసిబిలిటీ సెట్టింగ్‌లలో “చలనాన్ని తగ్గించు” ఆన్‌లో ఉంది; కాబట్టి Cover Flow చదునుగానే ఉంటుంది, పరికరాన్ని అనుసరించదు, రికార్డ్ కూడా తిరగదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "“ลดการเคลื่อนไหว” เปิดอยู่ในการตั้งค่าการช่วยการเข้าถึงของระบบ Cover Flow จึงแสดงแบบราบและไม่เคลื่อนตามอุปกรณ์ และแผ่นเสียงจะไม่หมุน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistemin Erişilebilirlik ayarlarında Hareketi Azalt açık olduğundan Cover Flow düz kalır ve aygıtı izlemez, plak da dönmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У системних параметрах Доступності ввімкнено «Зменшення руху», тому Cover Flow залишається пласким і не реагує на рухи пристрою, а платівка не обертається."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سسٹم کی رسائی کی سیٹنگز میں “حرکت کم کریں” آن ہے، اس لیے Cover Flow ہموار رہتا ہے اور ڈیوائس کی حرکت کو فالو نہیں کرتا، اور ریکارڈ نہیں گھومتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giảm chuyển động đang bật trong cài đặt Trợ năng của hệ thống, nên Cover Flow giữ phẳng và không chuyển động theo thiết bị, còn đĩa than không quay."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "系統「輔助使用」設定中的「減少動態效果」已開啟，因此 Cover Flow 會保持平面、不會跟隨裝置移動，唱片亦不會轉動。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统“辅助功能”设置中的“减弱动态效果”已打开，因此 Cover Flow 会保持平面、不跟随设备移动，唱片也不会转动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統「輔助使用」設定中的「減少動態效果」已開啟，因此 Cover Flow 會保持平面、不隨裝置移動，唱片也不會轉動。"
          }
        }
      }
    },
    "REFERENCED IN PLACE · OFFLINE · SCANNED LAST WEEK": {
      "comment": "Shown on the iPhone or iPad. Part of the built-in demo, which shows a pretend Mac. This is what a real Mac would say in its own language: use the Mac app's established translation where one exists (look it up in /mnt/project-files/l10n/final/<lang>.json). As above, for a folder on a disconnected drive.",
      "localizations": {
        "am": {

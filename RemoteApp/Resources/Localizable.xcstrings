        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac-ul încă convertește „%@”. Încercați din nou peste câteva momente."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Macen håller fortfarande på att konvertera ”%@”. Försök igen om en stund."

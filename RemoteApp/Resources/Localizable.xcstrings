    "Songs arrive over: %@": {
      "comment": "Shown on the iPhone or iPad. VoiceOver label in Now Playing. %@ is “Home network”, “Tailscale”, “Another network” or “On this device”.",
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ዘፈኖች የሚደርሱበት መንገድ፦ %@"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تصل الأغاني عبر: %@"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "গান আসছে এই পথে: %@"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdroj skladeb: %@"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sange kommer via: %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Titel kommen über: %@"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προέλευση τραγουδιών: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Origen de las canciones: %@"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "آهنگ‌ها از این راه می‌رسند: %@"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kappaleet saapuvat tätä kautta: %@"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Dumarating ang mga kanta sa pamamagitan ng: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Provenance des morceaux : %@"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ગીતો અહીંથી આવે છે: %@"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Waƙoƙi suna zuwa ta: %@"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השירים מגיעים דרך: %@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गीत यहाँ से आते हैं: %@"
          }
        },
        "hu": {

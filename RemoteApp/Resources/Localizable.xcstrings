            "state": "translated",
            "value": "待播清單"
          }
        }
      }
    },
    "Update Vespertine on the Mac to play here.": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "እዚህ ለማጫወት በMac ላይ ያለውን Vespertine ያዘምኑ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدّث Vespertine على الـ Mac للتشغيل هنا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখানে চালাতে Mac-এ Vespertine আপডেট করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chcete-li přehrávat zde, aktualizujte Vespertine na Macu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Opdater Vespertine på Mac’en for at afspille her."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualisiere Vespertine auf dem Mac, um hier abzuspielen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ενημερώστε το Vespertine στο Mac για αναπαραγωγή εδώ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualiza Vespertine en el Mac para reproducir aquí."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای پخش در اینجا، Vespertine را در Mac به‌روزرسانی کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Päivitä Macin Vespertine, jotta voit toistaa täällä."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "I-update ang Vespertine sa Mac para makapag-play dito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettez à jour Vespertine sur le Mac pour lire ici."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "અહીં વગાડવા માટે Mac પર Vespertine અપડેટ કરો."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Sabunta Vespertine a kan Mac don kunnawa a nan."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עדכן את Vespertine ב־Mac כדי לנגן כאן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यहाँ चलाने के लिए Mac पर Vespertine अपडेट करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az itteni lejátszáshoz frissítse a Vespertine-t a Macen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perbarui Vespertine di Mac untuk memutar di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiorna Vespertine sul Mac per riprodurre qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここで再生するには、MacのVespertineをアップデートしてください。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇಲ್ಲಿ ಪ್ಲೇ ಮಾಡಲು Mac ನಲ್ಲಿ Vespertine ಅಪ್‌ಡೇಟ್ ಮಾಡಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기에서 재생하려면 Mac의 Vespertine을 업데이트하십시오."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇവിടെ പ്ലേ ചെയ്യാൻ Mac-ലെ Vespertine അപ്ഡേറ്റ് ചെയ്യുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "येथे वाजवण्यासाठी Mac वरील Vespertine अपडेट करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kemas kini Vespertine pada Mac untuk bermain di sini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Oppdater Vespertine på Macen for å spille her."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Werk Vespertine op de Mac bij om hier af te spelen."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇੱਥੇ ਚਲਾਉਣ ਲਈ Mac ’ਤੇ Vespertine ਅੱਪਡੇਟ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uaktualnij Vespertine na Macu, aby odtwarzać tutaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Atualize o Vespertine no Mac para tocar aqui."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Atualize o Vespertine no Mac para reproduzir aqui."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualizați Vespertine pe Mac pentru a reda aici."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Uppdatera Vespertine på Macen för att spela här."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Sasisha Vespertine kwenye Mac ili kucheza hapa."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இங்கே இயக்க, Mac-இல் Vespertine-ஐப் புதுப்பிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇక్కడ ప్లే చేయడానికి Macలో Vespertineను అప్‌డేట్ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อัปเดต Vespertine บน Mac เพื่อเล่นที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Burada çalmak için Mac’teki Vespertine’i güncelleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб відтворювати тут, оновіть Vespertine на Mac."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہاں چلانے کے لیے Mac پر Vespertine کو اپ ڈیٹ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy cập nhật Vespertine trên máy Mac để phát tại đây."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "請更新 Mac 上的 Vespertine 才可在此播放。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请更新 Mac 上的 Vespertine 以在此处播放。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請更新 Mac 上的 Vespertine 才能在此播放。"
          }
        }
      }
    },
    "USB DAC · 44.1–768 kHz · DSD512": {

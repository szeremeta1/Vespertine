        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det ser inte ut som en adress. Skriv ett namn eller en IP-adress, följt av ”:port” om du känner till porten."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiyo haionekani kuwa anwani. Andika jina au anwani ya IP, ikifuatiwa na “:port” ikiwa unaijua port."
          }

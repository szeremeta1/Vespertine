    "“%@” isn’t in the Mac’s library, so it can’t be played on this device.": {
      "comment": "Phone player: a file played on the Mac from outside its library.",
      "extractionState": "manual",
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» በMac ቤተ-መጻሕፍት ውስጥ ስለሌለ በዚህ መሣሪያ ላይ ሊጫወት አይችልም።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” ليست في مكتبة الـ Mac، لذلك يتعذّر تشغيلها على هذا الجهاز."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” Mac-এর লাইব্রেরিতে নেই, তাই এটি এই ডিভাইসে চালানো যাবে না।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Skladba „%@“ není v knihovně Macu, takže ji v tomto zařízení nelze přehrát."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” er ikke i Mac’ens bibliotek, så den kan ikke afspilles på denne enhed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ ist nicht in der Mediathek des Mac und kann daher auf diesem Gerät nicht abgespielt werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το «%@» δεν υπάρχει στη βιβλιοθήκη του Mac, οπότε δεν μπορεί να αναπαραχθεί σε αυτήν τη συσκευή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” isn’t in the Mac’s library, so it can’t be played on this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” no está en la biblioteca del Mac, así que no se puede reproducir en este dispositivo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» در کتابخانهٔ Mac نیست، بنابراین نمی‌توان آن را در این دستگاه پخش کرد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "”%@” ei ole Macin kirjastossa, joten sitä ei voi toistaa tässä laitteessa."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Wala sa library ng Mac ang “%@”, kaya hindi ito mape-play sa device na ito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » ne figure pas dans la bibliothèque du Mac et ne peut donc pas être lu sur cet appareil."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” Mac ની લાઇબ્રેરીમાં નથી, તેથી તે આ ડિવાઇસ પર વગાડી શકાતું નથી."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” ba ta cikin laburaren Mac ɗin, don haka ba za a iya kunna ta a wannan na'ura ba."

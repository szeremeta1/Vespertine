          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಆ ಜೋಡಣೆ ಕೋಡ್‌ನ ಅವಧಿ ಮುಗಿದಿದೆ. Mac ನಲ್ಲಿ ಮತ್ತೆ “ಫೋನ್ ಜೋಡಿಸಿ” ಆಯ್ಕೆಮಾಡಿ, ಹೊಸ ಕೋಡ್ ಸ್ಕ್ಯಾನ್ ಮಾಡಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해당 페어링 코드가 만료되었습니다. Mac에서 ‘휴대폰 페어링’을 다시 선택하고 새로운 코드를 스캔하십시오."
          }
        },
        "ml": {

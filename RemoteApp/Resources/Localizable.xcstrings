    "That code didn’t work. Check the code on the Mac, or choose Pair a Phone there again for a new one.": {
      "comment": "Web remote: the code typed in the browser is wrong.",
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ያ ኮድ አልሰራም። በMac ላይ ያለውን ኮድ ያረጋግጡ፣ ወይም ለአዲስ ኮድ እዚያ «ስልክ አጣምር»ን እንደገና ይምረጡ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يعمل هذا الرمز. تحقق من الرمز على الـ Mac، أو اختر “إقران هاتف” هناك مرة أخرى للحصول على رمز جديد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ওই কোডটি কাজ করেনি। Mac-এ কোডটি দেখে নিন, অথবা নতুন কোডের জন্য সেখানে আবার “একটি ফোন পেয়ার করুন” বেছে নিন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento kód nefungoval. Zkontrolujte kód na Macu, nebo tam znovu zvolte Spárovat telefon a získejte nový."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Koden virkede ikke. Kontrollér koden på Mac'en, eller vælg Par en telefon der igen for at få en ny."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Code hat nicht funktioniert. Prüfe den Code auf dem Mac oder wähle dort erneut „Telefon koppeln“, um einen neuen zu erhalten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτός ο κωδικός δεν λειτούργησε. Ελέγξτε τον κωδικό στο Mac ή επιλέξτε ξανά εκεί «Σύζευξη τηλεφώνου» για νέο κωδικό."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese código no ha funcionado. Comprueba el código en el Mac o vuelve a elegir Enlazar un teléfono allí para obtener uno nuevo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این کد کار نکرد. کد را روی Mac بررسی کنید، یا برای دریافت کد جدید، آنجا دوباره «جفت کردن گوشی» را انتخاب کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Koodi ei toiminut. Tarkista koodi Macista tai valitse siellä uudelleen Parita puhelin saadaksesi uuden."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi gumana ang code na iyon. Tingnan ang code sa Mac, o piliin muli doon ang Mag-pair ng Telepono para sa bagong code."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce code n’a pas fonctionné. Vérifiez le code sur le Mac, ou choisissez à nouveau Jumeler un téléphone sur celui-ci pour en obtenir un nouveau."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તે કોડ કામ ન કર્યો. Mac પર કોડ તપાસો, અથવા નવા કોડ માટે ત્યાં ફરીથી “ફોન પેર કરો” પસંદ કરો."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Wannan lambar ba ta yi aiki ba. Duba lambar a Mac, ko ku sake zaɓar “Haɗa Waya” a can don samun sabuwar lamba."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקוד הזה לא עבד. בדוק את הקוד ב־Mac, או בחר שם שוב ״צמד טלפון״ כדי לקבל קוד חדש."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह कोड काम नहीं आया। Mac पर कोड जाँचें, या नए कोड के लिए वहाँ फिर से “फ़ोन पेयर करें” चुनें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a kód nem működött. Ellenőrizze a kódot a Macen, vagy egy új kódért válassza ott ismét a Telefon párosítása lehetőséget."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kode tersebut tidak berhasil. Periksa kode di Mac, atau pilih Pasangkan Ponsel lagi di Mac untuk mendapatkan kode baru."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quel codice non ha funzionato. Controlla il codice sul Mac oppure scegli di nuovo Abbina un telefono sul Mac per ottenerne uno nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コードが正しくありません。Macに表示されているコードを確認するか、Macでもう一度「スマートフォンをペアリング」を選択して新しいコードを表示してください。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಆ ಕೋಡ್ ಕೆಲಸ ಮಾಡಲಿಲ್ಲ. Mac ನಲ್ಲಿರುವ ಕೋಡ್ ಪರಿಶೀಲಿಸಿ, ಅಥವಾ ಹೊಸ ಕೋಡ್‌ಗಾಗಿ ಅಲ್ಲಿ ಮತ್ತೆ “ಫೋನ್ ಜೋಡಿಸಿ” ಆಯ್ಕೆಮಾಡಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코드가 올바르지 않습니다. Mac에 표시된 코드를 확인하거나, Mac에서 휴대폰 페어링을 다시 선택하여 새 코드를 받으십시오."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ആ കോഡ് പ്രവർത്തിച്ചില്ല. Mac-ലെ കോഡ് പരിശോധിക്കുക, അല്ലെങ്കിൽ പുതിയ കോഡിനായി അവിടെ വീണ്ടും “ഫോൺ ജോടിയാക്കുക” തിരഞ്ഞെടുക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तो कोड चालला नाही. Mac वरील कोड तपासा, किंवा नवीन कोडसाठी तेथे पुन्हा “फोन पेअर करा” निवडा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kod itu tidak berfungsi. Semak kod pada Mac, atau pilih Pasangkan Telefon sekali lagi pada Mac untuk mendapatkan kod baharu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Koden fungerte ikke. Sjekk koden på Macen, eller velg Sammenkoble en telefon der på nytt for å få en ny."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Die code werkte niet. Controleer de code op de Mac, of kies daar opnieuw ‘Koppel een telefoon’ voor een nieuwe."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਉਸ ਕੋਡ ਨੇ ਕੰਮ ਨਹੀਂ ਕੀਤਾ। Mac ’ਤੇ ਕੋਡ ਜਾਂਚੋ, ਜਾਂ ਨਵੇਂ ਕੋਡ ਲਈ ਉੱਥੇ ਦੁਬਾਰਾ “ਫ਼ੋਨ ਪੇਅਰ ਕਰੋ” ਚੁਣੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten kod nie zadziałał. Sprawdź kod na Macu lub wybierz tam ponownie Sparuj telefon, aby uzyskać nowy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esse código não funcionou. Confira o código no Mac ou escolha Emparelhar um Telefone nele novamente para obter um novo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esse código não funcionou. Verifique o código no Mac ou escolha novamente Emparelhar um telefone aí para obter um novo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Codul nu a funcționat. Verificați codul de pe Mac sau alegeți din nou acolo Asociază un telefon pentru un cod nou."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Koden fungerade inte. Kontrollera koden på Macen eller välj Parkoppla en telefon där igen för att få en ny."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Msimbo huo haukufanya kazi. Kagua msimbo kwenye Mac, au uchague Oanisha Simu tena kwenye Mac ili upate msimbo mpya."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அந்தக் குறியீடு வேலை செய்யவில்லை. Mac-இல் உள்ள குறியீட்டைச் சரிபார்க்கவும் அல்லது புதிய குறியீட்டுக்கு அங்கே மீண்டும் “ஃபோனை ஜோடியாக்கு” என்பதைத் தேர்வுசெய்யவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఆ కోడ్ పని చేయలేదు. Macలోని కోడ్‌ను తనిఖీ చేయండి, లేదా కొత్త కోడ్ కోసం అక్కడ మళ్లీ “ఫోన్‌ను జత చేయి” ఎంచుకోండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รหัสนั้นใช้ไม่ได้ ตรวจสอบรหัสบน Mac หรือเลือก จับคู่โทรศัพท์ บน Mac อีกครั้งเพื่อรับรหัสใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kod işe yaramadı. Mac’teki kodu kontrol edin veya yeni bir kod için orada yeniden Telefon Eşle’yi seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей код не спрацював. Перевірте код на Mac або знову виберіть там «Створити пару з телефоном», щоб отримати новий."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ کوڈ کام نہیں آیا۔ Mac پر کوڈ چیک کریں، یا نیا کوڈ لینے کے لیے وہاں دوبارہ “فون پیئر کریں” منتخب کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mã đó không hợp lệ. Hãy kiểm tra mã trên máy Mac hoặc chọn lại Ghép đôi điện thoại trên máy Mac để nhận mã mới."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "此代碼無效。請檢查 Mac 上顯示的代碼，或在 Mac 上再次選擇「配對手機」以取得新代碼。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该代码无效。请检查 Mac 上显示的代码，或在 Mac 上再次选择“配对手机”以获取新代码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此代碼無效。請檢查 Mac 上顯示的代碼，或在 Mac 上再次選擇「配對手機」以取得新代碼。"
          }
        }
      }
    },
    "That doesn’t look like an address. Type a name or an IP address, with “:port” after it if you know the port.": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ያ አድራሻ አይመስልም። ስም ወይም የIP አድራሻ ይተይቡ፤ ፖርቱን ካወቁ ከኋላው «:port» ይጨምሩ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يبدو هذا عنوانًا. اكتب اسمًا أو عنوان IP، وأضف بعده “:المنفذ” إذا كنت تعرف رقم المنفذ."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি ঠিকানার মতো দেখাচ্ছে না। একটি নাম বা IP ঠিকানা টাইপ করুন, আর পোর্ট জানা থাকলে তার পরে “:পোর্ট” যোগ করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tohle nevypadá jako adresa. Zadejte název nebo IP adresu a za ni „:port“, pokud port znáte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det ligner ikke en adresse. Skriv et navn eller en IP-adresse, efterfulgt af “:port”, hvis du kender porten."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das sieht nicht wie eine Adresse aus. Gib einen Namen oder eine IP-Adresse ein, gefolgt von „:Port“, falls du den Port kennst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό δεν μοιάζει με διεύθυνση. Πληκτρολογήστε ένα όνομα ή μια διεύθυνση IP και, αν γνωρίζετε τη θύρα, προσθέστε «:θύρα» στο τέλος."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eso no parece una dirección. Escribe un nombre o una dirección IP, seguido de “:puerto” si conoces el puerto."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این شبیه نشانی نیست. یک نام یا نشانی IP تایپ کنید و اگر درگاه را می‌دانید، بعد از آن «:درگاه» را بیاورید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä ei näytä osoitteelta. Kirjoita nimi tai IP-osoite ja sen perään ”:portti”, jos tiedät portin."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mukhang hindi iyan address. Mag-type ng pangalan o IP address, na may “:port” sa dulo kung alam mo ang port."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela ne ressemble pas à une adresse. Saisissez un nom ou une adresse IP, suivi de « :port » si vous connaissez le port."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ સરનામા જેવું લાગતું નથી. નામ અથવા IP સરનામું ટાઇપ કરો, અને પોર્ટ ખબર હોય તો તેની પછી “:પોર્ટ” ઉમેરો."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Wannan bai yi kama da adireshi ba. Rubuta suna ko adireshin IP, tare da “:port” a bayansa idan kun san port ɗin."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "זה לא נראה כמו כתובת. הקלד שם או כתובת IP, ואחריהם “:יציאה” אם היציאה ידועה לך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह पते जैसा नहीं लगता। कोई नाम या IP पता टाइप करें, और पोर्ट पता हो तो उसके बाद “:पोर्ट” जोड़ें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez nem tűnik címnek. Írjon be egy nevet vagy IP-címet, utána pedig „:port” formában a portot, ha ismeri."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sepertinya itu bukan alamat. Ketik nama atau alamat IP, diikuti “:port” jika Anda mengetahui port-nya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non sembra un indirizzo. Inserisci un nome o un indirizzo IP, seguito da “:porta” se conosci la porta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アドレスの形式ではないようです。名前またはIPアドレスを入力してください。ポートがわかっている場合は、そのあとに「:ポート」を付けます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇದು ವಿಳಾಸದಂತೆ ಕಾಣುತ್ತಿಲ್ಲ. ಹೆಸರು ಅಥವಾ IP ವಿಳಾಸವನ್ನು ಟೈಪ್ ಮಾಡಿ; ಪೋರ್ಟ್ ತಿಳಿದಿದ್ದರೆ ಅದರ ನಂತರ “:ಪೋರ್ಟ್” ಸೇರಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주소 형식이 아닌 것 같습니다. 이름이나 IP 주소를 입력하고, 포트를 알고 있다면 그 뒤에 ‘:포트’를 붙이십시오."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇതൊരു വിലാസം പോലെ തോന്നുന്നില്ല. ഒരു പേരോ IP വിലാസമോ ടൈപ്പ് ചെയ്യുക; പോർട്ട് അറിയാമെങ്കിൽ അതിനുശേഷം “:പോർട്ട്” ചേർക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हा पत्त्यासारखा दिसत नाही. नाव किंवा IP पत्ता टाइप करा, आणि पोर्ट माहीत असल्यास त्यानंतर “:पोर्ट” जोडा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Itu tidak kelihatan seperti alamat. Taip nama atau alamat IP, diikuti “:port” jika anda tahu portnya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det ser ikke ut som en adresse. Skriv inn et navn eller en IP-adresse, med «:port» etter hvis du kjenner porten."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dat lijkt geen adres. Typ een naam of een IP-adres, met ‘:poort’ erachter als je de poort weet."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਹ ਪਤੇ ਵਰਗਾ ਨਹੀਂ ਲੱਗਦਾ। ਕੋਈ ਨਾਂ ਜਾਂ IP ਪਤਾ ਟਾਈਪ ਕਰੋ, ਅਤੇ ਜੇ ਪੋਰਟ ਪਤਾ ਹੋਵੇ ਤਾਂ ਉਸ ਤੋਂ ਬਾਅਦ “:ਪੋਰਟ” ਜੋੜੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To nie wygląda na adres. Wpisz nazwę lub adres IP, a po nim „:port”, jeśli znasz port."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso não parece um endereço. Digite um nome ou um endereço IP, seguido de “:porta” se você souber a porta."

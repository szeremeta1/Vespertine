        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac ਹਾਲੇ “%@” ਨੂੰ ਬਦਲ ਰਿਹਾ ਹੈ। ਥੋੜ੍ਹੀ ਦੇਰ ਬਾਅਦ ਦੁਬਾਰਾ ਕੋਸ਼ਿਸ਼ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac nadal konwertuje „%@”. Spróbuj ponownie za chwilę."
          }
        },
        "pt-BR": {
          "stringUnit": {

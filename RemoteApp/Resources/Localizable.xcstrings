        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac bado inageuza “%@”. Jaribu tena baada ya muda mfupi."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac இன்னும் “%@”-ஐ மாற்றிக்கொண்டிருக்கிறது. சிறிது நேரம் கழித்து மீண்டும் முயலவும்."

        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso não parece um endereço. Escreva um nome ou um endereço IP, seguido de “:porta” se souber a porta."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceasta nu pare a fi o adresă. Introduceți un nume sau o adresă IP, urmată de „:port” dacă știți portul."
          }

    "Choose one of these and Vespertine on the Mac plays there.": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ከእነዚህ አንዱን ይምረጡ፤ በMac ላይ ያለው Vespertine እዚያ ያጫውታል።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر أحد هذه المخارج وسيشغّل Vespertine على الـ Mac الصوت عبره."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এগুলোর একটি বেছে নিন, Mac-এর Vespertine সেখানেই চালাবে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte jeden z nich a Vespertine na Macu bude hrát tam."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg en af disse, så afspiller Vespertine på Mac’en der."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle eine dieser Ausgaben, und Vespertine auf dem Mac spielt dort."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε μία από αυτές και το Vespertine στο Mac θα παίζει εκεί."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una de estas salidas y Vespertine reproducirá por ella en el Mac."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یکی از این‌ها را انتخاب کنید تا Vespertine در Mac از آنجا پخش کند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse jokin näistä, niin Macin Vespertine toistaa siellä."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pumili ng isa sa mga ito at doon magpe-play ang Vespertine sa Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez l’une de ces sorties et Vespertine, sur le Mac, y lira la musique."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આમાંથી એક પસંદ કરો, એટલે Mac પરનું Vespertine ત્યાં વગાડશે."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaɓi ɗaya daga cikin waɗannan, Vespertine a kan Mac zai kunna a can."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחר אחד מאלה ו־Vespertine ב־Mac ינגן שם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इनमें से कोई एक चुनें और Mac पर Vespertine वहीं चलाएगा।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válasszon ezek közül, és a Macen futó Vespertine ott játszik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih salah satu dan Vespertine di Mac akan memutar di sana."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli una di queste uscite e Vespertine sul Mac riprodurrà lì."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いずれかを選ぶと、MacのVespertineがそこで再生します。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇವುಗಳಲ್ಲಿ ಒಂದನ್ನು ಆರಿಸಿದರೆ Mac ನಲ್ಲಿರುವ Vespertine ಅಲ್ಲಿ ಪ್ಲೇ ಮಾಡುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 중 하나를 선택하면 Mac의 Vespertine이 해당 출력으로 재생합니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇവയിലൊന്ന് തിരഞ്ഞെടുത്താൽ Mac-ലെ Vespertine അവിടെ പ്ലേ ചെയ്യും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "यांपैकी एक निवडा, म्हणजे Mac वरील Vespertine तेथे वाजवेल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih salah satu dan Vespertine pada Mac akan bermain di situ."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg en av disse, så spiller Vespertine på Macen der."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een van deze en Vespertine op de Mac speelt daar af."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਹਨਾਂ ਵਿੱਚੋਂ ਇੱਕ ਚੁਣੋ ਅਤੇ Mac ’ਤੇ Vespertine ਉੱਥੇ ਚਲਾਏਗਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz jedno z nich, a Vespertine na Macu będzie tam odtwarzać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma destas saídas e o Vespertine no Mac tocará por ela."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma destas saídas e o Vespertine no Mac reproduz por ela."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alegeți una dintre acestea, iar Vespertine de pe Mac va reda acolo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj en av dessa, så spelar Vespertine på Macen där."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Chagua mojawapo ya hizi na Vespertine kwenye Mac itacheza hapo."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இவற்றில் ஒன்றைத் தேர்வுசெய்தால் Mac-இல் உள்ள Vespertine அங்கே இயக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "వీటిలో ఒకదాన్ని ఎంచుకుంటే Macలోని Vespertine అక్కడ ప్లే చేస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกรายการใดรายการหนึ่ง แล้ว Vespertine บน Mac จะเล่นที่นั่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunlardan birini seçin, Mac’teki Vespertine orada çalsın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть один із цих виходів, і Vespertine на Mac відтворюватиме музику через нього."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ان میں سے کوئی ایک منتخب کریں اور Mac پر Vespertine وہاں چلائے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy chọn một trong các mục này, Vespertine trên máy Mac sẽ phát ở đó."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇其中一項，Mac 上的 Vespertine 便會在該處播放。"

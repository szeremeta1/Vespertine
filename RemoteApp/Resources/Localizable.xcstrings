    "Swipe up or down for the next or previous album. Double-tap to open it.": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ለቀጣዩ ወይም ለቀዳሚው አልበም ወደ ላይ ወይም ወደ ታች ያንሸራትቱ። ለመክፈት ሁለቴ መታ ያድርጉ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حرّك لأعلى أو لأسفل للانتقال إلى الألبوم التالي أو السابق. اضغط مرتين لفتحه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পরের বা আগের অ্যালবামের জন্য উপরে বা নিচে সোয়াইপ করুন। এটি খুলতে দুবার ট্যাপ করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přejetím nahoru nebo dolů přejdete na další nebo předchozí album. Poklepáním ho otevřete."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skub op eller ned for at gå til næste eller forrige album. Tryk to gange for at åbne det."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Streiche nach oben oder unten, um zum nächsten oder vorherigen Album zu wechseln. Doppeltippe, um es zu öffnen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σαρώστε προς τα πάνω ή προς τα κάτω για το επόμενο ή το προηγούμενο άλμπουμ. Αγγίξτε δύο φορές για να το ανοίξετε."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza hacia arriba o hacia abajo para ir al álbum siguiente o al anterior. Toca dos veces para abrirlo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای آلبوم بعدی یا قبلی، انگشت را به بالا یا پایین بکشید. برای باز کردن آن، دو بار ضربه بزنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Siirry seuraavaan tai edelliseen albumiin pyyhkäisemällä ylös tai alas. Avaa kaksoisnapauttamalla."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mag-swipe pataas o pababa para sa susunod o nakaraang album. Mag-double tap para buksan ito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Balayez vers le haut ou le bas pour passer à l’album suivant ou précédent. Touchez deux fois pour l’ouvrir."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આગલા અથવા પાછલા આલ્બમ માટે ઉપર અથવા નીચે સ્વાઇપ કરો. તેને ખોલવા માટે ડબલ-ટૅપ કરો."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Shafa sama ko ƙasa don kundi na gaba ko na baya. Taɓa sau biyu don buɗe shi."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החלק מעלה או מטה כדי לעבור לאלבום הבא או הקודם. הקש פעמיים כדי לפתוח אותו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अगले या पिछले एल्बम के लिए ऊपर या नीचे स्वाइप करें। इसे खोलने के लिए डबल-टैप करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Legyintsen felfelé vagy lefelé a következő vagy az előző albumhoz. Koppintson duplán a megnyitásához."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesek ke atas atau bawah untuk album berikutnya atau sebelumnya. Ketuk dua kali untuk membukanya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorri verso l’alto o verso il basso per l’album successivo o precedente. Tocca due volte per aprirlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上または下にスワイプすると、次または前のアルバムに移動します。ダブルタップすると開きます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಮುಂದಿನ ಅಥವಾ ಹಿಂದಿನ ಆಲ್ಬಮ್‌ಗಾಗಿ ಮೇಲಕ್ಕೆ ಅಥವಾ ಕೆಳಕ್ಕೆ ಸ್ವೈಪ್ ಮಾಡಿ. ಅದನ್ನು ತೆರೆಯಲು ಎರಡು ಬಾರಿ ಟ್ಯಾಪ್ ಮಾಡಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위 또는 아래로 쓸어넘기면 다음 또는 이전 앨범으로 이동합니다. 이중 탭하면 열립니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അടുത്തതോ മുമ്പത്തെയോ ആൽബത്തിനായി മുകളിലേക്കോ താഴേക്കോ സ്വൈപ്പ് ചെയ്യുക. അത് തുറക്കാൻ രണ്ടുതവണ ടാപ്പ് ചെയ്യുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पुढील किंवा मागील अल्बमसाठी वर किंवा खाली स्वाइप करा. तो उघडण्यासाठी दोनदा टॅप करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Leret ke atas atau ke bawah untuk album seterusnya atau sebelumnya. Dwiketik untuk membukanya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sveip opp eller ned for neste eller forrige album. Dobbelttrykk for å åpne det."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Veeg omhoog of omlaag voor het volgende of vorige album. Tik dubbel om het te openen."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਅਗਲੀ ਜਾਂ ਪਿਛਲੀ ਐਲਬਮ ਲਈ ਉੱਪਰ ਜਾਂ ਹੇਠਾਂ ਸਵਾਈਪ ਕਰੋ। ਇਸਨੂੰ ਖੋਲ੍ਹਣ ਲਈ ਡਬਲ-ਟੈਪ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przesuń w górę lub w dół, aby przejść do następnego lub poprzedniego albumu. Stuknij dwukrotnie, aby go otworzyć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deslize para cima ou para baixo para ir ao álbum seguinte ou anterior. Toque duas vezes para abri-lo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Passe o dedo para cima ou para baixo para ir para o álbum seguinte ou anterior. Toque duas vezes para o abrir."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Glisați în sus sau în jos pentru albumul următor sau anterior. Apăsați dublu pentru a-l deschide."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Svep uppåt eller nedåt för nästa eller föregående album. Dubbeltryck för att öppna det."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Telezesha juu au chini kwa albamu inayofuata au iliyotangulia. Gusa mara mbili ili kuifungua."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அடுத்த அல்லது முந்தைய ஆல்பத்திற்கு மேலே அல்லது கீழே ஸ்வைப் செய்யவும். அதைத் திறக்க இருமுறை தட்டவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "తదుపరి లేదా మునుపటి ఆల్బమ్ కోసం పైకి లేదా కిందికి స్వైప్ చేయండి. దాన్ని తెరవడానికి రెండుసార్లు ట్యాప్ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปัดขึ้นหรือลงเพื่อไปยังอัลบั้มถัดไปหรือก่อนหน้า แตะสองครั้งเพื่อเปิด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonraki veya önceki albüm için yukarı ya da aşağı kaydırın. Açmak için çift dokunun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Проведіть угору або вниз, щоб перейти до наступного чи попереднього альбому. Торкніть двічі, щоб відкрити його."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اگلے یا پچھلے البم کے لیے اوپر یا نیچے سوائپ کریں۔ اسے کھولنے کے لیے دو بار تھپتھپائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuốt lên hoặc xuống để đến album tiếp theo hoặc trước đó. Chạm hai lần để mở."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "向上或向下掃以切換至下一張或上一張專輯。點兩下以開啟。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向上或向下轻扫可切换到下一张或上一张专辑。轻点两下可打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "向上或向下滑動來切換下一張或上一張專輯。點兩下來打開。"
          }
        }
      }
    },

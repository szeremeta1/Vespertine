        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac ಇನ್ನೂ “%@” ಅನ್ನು ಪರಿವರ್ತಿಸುತ್ತಿದೆ. ಸ್ವಲ್ಪ ಸಮಯದ ನಂತರ ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac이 아직 ‘%@’을(를) 변환하고 있습니다. 잠시 후 다시 시도하십시오."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac ഇപ്പോഴും “%@” പരിവർത്തനം ചെയ്യുകയാണ്. അൽപ്പസമയത്തിനു ശേഷം വീണ്ടും ശ്രമിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac अजूनही “%@” रूपांतरित करत आहे. थोड्या वेळाने पुन्हा प्रयत्न करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac masih menukar “%@”. Cuba lagi sebentar lagi."

        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಡಿಸ್ಕ್ ಇಮೇಜ್‌ನ ಮಲ್ಟಿಚಾನೆಲ್ ಏರಿಯಾ; ಎಡಿಟ್‌ಗಳು ಲೈಬ್ರರಿಯಲ್ಲೇ ಉಳಿಯುತ್ತವೆ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "디스크 이미지의 멀티채널 영역. 편집 내용은 보관함에 저장됨"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒരു ഡിസ്ക് ഇമേജിന്റെ മൾട്ടിചാനൽ ഏരിയ; എഡിറ്റുകൾ ലൈബ്രറിയിൽ നിലനിൽക്കും"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "डिस्क इमेजचा मल्टिचॅनेल भाग; संपादने लायब्ररीतच राहतात"

        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "DoPには排他的でビット透過な出力が必要です"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "DoP ಗೆ ಏಕಸ್ವಾಮ್ಯ, ಬಿಟ್-ಟ್ರಾನ್ಸ್‌ಪರೆಂಟ್ ಔಟ್‌ಪುಟ್ ಅಗತ್ಯವಿದೆ"

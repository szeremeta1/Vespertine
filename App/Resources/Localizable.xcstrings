        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De opnamen zijn bewaard, maar de responsies konden niet worden berekend"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੈਪਚਰ ਸੰਭਾਲੇ ਗਏ, ਪਰ ਜਵਾਬਾਂ ਦੀ ਗਣਨਾ ਨਹੀਂ ਹੋ ਸਕੀ"

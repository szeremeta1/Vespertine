    "The filter is %@ seconds long; room correction filters can be at most %@ seconds.": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ማጣሪያው %@ ሰከንድ ይረዝማል፤ የክፍል ማስተካከያ ማጣሪያዎች ቢበዛ %@ ሰከንድ ሊረዝሙ ይችላሉ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "طول المرشح %@ ثانية، ولا يمكن أن يتجاوز طول مرشحات تصحيح الغرفة %@ ثانية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফিল্টারটি %@ সেকেন্ড দীর্ঘ; রুম কারেকশন ফিল্টার সর্বোচ্চ %@ সেকেন্ড দীর্ঘ হতে পারে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtr je dlouhý %@ sekundy; filtry korekce místnosti mohou být dlouhé nejvýše %@ sekundy."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Filteret er %@ sekunder langt; rumkorrektionsfiltre kan højst være %@ sekunder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Filter ist %@ Sekunden lang; Raumkorrekturfilter dürfen höchstens %@ Sekunden lang sein."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το φίλτρο διαρκεί %@ δευτερόλεπτα. Τα φίλτρα διόρθωσης χώρου μπορούν να διαρκούν το πολύ %@ δευτερόλεπτα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El filtro dura %@ segundos; los filtros de corrección de sala pueden durar como máximo %@ segundos."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "طول فیلتر %@ ثانیه است؛ فیلترهای تصحیح اتاق حداکثر می‌توانند %@ ثانیه باشند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Suodatin on %@ sekuntia pitkä; huonekorjaussuodattimet voivat olla enintään %@ sekuntia pitkiä."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ segundo ang haba ng filter; hanggang %@ segundo lang ang puwedeng haba ng mga room correction filter."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le filtre dure %@ secondes ; les filtres de correction acoustique peuvent durer au maximum %@ secondes."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ફિલ્ટર %@ સેકંડ લાંબું છે; રૂમ કરેક્શન ફિલ્ટર વધુમાં વધુ %@ સેકંડના હોઈ શકે છે."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Tsawon matatar daƙiƙa %@ ne; matatun gyaran ɗaki za su iya kai daƙiƙa %@ a mafi yawa."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אורך המסנן הוא %@ שניות; מסנני תיקון חדר יכולים להיות באורך של %@ שניות לכל היותר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़िल्टर %@ सेकंड लंबा है; रूम करेक्शन फ़िल्टर अधिकतम %@ सेकंड के हो सकते हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szűrő %@ másodperc hosszú; a szobakorrekciós szűrők legfeljebb %@ másodpercesek lehetnek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Panjang filter %@ detik; filter koreksi ruangan maksimal %@ detik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il filtro dura %@ secondi; i filtri di correzione ambientale possono durare al massimo %@ secondi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フィルタの長さが%@秒あります。ルーム補正フィルタは最大%@秒までです。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಫಿಲ್ಟರ್ %@ ಸೆಕೆಂಡುಗಳಷ್ಟು ಉದ್ದವಿದೆ; ರೂಮ್ ಕರೆಕ್ಷನ್ ಫಿಲ್ಟರ್‌ಗಳು ಗರಿಷ್ಠ %@ ಸೆಕೆಂಡುಗಳಷ್ಟು ಇರಬಹುದು."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "필터 길이가 %@초입니다. 룸 보정 필터는 최대 %@초까지 가능합니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഫിൽട്ടറിന് %@ സെക്കൻഡ് നീളമുണ്ട്; റൂം കറക്ഷൻ ഫിൽട്ടറുകൾക്ക് പരമാവധി %@ സെക്കൻഡ് നീളമേ പാടുള്ളൂ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "फिल्टर %@ सेकंद लांब आहे; रूम करेक्शन फिल्टर जास्तीत जास्त %@ सेकंदांचे असू शकतात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Penapis ini sepanjang %@ saat; penapis pembetulan bilik boleh sepanjang paling lama %@ saat."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Filteret er %@ sekunder langt; romkorreksjonsfiltre kan være maks %@ sekunder lange."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het filter is %@ seconden lang; ruimtecorrectiefilters mogen maximaal %@ seconden lang zijn."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਫ਼ਿਲਟਰ %@ ਸਕਿੰਟ ਲੰਬਾ ਹੈ; ਰੂਮ ਕਰੈਕਸ਼ਨ ਫ਼ਿਲਟਰ ਵੱਧ ਤੋਂ ਵੱਧ %@ ਸਕਿੰਟ ਦੇ ਹੋ ਸਕਦੇ ਹਨ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtr trwa %@ sekundy; filtry korekcji pomieszczenia mogą trwać najwyżej %@ sekundy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O filtro tem %@ segundos; os filtros de correção de sala podem ter no máximo %@ segundos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O filtro tem %@ segundos; os filtros de correção de sala podem ter no máximo %@ segundos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtrul are %@ secunde; filtrele de corecție a camerei pot avea cel mult %@ secunde."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtret är %@ sekunder långt; rumskorrigeringsfilter får vara högst %@ sekunder långa."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kichujio kina urefu wa sekunde %@; vichujio vya urekebishaji wa chumba vinaweza kuwa na urefu wa hadi sekunde %@."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வடிப்பானின் நீளம் %@ வினாடிகள்; அறை திருத்த வடிப்பான்கள் அதிகபட்சம் %@ வினாடிகள் நீளம் இருக்கலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఫిల్టర్ పొడవు %@ సెకన్లు; గది దిద్దుబాటు ఫిల్టర్‌లు గరిష్ఠంగా %@ సెకన్లు ఉండవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ฟิลเตอร์ยาว %@ วินาที แต่ฟิลเตอร์สำหรับการปรับแก้เสียงห้องยาวได้ไม่เกิน %@ วินาที"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtre %@ saniye uzunluğunda; oda düzeltme filtreleri en fazla %@ saniye olabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тривалість фільтра — %@ с, а фільтри корекції приміщення можуть тривати щонайбільше %@ с."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فلٹر %@ سیکنڈ لمبا ہے؛ کمرے کی اصلاح کے فلٹرز زیادہ سے زیادہ %@ سیکنڈ کے ہو سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bộ lọc dài %@ giây; bộ lọc hiệu chỉnh phòng chỉ có thể dài tối đa %@ giây."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "此濾波器長 %@ 秒；房間校正濾波器最長只可為 %@ 秒。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该滤波器长 %@ 秒；房间校正滤波器最长为 %@ 秒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此濾波器長 %@ 秒；房間校正濾波器最長為 %@ 秒。"
          }
        }
      }
    },

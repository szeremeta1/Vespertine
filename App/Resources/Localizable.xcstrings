        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozvržení měření potřebuje vzorkovací frekvenci, sweep dlouhý alespoň vteřinu a mezeru alespoň 0,3 s kolem sweepu."

        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സൗജന്യവും ഓപ്പൺ സോഴ്‌സും. ഒരു മിനിറ്റത്തെ സജ്ജീകരണം, പിന്നെ കേട്ടുതുടങ്ങാം."
          }

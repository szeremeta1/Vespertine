    "Your token is stored in the macOS Keychain. Find it at listenbrainz.org → Settings.": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ቶከንዎ በmacOS Keychain ውስጥ ተቀምጧል። በlistenbrainz.org → Settings ላይ ያገኙታል።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُخزَّن رمزك في سلسلة مفاتيح macOS. تجده في listenbrainz.org ← الإعدادات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার টোকেন macOS কীচেইনে সংরক্ষিত থাকে। এটি listenbrainz.org → Settings-এ পাবেন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Váš token je uložen v Klíčence macOS. Najdete ho na listenbrainz.org → Settings."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit token opbevares i macOS-nøgleringen. Du finder det på listenbrainz.org → Settings."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Token wird im macOS-Schlüsselbund gespeichert. Du findest es unter listenbrainz.org → Settings."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το διακριτικό σας αποθηκεύεται στην Κλειδοθήκη του macOS. Θα το βρείτε στο listenbrainz.org → Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu token se guarda en el llavero de macOS. Lo encontrarás en listenbrainz.org → Settings."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "توکن شما در Keychain سیستم macOS ذخیره می‌شود. آن را در listenbrainz.org → Settings پیدا کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tunnuksesi säilytetään macOS:n avainnipussa. Löydät sen osoitteesta listenbrainz.org → Settings."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nakatabi ang token mo sa macOS Keychain. Hanapin ito sa listenbrainz.org → Settings."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre jeton est stocké dans le trousseau macOS. Vous le trouverez sur listenbrainz.org → Settings."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારું ટોકન macOS Keychain માં સંગ્રહિત છે. તે listenbrainz.org → Settings પર મળશે."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "An ajiye token ɗinku a Keychain na macOS. Nemo shi a listenbrainz.org → Settings."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האסימון שלך מאוחסן במחזיק המפתחות של macOS. תוכל למצוא אותו ב־listenbrainz.org ← Settings."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका टोकन macOS कीचेन में संग्रहीत है। इसे listenbrainz.org → Settings में पाएँ।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A token a macOS kulcskarikájában van tárolva. A listenbrainz.org → Settings oldalon találja meg."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Token Anda disimpan di Rantai Kunci macOS. Temukan di listenbrainz.org → Settings."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il token è memorizzato nel portachiavi di macOS. Lo trovi su listenbrainz.org → Settings."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トークンはmacOSのキーチェーンに保存されます。トークンはlistenbrainz.org →「Settings」で確認できます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಟೋಕನ್ ಅನ್ನು macOS ಕೀಚೈನ್‌ನಲ್ಲಿ ಸಂಗ್ರಹಿಸಲಾಗಿದೆ. ಅದನ್ನು listenbrainz.org → Settings ನಲ್ಲಿ ಹುಡುಕಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "토큰은 macOS 키체인에 저장됩니다. 토큰은 listenbrainz.org → Settings에서 확인할 수 있습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ ടോക്കൺ macOS കീചെയിനിൽ സംഭരിച്ചിരിക്കുന്നു. listenbrainz.org → Settings-ൽ അത് കണ്ടെത്താം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमचे टोकन macOS Keychain मध्ये संग्रहित आहे. ते listenbrainz.org → Settings येथे मिळेल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Token anda disimpan dalam Rantai Kunci macOS. Dapatkannya di listenbrainz.org → Settings."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tokenet ditt oppbevares i macOS-nøkkelringen. Du finner det på listenbrainz.org → Settings."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je token wordt bewaard in de macOS-sleutelhanger. Je vindt het op listenbrainz.org → Settings."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡਾ ਟੋਕਨ macOS Keychain ਵਿੱਚ ਸਟੋਰ ਹੁੰਦਾ ਹੈ। ਇਹ listenbrainz.org → Settings ’ਤੇ ਲੱਭੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Token jest przechowywany w pęku kluczy macOS. Znajdziesz go na listenbrainz.org → Settings."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",

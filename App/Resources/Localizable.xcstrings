        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-frames uberørte i IEC 61937-bursts; receiveren afkoder"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-Frames unverändert in IEC 61937-Bursts; der Receiver dekodiert"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πλαίσια %@ ανέγγιχτα σε ριπές IEC 61937· αποκωδικοποιεί ο δέκτης"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tramas %@ intactas en ráfagas IEC 61937; el receptor decodifica"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فریم‌های %@ دست‌نخورده در بسته‌های IEC 61937؛ گیرنده رمزگشایی می‌کند"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-kehykset koskemattomina IEC 61937 -purskeissa; vastaanotin purkaa"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ frame na hindi ginalaw sa mga IEC 61937 burst; ang receiver ang nagde-decode"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trames %@ intactes dans des salves IEC 61937 ; l’amplificateur décode"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "IEC 61937 બર્સ્ટમાં %@ ફ્રેમ અકબંધ; રિસીવર ડીકોડ કરે છે"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Firam na %@ ba a taɓa su ba a cikin bursts na IEC 61937; risiva ce ke warwarewa"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פריימי %@ ללא שינוי בפרצי IEC 61937; המקלט מפענח"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ फ़्रेम IEC 61937 बर्स्ट में बिना बदलाव के; रिसीवर डिकोड करता है"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-keretek érintetlenül, IEC 61937 csomagokban; a vevőkészülék dekódol"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Frame %@ tidak diubah dalam burst IEC 61937; receiver yang mendekode"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Frame %@ intatti in burst IEC 61937; decodifica il ricevitore"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@フレームをIEC 61937バーストでそのまま送信。レシーバーがデコードします"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ಫ್ರೇಮ್‌ಗಳು IEC 61937 ಬರ್ಸ್ಟ್‌ಗಳಲ್ಲಿ ಬದಲಾಗದೆ; ರಿಸೀವರ್ ಡೀಕೋಡ್ ಮಾಡುತ್ತದೆ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 프레임을 IEC 61937 버스트로 그대로 전송, 리시버가 디코딩"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ഫ്രെയിമുകൾ IEC 61937 ബർസ്റ്റുകളിൽ മാറ്റമില്ലാതെ; റിസീവർ ഡീകോഡ് ചെയ്യുന്നു"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "IEC 61937 बर्स्टमध्ये %@ फ्रेम अपरिवर्तित; रिसीव्हर डीकोड करतो"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bingkai %@ tidak diusik dalam letusan IEC 61937; penerima yang menyahkod"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-rammer urørt i IEC 61937-pakker; receiveren dekoder"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-frames onaangetast in IEC 61937-bursts; de receiver decodeert"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ਫ਼੍ਰੇਮ IEC 61937 ਬਰਸਟਾਂ ਵਿੱਚ ਬਿਨਾਂ ਛੇੜੇ; ਰਿਸੀਵਰ ਡੀਕੋਡ ਕਰਦਾ ਹੈ"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ramki %@ nienaruszone w pakietach IEC 61937; dekoduje amplituner"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quadros %@ intactos em rajadas IEC 61937; o receiver decodifica"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Tramas %@ intactas em rajadas IEC 61937; o recetor descodifica"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cadre %@ neatinse în rafale IEC 61937; receiverul decodează"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ramar orörda i IEC 61937-paket; receivern avkodar"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Fremu za %@ hazijaguswa katika mipasuko ya IEC 61937; resiva inasimbua"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ஃபிரேம்கள் IEC 61937 பர்ஸ்ட்களில் மாற்றமின்றி; ரிசீவர் டிகோட் செய்யும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ఫ్రేమ్‌లు IEC 61937 బర్స్ట్‌లలో మార్పు లేకుండా; రిసీవర్ డీకోడ్ చేస్తుంది"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เฟรม %@ ไม่ถูกแตะต้องในชุดข้อมูล IEC 61937 เครื่องรับจะถอดรหัสเอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "IEC 61937 paketlerinde dokunulmamış %@ çerçeveleri; kodu alıcı çözer"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Аудіокадри %@ без змін у пакетах IEC 61937; декодує ресивер"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "IEC 61937 برسٹس میں بغیر تبدیلی کے %@ فریمز؛ ریسیور ڈی کوڈ کرتا ہے"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khung %@ được giữ nguyên trong các cụm IEC 61937; bộ thu AV sẽ giải mã"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 幀以 IEC 61937 突發封包原封不動傳送；由擴音機解碼"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 帧在 IEC 61937 突发数据中保持不变；由接收器解码"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 訊框在 IEC 61937 突發資料中保持不變；由擴大機解碼"
          }
        }
      }
    },
    "%@ is connected but won’t start. Quit and reopen Vespertine, then press play.": {
      "comment": "%@ is the name of an audio output device.",
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ተገናኝቷል ግን አይጀምርም። Vespertineን አቋርጠው እንደገና ይክፈቱ፣ ከዚያ አጫውትን ይጫኑ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ متصل لكنه لا يبدأ. قم بإنهاء Vespertine وإعادة فتحه، ثم اضغط تشغيل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ সংযুক্ত, কিন্তু চালু হচ্ছে না। Vespertine থেকে প্রস্থান করে আবার খুলুন, তারপর প্লে চাপুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: zařízení je připojené, ale nespustí se. Ukončete a znovu otevřete Vespertine, pak stiskněte Přehrát."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ er forbundet, men vil ikke starte. Afslut og åbn Vespertine igen, og tryk derefter på afspil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist verbunden, startet aber nicht. Beende Vespertine, öffne es erneut und starte dann die Wiedergabe."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: υπάρχει σύνδεση, αλλά η συσκευή δεν ξεκινά. Τερματίστε και ανοίξτε ξανά το Vespertine και μετά πατήστε αναπαραγωγή."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está conectado pero no arranca. Sal de Vespertine, vuelve a abrirlo y pulsa Reproducir."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ وصل است اما راه‌اندازی نمی‌شود. از Vespertine خارج شوید و دوباره بازش کنید، سپس دکمهٔ پخش را بزنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Laite %@ on yhdistetty, mutta se ei käynnisty. Lopeta Vespertine ja avaa se uudelleen ja paina sitten toistoa."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nakakonekta ang %@ pero ayaw magsimula. Mag-quit at buksan muli ang Vespertine, saka pindutin ang play."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est connecté mais ne démarre pas. Quittez puis rouvrez Vespertine, puis appuyez sur Lecture."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ કનેક્ટ છે પણ શરૂ થતું નથી. Vespertine બંધ કરીને ફરી ખોલો, પછી પ્લે દબાવો."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "An haɗa %@ amma ba ya farawa. Fita daga Vespertine ku sake buɗe shi, sannan ku danna kunna."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ מחובר אך אינו מתחיל לפעול. צא מ־Vespertine ופתח אותו מחדש, ואז לחץ על ״נגן״."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ कनेक्ट है, लेकिन शुरू नहीं हो रहा। Vespertine को बंद करके फिर से खोलें, फिर प्ले दबाएँ।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: az eszköz csatlakoztatva van, de nem indul el. Lépjen ki a Vespertine alkalmazásból, nyissa meg újra, majd nyomja meg a lejátszás gombot."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ terhubung tetapi tidak mau mulai. Keluar dan buka kembali Vespertine, lalu tekan putar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è connesso ma non si avvia. Esci da Vespertine e riaprilo, poi premi Riproduci."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@は接続されていますが、起動しません。Vespertineを終了してから再度開き、再生ボタンを押してください。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ಸಂಪರ್ಕಗೊಂಡಿದೆ ಆದರೆ ಪ್ರಾರಂಭವಾಗುತ್ತಿಲ್ಲ. Vespertine ಅನ್ನು ತ್ಯಜಿಸಿ ಮತ್ತೆ ತೆರೆಯಿರಿ, ನಂತರ ಪ್ಲೇ ಒತ್ತಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 기기가 연결되어 있지만 시작되지 않습니다. Vespertine을 종료한 후 다시 열고 재생을 누르십시오."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ കണക്റ്റ് ചെയ്തിട്ടുണ്ട്, പക്ഷേ ആരംഭിക്കുന്നില്ല. Vespertine-ൽ നിന്ന് പുറത്തുകടന്ന് വീണ്ടും തുറന്നശേഷം പ്ലേ അമർത്തുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ कनेक्ट आहे पण सुरू होत नाही. Vespertine बंद करून पुन्हा उघडा, नंतर प्ले दाबा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bersambung tetapi tidak dapat bermula. Keluar dan buka semula Vespertine, kemudian tekan main."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ er tilkoblet, men vil ikke starte. Avslutt og åpne Vespertine på nytt, og trykk deretter på spill av."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is verbonden maar start niet. Stop Vespertine, open het opnieuw en start dan het afspelen."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ਕਨੈਕਟ ਹੈ ਪਰ ਸ਼ੁਰੂ ਨਹੀਂ ਹੋ ਰਿਹਾ। Vespertine ਨੂੰ ਬੰਦ ਕਰਕੇ ਦੁਬਾਰਾ ਖੋਲ੍ਹੋ, ਫਿਰ ਚਲਾਓ ਦਬਾਓ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Urządzenie %@ jest podłączone, ale nie daje się uruchomić. Zakończ i ponownie otwórz Vespertine, a następnie naciśnij Odtwórz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está conectado, mas não inicia. Encerre e reabra o Vespertine e pressione Reproduzir."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está ligado mas não arranca. Encerre e volte a abrir o Vespertine e, depois, prima Reproduzir."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ este conectat, dar nu pornește. Ieșiți din Vespertine și redeschideți-l, apoi apăsați Redă."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ är ansluten men startar inte. Avsluta och öppna Vespertine igen och tryck sedan på spela."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kimeunganishwa lakini hakianzi. Ondoka kwenye Vespertine na uifungue tena, kisha bonyeza cheza."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ இணைக்கப்பட்டுள்ளது, ஆனால் தொடங்கவில்லை. Vespertine-இலிருந்து வெளியேறி மீண்டும் திறந்து, பிறகு இயக்கு என்பதை அழுத்தவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ కనెక్ట్ అయి ఉంది కానీ ప్రారంభం కావడం లేదు. Vespertine నుండి నిష్క్రమించి మళ్లీ తెరవండి, తర్వాత ప్లే నొక్కండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ เชื่อมต่ออยู่แต่ไม่เริ่มทำงาน ออกจาก Vespertine แล้วเปิดใหม่ จากนั้นกดเล่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bağlı ancak başlamıyor. Vespertine’den çıkıp yeniden açın, sonra çal düğmesine basın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ під’єднано, але запустити не вдається. Вийдіть з Vespertine, відкрийте його знову й натисніть «Відтворити»."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ منسلک ہے لیکن شروع نہیں ہو رہا۔ Vespertine بند کر کے دوبارہ کھولیں، پھر پلے دبائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ đã được kết nối nhưng không khởi động. Hãy thoát và mở lại Vespertine, sau đó nhấn phát."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已連接但無法啟動。請結束並重新開啟 Vespertine，然後按播放。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已连接，但无法启动。请退出并重新打开 Vespertine，然后按下播放。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已連接，但無法啟動。請結束並重新打開 Vespertine，然後按下播放。"
          }
        }
      }
    },

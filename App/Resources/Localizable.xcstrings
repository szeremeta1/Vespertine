    "Import: filters from REW or another tool, as Equalizer APO text or impulse responses (WAV, AIFF, CAF, FLAC).": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "አስገባ፦ ከREW ወይም ከሌላ መሣሪያ የተገኙ ማጣሪያዎች፣ እንደ Equalizer APO ጽሑፍ ወይም የኢምፐልስ ምላሾች (WAV፣ AIFF፣ CAF፣ FLAC)።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استيراد: مرشحات من REW أو أداة أخرى، كنص Equalizer APO أو استجابات نبضية (WAV وAIFF وCAF وFLAC)."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ইমপোর্ট: REW বা অন্য টুল থেকে ফিল্টার, Equalizer APO টেক্সট বা ইমপালস রেসপন্স (WAV, AIFF, CAF, FLAC) হিসেবে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Import: filtry z REW nebo jiného nástroje, jako text Equalizer APO nebo impulzní odezvy (WAV, AIFF, CAF, FLAC)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Importer: filtre fra REW eller et andet værktøj, som Equalizer APO-tekst eller impulsresponser (WAV, AIFF, CAF, FLAC)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Importieren: Filter aus REW oder einem anderen Programm, als Equalizer-APO-Text oder Impulsantworten (WAV, AIFF, CAF, FLAC)."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εισαγωγή: φίλτρα από το REW ή άλλο εργαλείο, ως κείμενο Equalizer APO ή κρουστικές αποκρίσεις (WAV, AIFF, CAF, FLAC)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Importar: filtros de REW u otra herramienta, como texto de Equalizer APO o respuestas al impulso (WAV, AIFF, CAF, FLAC)."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "وارد کردن: فیلترهایی از REW یا ابزاری دیگر، به‌صورت متن Equalizer APO یا پاسخ ضربه (WAV، AIFF، CAF، FLAC)."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuo: suodattimia REW:stä tai muusta työkalusta, Equalizer APO -tekstinä tai impulssivasteina (WAV, AIFF, CAF, FLAC)."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "I-import: mga filter mula sa REW o ibang tool, bilang text ng Equalizer APO o impulse response (WAV, AIFF, CAF, FLAC)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Importer : des filtres de REW ou d’un autre outil, en texte Equalizer APO ou en réponses impulsionnelles (WAV, AIFF, CAF, FLAC)."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ઇમ્પોર્ટ: REW અથવા બીજા ટૂલમાંથી ફિલ્ટર, Equalizer APO ટેક્સ્ટ અથવા ઇમ્પલ્સ રિસ્પોન્સ (WAV, AIFF, CAF, FLAC) તરીકે."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Shigo da: matatu daga REW ko wani kayan aiki, a matsayin rubutun Equalizer APO ko amsoshin bugun sauti (WAV, AIFF, CAF, FLAC)."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ייבוא: מסננים מ־REW או מכלי אחר, כטקסט Equalizer APO או כתגובות הלם (WAV, AIFF, CAF, FLAC)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इंपोर्ट: REW या किसी दूसरे टूल से फ़िल्टर, Equalizer APO टेक्स्ट या इम्पल्स रिस्पॉन्स (WAV, AIFF, CAF, FLAC) के रूप में।"

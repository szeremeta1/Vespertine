        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Theo dõi thay đổi trong thư mục"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "監察資料夾的變更"

    "Bitstream requires exclusive, bit-transparent output": {
      "extractionState": "manual",
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitstream ብቸኛና ቢትን የማይቀይር ውፅዓት ይፈልጋል"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتطلب تدفق البتات مخرجًا حصريًا شفافًا للبتات"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বিটস্ট্রিমের জন্য এক্সক্লুসিভ, বিট-ট্রান্সপারেন্ট আউটপুট প্রয়োজন"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitstream vyžaduje výhradní, bitově transparentní výstup"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitstream kræver eksklusivt, bittransparent output"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitstream erfordert eine exklusive, bittransparente Ausgabe"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το bitstream απαιτεί αποκλειστική έξοδο χωρίς αλλοίωση των bit"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitstream requires exclusive, bit-transparent output"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El bitstream requiere una salida exclusiva y transparente a nivel de bits"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بیت‌استریم به خروجی انحصاری و بیت‌شفاف نیاز دارد"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bittivirta vaatii yksinomaisen, bittiläpinäkyvän ulostulon"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kailangan ng bitstream ang eksklusibo at bit-transparent na output"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le bitstream nécessite une sortie exclusive et transparente au bit près"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "બિટસ્ટ્રીમ માટે અનન્ય, બિટ-ટ્રાન્સપરન્ટ આઉટપુટ જરૂરી છે"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitstream yana buƙatar fitarwa ta keɓe wadda ba ta canza bit"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitstream דורש פלט בלעדי ושקוף לסיביות"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बिटस्ट्रीम के लिए एक्सक्लूसिव, बिट-ट्रांसपेरेंट आउटपुट ज़रूरी है"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A bitstream kizárólagos, bitátlátszó kimenetet igényel"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitstream memerlukan output eksklusif yang transparan bit"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il bitstream richiede un’uscita esclusiva e trasparente ai bit"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ビットストリームには排他的でビット透過な出力が必要です"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಬಿಟ್‌ಸ್ಟ್ರೀಮ್‌ಗೆ ಏಕಸ್ವಾಮ್ಯ, ಬಿಟ್-ಟ್ರಾನ್ಸ್‌ಪರೆಂಟ್ ಔಟ್‌ಪುಟ್ ಅಗತ್ಯವಿದೆ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비트스트림에는 독점적이고 비트 투명한 출력이 필요합니다"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ബിറ്റ്‌സ്ട്രീമിന് എക്സ്ക്ലൂസീവ്, ബിറ്റ്-ട്രാൻസ്പരന്റ് ഔട്ട്‌പുട്ട് ആവശ്യമാണ്"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "बिटस्ट्रीमसाठी अनन्य, बिट-ट्रान्सपरंट आउटपुट आवश्यक आहे"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitstream memerlukan output eksklusif yang telus bit"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitstrøm krever eksklusiv, bittransparent utgang"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitstream vereist exclusieve, bittransparante uitvoer"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਬਿੱਟਸਟ੍ਰੀਮ ਲਈ ਨਿਵੇਕਲਾ, ਬਿੱਟ-ਪਾਰਦਰਸ਼ੀ ਆਉਟਪੁੱਟ ਚਾਹੀਦਾ ਹੈ"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitstream wymaga wyłącznego, bitowo przezroczystego wyjścia"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O bitstream exige uma saída exclusiva e transparente em bits"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O bitstream requer uma saída exclusiva e transparente ao bit"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitstreamul necesită o ieșire exclusivă, transparentă la nivel de bit"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitström kräver exklusiv, bittransparent utgång"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitstream inahitaji utoaji wa kipekee unaopitisha biti bila kuzibadilisha"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பிட்ஸ்ட்ரீமுக்குப் பிரத்தியேகமான, பிட்-வெளிப்படையான வெளியீடு தேவை"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "బిట్‌స్ట్రీమ్‌కు ప్రత్యేక, బిట్-ట్రాన్స్‌పరెంట్ అవుట్‌పుట్ అవసరం"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บิตสตรีมต้องใช้ขาออกแบบผูกขาดที่ส่งบิตได้โปร่งใส"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitstream, özel ve bit düzeyinde şeffaf bir çıkış gerektirir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бітстрим потребує ексклюзивного, бітово прозорого виходу"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بٹ اسٹریم کے لیے خصوصی، بٹ ٹرانسپیرنٹ آؤٹ پٹ ضروری ہے"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitstream yêu cầu đầu ra độc quyền, trong suốt về bit"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "位元流需要獨佔、位元透明的輸出"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "比特流需要独占、比特透明的输出"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "位元流需要獨佔、位元透明的輸出"
          }
        }
      }

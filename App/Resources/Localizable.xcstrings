    "%@\n\nNothing was changed in the Nocturne folder. Vespertine will quit and try again next time it opens.": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nበNocturne አቃፊ ውስጥ ምንም አልተቀየረም። Vespertine ይዘጋል፣ በሚቀጥለው ጊዜ ሲከፈትም እንደገና ይሞክራል።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nلم يتغير شيء في مجلد Nocturne. سيتم إنهاء Vespertine وإعادة المحاولة في المرة القادمة التي يُفتح فيها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nNocturne ফোল্ডারে কিছুই পরিবর্তন করা হয়নি। Vespertine প্রস্থান করবে এবং পরের বার খোলার সময় আবার চেষ্টা করবে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nVe složce Nocturne se nic nezměnilo. Vespertine se ukončí a zkusí to znovu při příštím otevření."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nIntet blev ændret i Nocturne-mappen. Vespertine afsluttes og prøver igen, næste gang den åbnes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nIm Nocturne-Ordner wurde nichts verändert. Vespertine wird beendet und versucht es beim nächsten Öffnen erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nΔεν άλλαξε τίποτα στον φάκελο του Nocturne. Το Vespertine θα τερματιστεί και θα δοκιμάσει ξανά την επόμενη φορά που θα ανοίξει."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nNo se ha cambiado nada en la carpeta de Nocturne. Vespertine se cerrará y lo volverá a intentar la próxima vez que se abra."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nهیچ چیزی در پوشهٔ Nocturne تغییر نکرد. Vespertine بسته می‌شود و دفعهٔ بعد که باز شود دوباره تلاش می‌کند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nNocturne-kansioon ei tehty muutoksia. Vespertine lopetetaan, ja se yrittää uudelleen, kun se avataan seuraavan kerran."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nWalang binago sa Nocturne folder. Magku-quit ang Vespertine at susubukang muli sa susunod na pagbukas nito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nRien n’a été modifié dans le dossier Nocturne. Vespertine va quitter et réessaiera à sa prochaine ouverture."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nNocturne ફોલ્ડરમાં કંઈ બદલાયું નથી. Vespertine બંધ થશે અને આગલી વખતે ખૂલશે ત્યારે ફરી પ્રયાસ કરશે."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nBa a canza komai a foldar Nocturne ba. Vespertine zai rufe kuma ya sake gwadawa idan aka buɗe shi a gaba."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nשום דבר לא השתנה בתיקיית Nocturne. Vespertine ייסגר וינסה שוב בפעם הבאה שהוא ייפתח."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nNocturne फ़ोल्डर में कुछ भी नहीं बदला गया। Vespertine बंद हो जाएगा और अगली बार खुलने पर फिर से कोशिश करेगा।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nA Nocturne mappájában semmi sem változott. A Vespertine kilép, és a következő megnyitáskor újra megpróbálja."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nTidak ada yang diubah di folder Nocturne. Vespertine akan ditutup dan mencoba lagi saat dibuka berikutnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nNella cartella di Nocturne non è stato modificato nulla. Vespertine verrà chiuso e riproverà alla prossima apertura."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nNocturneフォルダ内は何も変更されていません。Vespertineは終了し、次回開いたときに再試行します。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nNocturne ಫೋಲ್ಡರ್‌ನಲ್ಲಿ ಏನನ್ನೂ ಬದಲಾಯಿಸಲಾಗಿಲ್ಲ. Vespertine ತ್ಯಜಿಸುತ್ತದೆ ಮತ್ತು ಮುಂದಿನ ಬಾರಿ ತೆರೆದಾಗ ಮತ್ತೆ ಪ್ರಯತ್ನಿಸುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nNocturne 폴더에서는 아무것도 변경되지 않았습니다. Vespertine이 종료되며 다음에 열 때 다시 시도합니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nNocturne ഫോൾഡറിൽ ഒന്നും മാറ്റിയിട്ടില്ല. Vespertine പുറത്തുകടക്കുകയും അടുത്ത തവണ തുറക്കുമ്പോൾ വീണ്ടും ശ്രമിക്കുകയും ചെയ്യും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nNocturne फोल्डरमध्ये काहीही बदलले नाही. Vespertine बंद होईल आणि पुढच्या वेळी उघडल्यावर पुन्हा प्रयत्न करेल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nTiada apa-apa yang diubah dalam folder Nocturne. Vespertine akan keluar dan mencuba lagi pada kali seterusnya ia dibuka."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nIngenting ble endret i Nocturne-mappen. Vespertine avsluttes og prøver igjen neste gang den åpnes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nEr is niets gewijzigd in de Nocturne-map. Vespertine stopt en probeert het opnieuw de volgende keer dat het wordt geopend."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nNocturne ਫ਼ੋਲਡਰ ਵਿੱਚ ਕੁਝ ਵੀ ਨਹੀਂ ਬਦਲਿਆ ਗਿਆ। Vespertine ਬੰਦ ਹੋ ਜਾਵੇਗਾ ਅਤੇ ਅਗਲੀ ਵਾਰ ਖੁੱਲ੍ਹਣ ’ਤੇ ਦੁਬਾਰਾ ਕੋਸ਼ਿਸ਼ ਕਰੇਗਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nW folderze Nocturne nic nie zostało zmienione. Vespertine zakończy działanie i spróbuje ponownie przy następnym otwarciu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nNada foi alterado na pasta do Nocturne. O Vespertine será encerrado e tentará novamente na próxima vez que for aberto."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nNada foi alterado na pasta do Nocturne. O Vespertine vai encerrar e tentar novamente da próxima vez que for aberto."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nNu s-a modificat nimic în dosarul Nocturne. Vespertine se va închide și va încerca din nou la următoarea deschidere."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nIngenting ändrades i Nocturne-mappen. Vespertine avslutas och försöker igen nästa gång det öppnas."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nHakuna kilichobadilishwa kwenye folda ya Nocturne. Vespertine itafungwa na kujaribu tena itakapofunguliwa wakati ujao."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nNocturne கோப்புறையில் எதுவும் மாற்றப்படவில்லை. Vespertine வெளியேறி, அடுத்த முறை திறக்கும்போது மீண்டும் முயலும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nNocturne ఫోల్డర్‌లో ఏదీ మార్చబడలేదు. Vespertine నిష్క్రమించి, తదుపరిసారి తెరిచినప్పుడు మళ్లీ ప్రయత్నిస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nไม่มีการเปลี่ยนแปลงใดในโฟลเดอร์ Nocturne Vespertine จะออกและลองอีกครั้งในครั้งถัดไปที่เปิด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nNocturne klasöründe hiçbir şey değiştirilmedi. Vespertine kapanacak ve bir sonraki açılışında yeniden deneyecek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nУ папці Nocturne нічого не змінено. Vespertine завершить роботу й спробує знову, коли ви відкриєте його наступного разу."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nNocturne فولڈر میں کچھ تبدیل نہیں ہوا۔ Vespertine بند ہو جائے گا اور اگلی بار کھلنے پر دوبارہ کوشش کرے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nKhông có gì bị thay đổi trong thư mục Nocturne. Vespertine sẽ thoát và thử lại vào lần mở tiếp theo."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nNocturne 資料夾中沒有任何更改。Vespertine 將會結束，並在下次開啟時再試。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nNocturne 文件夹中的内容没有任何更改。Vespertine 将退出，并在下次打开时重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nNocturne 檔案夾中的內容沒有任何更改。Vespertine 將會結束，並在下次打開時再試一次。"
          }
        }
      }
    },

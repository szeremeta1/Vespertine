          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Volume numérique (64 bits, avec dither). Pas bit-perfect en dessous de 100 %."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ડિજિટલ વૉલ્યૂમ (64-bit, ડિધર કરેલું). 100% થી નીચે બિટ-પરફેક્ટ નથી."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ƙarar dijital (bit 64, da dither). Ba bit-perfect ba idan ta yi ƙasa da 100%."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עוצמת קול דיגיטלית (64 סיביות, עם דיתור). אינה מדויקת לסיבית מתחת ל־100%."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डिजिटल वॉल्यूम (64-bit, डिदर के साथ)। 100% से कम पर बिट-परफ़ेक्ट नहीं।"
          }
        },
        "hu": {

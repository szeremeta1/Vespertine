    "Discord didn’t accept the status: %@": {
      "comment": "Settings › Online › Discord, status caption. %@ is Discord's own reason, in English (e.g. 'Invalid Client ID').",
      "extractionState": "manual",
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",

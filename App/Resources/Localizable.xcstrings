    "Show what’s playing as my Discord status": {
      "comment": "Settings › Online, a toggle: while on, the user's Discord profile status shows the song Vespertine is playing (like Spotify's 'Listening to' status).",
      "extractionState": "manual",
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "እየተጫወተ ያለውን እንደ Discord ሁኔታዬ አሳይ"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عرض ما يتم تشغيله كحالتي في Discord"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যা চলছে তা আমার Discord স্ট্যাটাস হিসেবে দেখান"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazovat přehrávanou hudbu jako můj stav na Discordu"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vis det, der spiller, som min Discord-status"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiedergabe als meinen Discord-Status anzeigen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εμφάνιση του τι παίζει ως κατάστασή μου στο Discord"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar lo que suena como mi estado de Discord"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نمایش آنچه در حال پخش است به‌عنوان وضعیت Discord من"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näytä toistettava musiikki Discord-tilanani"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ipakita ang nagpe-play bilang aking Discord status"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher ce que j’écoute dans mon statut Discord"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "જે વાગી રહ્યું છે તે મારા Discord સ્ટેટસ તરીકે બતાવો"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Nuna abin da ake kunnawa a cikin matsayina na Discord"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הצג את מה שמתנגן כסטטוס שלי ב־Discord"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जो चल रहा है, उसे मेरे Discord स्टेटस के रूप में दिखाएँ"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az éppen szóló zene megjelenítése a Discord-állapotomban"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tampilkan yang sedang diputar sebagai status Discord saya"

    "Each song fades into the next over the length and curve below.": {
      "comment": "Settings › Playback › Transitions: what the Crossfade style does.",
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "እያንዳንዱ ዘፈን ከታች ባለው ርዝመት እና ኩርባ ወደ ቀጣዩ ይደበዝዛል።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتلاشى كل أغنية في التالية على المدة والمنحنى أدناه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতিটি গান নিচের দৈর্ঘ্য ও কার্ভে পরের গানে মিশে যায়।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každá skladba přejde do další s délkou a křivkou níže."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver sang fader over i den næste med længden og kurven nedenfor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Titel blendet mit der Dauer und Kurve unten in den nächsten über."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάθε τραγούδι σβήνει στο επόμενο με τη διάρκεια και την καμπύλη παρακάτω."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada canción se funde con la siguiente con la duración y la curva de abajo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هر آهنگ با طول و منحنی زیر در آهنگ بعدی محو می‌شود."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jokainen kappale häivyttyy seuraavaan alla olevalla pituudella ja käyrällä."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang bawat kanta ay nagfe-fade sa susunod sa haba at kurba sa ibaba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque morceau se fond dans le suivant selon la durée et la courbe ci-dessous."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "દરેક ગીત નીચેની લંબાઈ અને વળાંકથી આગલામાં ભળે છે."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Kowace waƙa tana haɗewa da ta gaba da tsawo da lanƙwasa da ke ƙasa."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל שיר נמוג אל הבא באורך ובעקומה שלמטה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर गाना नीचे दी गई लंबाई और वक्र से अगले में घुल जाता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden dal az alábbi hosszal és görbével úszik át a következőbe."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap lagu memudar ke lagu berikutnya dengan durasi dan kurva di bawah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni brano sfuma nel successivo con la durata e la curva qui sotto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各曲は下の長さとカーブで次の曲へフェードします。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಪ್ರತಿ ಹಾಡು ಕೆಳಗಿನ ಉದ್ದ ಮತ್ತು ವಕ್ರದೊಂದಿಗೆ ಮುಂದಿನದಕ್ಕೆ ಫೇಡ್ ಆಗುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 곡이 아래의 길이와 곡선으로 다음 곡에 페이드됩니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഓരോ പാട്ടും താഴെയുള്ള ദൈർഘ്യത്തിലും വക്രത്തിലും അടുത്തതിലേക്ക് ഫേഡ് ചെയ്യുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रत्येक गाणे खालील लांबी आणि वक्राने पुढच्या गाण्यात मिसळते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap lagu pudar ke lagu seterusnya mengikut panjang dan lengkung di bawah."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver sang tones over i den neste med lengden og kurven nedenfor."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elk nummer vloeit over in het volgende met de duur en curve hieronder."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਹਰ ਗੀਤ ਹੇਠਾਂ ਦਿੱਤੀ ਲੰਬਾਈ ਅਤੇ ਵਕਰ ਨਾਲ ਅਗਲੇ ਵਿੱਚ ਘੁਲਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy utwór przechodzi w następny z długością i krzywą poniżej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada música passa para a próxima com a duração e a curva abaixo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada música passa para a seguinte com a duração e a curva abaixo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiecare melodie trece în următoarea cu durata și curba de mai jos."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje låt tonas över i nästa med längden och kurvan nedan."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kila wimbo hufifia kuingia unaofuata kwa urefu na mkunjo ulio hapa chini."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒவ்வொரு பாடலும் கீழே உள்ள நீளம் மற்றும் வளைவுடன் அடுத்ததில் மங்கிக் கலக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రతి పాట కింది నిడివి, వక్రంతో తర్వాతి పాటలో కలుస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แต่ละเพลงเฟดเข้าเพลงถัดไปตามความยาวและเส้นโค้งด้านล่าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her şarkı aşağıdaki süre ve eğriyle sonrakine geçer."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожна пісня переходить у наступну з тривалістю і кривою нижче."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہر گانا نیچے دی گئی لمبائی اور خم کے ساتھ اگلے میں گھل جاتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi bài chuyển mờ sang bài sau theo độ dài và đường cong bên dưới."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "每首歌按下方的長度和曲線淡入下一首。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每首歌按下方的时长和曲线淡入下一首。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每首歌依下方的長度和曲線淡入下一首。"
          }
        }
      }
    },

        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਹ ਸਰਵਰ ਦਾ ਪਤਾ ਨਹੀਂ ਲੱਗਦਾ। smb://server/share ਅਜ਼ਮਾਓ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To nie wygląda na adres serwera. Spróbuj smb://serwer/zasób."
          }
        },
        "pt-BR": {
          "stringUnit": {

          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede provocar crisis en personas con epilepsia fotosensible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Può scatenare crisi nelle persone con epilessia fotosensibile."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pode provocar crises em pessoas com epilepsia fotossensível."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pode provocar crises em pessoas com epilepsia fotossensível."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan aanvallen veroorzaken bij mensen met fotosensitieve epilepsie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan utlösa anfall hos personer med fotosensitiv epilepsi."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan udløse anfald hos personer med fotosensitiv epilepsi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan utløse anfall hos personer med fotosensitiv epilepsi."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voi laukaista kohtauksia ihmisillä, joilla on valoherkkä epilepsia."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Może wywołać napady u osób z padaczką fotogenną."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Může u lidí s fotosenzitivní epilepsií vyvolat záchvat."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Fényérzékeny epilepsziában szenvedőknél rohamot válthat ki."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Poate declanșa crize la persoanele cu epilepsie fotosensibilă."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Işığa duyarlı epilepsisi olan kişilerde nöbetleri tetikleyebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Може спричинити напади в людей із фоточутливою епілепсією."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μπορεί να προκαλέσει κρίσεις σε άτομα με φωτοευαίσθητη επιληψία."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "光過敏性てんかんのある人に発作を引き起こすことがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "광과민성 뇌전증이 있는 사람에게 발작을 일으킬 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可能会诱发光敏性癫痫患者发作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可能會誘發光敏性癲癇患者發作。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có thể gây co giật ở người mắc chứng động kinh nhạy cảm với ánh sáng."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dapat memicu kejang pada orang dengan epilepsi fotosensitif."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Boleh mencetuskan sawan pada orang yang menghidap epilepsi fotosensitif."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Maaaring magdulot ng seizure sa mga taong may photosensitive epilepsy."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kinaweza kusababisha kifafa kwa watu wenye kifafa kinachochochewa na mwanga."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Na iya jawo farfaɗiya ga mutanen da ke da farfaɗiyar da haske ke tayarwa."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "በብርሃን የሚቀሰቀስ የሚጥል በሽታ ባለባቸው ሰዎች ላይ መናድ ሊያስከትል ይችላል።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد يؤدي إلى نوبات لدى المصابين بالصرع الحساس للضوء."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ممکن است در افراد مبتلا به صرع حساس به نور باعث تشنج شود."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עלול לגרום להתקפים אצל אנשים עם אפילפסיה רגישה לאור."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "روشنی سے حساس مرگی والے لوگوں میں دورے کا سبب بن سکتا ہے۔"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रकाश-संवेदी मिर्गी वाले लोगों में दौरे ला सकता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আলোক-সংবেদী মৃগীরোগে আক্রান্ত মানুষের খিঁচুনি ঘটাতে পারে।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਰੋਸ਼ਨੀ ਪ੍ਰਤੀ ਸੰਵੇਦਨਸ਼ੀਲ ਮਿਰਗੀ ਵਾਲੇ ਲੋਕਾਂ ਵਿੱਚ ਦੌਰੇ ਲਿਆ ਸਕਦਾ ਹੈ।"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પ્રકાશ-સંવેદનશીલ વાઈ ધરાવતા લોકોમાં હુમલો લાવી શકે છે."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रकाश-संवेदनशील अपस्मार असलेल्या लोकांमध्ये झटके आणू शकतो."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒளி உணர்திறன் வலிப்பு உள்ளவர்களுக்கு வலிப்பைத் தூண்டக்கூடும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కాంతి సున్నితత్వ మూర్ఛ ఉన్నవారిలో మూర్ఛను కలిగించవచ్చు."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಬೆಳಕಿಗೆ ಸಂವೇದನಾಶೀಲ ಅಪಸ್ಮಾರ ಇರುವವರಲ್ಲಿ ಸೆಳವು ಉಂಟುಮಾಡಬಹುದು."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പ്രകാശ സംവേദനക്ഷമമായ അപസ്മാരമുള്ളവരിൽ അപസ്മാരം ഉണ്ടാക്കിയേക്കാം."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อาจกระตุ้นให้เกิดอาการชักในผู้ที่เป็นโรคลมชักที่ไวต่อแสง"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "可能會誘發光敏性癲癇患者發作。"
          }
        }
      }
    },

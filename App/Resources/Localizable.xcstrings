        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "IFO ਜਿਨ੍ਹਾਂ ਸੈੱਲਾਂ ਦੀ ਸੂਚੀ ਦਿੰਦਾ ਹੈ, ਉਨ੍ਹਾਂ ਤੋਂ ਪਹਿਲਾਂ ਹੀ VOB ਖ਼ਤਮ ਹੋ ਜਾਂਦੀਆਂ ਹਨ (ਅਧੂਰੀ ਕਾਪੀ)"
          }
        },
        "pl": {
          "stringUnit": {

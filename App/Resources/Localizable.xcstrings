    "Changes the sound, so this output isn't bit-perfect while it's on.": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ድምፁን ይለውጣል፣ ስለዚህ ይህ ውጤት በሚበራበት ጊዜ ቢት-ፍጹም አይደለም።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يغيّر الصوت، لذا لا يكون هذا المخرج مطابقًا للبتات أثناء التشغيل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শব্দ বদলায়, তাই চালু থাকা অবস্থায় এই আউটপুট বিট-পারফেক্ট থাকে না।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mění zvuk, takže tento výstup při zapnutí není bit-perfect."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ændrer lyden, så dette udgangspunkt ikke er bitperfekt, mens den er slået til."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verändert den Klang, daher ist dieser Ausgang bei eingeschalteter Korrektur nicht bit-perfekt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αλλάζει τον ήχο, επομένως αυτή η έξοδος δεν είναι bit-perfect όσο είναι ενεργό."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia el sonido, así que esta salida no es bit-perfect mientras está activado."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "صدا را تغییر می‌دهد، بنابراین تا زمانی که روشن است این خروجی بیت‌به‌بیت نیست."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muuttaa ääntä, joten tämä lähtö ei ole bittitarkka, kun se on päällä."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Binabago nito ang tunog, kaya hindi bit-perfect ang output na ito habang naka-on."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifie le son : cette sortie n'est donc pas bit-perfect tant qu'elle est activée."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "અવાજ બદલે છે, તેથી ચાલુ હોય ત્યારે આ આઉટપુટ બિટ-પરફેક્ટ નથી."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Yana canza sauti, don haka wannan fitarwa ba bit-perfect ba ne yayin da yake kunne."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "משנה את הצליל, ולכן הפלט הזה אינו מדויק לסיבית כשהוא פועל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आवाज़ बदलता है, इसलिए चालू रहने पर यह आउटपुट बिट-परफ़ेक्ट नहीं रहता।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Megváltoztatja a hangot, ezért bekapcsolt állapotban ez a kimenet nem bit-perfect."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengubah suara, sehingga keluaran ini tidak bit-perfect selama aktif."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia il suono, quindi questa uscita non è bit-perfect finché è attiva."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音が変わるため、オンの間はこの出力はビットパーフェクトではなくなります。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಧ್ವನಿಯನ್ನು ಬದಲಾಯಿಸುತ್ತದೆ, ಆದ್ದರಿಂದ ಆನ್ ಇರುವಾಗ ಈ ಔಟ್‌ಪುಟ್ ಬಿಟ್-ಪರ್ಫೆಕ್ಟ್ ಅಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소리가 바뀌므로 켜져 있는 동안 이 출력은 비트 퍼펙트가 아닙니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ശബ്ദം മാറ്റുന്നു, അതിനാൽ ഇത് ഓണായിരിക്കുമ്പോൾ ഈ ഔട്ട്പുട്ട് ബിറ്റ്-പെർഫെക്റ്റ് അല്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आवाज बदलते, त्यामुळे चालू असताना हे आउटपुट बिट-परफेक्ट नसते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengubah bunyi, jadi keluaran ini tidak bit-perfect semasa dihidupkan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Endrer lyden, så denne utgangen er ikke bitperfekt mens den er på."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verandert het geluid, dus deze uitgang is niet bitperfect zolang dit aan staat."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਆਵਾਜ਼ ਬਦਲਦਾ ਹੈ, ਇਸ ਲਈ ਚਾਲੂ ਹੋਣ 'ਤੇ ਇਹ ਆਊਟਪੁੱਟ ਬਿੱਟ-ਪਰਫ਼ੈਕਟ ਨਹੀਂ ਰਹਿੰਦਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmienia dźwięk, więc gdy jest włączone, to wyjście nie jest bit-perfect."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Muda o som, então esta saída não é bit-perfect enquanto estiver ativado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Altera o som, por isso esta saída não é bit-perfect enquanto estiver ativado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Schimbă sunetul, deci această ieșire nu este bit-perfect cât timp este activat."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändrar ljudet, så den här utgången är inte bitperfekt medan det är på."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hubadilisha sauti, kwa hivyo pato hili si bit-perfect likiwa limewashwa."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒலியை மாற்றுகிறது, எனவே இது இயக்கத்தில் இருக்கும்போது இந்த வெளியீடு பிட்-பெர்ஃபெக்ட் அல்ல."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "శబ్దాన్ని మారుస్తుంది, కాబట్టి ఇది ఆన్‌లో ఉన్నప్పుడు ఈ అవుట్‌పుట్ బిట్-పర్ఫెక్ట్ కాదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปลี่ยนเสียง ดังนั้นเอาต์พุตนี้จึงไม่ใช่บิตเพอร์เฟกต์ขณะที่เปิดอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesi değiştirir; bu yüzden açıkken bu çıkış bit-perfect değildir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Змінює звук, тому поки це ввімкнено, цей вихід не є біт-у-біт."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آواز بدلتا ہے، اس لیے آن ہونے کے دوران یہ آؤٹ پٹ بٹ پرفیکٹ نہیں رہتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Làm thay đổi âm thanh, nên khi bật, đầu ra này không còn bit-perfect."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "會改變聲音，因此開啟期間此輸出不是位元完美。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会改变声音，因此开启期间此输出不是比特完美。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "會改變聲音，因此開啟期間此輸出不是位元完美。"
          }
        }
      }
    },
    "Changes the sound, so this output isn't bit-perfect while one is on.": {

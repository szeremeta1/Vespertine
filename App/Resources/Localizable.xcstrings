            "state": "translated",
            "value": "Ativa ou desativa a correção de sala para esta saída"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pornește sau oprește corecția camerei pentru această ieșire"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Slår på eller av rumskorrigering för den här utgången"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Huwasha au kuzima usahihishaji wa chumba kwa pato hili"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த வெளியீட்டுக்கு அறைத் திருத்தத்தை இயக்கும் அல்லது அணைக்கும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ అవుట్‌పుట్‌కు రూమ్ కరెక్షన్‌ను ఆన్ లేదా ఆఫ్ చేస్తుంది"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดหรือปิดการปรับแก้ห้องสำหรับเอาต์พุตนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu çıkış için oda düzeltmesini açar veya kapatır"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вмикає або вимикає корекцію кімнати для цього виходу"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس آؤٹ پٹ کے لیے روم کریکشن آن یا آف کرتا ہے"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật hoặc tắt hiệu chỉnh phòng cho đầu ra này"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟或關閉此輸出的房間校正"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启或关闭此输出的房间校正"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟或關閉此輸出的房間校正"
          }
        }
      }
    },
    "Turns Vespertine’s song transitions on or off.": {
      "comment": "Shortcuts action description.",
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "የVespertine የዘፈን ሽግግሮችን ያበራል ወይም ያጠፋል።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يشغّل انتقالات الأغاني في Vespertine أو يوقفها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Vespertine-এর গানের ট্রানজিশন চালু বা বন্ধ করে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapne nebo vypne přechody mezi skladbami ve Vespertine."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slår Vespertines overgange mellem sange til eller fra."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schaltet die Übergänge zwischen Titeln in Vespertine ein oder aus."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ενεργοποιεί ή απενεργοποιεί τις μεταβάσεις τραγουδιών στο Vespertine."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa o desactiva las transiciones entre canciones de Vespertine."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "گذارهای بین آهنگ‌های Vespertine را روشن یا خاموش می‌کند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Laittaa Vespertinen kappaleiden väliset siirtymät päälle tai pois."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ino-on o ino-off ang mga transition ng kanta sa Vespertine."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Active ou désactive les transitions entre morceaux de Vespertine."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "Vespertine નાં ગીત ટ્રાન્ઝિશન ચાલુ કે બંધ કરે છે."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Yana kunna ko kashe sauye-sauyen waƙoƙi na Vespertine."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מפעיל או מכבה את המעברים בין שירים ב־Vespertine."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vespertine के गानों के ट्रांज़िशन चालू या बंद करता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Be- vagy kikapcsolja a Vespertine dalok közötti átmeneteit."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyalakan atau mematikan transisi lagu Vespertine."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva o disattiva le transizioni tra i brani di Vespertine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Vespertineの曲間トランジションをオンまたはオフにします。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "Vespertine ಹಾಡು ಟ್ರಾನ್ಸಿಷನ್‌ಗಳನ್ನು ಆನ್ ಅಥವಾ ಆಫ್ ಮಾಡುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Vespertine의 곡 전환을 켜거나 끕니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Vespertine-ന്റെ പാട്ട് ട്രാൻസിഷനുകൾ ഓണാക്കുകയോ ഓഫാക്കുകയോ ചെയ്യുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vespertine ची गाण्यांमधील ट्रान्झिशन चालू किंवा बंद करते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghidupkan atau mematikan peralihan lagu Vespertine."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slår Vespertines overganger mellom sanger på eller av."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet de overgangen tussen nummers in Vespertine aan of uit."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "Vespertine ਦੇ ਗੀਤ ਟ੍ਰਾਂਜ਼ੀਸ਼ਨ ਚਾਲੂ ਜਾਂ ਬੰਦ ਕਰਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącza lub wyłącza przejścia między utworami w Vespertine."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativa ou desativa as transições entre músicas do Vespertine."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativa ou desativa as transições entre músicas do Vespertine."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pornește sau oprește tranzițiile dintre melodii din Vespertine."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Slår på eller av Vespertines övergångar mellan låtar."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Huwasha au huzima mipito ya nyimbo ya Vespertine."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Vespertine பாடல் டிரான்சிஷன்களை இயக்கும் அல்லது அணைக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Vespertine పాటల ట్రాన్సిషన్‌లను ఆన్ లేదా ఆఫ్ చేస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดหรือปิดการเปลี่ยนเพลงของ Vespertine"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vespertine'in şarkı geçişlerini açar veya kapatır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вмикає або вимикає переходи між піснями у Vespertine."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Vespertine کی گانوں کی ٹرانزیشن آن یا آف کرتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật hoặc tắt chuyển bài của Vespertine."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟或關閉 Vespertine 的歌曲轉場。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开或关闭 Vespertine 的歌曲过渡。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟或關閉 Vespertine 的歌曲轉場。"
          }
        }
      }

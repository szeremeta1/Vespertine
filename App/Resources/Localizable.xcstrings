          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay conectado ningún micrófono llamado «%@». Conecta el UMIK-1 y vuelve a intentarlo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "میکروفونی با نام «%@» وصل نیست. UMIK-1 را وصل کنید و دوباره تلاش کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofonia nimeltä ”%@” ei ole kytketty. Liitä UMIK-1 ja yritä uudelleen."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang nakakonektang mikropono na may pangalang “%@”. Isaksak ang UMIK-1 at subukan muli."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun micro nommé « %@ » n'est connecté. Branchez l'UMIK-1 et réessayez."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” નામનું કોઈ માઇક્રોફોન જોડાયેલું નથી. UMIK-1 લગાવો અને ફરી પ્રયત્ન કરો."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Babu makirufo mai suna “%@” da aka haɗa. Toshe UMIK-1 sannan a sake gwadawa."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא מחובר מיקרופון בשם “%@”. חברו את ה-UMIK-1 ונסו שוב."

    "The calibration file needs at least two frequency and level rows.": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "የልኬት ፋይሉ ቢያንስ ሁለት የድግግሞሽና የደረጃ ረድፎች ያስፈልገዋል።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج ملف المعايرة إلى صفّين على الأقل من التردد والمستوى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ক্যালিব্রেশন ফাইলে অন্তত দুটি ফ্রিকোয়েন্সি ও লেভেল সারি দরকার।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalibrační soubor potřebuje alespoň dva řádky s frekvencí a úrovní."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalibreringsfilen skal have mindst to rækker med frekvens og niveau."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kalibrierungsdatei braucht mindestens zwei Zeilen mit Frequenz und Pegel."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το αρχείο βαθμονόμησης χρειάζεται τουλάχιστον δύο γραμμές συχνότητας και στάθμης."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo de calibración necesita al menos dos filas de frecuencia y nivel."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فایل کالیبراسیون دست‌کم به دو ردیف فرکانس و سطح نیاز دارد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalibrointitiedostossa on oltava vähintään kaksi taajuus- ja tasoriviä."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kailangan ng calibration file ng kahit dalawang hilera ng frequency at level."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier d'étalonnage doit contenir au moins deux lignes de fréquence et de niveau."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કેલિબ્રેશન ફાઇલમાં ઓછામાં ઓછી બે આવૃત્તિ અને લેવલ પંક્તિઓ જોઈએ."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Fayil ɗin daidaitawa yana buƙatar aƙalla layuka biyu na mita da mataki."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קובץ הכיול דורש לפחות שתי שורות של תדר ורמה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैलिब्रेशन फ़ाइल में कम से कम दो आवृत्ति-स्तर पंक्तियाँ चाहिए।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kalibrációs fájlnak legalább két frekvencia–szint sort kell tartalmaznia."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "File kalibrasi memerlukan setidaknya dua baris frekuensi dan level."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il file di calibrazione richiede almeno due righe di frequenza e livello."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャリブレーションファイルには、周波数とレベルの行が少なくとも 2 行必要です。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಕ್ಯಾಲಿಬ್ರೇಶನ್ ಫೈಲ್‌ಗೆ ಕನಿಷ್ಠ ಎರಡು ಆವರ್ತನ ಮತ್ತು ಮಟ್ಟದ ಸಾಲುಗಳು ಬೇಕು."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보정 파일에는 주파수와 레벨 행이 두 개 이상 필요합니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കാലിബ്രേഷൻ ഫയലിൽ കുറഞ്ഞത് രണ്ട് ആവൃത്തി–ലെവൽ വരികൾ വേണം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कॅलिब्रेशन फाइलमध्ये किमान दोन वारंवारता आणि पातळी ओळी हव्यात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Fail penentukuran memerlukan sekurang-kurangnya dua baris frekuensi dan aras."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalibreringsfilen trenger minst to rader med frekvens og nivå."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het kalibratiebestand heeft minstens twee regels met frequentie en niveau nodig."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੈਲੀਬ੍ਰੇਸ਼ਨ ਫ਼ਾਈਲ ਵਿੱਚ ਘੱਟੋ-ਘੱਟ ਦੋ ਆਵਿਰਤੀ ਅਤੇ ਪੱਧਰ ਦੀਆਂ ਕਤਾਰਾਂ ਚਾਹੀਦੀਆਂ ਹਨ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plik kalibracyjny musi zawierać co najmniej dwa wiersze z częstotliwością i poziomem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo de calibração precisa de pelo menos duas linhas de frequência e nível."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O ficheiro de calibração precisa de pelo menos duas linhas de frequência e nível."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fișierul de calibrare are nevoie de cel puțin două rânduri cu frecvență și nivel."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalibreringsfilen behöver minst två rader med frekvens och nivå."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Faili ya urekebishaji inahitaji angalau safu mbili za masafa na kiwango."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அளவுத்திருத்தக் கோப்புக்கு குறைந்தது இரண்டு அதிர்வெண்-அளவு வரிசைகள் தேவை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "క్యాలిబ్రేషన్ ఫైల్‌కు కనీసం రెండు ఫ్రీక్వెన్సీ మరియు స్థాయి వరుసలు కావాలి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟล์สอบเทียบต้องมีแถวความถี่และระดับอย่างน้อยสองแถว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalibrasyon dosyasında en az iki frekans ve seviye satırı olmalı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл калібрування має містити щонайменше два рядки з частотою й рівнем."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کیلیبریشن فائل میں کم از کم دو فریکوئنسی اور لیول قطاریں ہونی چاہئیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tệp hiệu chuẩn cần ít nhất hai hàng tần số và mức."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "校正檔案至少需要兩行頻率和電平資料。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "校准文件至少需要两行频率和电平数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "校正檔案至少需要兩行頻率和電平資料。"
          }
        }
      }
    },
    "The calibration file's first line has a sensitivity that couldn't be read.": {
      "localizations": {
        "am": {
          "stringUnit": {

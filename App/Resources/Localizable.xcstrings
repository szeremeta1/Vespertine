    "Too short for the spectral checks (they need a couple of seconds of audio), so the result is inconclusive.": {
      "extractionState": "manual",
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ለስፔክትራል ፍተሻዎች በጣም አጭር ነው (ጥቂት ሰከንዶች ድምፅ ያስፈልጋቸዋል)፣ ስለዚህ ውጤቱ ያልተወሰነ ነው።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قصير جدًا للفحوصات الطيفية (تحتاج إلى بضع ثوانٍ من الصوت)، لذا النتيجة غير حاسمة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্পেকট্রাল যাচাইয়ের জন্য খুব ছোট (এগুলোর জন্য কয়েক সেকেন্ডের অডিও দরকার), তাই ফলাফল অমীমাংসিত।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Příliš krátké pro spektrální kontroly (potřebují několik sekund zvuku), takže výsledek je neprůkazný."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "For kort til de spektrale kontroller (de kræver et par sekunders lyd), så resultatet er uafklaret."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu kurz für die Spektralprüfungen (sie benötigen ein paar Sekunden Audio), daher ist das Ergebnis unklar."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πολύ σύντομο για τους φασματικούς ελέγχους (χρειάζονται μερικά δευτερόλεπτα ήχου), οπότε το αποτέλεσμα είναι ασαφές."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too short for the spectral checks (they need a couple of seconds of audio), so the result is inconclusive."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es demasiado corto para las comprobaciones espectrales (necesitan un par de segundos de audio), así que el resultado no es concluyente."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای بررسی‌های طیفی بیش از حد کوتاه است (به چند ثانیه صدا نیاز دارند)، بنابراین نتیجه نامشخص است."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liian lyhyt spektritarkistuksiin (ne tarvitsevat pari sekuntia ääntä), joten tulos on epäselvä."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Masyadong maikli para sa mga spectral check (kailangan nila ng ilang segundo ng audio), kaya hindi tiyak ang resulta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop court pour les vérifications spectrales (elles nécessitent quelques secondes d’audio) : le résultat n’est donc pas concluant."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સ્પેક્ટ્રલ તપાસ માટે ખૂબ ટૂંકું (તેને થોડી સેકંડનો ઑડિયો જોઈએ), તેથી પરિણામ અનિર્ણિત છે."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya yi gajere sosai don binciken bakan mita (suna buƙatar 'yan daƙiƙoƙi na sauti), don haka sakamakon ba tabbas."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קצר מדי לבדיקות הספקטרליות (הן דורשות כמה שניות של שמע), ולכן התוצאה אינה חד־משמעית."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्पेक्ट्रल जाँच के लिए बहुत छोटी (उनके लिए कुछ सेकंड का ऑडियो चाहिए), इसलिए परिणाम अनिर्णीत है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Túl rövid a spektrális vizsgálatokhoz (néhány másodpercnyi hang kell hozzájuk), így az eredmény nem egyértelmű."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terlalu pendek untuk pemeriksaan spektral (memerlukan beberapa detik audio), sehingga hasilnya tidak meyakinkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Troppo breve per i controlli spettrali (richiedono un paio di secondi di audio), quindi il risultato non è conclusivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スペクトルの確認には数秒のオーディオが必要ですが、短すぎるため結果は判定不能です。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸ್ಪೆಕ್ಟ್ರಲ್ ಪರಿಶೀಲನೆಗಳಿಗೆ ತುಂಬಾ ಚಿಕ್ಕದು (ಅವುಗಳಿಗೆ ಕೆಲವು ಸೆಕೆಂಡುಗಳ ಆಡಿಯೋ ಬೇಕು), ಆದ್ದರಿಂದ ಫಲಿತಾಂಶ ಅನಿರ್ಣಾಯಕ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스펙트럼 검사에 필요한 길이(몇 초 분량의 오디오)보다 짧아 결과를 판정할 수 없습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സ്പെക്ട്രൽ പരിശോധനകൾക്ക് വളരെ ചെറുതാണ് (അവയ്ക്ക് കുറച്ച് സെക്കൻഡ് ഓഡിയോ വേണം), അതിനാൽ ഫലം നിർണ്ണയിക്കാനായില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "स्पेक्ट्रल तपासण्यांसाठी खूप लहान (त्यांना काही सेकंदांचा ऑडिओ लागतो), त्यामुळे परिणाम अनिर्णित आहे."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Terlalu pendek untuk semakan spektrum (ia memerlukan beberapa saat audio), jadi keputusannya tidak muktamad."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "For kort for spektralsjekkene (de trenger et par sekunder med lyd), så resultatet er uavklart."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te kort voor de spectrumcontroles (die hebben een paar seconden audio nodig), dus het resultaat is onbeslist."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਪੈਕਟ੍ਰਲ ਜਾਂਚਾਂ ਲਈ ਬਹੁਤ ਛੋਟੀ (ਉਹਨਾਂ ਨੂੰ ਕੁਝ ਸਕਿੰਟਾਂ ਦਾ ਆਡੀਓ ਚਾਹੀਦਾ ਹੈ), ਇਸ ਲਈ ਨਤੀਜਾ ਅਨਿਸ਼ਚਿਤ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zbyt krótki do kontroli widmowych (wymagają kilku sekund dźwięku), więc wynik jest nierozstrzygnięty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Curto demais para as verificações espectrais (elas precisam de alguns segundos de áudio), então o resultado é inconclusivo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Demasiado curto para as verificações espectrais (precisam de alguns segundos de áudio), por isso o resultado é inconclusivo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Prea scurt pentru verificările spectrale (acestea necesită câteva secunde de audio), așa că rezultatul este neconcludent."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För kort för spektralkontrollerna (de behöver ett par sekunders ljud), så resultatet är inte avgörande."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ni fupi mno kwa ukaguzi wa wigo (unahitaji sekunde chache za sauti), kwa hivyo matokeo hayajathibitishwa."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஸ்பெக்ட்ரல் சோதனைகளுக்கு மிகக் குறுகியது (அவற்றுக்குச் சில வினாடிகள் ஆடியோ தேவை), எனவே முடிவு உறுதியற்றது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "స్పెక్ట్రల్ తనిఖీలకు చాలా చిన్నది (వాటికి కొన్ని సెకన్ల ఆడియో అవసరం), కాబట్టి ఫలితం నిర్ధారణ కాలేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สั้นเกินไปสำหรับการตรวจสเปกตรัม (ต้องใช้เสียงอย่างน้อยสองสามวินาที) ผลลัพธ์จึงสรุปไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Spektral denetimler için çok kısa (birkaç saniyelik ses gerekir); bu yüzden sonuç belirsiz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надто короткий для спектральних перевірок (їм потрібно кілька секунд аудіо), тому результат невизначений."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اسپیکٹرل جانچ کے لیے بہت مختصر (انہیں چند سیکنڈ آڈیو درکار ہے)، اس لیے نتیجہ غیر حتمی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quá ngắn để kiểm tra phổ (cần vài giây âm thanh), vì vậy chưa thể kết luận."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "長度太短，無法進行頻譜檢查（需要數秒音訊），因此結果未能確定。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "时长太短，无法进行频谱检查（需要几秒钟的音频），因此结果无法确定。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "長度太短，無法進行頻譜檢查（需要幾秒鐘的音訊），因此結果無法確定。"
          }
        }
      }
    },

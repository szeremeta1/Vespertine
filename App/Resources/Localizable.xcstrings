                  "value": "%2$lld ఫైల్‌లకు %1$@ రాస్తుంది · అన్‌డూ కోసం బ్యాకప్ ఉంచబడుతుంది"
                }
              }
            }
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เขียน %@ ลงใน %lld ไฟล์ · เก็บข้อมูลสำรองไว้สำหรับเลิกทำ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$lld dosyaya %1$@ yazar · geri almak için yedek saklanır"
          }
        },
        "uk": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Записує %@ у %lld файл · є копія для скасування"
                }
              },
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Записує %@ у %lld файли · є копія для скасування"
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Записує %@ у %lld файлів · є копія для скасування"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Записує %@ у %lld файлу · є копія для скасування"
                }
              }
            }
          }
        },
        "ur": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%@ کو %lld فائل میں لکھتا ہے · واپس لینے کے لیے بیک اپ محفوظ رہتا ہے"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%@ کو %lld فائلوں میں لکھتا ہے · واپس لینے کے لیے بیک اپ محفوظ رہتا ہے"
                }
              }
            }
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi %@ vào %lld tệp · giữ bản sao lưu để hoàn tác"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "%@將寫入 %lld 個檔案 · 保留備份以便還原"
          }

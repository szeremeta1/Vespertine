          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فیلتر نمونه‌هایی دارد که عدد نیستند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Suodattimessa on näytteitä, jotka eivät ole lukuja."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "May mga sample ang filter na hindi numero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",

    "The sweep's fade must be short compared with the sweep.": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "የጠረጋው መደብዘዝ ከጠረጋው ጋር ሲነጻጸር አጭር መሆን አለበት።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب أن يكون تلاشي المسح قصيرًا مقارنةً بالمسح."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সুইপের ফেড সুইপের তুলনায় ছোট হতে হবে।"
          }

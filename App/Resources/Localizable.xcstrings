    "Bring in filters made with REW or another measurement tool": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "በREW ወይም በሌላ የመለኪያ መሣሪያ የተሠሩ ማጣሪያዎችን ያስገቡ"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استيراد مرشحات من REW أو أداة قياس أخرى"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "REW বা অন্য পরিমাপ টুলে তৈরি ফিল্টার আনুন"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Načíst filtry z REW nebo jiného měřicího nástroje"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hent filtre lavet i REW eller et andet måleværktøj"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Filter aus REW oder einem anderen Messprogramm übernehmen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Φέρτε φίλτρα από το REW ή άλλο εργαλείο μέτρησης"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Traer filtros hechos con REW u otra herramienta de medición"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "آوردن فیلترهای ساخته‌شده در REW یا ابزار اندازه‌گیری دیگر"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuo REW:llä tai muulla mittaustyökalulla tehtyjä suodattimia"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mag-import ng mga filter na ginawa sa REW o ibang tool sa pagsukat"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Importer des filtres créés avec REW ou un autre outil de mesure"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "REW અથવા બીજા માપન ટૂલથી બનેલા ફિલ્ટર લાવો"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Shigo da matatun da aka yi da REW ko wani kayan auna"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ייבוא מסננים שנוצרו ב־REW או בכלי מדידה אחר"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "REW या किसी दूसरे माप टूल से बने फ़िल्टर लाएँ"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "REW-vel vagy más mérőeszközzel készült szűrők behozása"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Impor filter yang dibuat dengan REW atau alat ukur lain"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Importa filtri creati con REW o un altro strumento di misura"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "REW などの測定ツールで作ったフィルターを取り込みます"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "REW ಅಥವಾ ಬೇರೆ ಅಳತೆ ಟೂಲ್‌ನಲ್ಲಿ ಮಾಡಿದ ಫಿಲ್ಟರ್‌ಗಳನ್ನು ತನ್ನಿ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "REW나 다른 측정 도구로 만든 필터 가져오기"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "REW-ലോ മറ്റൊരു അളവെടുപ്പ് ടൂളിലോ ഉണ്ടാക്കിയ ഫിൽട്ടറുകൾ കൊണ്ടുവരിക"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "REW किंवा दुसऱ्या मापन साधनाने बनवलेले फिल्टर आणा"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bawa masuk penapis yang dibuat dengan REW atau alat pengukuran lain"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hent filtre laget i REW eller et annet måleverktøy"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Filters overnemen uit REW of een ander meetprogramma"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "REW ਜਾਂ ਕਿਸੇ ਹੋਰ ਮਾਪ ਟੂਲ ਨਾਲ ਬਣੇ ਫ਼ਿਲਟਰ ਲਿਆਓ"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wczytaj filtry z REW lub innego narzędzia pomiarowego"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Trazer filtros feitos no REW ou em outra ferramenta de medição"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Trazer filtros feitos no REW ou noutra ferramenta de medição"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adaugă filtre făcute în REW sau în alt instrument de măsură"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hämta filter gjorda i REW eller ett annat mätverktyg"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Leta vichujio vilivyotengenezwa kwa REW au zana nyingine ya kupima"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "REW அல்லது வேறு அளவீட்டுக் கருவியில் உருவாக்கிய ஃபில்டர்களைக் கொண்டுவாருங்கள்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "REW లేదా ఇతర కొలత టూల్‌తో చేసిన ఫిల్టర్‌లను తీసుకురండి"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นำเข้าฟิลเตอร์ที่สร้างด้วย REW หรือเครื่องมือวัดอื่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "REW veya başka bir ölçüm aracıyla yapılan filtreleri getir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додати фільтри, створені в REW або іншому інструменті вимірювання"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "REW یا کسی اور پیمائشی ٹول میں بنے فلٹر لائیں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập bộ lọc tạo bằng REW hoặc công cụ đo khác"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "匯入用 REW 或其他量度工具製作的濾波器"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入用 REW 或其他测量工具制作的滤波器"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匯入用 REW 或其他量測工具製作的濾波器"
          }
        }
      }
    },

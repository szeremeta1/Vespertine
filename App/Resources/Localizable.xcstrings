          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspelningen är för kort för att innehålla tidsreferenserna."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekodi ni fupi mno kuweza kuwa na marejeo ya muda."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நேரக் குறிப்புகளைக் கொண்டிருக்க பதிவு மிகவும் குறைவாக உள்ளது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "టైమింగ్ రిఫరెన్స్‌లను కలిగి ఉండటానికి రికార్డింగ్ చాలా చిన్నది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การบันทึกสั้นเกินกว่าจะมีสัญญาณอ้างอิงเวลา"

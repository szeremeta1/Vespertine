        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "i VOB terminano prima delle celle elencate dall’IFO (una copia troncata)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "VOBがIFOに記載されたセルより前に終わっています（途中で切れたコピー）"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "IFO ಪಟ್ಟಿ ಮಾಡುವ ಸೆಲ್‌ಗಳಿಗಿಂತ ಮೊದಲೇ VOB ಗಳು ಕೊನೆಗೊಳ್ಳುತ್ತವೆ (ಅಪೂರ್ಣ ಪ್ರತಿ)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",

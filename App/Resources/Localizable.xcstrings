    "The calibration file at %@ couldn't be read: %@ Choose the UMIK-1's calibration file (90° for a microphone pointing up).": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "በ%@ ያለው የልኬት ፋይል ሊነበብ አልቻለም፦ %@ የUMIK-1 የልኬት ፋይል ይምረጡ (ማይክሮፎን ወደ ላይ ለሚያመለክት 90°)።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّرت قراءة ملف المعايرة في %@: %@ اختر ملف معايرة UMIK-1 (90° للميكروفون الموجّه للأعلى)."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-এর ক্যালিব্রেশন ফাইলটি পড়া যায়নি: %@ UMIK-1-এর ক্যালিব্রেশন ফাইল বেছে নিন (উপরের দিকে মুখ করা মাইক্রোফোনের জন্য 90°)।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalibrační soubor v %@ nelze přečíst: %@ Vyberte kalibrační soubor mikrofonu UMIK-1 (90° pro mikrofon mířící nahoru)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalibreringsfilen i %@ kunne ikke læses: %@ Vælg UMIK-1's kalibreringsfil (90° for en mikrofon, der peger opad)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kalibrierungsdatei unter %@ konnte nicht gelesen werden: %@ Wählen Sie die Kalibrierungsdatei des UMIK-1 (90° für ein nach oben zeigendes Mikrofon)."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το αρχείο βαθμονόμησης στο %@ δεν μπόρεσε να διαβαστεί: %@ Επιλέξτε το αρχείο βαθμονόμησης του UMIK-1 (90° για μικρόφωνο στραμμένο προς τα πάνω)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer el archivo de calibración en %@: %@ Elige el archivo de calibración del UMIK-1 (90° para un micrófono apuntando hacia arriba)."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فایل کالیبراسیون در %@ خوانده نشد: %@ فایل کالیبراسیون UMIK-1 را انتخاب کنید (90° برای میکروفون رو به بالا)."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalibrointitiedostoa kohteessa %@ ei voitu lukea: %@ Valitse UMIK-1:n kalibrointitiedosto (90° ylöspäin osoittavalle mikrofonille)."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi nabasa ang calibration file sa %@: %@ Piliin ang calibration file ng UMIK-1 (90° para sa mikroponong nakaturo pataas)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier d'étalonnage à %@ n'a pas pu être lu : %@ Choisissez le fichier d'étalonnage de l'UMIK-1 (90° pour un micro orienté vers le haut)."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ પરની કેલિબ્રેશન ફાઇલ વાંચી શકાઈ નથી: %@ UMIK-1 ની કેલિબ્રેશન ફાઇલ પસંદ કરો (ઉપર તરફના માઇક્રોફોન માટે 90°)."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ba a iya karanta fayil ɗin daidaitawa a %@ ba: %@ Zaɓi fayil ɗin daidaitawa na UMIK-1 (90° don makirufo mai nuni sama)."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לקרוא את קובץ הכיול ב-%@: %@ בחרו את קובץ הכיול של ה-UMIK-1 (90° למיקרופון המופנה כלפי מעלה)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ पर कैलिब्रेशन फ़ाइल पढ़ी नहीं जा सकी: %@ UMIK-1 की कैलिब्रेशन फ़ाइल चुनें (ऊपर की ओर वाले माइक्रोफ़ोन के लिए 90°)।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) %@ helyen lévő kalibrációs fájl nem olvasható: %@ Válassza ki az UMIK-1 kalibrációs fájlját (90° a felfelé néző mikrofonhoz)."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "File kalibrasi di %@ tidak dapat dibaca: %@ Pilih file kalibrasi UMIK-1 (90° untuk mikrofon yang mengarah ke atas)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile leggere il file di calibrazione in %@: %@ Scegli il file di calibrazione dell'UMIK-1 (90° per un microfono rivolto verso l'alto)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ のキャリブレーションファイルを読み取れませんでした: %@ UMIK-1 のキャリブレーションファイルを選んでください（マイクを上向きにする場合は 90°）。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ನಲ್ಲಿರುವ ಕ್ಯಾಲಿಬ್ರೇಶನ್ ಫೈಲ್ ಓದಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ: %@ UMIK-1 ನ ಕ್ಯಾಲಿಬ್ರೇಶನ್ ಫೈಲ್ ಆಯ್ಕೆಮಾಡಿ (ಮೇಲ್ಮುಖ ಮೈಕ್ರೊಫೋನ್‌ಗೆ 90°)."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 보정 파일을 읽을 수 없습니다: %@ UMIK-1의 보정 파일을 선택하세요(마이크를 위로 향하게 할 때는 90°)."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ലെ കാലിബ്രേഷൻ ഫയൽ വായിക്കാൻ കഴിഞ്ഞില്ല: %@ UMIK-1 ന്റെ കാലിബ്രേഷൻ ഫയൽ തിരഞ്ഞെടുക്കുക (മുകളിലേക്ക് തിരിച്ച മൈക്രോഫോണിന് 90°)."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ वरील कॅलिब्रेशन फाइल वाचता आली नाही: %@ UMIK-1 ची कॅलिब्रेशन फाइल निवडा (वरच्या दिशेने असलेल्या मायक्रोफोनसाठी 90°)."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Fail penentukuran di %@ tidak dapat dibaca: %@ Pilih fail penentukuran UMIK-1 (90° untuk mikrofon yang menghala ke atas)."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalibreringsfilen på %@ kunne ikke leses: %@ Velg UMIK-1s kalibreringsfil (90° for en mikrofon som peker oppover)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het kalibratiebestand op %@ kon niet worden gelezen: %@ Kies het kalibratiebestand van de UMIK-1 (90° voor een microfoon die omhoog wijst)."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ਦੀ ਕੈਲੀਬ੍ਰੇਸ਼ਨ ਫ਼ਾਈਲ ਪੜ੍ਹੀ ਨਹੀਂ ਜਾ ਸਕੀ: %@ UMIK-1 ਦੀ ਕੈਲੀਬ੍ਰੇਸ਼ਨ ਫ਼ਾਈਲ ਚੁਣੋ (ਉੱਪਰ ਵੱਲ ਮਾਈਕ੍ਰੋਫ਼ੋਨ ਲਈ 90°)।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można odczytać pliku kalibracyjnego w %@: %@ Wybierz plik kalibracyjny mikrofonu UMIK-1 (90° dla mikrofonu skierowanego do góry)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler o arquivo de calibração em %@: %@ Escolha o arquivo de calibração do UMIK-1 (90° para um microfone apontado para cima)."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler o ficheiro de calibração em %@: %@ Escolha o ficheiro de calibração do UMIK-1 (90° para um microfone a apontar para cima)."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fișierul de calibrare de la %@ nu a putut fi citit: %@ Alege fișierul de calibrare al UMIK-1 (90° pentru un microfon orientat în sus)."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalibreringsfilen på %@ gick inte att läsa: %@ Välj UMIK-1:s kalibreringsfil (90° för en mikrofon som pekar uppåt)."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Faili ya urekebishaji katika %@ haikuweza kusomwa: %@ Chagua faili ya urekebishaji ya UMIK-1 (90° kwa maikrofoni inayoelekeza juu)."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ இல் உள்ள அளவுத்திருத்தக் கோப்பைப் படிக்க முடியவில்லை: %@ UMIK-1 இன் அளவுத்திருத்தக் கோப்பைத் தேர்ந்தெடுக்கவும் (மேல்நோக்கிய மைக்ரோஃபோனுக்கு 90°)."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ వద్ద ఉన్న క్యాలిబ్రేషన్ ఫైల్‌ను చదవలేకపోయాం: %@ UMIK-1 క్యాలిబ్రేషన్ ఫైల్‌ను ఎంచుకోండి (పైకి చూపే మైక్రోఫోన్‌కు 90°)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อ่านไฟล์สอบเทียบที่ %@ ไม่ได้: %@ เลือกไฟล์สอบเทียบของ UMIK-1 (90° สำหรับไมโครโฟนที่หันขึ้น)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ konumundaki kalibrasyon dosyası okunamadı: %@ UMIK-1'in kalibrasyon dosyasını seçin (yukarı bakan mikrofon için 90°)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося прочитати файл калібрування за адресою %@: %@ Виберіть файл калібрування UMIK-1 (90° для мікрофона, спрямованого вгору)."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ پر موجود کیلیبریشن فائل پڑھی نہیں جا سکی: %@ UMIK-1 کی کیلیبریشن فائل منتخب کریں (اوپر کی طرف مائیکروفون کے لیے 90°)۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không đọc được tệp hiệu chuẩn tại %@: %@ Hãy chọn tệp hiệu chuẩn của UMIK-1 (90° cho micro hướng lên)."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取 %@ 處的校正檔案：%@ 請選擇 UMIK-1 的校正檔案（麥克風朝上時選 90°）。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取 %@ 处的校准文件：%@ 请选择 UMIK-1 的校准文件（麦克风朝上时选 90°）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取 %@ 處的校正檔案：%@ 請選擇 UMIK-1 的校正檔案（麥克風朝上時選 90°）。"
          }
        }
      }
    },
    "The calibration file isn't a text file.": {

          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ SACD ઇમેજમાં Vespertine વગાડી શકે એવો કોઈ ઑડિયો વિસ્તાર નથી."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Wannan kwafin SACD ba shi da yankin sauti da Vespertine zai iya kunnawa."

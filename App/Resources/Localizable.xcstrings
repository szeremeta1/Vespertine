          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta imagen SACD no tiene ningún área de audio que Vespertine pueda reproducir."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این ایمیج SACD هیچ ناحیهٔ صوتی‌ای ندارد که Vespertine بتواند پخش کند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tässä SACD-levykuvassa ei ole äänialuetta, jota Vespertine voisi toistaa."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang audio area sa SACD image na ito na kayang i-play ng Vespertine."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette image SACD ne contient aucune zone audio que Vespertine peut lire."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ SACD ઇમેજમાં Vespertine વગાડી શકે એવો કોઈ ઑડિયો વિસ્તાર નથી."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Wannan kwafin SACD ba shi da yankin sauti da Vespertine zai iya kunnawa."

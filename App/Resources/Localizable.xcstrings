    "Copies music into one folder, sorted by artist and album. Your originals stay as they are.": {
      "extractionState": "manual",
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ሙዚቃን በአርቲስት እና በአልበም አደራጅቶ ወደ አንድ አቃፊ ይቀዳል። ዋናዎቹ ፋይሎችዎ እንዳሉ ይቆያሉ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينسخ الموسيقى إلى مجلد واحد، مرتبةً حسب الفنان والألبوم. تبقى ملفاتك الأصلية كما هي."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মিউজিক একটি ফোল্ডারে কপি করে, শিল্পী ও অ্যালবাম অনুযায়ী সাজিয়ে। আপনার মূল ফাইল যেমন আছে তেমনই থাকে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zkopíruje hudbu do jedné složky, roztříděnou podle interpretů a alb. Originály zůstanou beze změny."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopierer musik til én mappe, sorteret efter kunstner og album. Dine originaler forbliver, som de er."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopiert Musik in einen Ordner, sortiert nach Künstler und Album. Deine Originale bleiben unverändert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αντιγράφει τη μουσική σε έναν φάκελο, ταξινομημένη ανά καλλιτέχνη και άλμπουμ. Τα πρωτότυπα μένουν ως έχουν."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copies music into one folder, sorted by artist and album. Your originals stay as they are."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia la música en una sola carpeta, ordenada por artista y álbum. Tus originales se quedan como están."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "موسیقی را در یک پوشه کپی و بر اساس هنرمند و آلبوم مرتب می‌کند. فایل‌های اصلی شما دست‌نخورده می‌مانند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopioi musiikin yhteen kansioon esittäjän ja albumin mukaan järjestettynä. Alkuperäiset tiedostot pysyvät ennallaan."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kinokopya ang musika sa iisang folder, inaayos ayon sa artist at album. Mananatiling buo ang mga orihinal mo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copie la musique dans un seul dossier, classée par artiste et par album. Vos originaux restent intacts."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સંગીતને એક ફોલ્ડરમાં કૉપિ કરે છે, કલાકાર અને આલ્બમ પ્રમાણે ગોઠવીને. તમારી મૂળ ફાઇલો જેમ છે તેમ જ રહે છે."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Yana kwafa waƙoƙi zuwa folda ɗaya, an tsara su bisa mawaƙi da kundi. Fayilolinku na asali suna nan yadda suke."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מעתיק מוזיקה לתיקייה אחת, ממוינת לפי אמן ואלבום. הקבצים המקוריים נשארים כפי שהם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संगीत को एक फ़ोल्डर में कॉपी करता है, कलाकार और एल्बम के अनुसार व्यवस्थित। आपकी मूल फ़ाइलें जैसी हैं, वैसी ही रहती हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egyetlen mappába másolja a zenét, előadó és album szerint rendezve. Az eredeti fájlok változatlanok maradnak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyalin musik ke satu folder, diurutkan menurut artis dan album. File asli Anda tetap seperti semula."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia la musica in un’unica cartella, ordinata per artista e album. I tuoi originali restano come sono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音楽を1つのフォルダにコピーし、アーティストとアルバムごとに整理します。元のファイルはそのまま残ります。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸಂಗೀತವನ್ನು ಕಲಾವಿದ ಮತ್ತು ಆಲ್ಬಮ್ ಪ್ರಕಾರ ಜೋಡಿಸಿ ಒಂದೇ ಫೋಲ್ಡರ್‌ಗೆ ನಕಲಿಸುತ್ತದೆ. ನಿಮ್ಮ ಮೂಲ ಫೈಲ್‌ಗಳು ಹಾಗೆಯೇ ಉಳಿಯುತ್ತವೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음악을 하나의 폴더에 복사하고 아티스트와 앨범별로 정리합니다. 원본 파일은 그대로 유지됩니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സംഗീതം ആർട്ടിസ്റ്റും ആൽബവും അനുസരിച്ച് ക്രമീകരിച്ച് ഒരു ഫോൾഡറിലേക്ക് പകർത്തുന്നു. നിങ്ങളുടെ ഒറിജിനൽ ഫയലുകൾ അതേപടി നിലനിൽക്കും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "संगीत एका फोल्डरमध्ये कॉपी करते, कलाकार आणि अल्बमनुसार लावलेले. तुमच्या मूळ फाइल्स आहेत तशाच राहतात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyalin muzik ke dalam satu folder, disusun mengikut artis dan album. Fail asal anda kekal seperti sedia ada."

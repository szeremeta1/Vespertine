    "Look up missing details and cover art on MusicBrainz afterwards": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ከዚያ በኋላ የጎደሉ ዝርዝሮችንና የሽፋን ምስሎችን በMusicBrainz ላይ ፈልግ"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "البحث عن التفاصيل وصور الغلاف الناقصة في MusicBrainz بعد ذلك"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এরপর MusicBrainz-এ অনুপস্থিত তথ্য ও কভার আর্ট খুঁজুন"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Poté vyhledat chybějící údaje a obaly v MusicBrainz"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå manglende oplysninger og omslag op på MusicBrainz bagefter"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fehlende Details und Cover anschließend in MusicBrainz suchen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αναζήτηση στοιχείων και εξωφύλλων που λείπουν στο MusicBrainz στη συνέχεια"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Buscar después los datos y las portadas que faltan en MusicBrainz"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "جست‌وجوی جزئیات و تصویر جلد ناموجود در MusicBrainz پس از افزودن"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hae puuttuvat tiedot ja kansikuvat MusicBrainzista jälkikäteen"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanapin pagkatapos sa MusicBrainz ang mga kulang na detalye at cover art"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechercher ensuite les informations et pochettes manquantes sur MusicBrainz"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પછીથી MusicBrainz પર ખૂટતી વિગતો અને કવર આર્ટ શોધો"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Nemi bayanan da suka ɓace da hotunan bango a MusicBrainz bayan haka"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חפש פרטים ותמונות עטיפה חסרים ב־MusicBrainz לאחר מכן"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसके बाद MusicBrainz पर छूटी हुई जानकारी और कवर आर्ट खोजें"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Utána a hiányzó adatok és borítók keresése a MusicBrainzen"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cari detail dan sampul yang hilang di MusicBrainz setelahnya"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerca poi su MusicBrainz i dettagli e le copertine mancanti"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追加後、足りない情報とカバーアートをMusicBrainzで検索"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಂತರ ಕಾಣೆಯಾದ ವಿವರಗಳು ಮತ್ತು ಕವರ್ ಆರ್ಟ್ ಅನ್ನು MusicBrainz ನಲ್ಲಿ ಹುಡುಕಿ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추가한 후 MusicBrainz에서 누락된 정보와 커버 아트 찾기"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അതിനുശേഷം MusicBrainz-ൽ നഷ്ടമായ വിശദാംശങ്ങളും കവർ ആർട്ടും തിരയുക"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "नंतर MusicBrainz वर गहाळ तपशील आणि कव्हर आर्ट शोधा"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Cari butiran dan kulit album yang tiada di MusicBrainz selepas itu"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå opp manglende opplysninger og omslag på MusicBrainz etterpå"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoek daarna ontbrekende gegevens en illustraties op in MusicBrainz"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਬਾਅਦ ਵਿੱਚ MusicBrainz ’ਤੇ ਗੁੰਮ ਵੇਰਵੇ ਅਤੇ ਕਵਰ ਆਰਟ ਲੱਭੋ"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Następnie wyszukaj brakujące informacje i okładki w MusicBrainz"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Buscar depois no MusicBrainz os detalhes e capas que faltam"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Procurar detalhes e capas em falta no MusicBrainz depois"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Caută ulterior detaliile și copertele lipsă pe MusicBrainz"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå upp saknade uppgifter och omslag på MusicBrainz efteråt"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Tafuta maelezo yanayokosekana na picha za jalada kwenye MusicBrainz baadaye"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பிறகு விடுபட்ட விவரங்களையும் கவர் ஆர்ட்டையும் MusicBrainz-இல் தேடு"

          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Subțire: măsurat. Groasă: prevăzut după corecție (calculat, nu măsurat). Întreruptă: țintă. Măsoară din nou cu corecția pornită pentru a verifica în cameră."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tunn: uppmätt. Fet: förutsagd efter korrigering (beräknad, inte uppmätt). Streckad: mål. Mät igen med korrigeringen på för att kontrollera det i rummet."

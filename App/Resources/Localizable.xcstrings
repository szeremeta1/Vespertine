        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಓದಲು ಮಾತ್ರ ಸ್ಥಳ · Vespertine ನ ಲೈಬ್ರರಿಯಲ್ಲಿ ಉಳಿಸಲಾಗಿದೆ; ಫೈಲ್‌ಗಳು ಬದಲಾಗುವುದಿಲ್ಲ"
          }

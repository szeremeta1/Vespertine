    "%lld multichannel tracks (stereo tracks are skipped). Your originals aren't changed.": {
      "localizations": {
        "am": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld ባለብዙ ቻናል ትራክ (የስቴሪዮ ትራኮች ይዘለላሉ)። ኦሪጅናል ፋይሎችዎ አይቀየሩም።"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld ባለብዙ ቻናል ትራኮች (የስቴሪዮ ትራኮች ይዘለላሉ)። ኦሪጅናል ፋይሎችዎ አይቀየሩም።"
                }
              }
            }
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عدد المقطوعات متعددة القنوات: %lld (يتم تخطي المقطوعات الستيريو). لا يتم تغيير ملفاتك الأصلية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld-টি মাল্টিচ্যানেল ট্র্যাক (স্টেরিও ট্র্যাক বাদ দেওয়া হয়)। আপনার মূল ফাইল পরিবর্তন হয় না।"
          }
        },
        "cs": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld vícekanálová skladba (stereofonní skladby se přeskočí). Originály se nemění."
                }
              },
              "few": {
                "stringUnit": {

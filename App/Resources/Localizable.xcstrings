            "value": "16-bit સ્રોત %@ kHz પર 16-bit તરીકે મોકલ્યો"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "An aika tushen bit 16 a matsayin bit 16 a %@ kHz"

        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld-bit ಫೈಲ್, ಆದರೆ %lld ಬಿಟ್‌ಗಳು ಮಾತ್ರ ಆಡಿಯೋ ಹೊಂದಿವೆ (ಜೀರೋ-ಪ್ಯಾಡೆಡ್)."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld비트 파일이지만 %lld비트만 오디오를 담고 있습니다(제로 패딩)."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld-bit ഫയൽ, പക്ഷേ %#@b@ മാത്രമേ ഓഡിയോ വഹിക്കുന്നുള്ളൂ (സീറോ-പാഡ് ചെയ്തത്)."
          },
          "substitutions": {
            "b": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {

    "Digital volume (64-bit, dithered). Not bit-perfect below 100%.": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ዲጂታል የድምፅ መጠን (64-bit፣ ዲዘር የተደረገ)። ከ100% በታች ቢት-ፍጹም አይደለም።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مستوى الصوت الرقمي (64 بت، مع التمويه). غير مطابق للبتات تحت 100%."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ডিজিটাল ভলিউম (64-bit, ডিদারসহ)। 100%-এর নিচে বিট-পারফেক্ট নয়।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Digitální hlasitost (64 bitů, s ditheringem). Pod 100 % není bit-perfect."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Digital lydstyrke (64-bit, med dither). Ikke bitperfekt under 100 %."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Digitale Lautstärke (64 Bit, mit Dither). Unter 100 % nicht bit-perfekt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ψηφιακή ένταση (64 bit, με dither). Όχι bit-perfect κάτω από 100%."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Volumen digital (64 bits, con dither). No es bit-perfect por debajo del 100 %."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "صدای دیجیتال (۶۴ بیتی، با دیتر). زیر ۱۰۰٪ بیت‌به‌بیت نیست."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Digitaalinen äänenvoimakkuus (64-bittinen, ditheröity). Ei bittitarkka alle 100 %:n tasolla."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",

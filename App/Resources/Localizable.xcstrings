          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "റീഡ്-ഓൺലി ലൊക്കേഷൻ · Vespertine-ന്റെ ലൈബ്രറിയിൽ സംരക്ഷിച്ചു; ഫയലുകൾ മാറ്റിയിട്ടില്ല"
          }

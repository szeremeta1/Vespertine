        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ స్పీకర్ స్థానం ప్రకారం %2$@లోకి కలపబడింది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ถูกรวมเป็น %@ ตามตำแหน่งลำโพง"

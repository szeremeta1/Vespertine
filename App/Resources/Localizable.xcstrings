        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ही रूम करेक्शन फाइल Vespertine च्या नवीन आवृत्तीने जतन केली होती."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Fail pembetulan bilik ini disimpan oleh Vespertine yang lebih baharu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne romkorrigeringsfilen ble lagret av en nyere Vespertine."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit ruimtecorrectiebestand is bewaard door een nieuwere Vespertine."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਹ ਰੂਮ ਕਰੈਕਸ਼ਨ ਫ਼ਾਈਲ Vespertine ਦੇ ਨਵੇਂ ਵਰਜ਼ਨ ਨੇ ਸੰਭਾਲੀ ਸੀ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten plik korekcji pomieszczenia zapisała nowsza wersja Vespertine."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este arquivo de correção de sala foi salvo por uma versão mais recente do Vespertine."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Este ficheiro de correção de sala foi guardado por uma versão mais recente do Vespertine."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest fișier de corecție a camerei a fost salvat de o versiune mai nouă de Vespertine."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här rumskorrigeringsfilen sparades av en nyare Vespertine."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Faili hii ya usahihishaji wa chumba ilihifadhiwa na Vespertine mpya zaidi."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த அறைத் திருத்தக் கோப்பை Vespertine இன் புதிய பதிப்பு சேமித்தது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ రూమ్ కరెక్షన్ ఫైల్‌ను Vespertine కొత్త వెర్షన్ సేవ్ చేసింది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟล์การปรับแก้ห้องนี้ถูกบันทึกโดย Vespertine เวอร์ชันที่ใหม่กว่า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu oda düzeltmesi dosyası daha yeni bir Vespertine tarafından kaydedilmiş."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей файл корекції кімнати збережено новішою версією Vespertine."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ روم کریکشن فائل Vespertine کے نئے ورژن نے محفوظ کی تھی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tệp hiệu chỉnh phòng này được lưu bởi một bản Vespertine mới hơn."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "此房間校正檔案由較新版本的 Vespertine 儲存。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此房间校正文件由较新版本的 Vespertine 保存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此房間校正檔案由較新版本的 Vespertine 儲存。"
          }
        }
      }
    },
    "This SACD image has no audio area Vespertine can play.": {
      "extractionState": "manual",
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ይህ የSACD ኢሜጅ Vespertine ሊያጫውተው የሚችል የድምፅ ክፍል የለውም።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تحتوي صورة SACD هذه على منطقة صوت يمكن لـ Vespertine تشغيلها."
          }

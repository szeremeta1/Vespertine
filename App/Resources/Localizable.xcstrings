    "The recording is too short to contain the timing references.": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ቀረጻው የጊዜ ማጣቀሻዎችን ለመያዝ በጣም አጭር ነው።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التسجيل أقصر من أن يحتوي على مراجع التوقيت."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "টাইমিং রেফারেন্স ধারণ করার জন্য রেকর্ডিংটি খুব ছোট।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nahrávka je příliš krátká, aby obsahovala časové reference."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Optagelsen er for kort til at indeholde tidsreferencerne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufnahme ist zu kurz, um die Zeitreferenzen zu enthalten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η εγγραφή είναι πολύ σύντομη για να περιέχει τις αναφορές χρονισμού."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La grabación es demasiado corta para contener las referencias de tiempo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ضبط برای داشتن مرجع‌های زمانی بسیار کوتاه است."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallenne on liian lyhyt sisältääkseen ajoitusviitteet."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Masyadong maikli ang recording para maglaman ng mga timing reference."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'enregistrement est trop court pour contenir les repères de synchronisation."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "રેકોર્ડિંગ ટાઇમિંગ રેફરન્સ સમાવવા માટે ખૂબ ટૂંકું છે."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Rikodin ya yi gajarta da yawa don ɗaukar nassoshin lokaci."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההקלטה קצרה מדי מכדי להכיל את נקודות ייחוס התזמון."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिकॉर्डिंग टाइमिंग संदर्भों को समेटने के लिए बहुत छोटी है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A felvétel túl rövid ahhoz, hogy tartalmazza az időzítési referenciákat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekaman terlalu pendek untuk memuat referensi waktu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La registrazione è troppo corta per contenere i riferimenti temporali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音が短すぎて、タイミング基準を含められません。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ರೆಕಾರ್ಡಿಂಗ್ ಸಮಯ ಉಲ್ಲೇಖಗಳನ್ನು ಒಳಗೊಳ್ಳಲು ತುಂಬಾ ಚಿಕ್ಕದಾಗಿದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음이 너무 짧아 타이밍 기준을 담을 수 없습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ടൈമിംഗ് റഫറൻസുകൾ ഉൾക്കൊള്ളാൻ റെക്കോർഡിംഗ് വളരെ ചെറുതാണ്."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "टायमिंग संदर्भ सामावण्यासाठी रेकॉर्डिंग खूपच लहान आहे."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Rakaman terlalu pendek untuk memuatkan rujukan masa."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Opptaket er for kort til å inneholde tidsreferansene."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De opname is te kort om de tijdreferenties te bevatten."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਰਿਕਾਰਡਿੰਗ ਟਾਈਮਿੰਗ ਹਵਾਲੇ ਸਮਾਉਣ ਲਈ ਬਹੁਤ ਛੋਟੀ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagranie jest zbyt krótkie, by zawierać odniesienia czasowe."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A gravação é curta demais para conter as referências de tempo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A gravação é demasiado curta para conter as referências de tempo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",

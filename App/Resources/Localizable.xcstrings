        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun %lld af %lld bit indeholder lyd (nulpolstret)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur %lld von %lld Bits enthalten Audio (mit Nullen aufgefüllt)"

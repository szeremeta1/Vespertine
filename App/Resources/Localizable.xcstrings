    "Folders are added whole when referencing": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "በማገናኘት ጊዜ አቃፊዎች በሙሉ ይታከላሉ"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُضاف المجلدات كاملة عند الإحالة إليها في مكانها"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রেফারেন্স করার সময় পুরো ফোল্ডার যোগ করা হয়"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Při odkazování se složky přidávají celé"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mapper tilføjes i deres helhed, når der henvises"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Referenzieren werden Ordner vollständig hinzugefügt"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Με την αναφορά, οι φάκελοι προστίθενται ολόκληροι"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al usar referencias, las carpetas se añaden completas"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هنگام ارجاع، پوشه‌ها به‌طور کامل افزوده می‌شوند"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kansiot lisätään kokonaisina, kun viitataan paikallaan"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Buong folder ang idinadagdag kapag nire-reference sa kinalalagyan"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les dossiers sont ajoutés entiers en mode référence"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "મૂળ જગ્યાએ રાખતી વખતે ફોલ્ડર આખાં ઉમેરાય છે"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ana ƙara foldoji gaba ɗaya idan ana nuni a inda suke"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תיקיות מתווספות בשלמותן בעת הפניה במקום"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रेफ़रेंस करते समय पूरे फ़ोल्डर जोड़े जाते हैं"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",

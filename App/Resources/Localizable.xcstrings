        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此文件夹包含现有的资料库来源（%@）。请添加互不重叠的文件夹，以保留曲目和播放列表的归属。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此檔案夾包含現有的資料庫來源（%@）。請加入互不重疊的檔案夾，以保留曲目和播放列表的歸屬。"
          }
        }
      }

    "%@ must be a nonnegative whole number or blank.": {
      "comment": "The name of a tag field, e.g. “Track”.",
      "extractionState": "manual",
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ አሉታዊ ያልሆነ ሙሉ ቁጥር ወይም ባዶ መሆን አለበት።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب أن يكون %@ عددًا صحيحًا غير سالب أو فارغًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ অবশ্যই একটি অঋণাত্মক পূর্ণসংখ্যা বা ফাঁকা হতে হবে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ musí být nezáporné celé číslo nebo prázdné."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ skal være et ikke-negativt heltal eller tomt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ muss eine nicht negative ganze Zahl oder leer sein."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το πεδίο «%@» πρέπει να είναι μη αρνητικός ακέραιος αριθμός ή κενό."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ must be a nonnegative whole number or blank."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ debe ser un número entero no negativo o estar vacío."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ باید یک عدد صحیح نامنفی یا خالی باشد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kentän %@ on oltava ei-negatiivinen kokonaisluku tai tyhjä."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Dapat ay buong numerong hindi negatibo o blangko ang %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ doit être un nombre entier positif ou rester vide."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ઋણ ન હોય એવી પૂર્ણ સંખ્યા અથવા ખાલી હોવું જોઈએ."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ dole ne ya zama cikakken lamba marar korau ko a bar shi babu komai."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ חייב להיות מספר שלם אי־שלילי או ריק."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ शून्य या धनात्मक पूर्ण संख्या होनी चाहिए, या खाली छोड़ें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: nemnegatív egész számnak kell lennie, vagy üresnek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ harus berupa bilangan bulat nonnegatif atau kosong."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ deve essere un numero intero non negativo o restare vuoto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@には0以上の整数を入力するか、空欄にしてください。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ಋಣಾತ್ಮಕವಲ್ಲದ ಪೂರ್ಣ ಸಂಖ್ಯೆಯಾಗಿರಬೇಕು ಅಥವಾ ಖಾಲಿಯಾಗಿರಬೇಕು."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 항목은 0 이상의 정수이거나 비어 있어야 합니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ഒരു നെഗറ്റീവല്ലാത്ത പൂർണ്ണസംഖ്യയോ ശൂന്യമോ ആയിരിക്കണം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ही ऋण नसलेली पूर्ण संख्या असावी किंवा रिकामी ठेवावी."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ mestilah nombor bulat bukan negatif atau dibiarkan kosong."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ må være et ikke-negativt heltall eller tomt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ moet een niet-negatief geheel getal zijn of leeg blijven."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ਇੱਕ ਗ਼ੈਰ-ਰਿਣਾਤਮਕ ਪੂਰਨ ਸੰਖਿਆ ਜਾਂ ਖਾਲੀ ਹੋਣਾ ਚਾਹੀਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pole %@ musi zawierać nieujemną liczbę całkowitą lub być puste."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ deve ser um número inteiro não negativo ou ficar em branco."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tem de ser um número inteiro não negativo ou ficar em branco."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ trebuie să fie un număr întreg nenegativ sau să fie gol."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",

    "Find your headphones on AutoEQ": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "የጆሮ ማዳመጫዎን በAutoEQ ላይ ያግኙ"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابحث عن سماعات رأسك في AutoEQ"

    "Highest %@ decibels at %@, lowest %@ decibels at %@": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ከፍተኛው %1$@ ዲሲቤል በ%2$@፣ ዝቅተኛው %3$@ ዲሲቤል በ%4$@"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأعلى %1$@ ديسيبل عند %2$@، والأدنى %3$@ ديسيبل عند %4$@"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সর্বোচ্চ %1$@ ডেসিবেল %2$@-এ, সর্বনিম্ন %3$@ ডেসিবেল %4$@-এ"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nejvýše %@ decibelu na %@, nejníže %@ decibelu na %@"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Højest %@ decibel ved %@, lavest %@ decibel ved %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Höchstwert %1$@ Dezibel bei %2$@, Tiefstwert %3$@ Dezibel bei %4$@"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μέγιστο %1$@ ντεσιμπέλ στα %2$@, ελάχιστο %3$@ ντεσιμπέλ στα %4$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Máximo de %1$@ decibelios a %2$@, mínimo de %3$@ decibelios a %4$@"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بیشترین %1$@ دسی‌بل در %2$@، کمترین %3$@ دسی‌بل در %4$@"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Korkein %@ desibeliä taajuudella %@, matalin %@ desibeliä taajuudella %@"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinakamataas %@ decibel sa %@, pinakamababa %@ decibel sa %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maximum %@ décibels à %@, minimum %@ décibels à %@"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સૌથી વધુ %@ ડેસિબલ %@ પર, સૌથી ઓછું %@ ડેસિબલ %@ પર"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Mafi girma decibel %@ a %@, mafi ƙanƙanta decibel %@ a %@"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הגבוה ביותר %1$@ דציבל ב־%2$@, הנמוך ביותר %3$@ דציבל ב־%4$@"

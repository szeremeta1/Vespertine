          }
        }
      }
    },
    "Line %lld names a channel Vespertine doesn't know (%@). Use L, R, C, LFE, RL, RR, SL, SR or a channel number.": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "መስመር %lld Vespertine የማያውቀውን ቻናል ይጠቅሳል (%@)። L፣ R፣ C፣ LFE፣ RL፣ RR፣ SL፣ SR ወይም የቻናል ቁጥር ይጠቀሙ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يشير السطر %lld إلى قناة لا يعرفها Vespertine (%@). استخدم L أو R أو C أو LFE أو RL أو RR أو SL أو SR أو رقم قناة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লাইন %lld এমন একটি চ্যানেলের নাম দিয়েছে যা Vespertine চেনে না (%@)। L, R, C, LFE, RL, RR, SL, SR বা একটি চ্যানেল নম্বর ব্যবহার করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Řádek %lld uvádí kanál, který Vespertine nezná (%@). Použijte L, R, C, LFE, RL, RR, SL, SR nebo číslo kanálu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Linje %lld angiver en kanal, som Vespertine ikke kender (%@). Brug L, R, C, LFE, RL, RR, SL, SR eller et kanalnummer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeile %lld nennt einen Kanal, den Vespertine nicht kennt (%@). Verwende L, R, C, LFE, RL, RR, SL, SR oder eine Kanalnummer."

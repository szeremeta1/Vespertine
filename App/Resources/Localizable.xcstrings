        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בתמונת SACD זו אין אזור שמע ש־Vespertine יכול לנגן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस SACD इमेज में ऐसा कोई ऑडियो क्षेत्र नहीं है जिसे Vespertine चला सके।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ebben az SACD-lemezképben nincs olyan hangterület, amelyet a Vespertine le tudna játszani."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Image SACD ini tidak memiliki area audio yang dapat diputar Vespertine."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa immagine SACD non ha un’area audio che Vespertine possa riprodurre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このSACDイメージには、Vespertineで再生できるオーディオ領域がありません。"

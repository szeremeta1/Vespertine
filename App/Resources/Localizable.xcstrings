    "Line %lld couldn't be read as a filter.": {
      "extractionState": "manual",
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "መስመር %lld እንደ ማጣሪያ ሊነበብ አልቻለም።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّرت قراءة السطر %lld كمرشح."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লাইন %lld ফিল্টার হিসেবে পড়া যায়নি।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Řádek %lld nelze načíst jako filtr."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Linje %lld kunne ikke læses som et filter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeile %lld konnte nicht als Filter gelesen werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η γραμμή %lld δεν ήταν δυνατό να διαβαστεί ως φίλτρο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Line %lld couldn't be read as a filter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La línea %lld no se ha podido leer como filtro."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "خط %lld به‌عنوان فیلتر خوانده نشد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Riviä %lld ei voitu lukea suotimena."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi mabasa bilang filter ang linya %lld."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La ligne %lld n’a pas pu être lue comme un filtre."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "લાઇન %lld ને ફિલ્ટર તરીકે વાંચી શકાઈ નહીં."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ba a iya karanta layi %lld a matsayin matata ba."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן היה לקרוא את שורה %lld כמסנן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",

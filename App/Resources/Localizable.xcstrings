        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبلغ المنحنى ذروته عند +%@ dB، لذا قد تتشوّه المقاطع العالية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কার্ভটির সর্বোচ্চ বিন্দু +%@ dB, তাই জোরালো অংশ ক্লিপ করতে পারে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Křivka dosahuje maxima +%@ dB, takže hlasité pasáže mohou přebuzovat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurven topper ved +%@ dB, så kraftige passager kan klippe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kurve erreicht maximal +%@ dB, daher können laute Passagen übersteuern."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η καμπύλη φτάνει στο +%@ dB, οπότε τα δυνατά σημεία μπορεί να παραμορφωθούν (clipping)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La curva alcanza un máximo de +%@ dB, así que los pasajes fuertes pueden saturar."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اوج منحنی +%@ dB است، بنابراین بخش‌های بلند ممکن است دچار برش (کلیپ) شوند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käyrän huippu on +%@ dB, joten voimakkaat kohdat voivat leikkautua."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Umaabot ang curve sa +%@ dB, kaya maaaring mag-clip ang malalakas na bahagi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La courbe culmine à +%@ dB : les passages forts risquent de saturer."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કર્વની ટોચ +%@ dB છે, તેથી ઊંચા અવાજવાળા ભાગો ક્લિપ થઈ શકે છે."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Lanƙwasa tana kai ƙololuwa a +%@ dB, don haka sassa masu ƙara sosai na iya yankewa (clip)."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שיא העקומה הוא +%@ dB, ולכן קטעים רועשים עלולים להיחתך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कर्व का शिखर +%@ dB पर है, इसलिए तेज़ हिस्से क्लिप हो सकते हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A görbe csúcsa +%@ dB, így a hangos részek túlvezérlődhetnek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurva memuncak di +%@ dB, sehingga bagian yang keras bisa mengalami clipping."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La curva raggiunge un picco di +%@ dB, quindi i passaggi forti possono andare in clipping."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カーブのピークが+%@ dBのため、大きな音の部分でクリップする可能性があります。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಕರ್ವ್ +%@ dB ನಲ್ಲಿ ಗರಿಷ್ಠ ತಲುಪುತ್ತದೆ, ಆದ್ದರಿಂದ ಜೋರಾದ ಭಾಗಗಳು ಕ್ಲಿಪ್ ಆಗಬಹುದು."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "커브의 최고점이 +%@ dB이므로 큰 소리 구간에서 클리핑이 발생할 수 있습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കർവിന്റെ ഉച്ചസ്ഥായി +%@ dB ആണ്, അതിനാൽ ഉച്ചത്തിലുള്ള ഭാഗങ്ങൾ ക്ലിപ്പ് ചെയ്തേക്കാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कर्व्हचे शिखर +%@ dB आहे, त्यामुळे मोठ्या आवाजातील भाग क्लिप होऊ शकतात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lengkung memuncak pada +%@ dB, jadi petikan yang kuat boleh terketip."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurven topper på +%@ dB, så kraftige partier kan klippe."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De curve piekt op +%@ dB, dus luide passages kunnen clippen."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕਰਵ ਦੀ ਸਿਖਰ +%@ dB ਹੈ, ਇਸ ਲਈ ਉੱਚੀ ਆਵਾਜ਼ ਵਾਲੇ ਹਿੱਸੇ ਕਲਿੱਪ ਹੋ ਸਕਦੇ ਹਨ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Krzywa osiąga szczyt +%@ dB, więc głośne fragmenty mogą być przesterowane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A curva atinge o pico de +%@ dB, então trechos altos podem saturar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A curva atinge um pico de +%@ dB, por isso as passagens mais altas podem saturar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Curba atinge un vârf de +%@ dB, așa că pasajele puternice se pot distorsiona."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurvan når som högst +%@ dB, så starka partier kan klippas."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Mkunjo unafika kilele cha +%@ dB, kwa hivyo sehemu zenye sauti kubwa zinaweza kukatika (clip)."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வளைவின் உச்சம் +%@ dB, எனவே உரத்த பகுதிகள் கிளிப் ஆகலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కర్వ్ +%@ dB వద్ద గరిష్ఠానికి చేరుతుంది, కాబట్టి బిగ్గరగా ఉండే భాగాలు క్లిప్ కావచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เส้นโค้งสูงสุดที่ +%@ dB ช่วงที่ดังอาจเกิดการคลิป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eğri +%@ dB’de tepe yapıyor; bu yüzden yüksek sesli bölümler kırpılabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пік кривої становить +%@ dB, тож у гучних фрагментах можливий кліпінг."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کرو کی چوٹی +%@ dB ہے، اس لیے بلند حصے کلپ ہو سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đường cong đạt đỉnh +%@ dB, vì vậy các đoạn lớn có thể bị méo (clipping)."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "曲線峰值為 +%@ dB，因此大聲的段落可能會削波。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "曲线峰值为 +%@ dB，响亮段落可能会削波。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "曲線峰值為 +%@ dB，大聲的段落可能會削峰。"
          }
        }
      }
    },

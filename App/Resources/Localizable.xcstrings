        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以隨時加入更多。"
          }
        }
      }
    },
    "You can also use “Add to Playlist” in any context menu.": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "በማንኛውም የአውድ ምናሌ ውስጥ «ወደ አጫዋች ዝርዝር አክል»ን መጠቀም ይችላሉ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك أيضًا استخدام “إضافة إلى قائمة تشغيل” في أي قائمة سياقية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যেকোনো কনটেক্সট মেনুতে “প্লেলিস্টে যোগ করুন”-ও ব্যবহার করতে পারেন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Můžete také použít „Přidat do playlistu“ v libovolné kontextové nabídce."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan også bruge “Føj til spilleliste” i alle genvejsmenuer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst auch „Zur Playlist hinzufügen“ in jedem Kontextmenü verwenden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μπορείτε επίσης να χρησιμοποιήσετε την εντολή «Προσθήκη σε λίστα αναπαραγωγής» σε οποιοδήποτε μενού συντομεύσεων."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "También puedes usar “Añadir a lista de reproducción” en cualquier menú contextual."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "همچنین می‌توانید از «افزودن به فهرست پخش» در هر منوی میانبر استفاده کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit myös käyttää ”Lisää soittolistaan” missä tahansa kontekstivalikossa."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Maaari mo ring gamitin ang “Idagdag sa Playlist” sa anumang context menu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez aussi utiliser « Ajouter à la playlist » dans n’importe quel menu contextuel."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે કોઈ પણ સંદર્ભ મેનૂમાં “પ્લેલિસ્ટમાં ઉમેરો” પણ વાપરી શકો છો."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuna iya amfani da “Ƙara cikin Jerin Waƙoƙi” a kowane menu na mahallin."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תוכל גם להשתמש ב״הוסף לרשימת השמעה״ בכל תפריט הקשר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप किसी भी संदर्भ मेनू में “प्लेलिस्ट में जोड़ें” का भी उपयोग कर सकते हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Bármely helyi menüben a „Hozzáadás lejátszási listához” parancsot is használhatja."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda juga dapat menggunakan “Tambahkan ke Daftar Putar” di menu konteks mana pun."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi anche usare “Aggiungi a playlist” in qualsiasi menu contestuale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どのコンテキストメニューからでも「プレイリストに追加」を使えます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಯಾವುದೇ ಸಂದರ್ಭ ಮೆನುವಿನಲ್ಲಿ “ಪ್ಲೇಲಿಸ್ಟ್‌ಗೆ ಸೇರಿಸಿ” ಅನ್ನು ಸಹ ಬಳಸಬಹುದು."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 컨텍스트 메뉴에서 ‘플레이리스트에 추가’를 사용할 수도 있습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഏത് സന്ദർഭ മെനുവിലും “പ്ലേലിസ്റ്റിലേക്ക് ചേർക്കുക” ഉപയോഗിക്കാനും കഴിയും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही कोणत्याही संदर्भ मेनूमधील “प्लेलिस्टमध्ये जोडा” देखील वापरू शकता."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda juga boleh menggunakan “Tambah ke Senarai Main” dalam mana-mana menu konteks."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan også bruke «Legg til i spilleliste» i alle kontekstmenyer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt ook ‘Voeg toe aan playlist’ gebruiken in elk contextueel menu."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਸੀਂ ਕਿਸੇ ਵੀ ਸੰਦਰਭ ਮੀਨੂ ਵਿੱਚ “ਪਲੇਲਿਸਟ ਵਿੱਚ ਜੋੜੋ” ਵੀ ਵਰਤ ਸਕਦੇ ਹੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz też użyć polecenia „Dodaj do playlisty” w dowolnym menu kontekstowym."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você também pode usar “Adicionar à Playlist” em qualquer menu de contexto."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Também pode usar “Adicionar à playlist” em qualquer menu de contexto."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Puteți folosi și „Adaugă în playlist” din orice meniu contextual."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan också använda ”Lägg till i spellista” i alla kontextmenyer."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Unaweza pia kutumia “Ongeza kwenye Orodha ya Nyimbo” katika menyu yoyote ya muktadha."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எந்தச் சூழல் மெனுவிலும் “பிளேலிஸ்ட்டில் சேர்” என்பதையும் பயன்படுத்தலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఏ సందర్భ మెనూలోనైనా “ప్లేలిస్ట్‌కు జోడించు”ను కూడా ఉపయోగించవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณยังใช้ “เพิ่มไปยังเพลย์ลิสต์” ในเมนูบริบทใดก็ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Herhangi bir içerik menüsündeki “Çalma Listesine Ekle” komutunu da kullanabilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Також можна скористатися пунктом «Додати до плейлиста» в будь-якому контекстному меню."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کسی بھی سیاق و سباق مینو میں “پلے لسٹ میں شامل کریں” بھی استعمال کر سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn cũng có thể dùng “Thêm vào danh sách phát” trong mọi menu ngữ cảnh."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "你亦可在任何快捷鍵選單中使用「加至播放列表」。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你也可以在任何快捷菜单中使用“添加到播放列表”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你也可以在任何快速選單中使用「加入播放列表」。"
          }
        }
      }
    },
    "You can skip this and add music later from the File menu.": {
      "extractionState": "manual",
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ይህን ዘልለው በኋላ ከፋይል ምናሌው ሙዚቃ ማከል ይችላሉ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك تخطي هذه الخطوة وإضافة الموسيقى لاحقًا من قائمة الملف."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি এটি বাদ দিয়ে পরে ফাইল মেনু থেকে মিউজিক যোগ করতে পারেন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento krok můžete přeskočit a hudbu přidat později z nabídky Soubor."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan springe dette over og tilføje musik senere fra Arkiv-menuen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst das überspringen und später Musik über das Menü „Ablage“ hinzufügen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μπορείτε να το παραλείψετε και να προσθέσετε μουσική αργότερα από το μενού «Αρχείο»."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can skip this and add music later from the File menu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes omitir este paso y añadir música más tarde desde el menú Archivo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "می‌توانید این مرحله را رد کنید و بعداً از منوی فایل موسیقی اضافه کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit ohittaa tämän ja lisätä musiikkia myöhemmin Arkisto-valikosta."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Puwede mo itong laktawan at magdagdag ng musika mamaya mula sa File menu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez passer cette étape et ajouter de la musique plus tard depuis le menu Fichier."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે આ છોડીને પછીથી ફાઇલ મેનૂમાંથી સંગીત ઉમેરી શકો છો."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuna iya tsallake wannan kuma ku ƙara waƙoƙi daga baya daga menu na Fayil."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תוכל לדלג על זה ולהוסיף מוזיקה מאוחר יותר מתפריט ״קובץ״."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप इसे छोड़कर बाद में फ़ाइल मेनू से संगीत जोड़ सकते हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezt kihagyhatja, és később a Fájl menüből adhat hozzá zenét."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda dapat melewati ini dan menambahkan musik nanti dari menu File."

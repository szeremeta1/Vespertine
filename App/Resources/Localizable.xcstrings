            "value": "NAS ಅಥವಾ ಇನ್ನೊಂದು Mac ನಲ್ಲಿರುವ ಸಂಗೀತ, SMB ಮೂಲಕ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",

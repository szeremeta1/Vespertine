          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Monikanavaiselle musiikille. Pois lähettää kaikki kanavat tämän laitteen kaiuttimiin."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Para sa multichannel na musika. Kapag naka-off, ipinapadala ang bawat channel sa mga speaker ng device na ito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour la musique multicanal. Désactivé, chaque canal est envoyé aux haut-parleurs de cet appareil."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "મલ્ટિચૅનલ સંગીત માટે. બંધ હોય ત્યારે દરેક ચૅનલ આ ડિવાઇસનાં સ્પીકરને મોકલાય છે."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Don waƙoƙi masu tashoshi da yawa. Idan a kashe, ana aika kowace tasha zuwa lasifikokin wannan na'ura."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "למוזיקה רב־ערוצית. כשהאפשרות כבויה, כל ערוץ נשלח לרמקולים של התקן זה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मल्टीचैनल संगीत के लिए। बंद होने पर हर चैनल इस डिवाइस के स्पीकर पर भेजा जाता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Többcsatornás zenéhez. Kikapcsolva minden csatorna ennek az eszköznek a hangszóróira jut."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk musik multisaluran. Jika mati, setiap saluran dikirim ke speaker perangkat ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per la musica multicanale. Se disattivato, ogni canale va agli altoparlanti di questo dispositivo."

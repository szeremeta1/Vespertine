    "DoP requires exclusive, bit-transparent output": {
      "extractionState": "manual",
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "DoP ብቸኛና ቢትን የማይቀይር ውፅዓት ይፈልጋል"
          }
        },
        "ar": {

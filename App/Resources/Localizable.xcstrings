    "%lld entries weren't found in your library. Add the folders those songs are in, then import again.": {
      "localizations": {
        "am": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld ግቤት በቤተ-መጻሕፍትዎ ውስጥ አልተገኘም። እነዚያ ዘፈኖች ያሉባቸውን አቃፊዎች ያክሉ፣ ከዚያ እንደገና ያስገቡ።"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld ግቤቶች በቤተ-መጻሕፍትዎ ውስጥ አልተገኙም። እነዚያ ዘፈኖች ያሉባቸውን አቃፊዎች ያክሉ፣ ከዚያ እንደገና ያስገቡ።"
                }
              }
            }
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُعثر في مكتبتك على %lld من الإدخالات. أضف المجلدات التي تحتوي على هذه الأغاني، ثم استورد مجددًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld-টি এন্ট্রি আপনার লাইব্রেরিতে পাওয়া যায়নি। যে ফোল্ডারগুলোতে সেই গানগুলো আছে সেগুলো যোগ করুন, তারপর আবার ইমপোর্ট করুন।"
          }
        },
        "cs": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld položka nebyla v knihovně nalezena. Přidejte složky, ve kterých tyto skladby jsou, a importujte znovu."
                }
              },
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld položky nebyly v knihovně nalezeny. Přidejte složky, ve kterých tyto skladby jsou, a importujte znovu."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld položek nebylo v knihovně nalezeno. Přidejte složky, ve kterých tyto skladby jsou, a importujte znovu."
                }
              }
            }
          }
        },
        "da": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld post blev ikke fundet i dit bibliotek. Tilføj den mappe, sangen ligger i, og importer derefter igen."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld poster blev ikke fundet i dit bibliotek. Tilføj de mapper, sangene ligger i, og importer derefter igen."
                }
              }
            }
          }
        },
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Eintrag wurde nicht in deiner Mediathek gefunden. Füge die Ordner mit diesen Titeln hinzu und importiere dann erneut."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Einträge wurden nicht in deiner Mediathek gefunden. Füge die Ordner mit diesen Titeln hinzu und importiere dann erneut."
                }
              }
            }
          }
        },
        "el": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld καταχώριση δεν βρέθηκε στη βιβλιοθήκη σας. Προσθέστε τους φακέλους όπου βρίσκονται αυτά τα τραγούδια και μετά κάντε ξανά εισαγωγή."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld καταχωρίσεις δεν βρέθηκαν στη βιβλιοθήκη σας. Προσθέστε τους φακέλους όπου βρίσκονται αυτά τα τραγούδια και μετά κάντε ξανά εισαγωγή."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld entry wasn't found in your library. Add the folder that song is in, then import again."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld entries weren't found in your library. Add the folders those songs are in, then import again."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld entrada no se ha encontrado en tu biblioteca. Añade la carpeta que contiene esa canción y vuelve a importar."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld entradas no se han encontrado en tu biblioteca. Añade las carpetas que contienen esas canciones y vuelve a importar."
                }
              }
            }
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld مورد در کتابخانهٔ شما پیدا نشد. پوشه‌هایی را که آن آهنگ‌ها در آن‌ها هستند اضافه کنید، سپس دوباره وارد کنید."
          }
        },
        "fi": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld kohde ei löytynyt kirjastostasi. Lisää kansiot, joissa nämä kappaleet ovat, ja tuo sitten uudelleen."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld kohdetta ei löytynyt kirjastostasi. Lisää kansiot, joissa nämä kappaleet ovat, ja tuo sitten uudelleen."
                }
              }
            }
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi nahanap sa library mo ang %lld entry. Idagdag ang mga folder kung nasaan ang mga kantang iyon, saka mag-import muli."
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld entrée est introuvable dans votre bibliothèque. Ajoutez les dossiers qui contiennent ces morceaux, puis importez à nouveau."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld entrées sont introuvables dans votre bibliothèque. Ajoutez les dossiers qui contiennent ces morceaux, puis importez à nouveau."
                }
              }
            }
          }
        },
        "gu": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld એન્ટ્રી તમારી લાઇબ્રેરીમાં મળી નહીં. તે ગીત જે ફોલ્ડરમાં છે તે ઉમેરો, પછી ફરી ઇમ્પોર્ટ કરો."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld એન્ટ્રી તમારી લાઇબ્રેરીમાં મળી નહીં. તે ગીતો જે ફોલ્ડરમાં છે તે ઉમેરો, પછી ફરી ઇમ્પોર્ટ કરો."
                }
              }
            }
          }
        },
        "ha": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Ba a sami abu %lld a cikin laburarenku ba. Ƙara foldojin da waɗannan waƙoƙin suke ciki, sannan ku sake shigo da su."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Ba a sami abubuwa %lld a cikin laburarenku ba. Ƙara foldojin da waɗannan waƙoƙin suke ciki, sannan ku sake shigo da su."
                }
              }
            }
          }
        },
        "he": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "פריט אחד לא נמצא בספריה שלך. הוסף את התיקיות שבהן נמצאים שירים אלה, ואז ייבא שוב."

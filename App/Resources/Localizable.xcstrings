    "DSD packed into 24-bit frames with DoP markers": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "DSD ከDoP ምልክቶች ጋር በ24-bit ፍሬሞች ውስጥ ታሽጓል"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "DSD مُعبّأ في إطارات 24 بت مع علامات DoP"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "DoP মার্কারসহ 24-bit ফ্রেমে প্যাক করা DSD"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "DSD zabalené do 24bitových rámců se značkami DoP"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "DSD pakket i 24-bit frames med DoP-markører"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "DSD in 24-Bit-Frames mit DoP-Markern verpackt"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "DSD συσκευασμένο σε πλαίσια 24 bit με δείκτες DoP"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "DSD empaquetado en tramas de 24 bits con marcadores DoP"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "DSD بسته‌بندی‌شده در فریم‌های ۲۴ بیتی با نشانگرهای DoP"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "DSD pakattuna 24-bittisiin kehyksiin DoP-merkinnöin"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "DSD na nakabalot sa 24-bit na frame na may mga DoP marker"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "DSD encapsulé dans des trames 24 bits avec marqueurs DoP"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "DoP માર્કર સાથે 24-bit ફ્રેમમાં પૅક કરેલું DSD"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "An naɗe DSD cikin firam na bit 24 masu alamomin DoP"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "DSD ארוז בפריימים של 24 סיביות עם סמני DoP"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "DSD को DoP मार्कर के साथ 24-bit फ़्रेम में पैक किया गया"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "24 bites keretekbe csomagolt DSD DoP-jelölőkkel"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "DSD dikemas ke dalam frame 24-bit dengan penanda DoP"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "DSD racchiuso in frame a 24 bit con marcatori DoP"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "DSDをDoPマーカー付きの24ビットフレームに格納"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "DoP ಮಾರ್ಕರ್‌ಗಳೊಂದಿಗೆ 24-bit ಫ್ರೇಮ್‌ಗಳಲ್ಲಿ ಪ್ಯಾಕ್ ಮಾಡಿದ DSD"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "DSD를 DoP 마커가 있는 24비트 프레임에 담음"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "DoP മാർക്കറുകളോടെ 24-bit ഫ്രെയിമുകളിൽ പാക്ക് ചെയ്ത DSD"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "DoP मार्करसह 24-bit फ्रेममध्ये पॅक केलेले DSD"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "DSD dibungkus ke dalam bingkai 24-bit dengan penanda DoP"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "DSD pakket i 24-bit rammer med DoP-markører"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "DSD verpakt in 24-bits frames met DoP-markeringen"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "DoP ਮਾਰਕਰਾਂ ਨਾਲ 24-bit ਫ਼੍ਰੇਮਾਂ ਵਿੱਚ ਪੈਕ ਕੀਤਾ DSD"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "DSD spakowane w ramki 24-bitowe ze znacznikami DoP"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "DSD empacotado em quadros de 24 bits com marcadores DoP"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "DSD empacotado em tramas de 24 bits com marcadores DoP"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "DSD împachetat în cadre pe 24 de biți cu marcaje DoP"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "DSD packat i 24-bitarsramar med DoP-markörer"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "DSD imefungwa katika fremu za biti 24 zenye alama za DoP"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "DoP குறிப்பான்களுடன் 24-bit ஃபிரேம்களில் அடைக்கப்பட்ட DSD"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "DoP మార్కర్‌లతో 24-bit ఫ్రేమ్‌లలో ప్యాక్ చేసిన DSD"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "DSD บรรจุในเฟรม 24 บิตพร้อมเครื่องหมาย DoP"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "DoP işaretçileriyle 24 bit çerçevelere paketlenmiş DSD"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "DSD, упакований у 24-бітні аудіокадри з маркерами DoP"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "DoP مارکرز کے ساتھ 24-bit فریمز میں پیک کیا گیا DSD"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "DSD được đóng gói vào khung 24 bit với dấu DoP"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "DSD 以 DoP 標記封裝於 24 位元幀中"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "DSD 封装在带有 DoP 标记的 24 位帧中"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "DSD 封裝在帶有 DoP 標記的 24 位元訊框中"
          }
        }
      }
    },
    "DSD source: bit depth analysis doesn't apply.": {
      "extractionState": "manual",
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "የDSD ምንጭ፦ የቢት ጥልቀት ትንተና አይመለከተውም።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مصدر DSD: لا ينطبق تحليل عمق البت."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "DSD উৎস: বিট ডেপথ বিশ্লেষণ প্রযোজ্য নয়।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdroj DSD: analýza bitové hloubky se nepoužije."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "DSD-kilde: Analyse af bitdybde er ikke relevant."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "DSD-Quelle: Die Bittiefenanalyse ist nicht anwendbar."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πηγή DSD: η ανάλυση βάθους bit δεν ισχύει."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DSD source: bit depth analysis doesn't apply."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuente DSD: el análisis de profundidad de bits no se aplica."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "منبع DSD: تحلیل عمق بیت کاربرد ندارد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "DSD-lähde: bittisyvyyden analyysi ei koske sitä."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "DSD source: hindi nalalapat ang pagsusuri ng bit depth."

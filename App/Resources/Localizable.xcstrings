            "value": "Folda ya mtandao imetenganishwa."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பகிர்வு துண்டிக்கப்பட்டது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "షేర్ డిస్‌కనెక్ట్ అయింది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แชร์ถูกตัดการเชื่อมต่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paylaşımın bağlantısı kesildi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ресурс від’єднано."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "شیئر منقطع ہو گیا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chia sẻ đã bị ngắt kết nối."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "共享已中斷連接。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "共享已断开连接。"

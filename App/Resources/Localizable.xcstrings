        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para música multicanal. Desativado envia cada canal para os altifalantes deste dispositivo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentru muzica multicanal. Dezactivat trimite fiecare canal către difuzoarele acestui dispozitiv."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För flerkanalsmusik. Av skickar varje kanal till enhetens högtalare."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kwa muziki wa chaneli nyingi. Ikizimwa, kila chaneli hutumwa kwa spika za kifaa hiki."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மல்டிசேனல் இசைக்கு. ஆஃப் எனில் ஒவ்வொரு சேனலும் இந்தச் சாதனத்தின் ஸ்பீக்கர்களுக்கு அனுப்பப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మల్టీఛానెల్ సంగీతం కోసం. ఆఫ్‌లో ఉంటే ప్రతి ఛానెల్ ఈ పరికరం స్పీకర్‌లకు పంపబడుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สำหรับเพลงหลายช่องสัญญาณ เมื่อปิด จะส่งทุกช่องสัญญาณไปยังลำโพงของอุปกรณ์นี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çok kanallı müzik için. Kapalıyken her kanal bu aygıtın hoparlörlerine gönderilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для багатоканальної музики. Якщо вимкнено, кожен канал надсилається на динаміки цього пристрою."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ملٹی چینل موسیقی کے لیے۔ بند ہونے پر ہر چینل اس ڈیوائس کے اسپیکرز کو بھیجا جاتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dành cho nhạc đa kênh. Khi tắt, mọi kênh được gửi đến loa của thiết bị này."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "適用於多聲道音樂。關閉時，每個聲道都會傳送至此裝置的揚聲器。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "适用于多声道音乐。关闭时会将每个声道发送到此设备的扬声器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "適用於多聲道音樂。關閉時會將每個聲道傳送到此裝置的揚聲器。"
          }
        }
      }
    },

    "The recording lost %@ frames, so it can't be used.": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ቀረጻው %@ ክፈፎችን አጥቷል፣ ስለዚህ ጥቅም ላይ ሊውል አይችልም።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فقد التسجيل %@ من الإطارات، لذا لا يمكن استخدامه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রেকর্ডিং %@টি ফ্রেম হারিয়েছে, তাই এটি ব্যবহার করা যাবে না।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V nahrávce chybí %@ snímků, takže ji nelze použít."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Optagelsen mistede %@ frames og kan derfor ikke bruges."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Aufnahme fehlen %@ Frames, daher ist sie unbrauchbar."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η εγγραφή έχασε %@ καρέ, επομένως δεν μπορεί να χρησιμοποιηθεί."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La grabación perdió %@ fotogramas, así que no se puede usar."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ضبط %@ فریم از دست داد، بنابراین قابل استفاده نیست."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallenteesta puuttuu %@ kehystä, joten sitä ei voi käyttää."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nawalan ng %@ frame ang recording, kaya hindi ito magagamit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'enregistrement a perdu %@ trames et ne peut donc pas être utilisé."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "રેકોર્ડિંગે %@ ફ્રેમ ગુમાવી, તેથી તે વાપરી શકાતું નથી."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Rikodin ya rasa firam %@, don haka ba za a iya amfani da shi ba."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההקלטה איבדה %@ פריימים ולכן אי אפשר להשתמש בה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिकॉर्डिंग में %@ फ़्रेम खो गए, इसलिए उसका उपयोग नहीं हो सकता।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",

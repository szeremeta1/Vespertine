        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Vespertine réessaiera dans 30 minutes, ou lorsque vous choisirez Se reconnecter."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Vespertine 30 મિનિટ પછી ફરી પ્રયાસ કરશે, અથવા જ્યારે તમે “ફરી કનેક્ટ કરો” પસંદ કરો ત્યારે."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Vespertine zai sake gwadawa bayan mintuna 30, ko idan kuka zaɓi Sake Haɗawa."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Vespertine ינסה שוב בעוד 30 דקות, או כשתבחר ״התחבר מחדש״."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Vespertine 30 मिनट में फिर से कोशिश करेगा, या तब जब आप “फिर से कनेक्ट करें” चुनेंगे।"
          }
        },
        "hu": {
          "stringUnit": {

    "this stream's channels don't match the speakers it was made for": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "የዚህ ዥረት ቻናሎች ከተሠራላቸው ድምፅ ማጉያዎች ጋር አይዛመዱም"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قنوات هذا البث لا تطابق السماعات التي صُنع لها"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই স্ট্রিমের চ্যানেলগুলি যে স্পিকারের জন্য এটি তৈরি তাদের সঙ্গে মেলে না"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "kanály tohoto streamu neodpovídají reproduktorům, pro které byla vytvořena"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "denne streams kanaler passer ikke til de højttalere, den blev lavet til"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "die Kanäle dieses Streams passen nicht zu den Lautsprechern, für die sie gemacht wurde"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "τα κανάλια αυτής της ροής δεν ταιριάζουν με τα ηχεία για τα οποία φτιάχτηκε"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "los canales de este flujo no coinciden con los altavoces para los que se hizo"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کانال‌های این جریان با بلندگوهایی که برایشان ساخته شده جور نیست"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "tämän virran kanavat eivät vastaa kaiuttimia, joille se tehtiin"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "hindi tugma ang mga channel ng stream na ito sa mga speaker na pinaggawan nito"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "les canaux de ce flux ne correspondent pas aux enceintes pour lesquelles elle a été créée"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ સ્ટ્રીમની ચેનલ તે જે સ્પીકર માટે બની હતી તેમની સાથે મેળ ખાતી નથી"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "tashoshin wannan rafi ba su dace da lasifikokin da aka yi shi domin su ba"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הערוצים של הזרם הזה לא תואמים לרמקולים שעבורם הוא נוצר"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस स्ट्रीम के चैनल उन स्पीकरों से मेल नहीं खाते जिनके लिए यह बनी थी"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "a stream csatornái nem egyeznek azokkal a hangszórókkal, amelyekhez készült"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "saluran stream ini tidak cocok dengan speaker tempat profil dibuat"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "i canali di questo flusso non corrispondono ai diffusori per cui è stata creata"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このストリームのチャンネルが、作成時のスピーカーと一致しません"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಸ್ಟ್ರೀಮ್‌ನ ಚಾನಲ್‌ಗಳು ಅದನ್ನು ಮಾಡಿದ ಸ್ಪೀಕರ್‌ಗಳಿಗೆ ಹೊಂದುವುದಿಲ್ಲ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 스트림의 채널이 프로필을 만든 스피커와 맞지 않습니다"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ സ്ട്രീമിന്റെ ചാനലുകൾ അത് ഉണ്ടാക്കിയ സ്പീക്കറുകളുമായി പൊരുത്തപ്പെടുന്നില്ല"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या स्ट्रीमचे चॅनेल ते ज्या स्पीकरसाठी बनवले त्यांच्याशी जुळत नाहीत"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "saluran strim ini tidak sepadan dengan pembesar suara yang ia dibuat untuknya"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "kanalene i denne strømmen passer ikke til høyttalerne den ble laget for"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "de kanalen van deze stream passen niet bij de luidsprekers waarvoor hij is gemaakt"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ ਸਟ੍ਰੀਮ ਦੇ ਚੈਨਲ ਉਨ੍ਹਾਂ ਸਪੀਕਰਾਂ ਨਾਲ ਮੇਲ ਨਹੀਂ ਖਾਂਦੇ ਜਿਨ੍ਹਾਂ ਲਈ ਇਹ ਬਣੀ ਸੀ"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "kanały tego strumienia nie pasują do głośników, dla których powstała"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "os canais deste fluxo não correspondem às caixas para as quais ela foi feita"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "os canais deste fluxo não correspondem às colunas para as quais foi feita"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "canalele acestui flux nu se potrivesc cu difuzoarele pentru care a fost făcută"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "den här strömmens kanaler stämmer inte med högtalarna den gjordes för"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "chaneli za mtiririko huu hazilingani na spika ulizotengenezewa"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த ஸ்ட்ரீமின் சேனல்கள் அது உருவாக்கப்பட்ட ஸ்பீக்கர்களுடன் பொருந்தவில்லை"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ స్ట్రీమ్ ఛానెల్‌లు అది రూపొందించిన స్పీకర్‌లతో సరిపోలడం లేదు"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ช่องสัญญาณของสตรีมนี้ไม่ตรงกับลำโพงที่สร้างไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "bu akışın kanalları, yapıldığı hoparlörlerle eşleşmiyor"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "канали цього потоку не відповідають динамікам, для яких її створено"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس اسٹریم کے چینل ان اسپیکرز سے میل نہیں کھاتے جن کے لیے یہ بنی تھی"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "các kênh của luồng này không khớp với các loa mà nó được tạo cho"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "此音訊串流的聲道與其所針對的揚聲器不相符"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此音频流的声道与其所针对的扬声器不匹配"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此音訊串流的聲道與其所針對的揚聲器不相符"
          }
        }
      }
    },
    "While room correction is on, DSD is converted to PCM so it's corrected too.": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "የክፍል ማስተካከያ በርቶ ሳለ DSD እሱም እንዲስተካከል ወደ PCM ይቀየራል።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أثناء تشغيل تصحيح الغرفة، يُحوَّل DSD إلى PCM ليُصحَّح هو أيضًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রুম কারেকশন চালু থাকলে DSD-কে PCM-এ রূপান্তর করা হয় যাতে সেটিও ঠিক হয়।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když je korekce místnosti zapnutá, DSD se převádí na PCM, aby se také korigovalo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mens rumkorrektion er slået til, konverteres DSD til PCM, så det også bliver korrigeret."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Solange die Raumkorrektur an ist, wird DSD in PCM umgewandelt, damit es ebenfalls korrigiert wird."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όσο η διόρθωση χώρου είναι ενεργή, το DSD μετατρέπεται σε PCM ώστε να διορθώνεται κι αυτό."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mientras la corrección de sala está activa, el DSD se convierte a PCM para corregirlo también."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تا وقتی تصحیح اتاق روشن است، DSD به PCM تبدیل می‌شود تا آن هم تصحیح شود."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun huonekorjaus on päällä, DSD muunnetaan PCM:ksi, jotta sekin korjataan."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Habang naka-on ang room correction, kino-convert ang DSD sa PCM para maitama rin ito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tant que la correction de pièce est active, le DSD est converti en PCM pour être corrigé lui aussi."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "રૂમ કરેક્શન ચાલુ હોય ત્યારે DSD ને PCM માં ફેરવાય છે જેથી તે પણ સુધરે."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokacin da gyaran ɗaki yake kunne, ana mayar da DSD zuwa PCM don shi ma a gyara shi."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כשתיקון החדר פועל, DSD מומר ל־PCM כדי שגם הוא יתוקן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रूम करेक्शन चालू रहने पर DSD को PCM में बदला जाता है ताकि वह भी ठीक हो।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Amíg a térkorrekció be van kapcsolva, a DSD PCM-mé alakul, hogy azt is korrigálja."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Selama koreksi ruangan menyala, DSD diubah ke PCM agar ikut dikoreksi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mentre la correzione ambientale è attiva, il DSD viene convertito in PCM per correggere anche quello."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルーム補正がオンの間、DSD も補正されるよう PCM に変換されます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ರೂಮ್ ಕರೆಕ್ಷನ್ ಆನ್ ಇರುವಾಗ, DSD ಕೂಡ ಸರಿಯಾಗಲು PCM ಗೆ ಪರಿವರ್ತಿಸಲಾಗುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "룸 보정이 켜져 있는 동안 DSD도 보정되도록 PCM으로 변환됩니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "റൂം കറക്ഷൻ ഓണായിരിക്കുമ്പോൾ, DSD-യും ശരിയാക്കപ്പെടാൻ അത് PCM-ലേക്ക് മാറ്റുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "रूम करेक्शन सुरू असताना DSD चे PCM मध्ये रूपांतर होते, म्हणजे तेही दुरुस्त होते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semasa pembetulan bilik hidup, DSD ditukar kepada PCM supaya ia turut dibetulkan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Mens romkorrigeringen er på, gjøres DSD om til PCM slik at det også blir korrigert."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zolang ruimtecorrectie aan staat, wordt DSD naar PCM omgezet zodat het ook wordt gecorrigeerd."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਰੂਮ ਕਰੈਕਸ਼ਨ ਚਾਲੂ ਹੋਣ 'ਤੇ DSD ਨੂੰ PCM ਵਿੱਚ ਬਦਲਿਆ ਜਾਂਦਾ ਹੈ ਤਾਂ ਜੋ ਉਹ ਵੀ ਠੀਕ ਹੋਵੇ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy korekcja pomieszczenia jest włączona, DSD jest zamieniane na PCM, by też zostało skorygowane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com a correção de sala ligada, o DSD é convertido em PCM para ser corrigido também."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Com a correção de sala ligada, o DSD é convertido em PCM para também ser corrigido."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cât timp corecția camerei e activă, DSD este convertit în PCM ca să fie și el corectat."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När rumskorrigeringen är på omvandlas DSD till PCM så att det också korrigeras."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Wakati usahihishaji wa chumba umewashwa, DSD hubadilishwa kuwa PCM ili nayo isahihishwe."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அறைத் திருத்தம் இயங்கும்போது, DSD-யும் திருத்தப்படுவதற்காக PCM-ஆக மாற்றப்படுகிறது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "రూమ్ కరెక్షన్ ఆన్‌లో ఉన్నప్పుడు, DSD కూడా సరిచేయబడేలా PCMగా మార్చబడుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขณะเปิดการปรับแก้ห้อง DSD จะถูกแปลงเป็น PCM เพื่อให้ได้รับการปรับแก้ด้วย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oda düzeltmesi açıkken DSD, o da düzeltilsin diye PCM'e dönüştürülür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поки корекція кімнати ввімкнена, DSD перетворюється на PCM, щоб його теж коригувати."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جب تک روم کریکشن آن ہے، DSD کو PCM میں بدلا جاتا ہے تاکہ وہ بھی درست ہو۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi bật hiệu chỉnh phòng, DSD được chuyển sang PCM để cũng được hiệu chỉnh."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "房間校正開啟時，DSD 會轉換為 PCM，以便同樣獲得校正。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "房间校正打开时，DSD 会转换为 PCM，以便同样得到校正。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "房間校正開啟時，DSD 會轉換為 PCM，以便同樣獲得校正。"
          }
        }
      }
    },

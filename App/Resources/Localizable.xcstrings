            "state": "translated",
            "value": "मल्टिचॅनेल संगीत स्थानानुसार प्रत्येक स्पीकरकडे जाते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Muzik berbilang saluran dihantar ke setiap pembesar suara mengikut kedudukan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Flerkanalsmusikk sendes til hver høyttaler etter posisjon."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meerkanaalsmuziek gaat op positie naar elke luidspreker."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਮਲਟੀਚੈਨਲ ਸੰਗੀਤ ਸਥਿਤੀ ਮੁਤਾਬਕ ਹਰ ਸਪੀਕਰ ਨੂੰ ਜਾਂਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Muzyka wielokanałowa trafia do każdego głośnika według położenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As músicas multicanal vão para cada alto-falante conforme a posição."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A música multicanal vai para cada altifalante conforme a posição."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Muzica multicanal ajunge la fiecare difuzor după poziție."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Flerkanalsmusik går till varje högtalare efter position."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Muziki wa chaneli nyingi huenda kwa kila spika kulingana na nafasi."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மல்டிசேனல் இசை நிலையின்படி ஒவ்வொரு ஸ்பீக்கருக்கும் செல்லும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మల్టీఛానెల్ సంగీతం స్థానం ప్రకారం ప్రతి స్పీకర్‌కు వెళ్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพลงหลายช่องสัญญาณไปยังลำโพงแต่ละตัวตามตำแหน่ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çok kanallı müzik her hoparlöre konumuna göre gider."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Багатоканальна музика надходить на кожен динамік відповідно до його положення."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ملٹی چینل موسیقی پوزیشن کے لحاظ سے ہر اسپیکر پر جاتی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhạc đa kênh được gửi đến từng loa theo vị trí."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "多聲道音樂會按位置送至各揚聲器。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "多声道音乐会按位置送往每个扬声器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "多聲道音樂會依位置送往每個揚聲器。"
          }
        }
      }
    },

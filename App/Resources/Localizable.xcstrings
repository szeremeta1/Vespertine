        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "欢迎"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "歡迎"
          }
        }
      }
    },
    "What Find Music on This Mac starts with. Add Folder always references files in place, and Import & Organize always copies.": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "«በዚህ Mac ላይ ሙዚቃ ፈልግ» በምን እንደሚጀምር። «አቃፊ አክል» ሁልጊዜ ፋይሎችን ባሉበት ያገናኛል፣ «አስገባና አደራጅ» ደግሞ ሁልጊዜ ይቀዳል።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما يبدأ به “البحث عن الموسيقى على هذا الـ Mac”. يحيل “إضافة مجلد” دائمًا إلى الملفات في مكانها، ويقوم “استيراد وتنظيم” دائمًا بالنسخ."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "“এই Mac-এ মিউজিক খুঁজুন” কোন বিকল্প দিয়ে শুরু হয়। “ফোল্ডার যোগ করুন” সবসময় ফাইলগুলো মূল স্থানে রেফারেন্স করে, আর “ইমপোর্ট ও সাজান” সবসময় কপি করে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Výchozí volba pro Najít hudbu v tomto Macu. Přidat složku vždy odkazuje na soubory na místě a Importovat a uspořádat vždy kopíruje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det, Find musik på denne Mac starter med. Tilføj mappe henviser altid til filer på stedet, og Importer og organiser kopierer altid."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Womit „Musik auf diesem Mac finden“ beginnt. „Ordner hinzufügen“ referenziert Dateien immer am Speicherort, und „Importieren & organisieren“ kopiert immer."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Με ποια επιλογή ξεκινά η «Εύρεση μουσικής σε αυτό το Mac». Η «Προσθήκη φακέλου» κάνει πάντα αναφορά στα αρχεία στη θέση τους και η «Εισαγωγή και οργάνωση» πάντα αντιγράφει."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La opción con la que empieza Buscar música en este Mac. Añadir carpeta siempre referencia los archivos en su ubicación, e Importar y organizar siempre los copia."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "گزینه‌ای که «یافتن موسیقی در این Mac» با آن شروع می‌شود. «افزودن پوشه» همیشه به فایل‌ها در محل ارجاع می‌دهد و «وارد کردن و سازمان‌دهی» همیشه کپی می‌کند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapa, jolla Etsi musiikkia tältä Macilta aloittaa. Lisää kansio viittaa aina tiedostoihin paikallaan, ja Tuo ja järjestä kopioi aina."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kung saan nagsisimula ang Maghanap ng Musika sa Mac na Ito. Laging nire-reference ng Magdagdag ng Folder ang mga file sa kinalalagyan, at laging kumokopya ang I-import at Ayusin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le choix initial de Rechercher de la musique sur ce Mac. Ajouter un dossier référence toujours les fichiers sur place, et Importer et organiser copie toujours."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "“આ Mac પર સંગીત શોધો” કઈ રીતથી શરૂ થાય છે તે. “ફોલ્ડર ઉમેરો” હંમેશાં ફાઇલો મૂળ જગ્યાએ રાખે છે, અને “ઇમ્પોર્ટ કરો અને ગોઠવો” હંમેશાં કૉપિ કરે છે."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Abin da Nemo Waƙoƙi a Wannan Mac ke farawa da shi. Ƙara Folda koyaushe yana nuni ga fayiloli a inda suke, kuma Shigo da Kuma Tsara koyaushe yana kwafawa."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האפשרות שבה ״חפש מוזיקה ב־Mac זה״ מתחיל. ״הוסף תיקייה״ תמיד מפנה לקבצים במקומם, ו״ייבא וארגן״ תמיד מעתיק."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“इस Mac पर संगीत ढूँढें” किस विकल्प से शुरू होता है। “फ़ोल्डर जोड़ें” हमेशा फ़ाइलों को मूल स्थान पर रेफ़रेंस करता है, और “इंपोर्ट और व्यवस्थित करें” हमेशा कॉपी करता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezzel indul a Zene keresése ezen a Macen. A Mappa hozzáadása mindig a helyükön hivatkozza a fájlokat, az Importálás és rendezés pedig mindig másol."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilihan awal untuk Temukan Musik di Mac Ini. Tambahkan Folder selalu merujuk file di tempat, dan Impor & Atur selalu menyalin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’opzione iniziale di Trova musica su questo Mac. Aggiungi cartella usa sempre i file come riferimento sul posto, e Importa e organizza li copia sempre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「このMac上の音楽を探す」の初期設定です。「フォルダを追加」は常にファイルをその場で参照し、「読み込んで整理」は常にコピーします。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "“ಈ Mac ನಲ್ಲಿ ಸಂಗೀತ ಹುಡುಕಿ” ಯಾವುದರೊಂದಿಗೆ ಪ್ರಾರಂಭವಾಗುತ್ತದೆ ಎಂಬುದು. “ಫೋಲ್ಡರ್ ಸೇರಿಸಿ” ಯಾವಾಗಲೂ ಫೈಲ್‌ಗಳನ್ನು ಇರುವಲ್ಲೇ ಉಲ್ಲೇಖಿಸುತ್ತದೆ, ಮತ್ತು “ಆಮದುಮಾಡಿ ಮತ್ತು ಸಂಘಟಿಸಿ” ಯಾವಾಗಲೂ ನಕಲಿಸುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에서 음악 찾기의 기본 설정입니다. 폴더 추가는 항상 파일을 제자리에서 참조하고, 가져오기 및 정리는 항상 복사합니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ Mac-ൽ സംഗീതം കണ്ടെത്തുക എന്നത് ഏതിൽ തുടങ്ങണമെന്ന്. ഫോൾഡർ ചേർക്കുക എപ്പോഴും ഫയലുകൾ സ്ഥലത്തുതന്നെ റഫറൻസ് ചെയ്യുന്നു, ഇംപോർട്ട് ചെയ്ത് ക്രമീകരിക്കുക എപ്പോഴും പകർത്തുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "“या Mac वर संगीत शोधा” कोणत्या पद्धतीने सुरू होते ते. “फोल्डर जोडा” नेहमी फाइल्स मूळ जागी ठेवते, आणि “इम्पोर्ट करा आणि व्यवस्थित लावा” नेहमी कॉपी करते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilihan permulaan Cari Muzik pada Mac Ini. Tambah Folder sentiasa merujuk fail di tempat, dan Import & Susun sentiasa menyalin."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det Finn musikk på denne Macen starter med. Legg til mappe refererer alltid til filer på stedet, og Importer og organiser kopierer alltid."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Waarmee ‘Zoek muziek op deze Mac’ begint. ‘Voeg map toe’ verwijst altijd naar bestanden op hun locatie en ‘Importeer en orden’ kopieert altijd."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "‘ਇਸ Mac ’ਤੇ ਸੰਗੀਤ ਲੱਭੋ’ ਕਿਸ ਚੋਣ ਨਾਲ ਸ਼ੁਰੂ ਹੁੰਦਾ ਹੈ। ‘ਫ਼ੋਲਡਰ ਜੋੜੋ’ ਹਮੇਸ਼ਾ ਫ਼ਾਈਲਾਂ ਨੂੰ ਮੌਜੂਦਾ ਥਾਂ ਤੋਂ ਵਰਤਦਾ ਹੈ, ਅਤੇ ‘ਇੰਪੋਰਟ ਅਤੇ ਵਿਵਸਥਿਤ ਕਰੋ’ ਹਮੇਸ਼ਾ ਕਾਪੀ ਕਰਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Od tego zaczyna Znajdź muzykę na tym Macu. Dodaj folder zawsze pozostawia pliki na miejscu, a Importuj i uporządkuj zawsze kopiuje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A opção com que Encontrar Músicas neste Mac começa. Adicionar Pasta sempre referencia os arquivos no local, e Importar e Organizar sempre os copia."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Opção inicial de Procurar música neste Mac. Adicionar pasta referencia sempre os ficheiros no local, e Importar e organizar copia sempre."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Opțiunea de pornire pentru Găsește muzică pe acest Mac. Adaugă dosar referențiază întotdeauna fișierele pe loc, iar Importă și organizează copiază întotdeauna."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här använder Hitta musik på den här datorn från början. Lägg till mapp refererar alltid filer på plats, och Importera och ordna kopierar alltid."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kile ambacho Tafuta Muziki kwenye Mac Hii huanza nacho. Ongeza Folda hurejelea faili mahali zilipo kila wakati, na Ingiza na Upange hunakili kila wakati."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "‘இந்த Mac-இல் இசையைக் கண்டறி’ எதைக் கொண்டு தொடங்கும் என்பது. ‘கோப்புறையைச் சேர்’ எப்போதும் கோப்புகளை இருக்கும் இடத்திலேயே பயன்படுத்தும், ‘இறக்குமதிசெய்து ஒழுங்கமை’ எப்போதும் நகலெடுக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "“ఈ Macలో సంగీతాన్ని కనుగొను” దేనితో ప్రారంభమవుతుందో. “ఫోల్డర్‌ను జోడించు” ఎల్లప్పుడూ ఫైల్‌లను ఉన్నచోటే రిఫరెన్స్ చేస్తుంది, “దిగుమతి చేసి నిర్వహించు” ఎల్లప్పుడూ కాపీ చేస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ค่าเริ่มต้นของ ค้นหาเพลงบน Mac เครื่องนี้ ส่วน เพิ่มโฟลเดอร์ จะอ้างอิงไฟล์ในตำแหน่งเดิมเสมอ และ นำเข้าและจัดระเบียบ จะคัดลอกเสมอ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac’teki Müzikleri Bul’un başlangıç seçeneği. Klasör Ekle her zaman dosyalara yerinde başvurur, İçe Aktar ve Düzenle ise her zaman kopyalar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Режим, з якого починає «Знайти музику на цьому Mac». «Додати папку» завжди залишає файли на місці, а «Імпортувати й упорядкувати» завжди копіює їх."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "“اس Mac پر موسیقی تلاش کریں” کس انتخاب سے شروع ہو۔ “فولڈر شامل کریں” ہمیشہ فائلوں کا اپنی جگہ پر حوالہ دیتا ہے، اور “درآمد اور ترتیب” ہمیشہ کاپی کرتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chế độ mà Tìm nhạc trên máy Mac này dùng ban đầu. Thêm thư mục luôn tham chiếu tệp tại chỗ, còn Nhập & sắp xếp luôn sao chép."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "「在這部 Mac 上尋找音樂」的預設方式。「加入資料夾」一律在原位置參照檔案，而「匯入並整理」一律會複製。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“在这台 Mac 上查找音乐”的默认方式。“添加文件夹”始终原位引用文件，“导入并整理”始终拷贝文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「在這部 Mac 上尋找音樂」的預設方式。「加入檔案夾」一律原地參照檔案，「輸入並整理」一律拷貝檔案。"
          }
        }
      }
    },
    "What's above %@ kHz isn't a mirror image of the music below it, as an upsampler's would be.": {
      "extractionState": "manual",
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ከ%@ kHz በላይ ያለው፣ አፕሳምፕለር እንደሚያደርገው፣ ከሥሩ ያለው ሙዚቃ የመስተዋት ምስል አይደለም።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما يوجد فوق %@ kHz ليس صورة معكوسة للموسيقى التي تحته، كما يكون في حالة رفع معدل العينة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kHz-এর ওপরে যা আছে তা নিচের মিউজিকের প্রতিফলিত ইমেজ নয়, যেমনটা আপস্যাম্পলারের ক্ষেত্রে হতো।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Obsah nad %@ kHz není zrcadlovým obrazem hudby pod ním, jako by tomu bylo po převzorkování."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det, der ligger over %@ kHz, er ikke et spejlbillede af musikken under, som det ville være fra en opsampler."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was oberhalb von %@ kHz liegt, ist kein Spiegelbild der Musik darunter, wie es bei einem Upsampler der Fall wäre."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ό,τι υπάρχει πάνω από τα %@ kHz δεν είναι κατοπτρικό είδωλο της μουσικής από κάτω, όπως θα ήταν με έναν υπερδειγματολήπτη."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What's above %@ kHz isn't a mirror image of the music below it, as an upsampler's would be."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que hay por encima de %@ kHz no es una imagen especular de la música de debajo, como lo sería la de un sobremuestreador."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "آنچه بالای %@ kHz است، برخلاف خروجی یک افزایش‌دهندهٔ نرخ، تصویر آینه‌ای موسیقی زیر آن نیست."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Se, mitä on yli %@ kHz:n, ei ole alapuolisen musiikin peilikuva, kuten ylösnäytteistimen jäljiltä olisi."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang nasa itaas ng %@ kHz ay hindi salamin ng musika sa ibaba nito, gaya ng iiwan ng upsampler."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qui se trouve au-dessus de %@ kHz n’est pas une image miroir de la musique située en dessous, contrairement à ce que produirait un suréchantillonneur."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kHz ની ઉપરનો ભાગ નીચેના સંગીતનું પ્રતિબિંબ નથી, જેવું અપસેમ્પલરને કારણે હોત."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Abin da ke sama da %@ kHz ba hoton madubi ba ne na waƙar da ke ƙasa da shi, kamar yadda na mai upsampling zai kasance."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מה שמעל %@ kHz אינו תמונת מראה של המוזיקה שמתחתיו, כפי שהיה אצל דגימת־על."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kHz के ऊपर जो है, वह नीचे के संगीत की प्रतिबिंब इमेज नहीं है, जैसी अपसैंपलर से बनती।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ami %@ kHz fölött van, az nem tükörképe az alatta lévő zenének, ahogyan felülmintavételezés után lenne."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apa yang ada di atas %@ kHz bukan cerminan musik di bawahnya, seperti yang akan dihasilkan upsampler."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciò che si trova sopra i %@ kHz non è un’immagine speculare della musica sottostante, come sarebbe quella di un sovracampionatore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kHzより上の成分は、アップサンプラによるもののような、下の音楽の鏡像ではありません。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kHz ಮೇಲಿರುವುದು, ಅಪ್‌ಸ್ಯಾಂಪ್ಲರ್‌ನದ್ದಾಗಿದ್ದರೆ ಇರುವಂತೆ, ಅದರ ಕೆಳಗಿನ ಸಂಗೀತದ ಪ್ರತಿಬಿಂಬವಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kHz 위의 성분은 업샘플러가 남기는 것처럼 아래 음악의 거울 이미지가 아닙니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kHz-ന് മുകളിലുള്ളത്, ഒരു അപ്‌സാമ്പ്ലറിന്റേത് പോലെ, താഴെയുള്ള സംഗീതത്തിന്റെ പ്രതിബിംബമല്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kHz च्या वरील भाग खालील संगीताचे प्रतिबिंब नाही, जसा अपसॅम्पलरमुळे झाला असता."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apa yang berada di atas %@ kHz bukan imej cermin muzik di bawahnya, seperti yang akan ditinggalkan oleh penyampel naik."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det som ligger over %@ kHz, er ikke et speilbilde av musikken under, slik det ville vært fra en oppsampler."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat boven %@ kHz zit, is geen spiegelbeeld van de muziek eronder, zoals bij een upsampler het geval zou zijn."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kHz ਤੋਂ ਉੱਪਰ ਜੋ ਹੈ, ਉਹ ਹੇਠਾਂ ਵਾਲੇ ਸੰਗੀਤ ਦਾ ਪ੍ਰਤੀਬਿੰਬ ਨਹੀਂ ਹੈ, ਜਿਵੇਂ ਅੱਪਸੈਂਪਲਰ ਦਾ ਹੁੰਦਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To, co jest powyżej %@ kHz, nie jest lustrzanym odbiciem muzyki poniżej, jak byłoby po upsamplingu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que está acima de %@ kHz não é uma imagem espelhada da música abaixo, como seria a de um upsampler."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O que está acima de %@ kHz não é uma imagem espelhada da música abaixo, como seria a de um sobreamostrador."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce se află peste %@ kHz nu este o imagine în oglindă a muzicii de dedesubt, cum ar fi cea a unui supraeșantionator."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det som finns över %@ kHz är inte en spegelbild av musiken under, som en uppsamplares skulle vara."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kilicho juu ya %@ kHz si taswira ya kioo ya muziki ulio chini yake, kama ambavyo cha upsampler kingekuwa."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kHz-க்கு மேல் உள்ளது, அப்சாம்பிளர் உருவாக்குவதுபோல் கீழே உள்ள இசையின் பிரதிபலிப்பாக இல்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kHz పైన ఉన్నది, అప్‌శాంప్లర్ విషయంలో ఉండే విధంగా, దాని కింది సంగీతానికి ప్రతిబింబం కాదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สิ่งที่อยู่เหนือ %@ kHz ไม่ใช่ภาพสะท้อนของเพลงด้านล่างอย่างที่ตัวอัปแซมเปิลจะทิ้งไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kHz’in üzerindeki içerik, bir yukarı örnekleyicininki gibi altındaki müziğin ayna görüntüsü değil."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вміст вище %@ kHz не є дзеркальним відображенням музики нижче, яке залишила б передискретизація."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kHz سے اوپر جو ہے وہ نیچے کی موسیقی کا عکس نہیں، جیسا کہ اپ سیمپلر کا ہوتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phần trên %@ kHz không phải là ảnh phản chiếu của phần nhạc bên dưới, như khi có bộ nâng mẫu."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kHz 以上的內容並非其下方音樂的鏡像，與升頻器產生的不同。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kHz 以上的内容并不是其下方音乐的镜像，而升频器产生的内容会是镜像。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kHz 以上的內容並不是其下方音樂的鏡像，而升頻器產生的內容會是鏡像。"
          }
        }
      }
    },

    "Add music whenever you're ready, from the File menu or the empty library.": {
      "extractionState": "manual",
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ዝግጁ ሲሆኑ ሙዚቃን ከፋይል ምናሌው ወይም ከባዶው ቤተ-መጻሕፍት ያክሉ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف الموسيقى متى كنت جاهزًا، من قائمة الملف أو من المكتبة الفارغة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যখন খুশি, ফাইল মেনু বা খালি লাইব্রেরি থেকে মিউজিক যোগ করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hudbu přidáte, kdykoli budete chtít, z nabídky Soubor nebo z prázdné knihovny."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføj musik, når du er klar, fra Arkiv-menuen eller det tomme bibliotek."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge Musik hinzu, wann immer du so weit bist – über das Menü „Ablage“ oder die leere Mediathek."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προσθέστε μουσική όποτε είστε έτοιμοι, από το μενού «Αρχείο» ή από την κενή βιβλιοθήκη."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add music whenever you're ready, from the File menu or the empty library."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade música cuando quieras desde el menú Archivo o desde la biblioteca vacía."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هر وقت آماده بودید، از منوی فایل یا کتابخانهٔ خالی موسیقی اضافه کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää musiikkia milloin haluat Arkisto-valikosta tai tyhjästä kirjastosta."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Magdagdag ng musika kapag handa ka na, mula sa File menu o sa walang lamang library."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez de la musique quand vous le souhaitez, depuis le menu Fichier ou la bibliothèque vide."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "જ્યારે તૈયાર હો ત્યારે ફાઇલ મેનૂ કે ખાલી લાઇબ્રેરીમાંથી સંગીત ઉમેરો."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ƙara waƙoƙi a duk lokacin da kuka shirya, daga menu na Fayil ko laburaren da babu komai."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הוסף מוזיקה מתי שתרצה, מתפריט ״קובץ״ או מהספריה הריקה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब चाहें, फ़ाइल मेनू या खाली लाइब्रेरी से संगीत जोड़ें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Zenét bármikor hozzáadhat a Fájl menüből vagy az üres könyvtárból."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan musik kapan pun Anda siap, dari menu File atau perpustakaan yang kosong."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi musica quando vuoi, dal menu File o dalla libreria vuota."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音楽はいつでも、「ファイル」メニューや空のライブラリから追加できます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ಸಿದ್ಧರಾದಾಗ ಫೈಲ್ ಮೆನು ಅಥವಾ ಖಾಲಿ ಲೈಬ್ರರಿಯಿಂದ ಸಂಗೀತ ಸೇರಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "준비가 되면 언제든지 파일 메뉴나 비어 있는 보관함에서 음악을 추가할 수 있습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "തയ്യാറാകുമ്പോൾ ഫയൽ മെനുവിൽ നിന്നോ ശൂന്യമായ ലൈബ്രറിയിൽ നിന്നോ സംഗീതം ചേർക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तयार असाल तेव्हा फाइल मेनूमधून किंवा रिकाम्या लायब्ररीतून संगीत जोडा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambah muzik bila-bila masa anda bersedia, daripada menu Fail atau pustaka yang kosong."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg til musikk når du er klar, fra Arkiv-menyen eller det tomme biblioteket."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg muziek toe wanneer je er klaar voor bent, via het menu ‘Archief’ of de lege bibliotheek."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਜਦੋਂ ਵੀ ਤਿਆਰ ਹੋਵੋ, ਫ਼ਾਈਲ ਮੀਨੂ ਜਾਂ ਖਾਲੀ ਲਾਇਬ੍ਰੇਰੀ ਤੋਂ ਸੰਗੀਤ ਜੋੜੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj muzykę, kiedy zechcesz, z menu Plik lub z pustej biblioteki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione músicas quando quiser, pelo menu Arquivo ou pela biblioteca vazia."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione música quando quiser, a partir do menu Ficheiro ou da biblioteca vazia."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adăugați muzică oricând doriți, din meniul Fișier sau din biblioteca goală."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg till musik när du vill, från Arkiv-menyn eller det tomma biblioteket."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ongeza muziki wakati wowote ukiwa tayari, kutoka kwenye menyu ya File au maktaba tupu."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தயாரானதும் கோப்பு மெனுவிலிருந்தோ வெற்று லைப்ரரியிலிருந்தோ இசையைச் சேர்க்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు సిద్ధంగా ఉన్నప్పుడు ఫైల్ మెనూ లేదా ఖాళీ లైబ్రరీ నుండి సంగీతాన్ని జోడించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มเพลงได้ทุกเมื่อที่คุณพร้อม จากเมนูไฟล์หรือจากคลังที่ว่างอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hazır olduğunuzda Dosya menüsünden veya boş arşivden müzik ekleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додавайте музику, коли будете готові, з меню «Файл» або з порожньої медіатеки."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جب چاہیں، فائل مینو یا خالی لائبریری سے موسیقی شامل کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm nhạc bất cứ khi nào bạn sẵn sàng, từ menu Tệp hoặc thư viện trống."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "準備好後，隨時可從「檔案」選單或空白的資料庫加入音樂。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "准备好后，随时可以通过“文件”菜单或空白资料库添加音乐。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "準備好後，隨時可以從「檔案」選單或空白的資料庫加入音樂。"
          }
        }
      }
    },

          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запис надто короткий, щоб містити часові орієнтири."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ریکارڈنگ ٹائمنگ ریفرنس سمونے کے لیے بہت چھوٹی ہے۔"

    "Use a simulated room (no microphone, no sound)": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "የተመሰለ ክፍል ተጠቀም (ማይክሮፎን የለም፣ ድምፅ የለም)"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم غرفة محاكاة (بلا ميكروفون ولا صوت)"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি সিমুলেটেড ঘর ব্যবহার করুন (মাইক্রোফোন নেই, শব্দ নেই)"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Použít simulovanou místnost (bez mikrofonu, bez zvuku)"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug et simuleret rum (ingen mikrofon, ingen lyd)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Simulierten Raum verwenden (kein Mikrofon, kein Ton)"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χρήση προσομοιωμένου δωματίου (χωρίς μικρόφωνο, χωρίς ήχο)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usar una sala simulada (sin micrófono, sin sonido)"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "استفاده از اتاق شبیه‌سازی‌شده (بدون میکروفون، بدون صدا)"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käytä simuloitua huonetta (ei mikrofonia, ei ääntä)"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Gumamit ng simulated na kuwarto (walang mikropono, walang tunog)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiliser une pièce simulée (sans micro, sans son)"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સિમ્યુલેટેડ રૂમ વાપરો (માઇક્રોફોન નહીં, અવાજ નહીં)"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Yi amfani da ɗaki na kwaikwayo (babu makirufo, babu sauti)"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שימוש בחדר מדומה (ללא מיקרופון, ללא צליל)"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिम्युलेटेड कमरा इस्तेमाल करें (न माइक्रोफ़ोन, न आवाज़)"
          }
        },
        "hu": {

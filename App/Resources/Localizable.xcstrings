    "Bit-perfect, high-resolution playback for every format and every DAC.": {
      "extractionState": "manual",
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ለእያንዳንዱ ቅርጸት እና ለእያንዳንዱ DAC ቢት-ፍጹም፣ ከፍተኛ ጥራት ያለው መጫወት።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تشغيل مطابق للبتات وعالي الدقة لكل تنسيق ولكل DAC."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতিটি ফরম্যাট ও প্রতিটি DAC-এর জন্য বিট-পারফেক্ট, হাই-রেজোলিউশন প্লেব্যাক।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bit-perfect přehrávání ve vysokém rozlišení pro každý formát a každý DAC."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitperfekt afspilning i høj opløsning til alle formater og alle DAC'er."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bit-perfekte Wiedergabe in hoher Auflösung für jedes Format und jeden DAC."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αναπαραγωγή bit-perfect υψηλής ανάλυσης για κάθε μορφή και κάθε DAC."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bit-perfect, high-resolution playback for every format and every DAC."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproducción bit-perfect en alta resolución para cualquier formato y cualquier DAC."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پخش بیت‌به‌بیت با وضوح بالا برای هر قالب و هر DAC."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bittitarkka, korkearesoluutioinen toisto kaikille formaateille ja kaikille DAC:ille."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Bit-perfect at high-resolution na playback para sa bawat format at bawat DAC."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une lecture bit-perfect en haute résolution, pour tous les formats et tous les DAC."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "દરેક ફૉર્મેટ અને દરેક DAC માટે બિટ-પરફેક્ટ, હાઇ-રેઝોલ્યુશન પ્લેબૅક."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunnawa bit-perfect mai inganci sosai don kowane tsari da kowace DAC."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השמעה מדויקת לסיבית ברזולוציה גבוהה, לכל פורמט ולכל DAC."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर फ़ॉर्मैट और हर DAC के लिए बिट-परफ़ेक्ट, हाई-रेज़ोल्यूशन प्लेबैक।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Bit-perfect, nagy felbontású lejátszás minden formátumhoz és minden DAC-hoz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemutaran bit-perfect beresolusi tinggi untuk setiap format dan setiap DAC."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riproduzione bit-perfect ad alta risoluzione per ogni formato e ogni DAC."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あらゆるフォーマット、あらゆるDACで、ビットパーフェクトなハイレゾ再生。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಪ್ರತಿ ಫಾರ್ಮ್ಯಾಟ್ ಮತ್ತು ಪ್ರತಿ DAC ಗಾಗಿ ಬಿಟ್-ಪರ್ಫೆಕ್ಟ್, ಹೈ-ರೆಸಲ್ಯೂಶನ್ ಪ್ಲೇಬ್ಯಾಕ್."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 포맷과 모든 DAC에서 비트 퍼펙트 고해상도 재생."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "എല്ലാ ഫോർമാറ്റിനും എല്ലാ DAC-നും ബിറ്റ്-പെർഫെക്റ്റ്, ഹൈ-റെസല്യൂഷൻ പ്ലേബാക്ക്."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रत्येक फॉरमॅट आणि प्रत्येक DAC साठी बिट-परफेक्ट, हाय-रेझोल्यूशन प्लेबॅक."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Main balik bit-perfect beresolusi tinggi untuk setiap format dan setiap DAC."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitperfekt avspilling i høy oppløsning for alle formater og alle DAC-er."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitperfecte weergave in hoge resolutie voor elk formaat en elke DAC."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਹਰ ਫ਼ਾਰਮੈਟ ਅਤੇ ਹਰ DAC ਲਈ ਬਿੱਟ-ਪਰਫ਼ੈਕਟ, ਹਾਈ-ਰੈਜ਼ੋਲਿਊਸ਼ਨ ਪਲੇਬੈਕ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odtwarzanie bit-perfect w wysokiej rozdzielczości dla każdego formatu i każdego przetwornika DAC."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reprodução bit-perfect em alta resolução para todos os formatos e todos os DACs."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Reprodução bit-perfect em alta resolução para todos os formatos e todos os DAC."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Redare bit-perfect, de înaltă rezoluție, pentru orice format și orice DAC."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitperfekt uppspelning i hög upplösning för alla format och alla DAC:ar."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Uchezaji wa bit-perfect wa ubora wa juu kwa kila fomati na kila DAC."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒவ்வொரு வடிவத்துக்கும் ஒவ்வொரு DAC-க்கும் பிட்-பெர்ஃபெக்ட், உயர் தெளிவுத்திறன் இயக்கம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రతి ఫార్మాట్‌కు, ప్రతి DACకు బిట్-పర్ఫెక్ట్, హై-రిజల్యూషన్ ప్లేబ్యాక్."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเล่นความละเอียดสูงแบบบิตเพอร์เฟกต์ สำหรับทุกรูปแบบไฟล์และทุก DAC"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her biçim ve her DAC için bit-perfect, yüksek çözünürlüklü oynatma."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відтворення біт-у-біт у високій роздільності для будь-якого формату й будь-якого ЦАП."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہر فارمیٹ اور ہر DAC کے لیے بٹ پرفیکٹ، ہائی ریزولوشن پلے بیک۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phát bit-perfect, độ phân giải cao cho mọi định dạng và mọi DAC."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "位元完美的 Hi-Res 播放，支援所有格式及所有 DAC。"
          }
        },
        "zh-Hans": {

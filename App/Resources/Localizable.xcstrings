    "No microphone named “%@” is connected. Plug in the UMIK-1 and try again.": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” የሚባል ማይክሮፎን አልተገናኘም። UMIK-1 ን ይሰኩ እና እንደገና ይሞክሩ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد ميكروفون باسم “%@” متصل. وصّل UMIK-1 وحاول مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” নামের কোনো মাইক্রোফোন যুক্ত নেই। UMIK-1 লাগিয়ে আবার চেষ্টা করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Není připojen žádný mikrofon s názvem „%@“. Připojte UMIK-1 a zkuste to znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der er ikke tilsluttet nogen mikrofon ved navn “%@”. Sæt UMIK-1 i, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist kein Mikrofon mit dem Namen „%@“ angeschlossen. Schließen Sie das UMIK-1 an und versuchen Sie es erneut."
          }
        },
        "el": {
          "stringUnit": {

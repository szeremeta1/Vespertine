        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کچھ درآمد نہیں ہوا: کاپیوں کے لیے %@ درکار ہے اور Mac پر %@ خالی ہے (Vespertine %@ فاضل رکھتا ہے)۔ کچھ جگہ خالی کریں، یا موسیقی کو اس کی جگہ پر چلانے کے لیے “فولڈر شامل کریں” استعمال کریں۔"
          }

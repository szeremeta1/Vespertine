    "Little recorded above ~%@ kHz, which is normal for analog-era masters.": {
      "extractionState": "manual",
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ከ~%@ kHz በላይ የተቀዳው ጥቂት ነው፣ ይህም ለአናሎግ ዘመን ማስተሮች የተለመደ ነው።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "القليل مسجّل فوق ~%@ kHz، وهذا طبيعي في ماسترات الحقبة التناظرية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "~%@ kHz-এর ওপরে সামান্যই রেকর্ড হয়েছে, যা অ্যানালগ যুগের মাস্টারের জন্য স্বাভাবিক।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nad ~%@ kHz je zaznamenáno málo, což je u masterů z analogové éry běžné."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun lidt er optaget over ~%@ kHz, hvilket er normalt for mastere fra den analoge æra."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenig Aufgezeichnetes oberhalb von ~%@ kHz, was für Master aus der Analog-Ära normal ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ελάχιστο ηχογραφημένο περιεχόμενο πάνω από τα ~%@ kHz, κάτι φυσιολογικό για masters της αναλογικής εποχής."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Little recorded above ~%@ kHz, which is normal for analog-era masters."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Poco contenido grabado por encima de ~%@ kHz, algo normal en los másteres de la era analógica."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "محتوای ضبط‌شدهٔ اندکی بالای حدود %@ kHz وجود دارد، که برای مسترهای دوران آنالوگ طبیعی است."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vähän tallennettua yli noin %@ kHz:n, mikä on tavallista analogisen aikakauden mastereille."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaunti lang ang na-record sa itaas ng ~%@ kHz, na normal para sa mga master noong panahon ng analog."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Peu de contenu enregistré au-dessus de ~%@ kHz, ce qui est normal pour les masters de l’ère analogique."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "~%@ kHz ની ઉપર ભાગ્યે જ કંઈ રેકોર્ડ થયું છે, જે ઍનાલૉગ યુગના માસ્ટર માટે સામાન્ય છે."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaɗan ne aka naɗa sama da ~%@ kHz, wanda ya saba ga master na zamanin analog."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מעט מוקלט מעל כ־%@ kHz, דבר רגיל במאסטרים מהעידן האנלוגי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "~%@ kHz के ऊपर बहुत कम रिकॉर्ड हुआ है, जो एनालॉग युग के मास्टर के लिए सामान्य है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "~%@ kHz fölött kevés a rögzített tartalom, ami az analóg korszak mastereinél normális."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sedikit yang terekam di atas ~%@ kHz, yang normal untuk master era analog."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Poco contenuto registrato sopra ~%@ kHz, il che è normale per i master dell’era analogica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "約%@ kHzより上はほとんど録音されていません。アナログ時代のマスターでは普通のことです。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "~%@ kHz ಮೇಲೆ ರೆಕಾರ್ಡ್ ಆಗಿರುವುದು ಕಡಿಮೆ, ಇದು ಅನಲಾಗ್ ಯುಗದ ಮಾಸ್ಟರ್‌ಗಳಿಗೆ ಸಾಮಾನ್ಯ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "약 %@ kHz 위로는 녹음된 성분이 거의 없으며, 이는 아날로그 시대 마스터에서는 정상입니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "~%@ kHz-ന് മുകളിൽ കാര്യമായി ഒന്നും റെക്കോർഡ് ചെയ്തിട്ടില്ല, അനലോഗ് കാലഘട്ടത്തിലെ മാസ്റ്ററുകൾക്ക് ഇത് സാധാരണമാണ്."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "~%@ kHz च्या वर फारसे काही रेकॉर्ड झालेले नाही, जे ॲनालॉग काळातील मास्टरसाठी सामान्य आहे."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sedikit sahaja dirakam di atas ~%@ kHz, yang biasa bagi master era analog."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lite er tatt opp over ~%@ kHz, noe som er normalt for mastere fra den analoge æraen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Weinig opgenomen boven ~%@ kHz, wat normaal is voor masters uit het analoge tijdperk."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "~%@ kHz ਤੋਂ ਉੱਪਰ ਬਹੁਤ ਘੱਟ ਰਿਕਾਰਡ ਹੋਇਆ ਹੈ, ਜੋ ਐਨਾਲੌਗ ਦੌਰ ਦੇ ਮਾਸਟਰਾਂ ਲਈ ਆਮ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niewiele nagrane powyżej ~%@ kHz, co jest normalne dla masterów z ery analogowej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pouco conteúdo gravado acima de ~%@ kHz, o que é normal em masters da era analógica."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pouco gravado acima de ~%@ kHz, o que é normal em masters da era analógica."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Puțin conținut înregistrat peste ~%@ kHz, ceea ce este normal pentru masterele din era analogică."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lite inspelat över ~%@ kHz, vilket är normalt för masters från den analoga eran."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kidogo kimerekodiwa juu ya ~%@ kHz, jambo ambalo ni la kawaida kwa master za enzi ya analogi."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "~%@ kHz-க்கு மேல் மிகக் குறைவாகவே பதிவாகியுள்ளது, இது அனலாக் கால மாஸ்டர்களுக்கு இயல்பானது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "~%@ kHz పైన రికార్డ్ అయినది చాలా తక్కువ, అనలాగ్ కాలం నాటి మాస్టర్‌లకు ఇది సాధారణం."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีการบันทึกเหนือประมาณ %@ kHz น้อยมาก ซึ่งเป็นเรื่องปกติสำหรับมาสเตอร์ยุคแอนะล็อก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "~%@ kHz’in üzerinde çok az kayıt var; bu, analog dönem masterları için normaldir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вище ~%@ kHz записано мало — це нормально для мастерів аналогової епохи."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تقریباً %@ kHz سے اوپر بہت کم ریکارڈ شدہ مواد، جو اینالاگ دور کے ماسٹرز کے لیے معمول کی بات ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có ít nội dung được ghi trên ~%@ kHz, điều này bình thường với các bản master thời analog."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "約 %@ kHz 以上錄得的內容很少，這對於類比年代的母帶屬正常。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "约 %@ kHz 以上几乎没有录制内容，这对于模拟时代的母带来说很正常。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "約 %@ kHz 以上幾乎沒有錄製內容，這對類比時代的母帶來說很正常。"
          }
        }
      }
    },

        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El fundido del barrido debe ser corto en comparación con el barrido."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "محو شدن سوییپ باید در مقایسه با خود سوییپ کوتاه باشد."

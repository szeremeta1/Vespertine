        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再生中の曲をDiscordのステータスに表示"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಪ್ಲೇ ಆಗುತ್ತಿರುವುದನ್ನು ನನ್ನ Discord ಸ್ಟೇಟಸ್ ಆಗಿ ತೋರಿಸಿ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재생 중인 음악을 Discord 상태로 표시"
          }
        },
        "ml": {

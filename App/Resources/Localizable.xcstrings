        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Waƙoƙi a NAS ko wata Mac, ta SMB."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מוזיקה ב־NAS או ב־Mac אחר, דרך SMB."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "NAS या दूसरे Mac पर रखा संगीत, SMB के ज़रिए।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Zene NAS-on vagy egy másik Macen, SMB-n keresztül."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Musik di NAS atau Mac lain, melalui SMB."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Musica su un NAS o su un altro Mac, tramite SMB."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "NASや別のMacの音楽にSMBで接続します。"
          }
        },
        "kn": {
          "stringUnit": {

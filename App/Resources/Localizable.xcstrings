        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مائیکروفون اور اسپیکر کے کلاک میں %@ ppm کا فرق ہے، جو پیمائش درست کر سکنے سے زیادہ ہے۔"
          }
        },
        "vi": {

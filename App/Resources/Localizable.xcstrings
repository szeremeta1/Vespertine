          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Behold lokale kopier af musik, der afspilles fra delinger"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale Kopien von Musik behalten, die von Freigaben abgespielt wird"

    "The measurement has a different number of frequencies and levels.": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "መለኪያው የድግግሞሾችና የደረጃዎች ቁጥር እኩል አይደለም።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عدد الترددات والمستويات في القياس غير متساوٍ."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পরিমাপে ফ্রিকোয়েন্সি ও লেভেলের সংখ্যা সমান নয়।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Měření má jiný počet frekvencí a úrovní."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Målingen har et forskelligt antal frekvenser og niveauer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Messung hat nicht gleich viele Frequenzen und Pegel."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η μέτρηση έχει διαφορετικό πλήθος συχνοτήτων και στάθμεων."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La medición tiene un número distinto de frecuencias y niveles."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اندازه‌گیری تعداد فرکانس‌ها و سطوح یکسانی ندارد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mittauksessa on eri määrä taajuuksia ja tasoja."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Magkaiba ang bilang ng mga frequency at level sa pagsukat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La mesure a un nombre différent de fréquences et de niveaux."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "માપનમાં આવૃત્તિઓ અને લેવલની સંખ્યા અલગ છે."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Aunawar tana da adadin mita da matakai daban-daban."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "במדידה יש מספר שונה של תדרים ורמות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "माप में आवृत्तियों और स्तरों की संख्या अलग-अलग है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A mérésben eltér a frekvenciák és a szintek száma."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengukuran memiliki jumlah frekuensi dan level yang berbeda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La misurazione ha un numero diverso di frequenze e livelli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "測定の周波数とレベルの数が一致しません。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಅಳತೆಯಲ್ಲಿ ಆವರ್ತನಗಳು ಮತ್ತು ಮಟ್ಟಗಳ ಸಂಖ್ಯೆ ಬೇರೆಯಾಗಿದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "측정의 주파수 개수와 레벨 개수가 다릅니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",

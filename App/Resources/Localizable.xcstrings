    "Connected, but the share’s contents can’t be read.": {
      "extractionState": "manual",
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ተገናኝቷል፣ ግን የማጋሪያው ይዘት ሊነበብ አይችልም።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم الاتصال، لكن تتعذر قراءة محتويات المشاركة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সংযুক্ত, কিন্তু শেয়ারের বিষয়বস্তু পড়া যাচ্ছে না।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Připojeno, ale obsah sdílení nelze přečíst."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Forbundet, men delingens indhold kan ikke læses."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbunden, aber der Inhalt der Freigabe kann nicht gelesen werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συνδέθηκε, αλλά δεν είναι δυνατή η ανάγνωση των περιεχομένων του κοινόχρηστου φακέλου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connected, but the share’s contents can’t be read."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectado, pero no se puede leer el contenido del recurso compartido."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "وصل شد، اما محتوای اشتراک قابل خواندن نیست."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yhdistetty, mutta jaon sisältöä ei voi lukea."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nakakonekta, pero hindi mabasa ang laman ng share."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecté, mais le contenu du partage ne peut pas être lu."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કનેક્ટ થયું, પણ શેરની સામગ્રી વાંચી શકાતી નથી."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "An haɗa, amma ba za a iya karanta abubuwan da ke cikin folda ta cibiyar sadarwa ba."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",

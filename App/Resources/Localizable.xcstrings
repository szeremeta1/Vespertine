          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ಆಯ್ಕೆಮಾಡಿದ ಔಟ್‌ಪುಟ್ ಮತ್ತೆ ಸಂಪರ್ಕಗೊಳ್ಳುವವರೆಗೆ ಏನೂ ಪ್ಲೇ ಆಗುವುದಿಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 출력이 다시 연결될 때까지 아무것도 재생되지 않습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ തിരഞ്ഞെടുത്ത ഔട്ട്‌പുട്ട് വീണ്ടും കണക്റ്റ് ചെയ്യുന്നതുവരെ ഒന്നും പ്ലേ ചെയ്യില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही निवडलेले आउटपुट पुन्हा कनेक्ट होईपर्यंत काहीही प्ले होणार नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada apa-apa dimainkan sehingga output yang anda pilih bersambung semula."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingenting spilles av før den valgte utgangen er tilkoblet igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er wordt niets afgespeeld totdat de gekozen uitvoer weer verbonden is."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਜਦੋਂ ਤੱਕ ਤੁਹਾਡਾ ਚੁਣਿਆ ਆਉਟਪੁੱਟ ਦੁਬਾਰਾ ਕਨੈਕਟ ਨਹੀਂ ਹੁੰਦਾ, ਕੁਝ ਨਹੀਂ ਚੱਲੇਗਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic nie jest odtwarzane, dopóki wybrane wyjście nie zostanie ponownie podłączone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada é reproduzido até que a saída escolhida seja conectada novamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada é reproduzido até que a saída escolhida volte a estar ligada."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu se redă nimic până când ieșirea pe care ați ales-o este conectată din nou."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget spelas förrän utgången du valde är ansluten igen."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hakuna kitakachocheza hadi kifaa ulichochagua kiunganishwe tena."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் தேர்ந்தெடுத்த வெளியீடு மீண்டும் இணைக்கப்படும் வரை எதுவும் இயங்காது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు ఎంచుకున్న అవుట్‌పుట్ మళ్లీ కనెక్ట్ అయ్యే వరకు ఏదీ ప్లే కాదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จะไม่มีการเล่นใดๆ จนกว่าขาออกที่คุณเลือกจะเชื่อมต่ออีกครั้ง"
          }

        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Emplacement en lecture seule · enregistré dans la bibliothèque de Vespertine ; les fichiers ne sont pas modifiés"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ફક્ત વાંચવા માટેનું સ્થાન · Vespertine ની લાઇબ્રેરીમાં સેવ થયું; ફાઇલો બદલાતી નથી"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Wurin karantawa kawai · an ajiye a laburaren Vespertine; ba a canza fayilolin ba"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מיקום לקריאה בלבד · נשמר בספריית Vespertine; הקבצים אינם משתנים"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल-पठन स्थान · Vespertine की लाइब्रेरी में सहेजा गया; फ़ाइलें नहीं बदलतीं"
          }
        },
        "hu": {
          "stringUnit": {

    "Songs you listen to appear here, the most recent first.": {
      "comment": "Explanation under “No history yet” in the empty History tab.",
      "extractionState": "manual",
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "የሚያዳምጧቸው ዘፈኖች እዚህ ይታያሉ፣ የቅርቡ መጀመሪያ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر هنا الأغاني التي تستمع إليها، الأحدث أولًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি যে গানগুলো শোনেন সেগুলো এখানে দেখা যায়, সবচেয়ে সাম্প্রতিকটি প্রথমে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zde se zobrazí skladby, které posloucháte, od nejnovějších."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sange, du lytter til, vises her med de nyeste først."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Titel, die du hörst, erscheinen hier – die neuesten zuerst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα τραγούδια που ακούτε εμφανίζονται εδώ, με τα πιο πρόσφατα πρώτα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las canciones que escuchas aparecen aquí, de la más reciente a la más antigua."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "آهنگ‌هایی که گوش می‌دهید اینجا نمایش داده می‌شوند، جدیدترین‌ها اول."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuuntelemasi kappaleet näkyvät tässä uusimmat ensin."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Lalabas dito ang mga kantang pinapakinggan mo, nauuna ang pinakabago."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les morceaux que vous écoutez apparaissent ici, du plus récent au plus ancien."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે સાંભળો છો તે ગીતો અહીં દેખાય છે, સૌથી તાજેતરનાં પહેલાં."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Waƙoƙin da kuke saurara za su bayyana a nan, na baya-bayan nan a farko."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שירים שתאזין להם יופיעו כאן, האחרונים ראשונים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप जो गीत सुनते हैं, वे यहाँ दिखाई देते हैं, सबसे हाल के सबसे पहले।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A meghallgatott dalok itt jelennek meg, a legutóbbi elöl."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagu yang Anda dengarkan muncul di sini, yang terbaru di urutan pertama."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I brani che ascolti vengono mostrati qui, dal più recente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "聴いた曲が新しい順にここに表示されます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ಕೇಳುವ ಹಾಡುಗಳು ಇಲ್ಲಿ ಕಾಣಿಸುತ್ತವೆ, ಇತ್ತೀಚಿನವು ಮೊದಲು."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "들은 노래가 최신순으로 여기에 표시됩니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ കേൾക്കുന്ന പാട്ടുകൾ ഇവിടെ ദൃശ്യമാകും, ഏറ്റവും പുതിയത് ആദ്യം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही ऐकलेली गाणी येथे दिसतात, सर्वात अलीकडील आधी."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagu yang anda dengar dipaparkan di sini, yang terbaharu dahulu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sanger du hører på, vises her, med de nyeste først."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nummers waarnaar je luistert, verschijnen hier, de meest recente eerst."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਸੀਂ ਜੋ ਗੀਤ ਸੁਣਦੇ ਹੋ, ਉਹ ਇੱਥੇ ਦਿਖਾਈ ਦਿੰਦੇ ਹਨ, ਸਭ ਤੋਂ ਨਵੇਂ ਪਹਿਲਾਂ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utwory, których słuchasz, pojawiają się tutaj, od najnowszych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As músicas que você ouve aparecem aqui, das mais recentes para as mais antigas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As músicas que ouve aparecem aqui, das mais recentes para as mais antigas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Melodiile pe care le ascultați apar aici, cele mai recente primele."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Låtar du lyssnar på visas här, de senaste först."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyimbo unazosikiliza zinaonekana hapa, za hivi karibuni kwanza."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் கேட்கும் பாடல்கள் இங்கே தோன்றும், சமீபத்தியவை முதலில்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు వినే పాటలు ఇక్కడ కనిపిస్తాయి, ఇటీవలివి ముందుగా."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพลงที่คุณฟังจะแสดงที่นี่ โดยเรียงจากล่าสุดก่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dinlediğiniz şarkılar burada en yenisi en üstte olacak şekilde görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тут з’являтимуться пісні, які ви слухаєте, — спершу найновіші."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ جو گانے سنتے ہیں وہ یہاں ظاہر ہوتے ہیں، تازہ ترین سب سے پہلے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các bài hát bạn nghe sẽ xuất hiện ở đây, bài gần nhất ở trên cùng."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "你聆聽過的歌曲會在此顯示，最近播放的會排在最前。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你听过的歌曲会显示在这里，最近播放的排在最前面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你聆聽過的歌曲會顯示在這裡，最近播放的排在最前面。"
          }
        }
      }
    },

        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ট্রানজিশনের ধরন বেছে নিন"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvolit styl přechodu"
          }
        },
        "da": {

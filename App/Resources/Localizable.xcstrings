        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ವರ್ಚುವಲ್ ಟ್ರ್ಯಾಕ್; ಎಡಿಟ್‌ಗಳು ಲೈಬ್ರರಿಯಲ್ಲೇ ಉಳಿಯುತ್ತವೆ"

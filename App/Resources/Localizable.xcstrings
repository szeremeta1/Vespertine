    "AirPlay streams at 44.1 kHz; the receiver controls the final format.": {
      "extractionState": "manual",
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay በ44.1 kHz ያስተላልፋል፤ የመጨረሻውን ቅርጸት የሚቆጣጠረው ተቀባዩ ነው።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبث AirPlay بمعدل 44.1 kHz؛ ويتحكم جهاز الاستقبال في التنسيق النهائي."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay 44.1 kHz-এ স্ট্রিম করে; চূড়ান্ত ফরম্যাট রিসিভার ঠিক করে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay streamuje v 44,1 kHz; o konečném formátu rozhoduje přijímač."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay streamer ved 44,1 kHz; modtageren bestemmer det endelige format."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay überträgt mit 44,1 kHz; der Empfänger bestimmt das endgültige Format."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το AirPlay μεταδίδει στα 44,1 kHz· ο δέκτης ελέγχει την τελική μορφή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay streams at 44.1 kHz; the receiver controls the final format."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay transmite a 44,1 kHz; el receptor controla el formato final."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay با ۴۴٫۱ kHz پخش می‌کند؛ گیرنده قالب نهایی را تعیین می‌کند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",

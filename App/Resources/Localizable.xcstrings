    "Finds missing album covers when you look an album up on MusicBrainz. Only when you ask for a lookup.": {
      "extractionState": "manual",
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "አንድን አልበም በMusicBrainz ላይ ሲፈልጉ የጎደሉ የአልበም ሽፋኖችን ያገኛል። ፍለጋ ሲጠይቁ ብቻ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعثر على أغلفة الألبومات المفقودة عند البحث عن ألبوم في MusicBrainz. فقط عندما تطلب البحث."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "MusicBrainz-এ কোনো অ্যালবাম খুঁজলে অনুপস্থিত অ্যালবাম কভার খুঁজে আনে। শুধু আপনি খুঁজতে বললেই।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Najde chybějící obaly alb, když album vyhledáte v MusicBrainz. Jen když o vyhledání požádáte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder manglende albumomslag, når du slår et album op på MusicBrainz. Kun når du beder om et opslag."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Findet fehlende Albumcover, wenn du ein Album in MusicBrainz suchst. Nur wenn du eine Suche startest."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Βρίσκει εξώφυλλα άλμπουμ που λείπουν όταν αναζητάτε ένα άλμπουμ στο MusicBrainz. Μόνο όταν ζητάτε αναζήτηση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finds missing album covers when you look an album up on MusicBrainz. Only when you ask for a lookup."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca las portadas que faltan cuando buscas un álbum en MusicBrainz. Solo cuando tú lo pides."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "وقتی آلبومی را در MusicBrainz جست‌وجو می‌کنید، جلدهای گم‌شدهٔ آلبوم را پیدا می‌کند. فقط وقتی خودتان درخواست جست‌وجو بدهید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Löytää puuttuvat albumien kansikuvat, kun haet albumia MusicBrainzista. Vain kun pyydät hakua."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinahanap ang mga nawawalang album cover kapag nag-lookup ka ng album sa MusicBrainz. Kapag humiling ka lang ng lookup."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trouve les pochettes manquantes lorsque vous recherchez un album sur MusicBrainz. Uniquement à votre demande."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે MusicBrainz પર કોઈ આલ્બમ શોધો ત્યારે ખૂટતાં આલ્બમ કવર શોધી લાવે છે. ફક્ત તમે શોધવાનું કહો ત્યારે જ."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Yana nemo hotunan bangon kundi da suka ɓace idan kun nemi kundi a MusicBrainz. Sai dai idan kun nemi bincike."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מוצא עטיפות אלבום חסרות כשאתה מחפש אלבום ב־MusicBrainz. רק כשאתה מבקש חיפוש."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब आप MusicBrainz पर कोई एल्बम खोजते हैं, तो छूटे हुए एल्बम कवर ढूँढता है। सिर्फ़ तभी, जब आप खोज करने को कहें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Megkeresi a hiányzó albumborítókat, amikor egy albumot kikeres a MusicBrainzben. Csak ha Ön kér keresést."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menemukan sampul album yang hilang saat Anda mencari album di MusicBrainz. Hanya jika Anda meminta pencarian."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trova le copertine mancanti quando cerchi un album su MusicBrainz. Solo quando richiedi una ricerca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MusicBrainzでアルバムを照会したときに、足りないアルバムカバーを見つけます。照会を求めたときだけ動作します。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು MusicBrainz ನಲ್ಲಿ ಆಲ್ಬಮ್ ಹುಡುಕಿದಾಗ ಕಾಣೆಯಾದ ಆಲ್ಬಮ್ ಕವರ್‌ಗಳನ್ನು ಹುಡುಕುತ್ತದೆ. ನೀವು ಹುಡುಕಲು ಕೇಳಿದಾಗ ಮಾತ್ರ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "MusicBrainz에서 앨범을 조회할 때 누락된 앨범 커버를 찾아줍니다. 조회를 요청할 때만 작동합니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ MusicBrainz-ൽ ഒരു ആൽബം തിരയുമ്പോൾ ഇല്ലാത്ത ആൽബം കവറുകൾ കണ്ടെത്തുന്നു. നിങ്ങൾ തിരയാൻ ആവശ്യപ്പെടുമ്പോൾ മാത്രം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही MusicBrainz वर एखादा अल्बम शोधता तेव्हा गहाळ अल्बम कव्हर शोधते. फक्त तुम्ही शोधायला सांगाल तेव्हाच."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mencari kulit album yang tiada apabila anda mencari album di MusicBrainz. Hanya apabila anda meminta carian."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Finner manglende albumomslag når du slår opp et album på MusicBrainz. Bare når du ber om et oppslag."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vindt ontbrekende albumillustraties wanneer je een album opzoekt in MusicBrainz. Alleen als je daarom vraagt."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਜਦੋਂ ਤੁਸੀਂ MusicBrainz ’ਤੇ ਕੋਈ ਐਲਬਮ ਲੱਭਦੇ ਹੋ, ਤਾਂ ਗੁੰਮ ਐਲਬਮ ਕਵਰ ਲੱਭ ਲਿਆਉਂਦਾ ਹੈ। ਸਿਰਫ਼ ਉਦੋਂ, ਜਦੋਂ ਤੁਸੀਂ ਲੱਭਣ ਲਈ ਕਹੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Znajduje brakujące okładki albumów, gdy wyszukujesz album w MusicBrainz. Tylko wtedy, gdy o to poprosisz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontra capas de álbuns que estão faltando quando você busca um álbum no MusicBrainz. Somente quando você pede uma busca."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontra capas de álbuns em falta quando procura um álbum no MusicBrainz. Apenas quando pede uma pesquisa."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Găsește copertele lipsă ale albumelor când căutați un album în MusicBrainz. Doar când cereți o căutare."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hittar saknade albumomslag när du slår upp ett album på MusicBrainz. Bara när du ber om ett uppslag."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hutafuta majalada ya albamu yanayokosekana unapotafuta albamu kwenye MusicBrainz. Ni pale tu unapoomba utafutaji."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "MusicBrainz-இல் ஒரு ஆல்பத்தைத் தேடும்போது விடுபட்ட ஆல்பம் கவர்களைக் கண்டறியும். நீங்கள் தேடச் சொன்னால் மட்டுமே."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు MusicBrainzలో ఆల్బమ్‌ను వెతికినప్పుడు లేని ఆల్బమ్ కవర్‌లను కనుగొంటుంది. మీరు వెతకమని అడిగినప్పుడు మాత్రమే."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ค้นหาภาพปกอัลบั้มที่ขาดหายไปเมื่อคุณค้นหาอัลบั้มใน MusicBrainz ทำงานเฉพาะเมื่อคุณสั่งให้ค้นหาเท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "MusicBrainz’de bir albüm aradığınızda eksik albüm kapaklarını bulur. Yalnızca siz arama istediğinizde."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Знаходить відсутні обкладинки альбомів, коли ви шукаєте альбом у MusicBrainz. Лише коли ви самі запускаєте пошук."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جب آپ MusicBrainz پر کوئی البم تلاش کرتے ہیں تو غائب البم کورز ڈھونڈتا ہے۔ صرف تب جب آپ تلاش کا کہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tìm ảnh bìa album còn thiếu khi bạn tra cứu album trên MusicBrainz. Chỉ khi bạn yêu cầu tra cứu."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "在 MusicBrainz 查詢專輯時，找出缺少的專輯封面。只會在你要求查詢時進行。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 MusicBrainz 上查询专辑时，查找缺失的专辑封面。仅在你请求查询时进行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 MusicBrainz 上查詢專輯時，找出缺少的專輯封面。只在你要求查詢時進行。"
          }
        }
      }
    },
    "Fix the cause, then try again.": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "መንስኤውን ያስተካክሉ፣ ከዚያ እንደገና ይሞክሩ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عالج السبب ثم حاول مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কারণটি ঠিক করুন, তারপর আবার চেষ্টা করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odstraňte příčinu a zkuste to znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ret årsagen, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ursache beheben und dann erneut versuchen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διορθώστε την αιτία και δοκιμάστε ξανά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Corrige la causa y vuelve a intentarlo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "علت را برطرف کنید و دوباره تلاش کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Korjaa syy ja yritä uudelleen."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayusin ang sanhi, saka subukan muli."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Corrigez la cause, puis réessayez."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કારણ સુધારો, પછી ફરી પ્રયત્ન કરો."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Gyara dalilin, sannan a sake gwadawa."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "טפלו בגורם ונסו שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कारण ठीक करें, फिर दोबारा कोशिश करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hárítsa el az okot, majd próbálja újra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perbaiki penyebabnya, lalu coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Correggi la causa, poi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "原因を取り除いてから、もう一度お試しください。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಕಾರಣವನ್ನು ಸರಿಪಡಿಸಿ, ನಂತರ ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원인을 해결한 다음 다시 시도하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കാരണം പരിഹരിച്ച ശേഷം വീണ്ടും ശ്രമിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कारण दुरुस्त करा, मग पुन्हा प्रयत्न करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Betulkan puncanya, kemudian cuba lagi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Rett opp årsaken, og prøv på nytt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Los de oorzaak op en probeer het opnieuw."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕਾਰਨ ਠੀਕ ਕਰੋ, ਫਿਰ ਦੁਬਾਰਾ ਕੋਸ਼ਿਸ਼ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuń przyczynę i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Corrija a causa e tente de novo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Corrija a causa e tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Remediază cauza, apoi încearcă din nou."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Åtgärda orsaken och försök igen."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Tatua chanzo, kisha jaribu tena."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "காரணத்தைச் சரிசெய்து, மீண்டும் முயலவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కారణాన్ని సరిచేసి, మళ్లీ ప్రయత్నించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แก้ที่สาเหตุ แล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nedeni giderin, sonra tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усуньте причину та спробуйте ще раз."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "وجہ دور کریں، پھر دوبارہ کوشش کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy khắc phục nguyên nhân rồi thử lại."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "請排除原因後重試。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请排除原因后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請排除原因後重試。"
          }
        }
      }
    },

        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sweepets fade skal være kort i forhold til sweepet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Ein- und Ausblenden des Sweeps muss im Vergleich zum Sweep kurz sein."

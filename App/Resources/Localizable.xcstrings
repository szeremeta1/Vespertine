    "The file decoded as digital silence, so there's nothing to analyze.": {
      "extractionState": "manual",
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ፋይሉ እንደ ዲጂታል ጸጥታ ዲኮድ ስለተደረገ የሚተነተን ነገር የለም።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فُكّ ترميز الملف كصمت رقمي، لذا لا يوجد ما يمكن تحليله."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফাইলটি ডিজিটাল নীরবতা হিসেবে ডিকোড হয়েছে, তাই বিশ্লেষণ করার মতো কিছু নেই।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Soubor se dekódoval jako digitální ticho, takže není co analyzovat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Filen blev afkodet som digital stilhed, så der er intet at analysere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei wurde als digitale Stille dekodiert, daher gibt es nichts zu analysieren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το αρχείο αποκωδικοποιήθηκε ως ψηφιακή σιωπή, οπότε δεν υπάρχει κάτι για ανάλυση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file decoded as digital silence, so there's nothing to analyze."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo se ha decodificado como silencio digital, así que no hay nada que analizar."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فایل به‌صورت سکوت دیجیتال رمزگشایی شد، بنابراین چیزی برای تحلیل نیست."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiedosto purkautui digitaaliseksi hiljaisuudeksi, joten analysoitavaa ei ole."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Na-decode ang file bilang digital na katahimikan, kaya walang masusuri."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier a été décodé comme un silence numérique : il n’y a donc rien à analyser."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ફાઇલ ડિજિટલ શાંતિ તરીકે ડીકોડ થઈ, તેથી વિશ્લેષણ કરવા જેવું કંઈ નથી."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Fayil ɗin ya warware a matsayin shiru na dijital, don haka babu abin da za a yi nazari."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקובץ פוענח כשקט דיגיטלי, ולכן אין מה לנתח."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ाइल डिजिटल मौन के रूप में डिकोड हुई, इसलिए विश्लेषण के लिए कुछ नहीं है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fájl digitális csendként dekódolódott, így nincs mit elemezni."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "File didekode sebagai senyap digital, sehingga tidak ada yang dapat dianalisis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il file è stato decodificato come silenzio digitale, quindi non c’è nulla da analizzare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルはデジタル無音としてデコードされたため、解析する内容がありません。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಫೈಲ್ ಡಿಜಿಟಲ್ ನಿಶ್ಯಬ್ದವಾಗಿ ಡೀಕೋಡ್ ಆಗಿದೆ, ಆದ್ದರಿಂದ ವಿಶ್ಲೇಷಿಸಲು ಏನೂ ಇಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일이 디지털 무음으로 디코딩되어 분석할 내용이 없습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഫയൽ ഡിജിറ്റൽ നിശ്ശബ്ദതയായി ഡീകോഡ് ചെയ്തു, അതിനാൽ വിശകലനം ചെയ്യാൻ ഒന്നുമില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "फाइल डिजिटल शांतता म्हणून डीकोड झाली, त्यामुळे विश्लेषण करण्यासारखे काही नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Fail dinyahkod sebagai senyap digital, jadi tiada apa-apa untuk dianalisis."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Filen ble dekodet som digital stillhet, så det er ingenting å analysere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het bestand is gedecodeerd als digitale stilte, dus er valt niets te analyseren."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਫ਼ਾਈਲ ਡਿਜੀਟਲ ਚੁੱਪ ਵਜੋਂ ਡੀਕੋਡ ਹੋਈ, ਇਸ ਲਈ ਵਿਸ਼ਲੇਸ਼ਣ ਲਈ ਕੁਝ ਨਹੀਂ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",

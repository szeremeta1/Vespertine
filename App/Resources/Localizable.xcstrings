    "%lld channels to %@ across %lld outputs in standard order (1 L, 2 R, 3 C, 4 LFE, 5 Ls, 6 Rs…). Set up speakers in Audio MIDI Setup to place them by position.": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@c@ ወደ %2$@ በ%#@o@ በመደበኛ ቅደም ተከተል (1 L፣ 2 R፣ 3 C፣ 4 LFE፣ 5 Ls፣ 6 Rs…)። በአቀማመጣቸው ለማስቀመጥ ድምፅ ማጉያዎችን በAudio MIDI Setup ውስጥ ያዘጋጁ።"
          },
          "substitutions": {
            "c": {
              "argNum": 1,

    "MusicBrainz allows one request per second.": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "MusicBrainz በሰከንድ አንድ ጥያቄ ብቻ ይፈቅዳል።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسمح MusicBrainz بطلب واحد في الثانية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "MusicBrainz প্রতি সেকেন্ডে একটি অনুরোধের অনুমতি দেয়।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "MusicBrainz povoluje jeden požadavek za sekundu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "MusicBrainz tillader én forespørgsel pr. sekund."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "MusicBrainz erlaubt eine Anfrage pro Sekunde."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το MusicBrainz επιτρέπει ένα αίτημα ανά δευτερόλεπτο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "MusicBrainz permite una solicitud por segundo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "MusicBrainz در هر ثانیه یک درخواست را می‌پذیرد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "MusicBrainz sallii yhden pyynnön sekunnissa."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Isang request bawat segundo ang pinapayagan ng MusicBrainz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "MusicBrainz autorise une requête par seconde."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "MusicBrainz પ્રતિ સેકંડ એક જ વિનંતી સ્વીકારે છે."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "MusicBrainz yana ba da damar buƙata ɗaya a kowane daƙiƙa."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "MusicBrainz מאפשר בקשה אחת בשנייה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "MusicBrainz प्रति सेकंड एक अनुरोध की अनुमति देता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A MusicBrainz másodpercenként egy kérést enged."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "MusicBrainz mengizinkan satu permintaan per detik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "MusicBrainz consente una richiesta al secondo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MusicBrainzへのリクエストは1秒に1回までです。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "MusicBrainz ಪ್ರತಿ ಸೆಕೆಂಡಿಗೆ ಒಂದು ವಿನಂತಿಯನ್ನು ಮಾತ್ರ ಅನುಮತಿಸುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "MusicBrainz는 초당 1회의 요청만 허용합니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "MusicBrainz സെക്കൻഡിൽ ഒരു അഭ്യർത്ഥന മാത്രമേ അനുവദിക്കൂ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "MusicBrainz प्रति सेकंद एकच विनंती स्वीकारते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "MusicBrainz membenarkan satu permintaan sesaat."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "MusicBrainz tillater én forespørsel per sekund."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "MusicBrainz staat één verzoek per seconde toe."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "MusicBrainz ਪ੍ਰਤੀ ਸਕਿੰਟ ਇੱਕ ਬੇਨਤੀ ਦੀ ਇਜਾਜ਼ਤ ਦਿੰਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "MusicBrainz pozwala na jedno zapytanie na sekundę."
          }
        },

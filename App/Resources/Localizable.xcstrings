    "%@ folded into %@ by speaker position.": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ በድምፅ ማጉያ አቀማመጥ ወደ %@ ተደባልቋል።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ مدموجة في %2$@ حسب موضع السماعات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্পিকারের অবস্থান অনুযায়ী %1$@ মিশিয়ে %2$@ করা হয়েছে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ smícháno do %@ podle polohy reproduktorů."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ foldet ind i %@ efter højttalerposition."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nach Lautsprecherposition in %@ eingemischt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ενσωματωμένα σε %@ βάσει θέσης ηχείων."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ integrados en %2$@ según la posición de los altavoces."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ بر اساس موقعیت بلندگو در %@ ادغام شده است."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ yhdistetty muotoon %@ kaiuttimien sijainnin mukaan."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Isinama ang %@ sa %@ ayon sa posisyon ng speaker."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ réduits en %@ selon la position des haut-parleurs."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ને સ્પીકરના સ્થાન મુજબ %2$@ માં ભેળવ્યું."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "An haɗa %@ zuwa %@ bisa matsayin lasifikoki."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ משולבים לתוך %2$@ לפי מיקום הרמקולים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ को स्पीकर की स्थिति के अनुसार %2$@ में मिलाया गया।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ összekeverve erre: %@, a hangszórók helyzete szerint."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ digabungkan menjadi %@ berdasarkan posisi speaker."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ridotti a %@ in base alla posizione degli altoparlanti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@をスピーカーの位置に従って%2$@にまとめています。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ಅನ್ನು ಸ್ಪೀಕರ್ ಸ್ಥಾನದ ಪ್ರಕಾರ %2$@ ಗೆ ಸೇರಿಸಲಾಗಿದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@을(를) 스피커 위치에 따라 %2$@(으)로 통합합니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ സ്പീക്കർ സ്ഥാനമനുസരിച്ച് %2$@-ലേക്ക് ചേർത്തു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ स्पीकरच्या स्थानानुसार %2$@ मध्ये मिसळले."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ digabungkan ke dalam %@ mengikut kedudukan pembesar suara."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ foldet inn i %@ etter høyttalerposisjon."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ingemengd in %@ op basis van luidsprekerpositie."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ਨੂੰ ਸਪੀਕਰ ਸਥਿਤੀ ਮੁਤਾਬਕ %2$@ ਵਿੱਚ ਸਮੇਟਿਆ ਗਿਆ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Układ %@ zmiksowany do %@ według położenia głośników."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ incorporados em %2$@ conforme a posição dos alto-falantes."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ integrado em %@ por posição dos altifalantes."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ combinat în %@ după poziția difuzoarelor."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nedmixade till %@ efter högtalarposition."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ zimeunganishwa kuwa %@ kulingana na nafasi za spika."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ஸ்பீக்கர் நிலையின்படி %2$@-இல் இணைக்கப்பட்டது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ స్పీకర్ స్థానం ప్రకారం %2$@లోకి కలపబడింది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ถูกรวมเป็น %@ ตามตำแหน่งลำโพง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, hoparlör konumuna göre %2$@ düzenine katlandı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ зведено в %@ за положенням динаміків."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ کو اسپیکر کی پوزیشن کے لحاظ سے %@ میں سمویا گیا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ được gộp vào %@ theo vị trí loa."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 已按揚聲器位置併入 %2$@。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 按扬声器位置并入 %@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 依揚聲器位置併入 %@。"
          }
        }
      }

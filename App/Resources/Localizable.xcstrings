    "Waiting for %@. Playback continues as soon as it’s ready.": {
      "comment": "%@ is the name of an audio output device.",
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ን በመጠበቅ ላይ። ልክ እንደተዘጋጀ መጫወቱ ይቀጥላል።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في انتظار %@. سيُستأنف التشغيل فور جاهزيته."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-এর জন্য অপেক্ষা করা হচ্ছে। এটি প্রস্তুত হলেই প্লেব্যাক আবার চলবে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: čeká se na připojení. Přehrávání bude pokračovat, jakmile bude zařízení připravené."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Venter på %@. Afspilningen fortsætter, så snart den er klar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warten auf %@. Die Wiedergabe wird fortgesetzt, sobald das Gerät bereit ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: αναμονή. Η αναπαραγωγή θα συνεχιστεί μόλις είναι έτοιμη."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esperando a %@. La reproducción continuará en cuanto esté listo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در انتظار %@. به‌محض آماده شدن، پخش ادامه می‌یابد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Odotetaan laitetta %@. Toisto jatkuu heti, kun se on valmis."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinihintay ang %@. Magpapatuloy ang playback sa sandaling handa na ito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En attente de %@. La lecture reprendra dès qu’il sera prêt."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ની રાહ જોઈ રહ્યાં છીએ. તે તૈયાર થતાં જ પ્લેબૅક આગળ ચાલશે."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ana jiran %@. Kunnawa za ta ci gaba da zarar ya shirya."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ממתין ל־%@. ההשמעה תימשך ברגע שהוא יהיה מוכן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ की प्रतीक्षा की जा रही है। इसके तैयार होते ही प्लेबैक जारी रहेगा।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Várakozás erre: %@. A lejátszás folytatódik, amint az eszköz készen áll."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menunggu %@. Pemutaran berlanjut segera setelah siap."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In attesa di %@. La riproduzione riprende non appena è pronto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@を待っています。準備ができ次第、再生を続けます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ಗಾಗಿ ಕಾಯಲಾಗುತ್ತಿದೆ. ಅದು ಸಿದ್ಧವಾದ ತಕ್ಷಣ ಪ್ಲೇಬ್ಯಾಕ್ ಮುಂದುವರಿಯುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 기기를 기다리는 중입니다. 준비되는 대로 재생이 계속됩니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-നായി കാത്തിരിക്കുന്നു. അത് തയ്യാറായാലുടൻ പ്ലേബാക്ക് തുടരും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ची प्रतीक्षा करत आहे. ते तयार होताच प्लेबॅक पुढे सुरू होईल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menunggu %@. Main balik diteruskan sebaik sahaja ia sedia."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Venter på %@. Avspillingen fortsetter så snart den er klar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wachten op %@. Het afspelen gaat verder zodra het apparaat gereed is."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ਦੀ ਉਡੀਕ ਕੀਤੀ ਜਾ ਰਹੀ ਹੈ। ਇਸਦੇ ਤਿਆਰ ਹੁੰਦਿਆਂ ਹੀ ਪਲੇਬੈਕ ਜਾਰੀ ਰਹੇਗਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oczekiwanie na urządzenie %@. Odtwarzanie zostanie wznowione, gdy tylko będzie gotowe."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aguardando %@. A reprodução continua assim que estiver pronto."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A aguardar %@. A reprodução continua assim que estiver pronto."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se așteaptă %@. Redarea continuă imediat ce este gata."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Väntar på %@. Uppspelningen fortsätter så snart den är redo."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Inasubiri %@. Uchezaji utaendelea mara tu kitakapokuwa tayari."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-க்காகக் காத்திருக்கிறது. அது தயாரானதும் இயக்கம் தொடரும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ కోసం వేచి ఉంది. అది సిద్ధమైన వెంటనే ప్లేబ్యాక్ కొనసాగుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กำลังรอ %@ การเล่นจะดำเนินต่อทันทีที่พร้อม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bekleniyor. Hazır olduğunda oynatma devam edecek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Очікування: %@. Відтворення продовжиться, щойно пристрій буде готовий."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ کا انتظار ہے۔ اس کے تیار ہوتے ہی پلے بیک جاری رہے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang chờ %@. Sẽ tiếp tục phát ngay khi thiết bị sẵn sàng."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "正在等待 %@。裝置準備好後便會繼續播放。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",

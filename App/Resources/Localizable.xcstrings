        "ur": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "فائل میں ایک اسپیکر کے بہت زیادہ فلٹرز ہیں۔ Vespertine ہر اسپیکر کے لیے زیادہ سے زیادہ %lld فلٹر چلاتا ہے۔"

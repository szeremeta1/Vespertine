    "DoP requires exclusive, bit-transparent output": {
      "extractionState": "manual",
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "DoP ብቸኛና ቢትን የማይቀይር ውፅዓት ይፈልጋል"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتطلب DoP مخرجًا حصريًا شفافًا للبتات"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "DoP-এর জন্য এক্সক্লুসিভ, বিট-ট্রান্সপারেন্ট আউটপুট প্রয়োজন"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "DoP vyžaduje výhradní, bitově transparentní výstup"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "DoP kræver eksklusivt, bittransparent output"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "DoP erfordert eine exklusive, bittransparente Ausgabe"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το DoP απαιτεί αποκλειστική έξοδο χωρίς αλλοίωση των bit"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DoP requires exclusive, bit-transparent output"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "DoP requiere una salida exclusiva y transparente a nivel de bits"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "DoP به خروجی انحصاری و بیت‌شفاف نیاز دارد"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "DoP vaatii yksinomaisen, bittiläpinäkyvän ulostulon"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kailangan ng DoP ang eksklusibo at bit-transparent na output"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le DoP nécessite une sortie exclusive et transparente au bit près"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "DoP માટે અનન્ય, બિટ-ટ્રાન્સપરન્ટ આઉટપુટ જરૂરી છે"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "DoP yana buƙatar fitarwa ta keɓe wadda ba ta canza bit"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "DoP דורש פלט בלעדי ושקוף לסיביות"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "DoP के लिए एक्सक्लूसिव, बिट-ट्रांसपेरेंट आउटपुट ज़रूरी है"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A DoP kizárólagos, bitátlátszó kimenetet igényel"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "DoP memerlukan output eksklusif yang transparan bit"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il DoP richiede un’uscita esclusiva e trasparente ai bit"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "DoPには排他的でビット透過な出力が必要です"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "DoP ಗೆ ಏಕಸ್ವಾಮ್ಯ, ಬಿಟ್-ಟ್ರಾನ್ಸ್‌ಪರೆಂಟ್ ಔಟ್‌ಪುಟ್ ಅಗತ್ಯವಿದೆ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "DoP에는 독점적이고 비트 투명한 출력이 필요합니다"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "DoP-ന് എക്സ്ക്ലൂസീവ്, ബിറ്റ്-ട്രാൻസ്പരന്റ് ഔട്ട്‌പുട്ട് ആവശ്യമാണ്"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "DoP साठी अनन्य, बिट-ट्रान्सपरंट आउटपुट आवश्यक आहे"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "DoP memerlukan output eksklusif yang telus bit"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "DoP krever eksklusiv, bittransparent utgang"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "DoP vereist exclusieve, bittransparante uitvoer"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "DoP ਲਈ ਨਿਵੇਕਲਾ, ਬਿੱਟ-ਪਾਰਦਰਸ਼ੀ ਆਉਟਪੁੱਟ ਚਾਹੀਦਾ ਹੈ"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "DoP wymaga wyłącznego, bitowo przezroczystego wyjścia"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O DoP exige uma saída exclusiva e transparente em bits"
          }
        },
        "pt-PT": {

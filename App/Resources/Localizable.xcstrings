    "No 16-bit mode at %@ kHz; sent as %lld-bit (same samples, zero-padded)": {
      "comment": "Signal-path note; %@ is a sample rate, %lld a bit depth (24 or 32).",
      "extractionState": "manual",
      "localizations": {
        "am": {
          "stringUnit": {

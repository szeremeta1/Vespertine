    "Raw captures, the session file, the calibrated responses and the designed profile are in the measurement folder.": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ጥሬ ቀረጻዎቹ፣ የክፍለ ጊዜ ፋይሉ፣ የተስተካከሉ ምላሾቹ እና የተነደፈው መገለጫ በመለኪያ አቃፊው ውስጥ ናቸው።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التسجيلات الخام وملف الجلسة والاستجابات المعايَرة والملف الشخصي المصمَّم كلها في مجلد القياس."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অপরিশোধিত ক্যাপচার, সেশন ফাইল, ক্যালিব্রেটেড রেসপন্স এবং তৈরি করা প্রোফাইল পরিমাপ ফোল্ডারে আছে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Surové záznamy, soubor relace, kalibrované odezvy a navržený profil jsou ve složce měření."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Rå optagelser, sessionsfilen, de kalibrerede responser og den designede profil ligger i målemappen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rohaufnahmen, Sitzungsdatei, kalibrierte Frequenzgänge und das erstellte Profil liegen im Messordner."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι ακατέργαστες καταγραφές, το αρχείο συνεδρίας, οι βαθμονομημένες αποκρίσεις και το σχεδιασμένο προφίλ βρίσκονται στον φάκελο της μέτρησης."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las capturas sin procesar, el archivo de sesión, las respuestas calibradas y el perfil diseñado están en la carpeta de la medición."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ضبط‌های خام، فایل نشست، پاسخ‌های کالیبره‌شده و نمایه طراحی‌شده در پوشه اندازه‌گیری هستند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Raakatallenteet, istuntotiedosto, kalibroidut vasteet ja suunniteltu profiili ovat mittauskansiossa."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nasa measurement folder ang mga raw capture, ang session file, ang mga na-calibrate na response at ang dinisenyong profile."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les captures brutes, le fichier de session, les réponses étalonnées et le profil calculé se trouvent dans le dossier de la mesure."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "રો કેપ્ચર, સેશન ફાઇલ, કેલિબ્રેટ કરેલા રિસ્પોન્સ અને બનાવેલી પ્રોફાઇલ માપન ફોલ્ડરમાં છે."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ɗaukar danye, fayil ɗin zama, amsoshin da aka daidaita da bayanin da aka ƙera suna cikin babban fayil ɗin aunawa."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההקלטות הגולמיות, קובץ ההפעלה, התגובות המכוילות והפרופיל המתוכנן נמצאים בתיקיית המדידה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रॉ कैप्चर, सेशन फ़ाइल, कैलिब्रेटेड प्रतिक्रियाएँ और बनाई गई प्रोफ़ाइल माप फ़ोल्डर में हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A nyers felvételek, a munkamenetfájl, a kalibrált átvitelek és a megtervezett profil a mérési mappában vannak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekaman mentah, file sesi, respons terkalibrasi, dan profil yang dirancang ada di folder pengukuran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le acquisizioni grezze, il file di sessione, le risposte calibrate e il profilo calcolato sono nella cartella della misurazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "生の収録データ、セッションファイル、補正済みの応答、設計したプロファイルは、測定フォルダに入っています。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಕಚ್ಚಾ ಕ್ಯಾಪ್ಚರ್‌ಗಳು, ಸೆಷನ್ ಫೈಲ್, ಕ್ಯಾಲಿಬ್ರೇಟ್ ಮಾಡಿದ ಪ್ರತಿಕ್ರಿಯೆಗಳು ಮತ್ತು ವಿನ್ಯಾಸಗೊಳಿಸಿದ ಪ್ರೊಫೈಲ್ ಅಳತೆ ಫೋಲ್ಡರ್‌ನಲ್ಲಿವೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원본 캡처, 세션 파일, 보정된 응답, 설계된 프로필이 측정 폴더에 있습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "റോ ക്യാപ്ചറുകൾ, സെഷൻ ഫയൽ, കാലിബ്രേറ്റ് ചെയ്ത പ്രതികരണങ്ങൾ, രൂപകൽപ്പന ചെയ്ത പ്രൊഫൈൽ എന്നിവ അളവ് ഫോൾഡറിലുണ്ട്."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "रॉ कॅप्चर, सेशन फाइल, कॅलिब्रेट केलेले प्रतिसाद आणि तयार केलेली प्रोफाइल मापन फोल्डरमध्ये आहेत."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tangkapan mentah, fail sesi, sambutan yang ditentukur dan profil yang direka ada dalam folder ukuran."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Råopptakene, sesjonsfilen, de kalibrerte responsene og den utformede profilen ligger i målemappen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De ruwe opnamen, het sessiebestand, de gekalibreerde responsies en het ontworpen profiel staan in de metingmap."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੱਚੇ ਕੈਪਚਰ, ਸੈਸ਼ਨ ਫ਼ਾਈਲ, ਕੈਲੀਬ੍ਰੇਟ ਕੀਤੇ ਜਵਾਬ ਅਤੇ ਬਣਾਈ ਪ੍ਰੋਫਾਈਲ ਮਾਪ ਫੋਲਡਰ ਵਿੱਚ ਹਨ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Surowe nagrania, plik sesji, skalibrowane charakterystyki i zaprojektowany profil są w folderze pomiaru."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As capturas brutas, o arquivo da sessão, as respostas calibradas e o perfil projetado estão na pasta da medição."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As capturas em bruto, o ficheiro da sessão, as respostas calibradas e o perfil criado estão na pasta da medição."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Capturile brute, fișierul sesiunii, răspunsurile calibrate și profilul proiectat se află în dosarul măsurării."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Råinspelningarna, sessionsfilen, de kalibrerade svaren och den framtagna profilen finns i mätmappen."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekodi ghafi, faili ya kipindi, majibu yaliyorekebishwa na wasifu uliobuniwa viko kwenye folda ya kipimo."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மூலப் பதிவுகள், அமர்வுக் கோப்பு, அளவுத்திருத்திய துலக்கங்கள் மற்றும் வடிவமைத்த சுயவிவரம் அளவீட்டு கோப்புறையில் உள்ளன."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "రా క్యాప్చర్లు, సెషన్ ఫైల్, క్యాలిబ్రేట్ చేసిన ప్రతిస్పందనలు మరియు రూపొందించిన ప్రొఫైల్ కొలత ఫోల్డర్‌లో ఉన్నాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟล์บันทึกดิบ ไฟล์เซสชัน การตอบสนองที่สอบเทียบแล้ว และโปรไฟล์ที่ออกแบบ อยู่ในโฟลเดอร์การวัด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ham kayıtlar, oturum dosyası, kalibre edilmiş yanıtlar ve tasarlanan profil ölçüm klasöründe."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Необроблені записи, файл сеансу, відкалібровані характеристики та створений профіль — у теці вимірювання."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "خام کیپچر، سیشن فائل، کیلیبریٹ شدہ ردعمل اور بنایا گیا پروفائل پیمائش کے فولڈر میں ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản ghi thô, tệp phiên, đáp tuyến đã hiệu chuẩn và hồ sơ đã thiết kế nằm trong thư mục phép đo."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "原始擷取、工作階段檔案、校正後的響應和設計好的設定檔都在量度資料夾中。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原始采集、会话文件、校准后的响应和设计好的配置文件都在测量文件夹中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "原始擷取、工作階段檔案、校正後的響應和設計好的設定檔都在量測資料夾中。"
          }
        }

        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Målingen trenger en inngangsenhet, en utgangsenhet og kanalnumre som ikke er negative."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De meting heeft een invoerapparaat, een uitvoerapparaat en niet-negatieve kanaalnummers nodig."

        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇത് ഒഴിവാക്കി പിന്നീട് ഫയൽ മെനുവിൽ നിന്ന് സംഗീതം ചേർക്കാം."

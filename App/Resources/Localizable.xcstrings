    "Each speaker plays a rising tone. Between rounds, move the microphone to the next glowing spot.": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "እያንዳንዱ ድምፅ ማጉያ ወደ ላይ የሚወጣ ድምፅ ያጫውታል። በዙሮች መካከል ማይክሮፎኑን ወደሚቀጥለው የሚያበራ ቦታ ያንቀሳቅሱ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعزف كل سماعة نغمة صاعدة. بين الجولات، انقل الميكروفون إلى النقطة المضيئة التالية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতিটি স্পিকার একটি ক্রমশ উঁচু সুর বাজায়। প্রতি রাউন্ডের মাঝে মাইক্রোফোনটি পরের জ্বলজ্বলে জায়গায় সরান।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každý reproduktor zahraje stoupající tón. Mezi koly přesuňte mikrofon na další svítící bod."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver højttaler spiller en stigende tone. Mellem runderne flytter du mikrofonen til det næste lysende punkt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Lautsprecher spielt einen ansteigenden Ton. Stell das Mikrofon zwischen den Runden an die nächste leuchtende Stelle."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάθε ηχείο παίζει έναν ανερχόμενο τόνο. Ανάμεσα στους γύρους, μετακινήστε το μικρόφωνο στο επόμενο φωτεινό σημείο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada altavoz reproduce un tono ascendente. Entre rondas, lleva el micrófono al siguiente punto iluminado."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هر بلندگو یک نوای بالارونده پخش می‌کند. بین دورها، میکروفون را به نقطه درخشان بعدی ببرید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jokainen kaiutin soittaa nousevan äänen. Siirrä mikrofoni kierrosten välillä seuraavaan hehkuvaan kohtaan."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Tumutugtog ang bawat speaker ng tonong pataas. Sa pagitan ng mga round, ilipat ang mikropono sa susunod na kumikinang na puwesto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque enceinte joue un son montant. Entre les séries, déplacez le micro sur le point lumineux suivant."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "દરેક સ્પીકર ચઢતો સૂર વગાડે છે. રાઉન્ડ વચ્ચે માઇક્રોફોનને આગલી ચમકતી જગ્યાએ લઈ જાઓ."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Kowane lasifika yana kunna sauti mai hawa. Tsakanin zagaye, matsar da makirufo zuwa wuri na gaba da ke haskakawa."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל רמקול מנגן צליל עולה. בין הסבבים, הזיזו את המיקרופון לנקודה הזוהרת הבאה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर स्पीकर एक चढ़ता हुआ स्वर बजाता है। राउंड के बीच माइक्रोफ़ोन को अगली चमकती जगह पर ले जाएँ।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden hangszóró egy emelkedő hangot játszik. A körök között tedd a mikrofont a következő világító pontra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap speaker memutar nada yang naik. Di antara putaran, pindahkan mikrofon ke titik menyala berikutnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni diffusore suona un tono crescente. Tra un giro e l’altro, sposta il microfono sul punto illuminato successivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各スピーカーが上昇する音を鳴らします。各回の間に、マイクを次の光っている位置へ動かしてください。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಪ್ರತಿ ಸ್ಪೀಕರ್ ಏರುವ ಸ್ವರವನ್ನು ನುಡಿಸುತ್ತದೆ. ಸುತ್ತುಗಳ ನಡುವೆ ಮೈಕ್ರೊಫೋನ್ ಅನ್ನು ಮುಂದಿನ ಹೊಳೆಯುವ ಜಾಗಕ್ಕೆ ಸರಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 스피커가 올라가는 톤을 재생합니다. 라운드 사이에 마이크를 다음 빛나는 위치로 옮기세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഓരോ സ്പീക്കറും ഉയർന്നുപോകുന്ന ഒരു സ്വരം കേൾപ്പിക്കും. റൗണ്ടുകൾക്കിടയിൽ മൈക്രോഫോൺ അടുത്ത തിളങ്ങുന്ന സ്ഥലത്തേക്ക് നീക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रत्येक स्पीकर चढता सूर वाजवतो. फेऱ्यांच्या मध्ये मायक्रोफोन पुढच्या चमकणाऱ्या जागी हलवा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap pembesar suara memainkan nada yang meninggi. Antara pusingan, alihkan mikrofon ke titik bercahaya seterusnya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver høyttaler spiller en stigende tone. Mellom rundene flytter du mikrofonen til neste lysende punkt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke luidspreker speelt een stijgende toon. Zet de microfoon tussen de rondes op de volgende oplichtende plek."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਹਰ ਸਪੀਕਰ ਇੱਕ ਚੜ੍ਹਦੀ ਸੁਰ ਵਜਾਉਂਦਾ ਹੈ। ਗੇੜਾਂ ਦੇ ਵਿਚਕਾਰ ਮਾਈਕ੍ਰੋਫ਼ੋਨ ਨੂੰ ਅਗਲੀ ਚਮਕਦੀ ਥਾਂ 'ਤੇ ਲੈ ਜਾਓ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy głośnik gra narastający ton. Między rundami przenieś mikrofon w następny świecący punkt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada caixa toca um tom ascendente. Entre as rodadas, leve o microfone ao próximo ponto iluminado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada coluna toca um tom ascendente. Entre rondas, leve o microfone ao ponto iluminado seguinte."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiecare difuzor redă un ton ascendent. Între runde, mută microfonul pe următorul punct luminos."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje högtalare spelar en stigande ton. Mellan omgångarna flyttar du mikrofonen till nästa lysande plats."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kila spika hucheza sauti inayopanda. Kati ya mizunguko, hamisha maikrofoni hadi sehemu inayofuata inayong'aa."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒவ்வொரு ஸ்பீக்கரும் ஏறும் ஒலியை இசைக்கும். சுற்றுகளுக்கு இடையில் மைக்ரோஃபோனை அடுத்த ஒளிரும் இடத்துக்கு நகர்த்துங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రతి స్పీకర్ పైకి ఎక్కే స్వరాన్ని వినిపిస్తుంది. రౌండ్ల మధ్య మైక్రోఫోన్‌ను తదుపరి మెరుస్తున్న చోటుకు జరపండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลำโพงแต่ละตัวเล่นเสียงที่สูงขึ้นเรื่อยๆ ระหว่างแต่ละรอบ ให้ย้ายไมโครโฟนไปยังจุดเรืองแสงถัดไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her hoparlör yükselen bir ton çalar. Turlar arasında mikrofonu bir sonraki parlayan noktaya taşıyın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожен динамік відтворює висхідний тон. Між раундами переміщуйте мікрофон у наступну точку, що світиться."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہر اسپیکر ایک چڑھتا سُر بجاتا ہے۔ راؤنڈز کے درمیان مائیکروفون کو اگلی چمکتی جگہ پر لے جائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi loa phát một âm đi lên. Giữa các lượt, chuyển micro đến điểm sáng tiếp theo."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "每個揚聲器播放一段上升的音調。每輪之間，把咪高峰移到下一個發光的位置。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个扬声器播放一段上升的音调。每轮之间，把麦克风移到下一个发光的位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個揚聲器播放一段上升的音調。每輪之間，把麥克風移到下一個發光的位置。"
          }
        }
      }
    },
    "Music pauses. A quiet test plays first; the sweeps get only as loud as the microphone needs. Keep your amplifier at a comfortable level.": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ሙዚቃው ለአፍታ ይቆማል። መጀመሪያ ለስላሳ ሙከራ ይጫወታል፤ ስዊፖቹ ማይክሮፎኑ የሚፈልገውን ያህል ብቻ ይጮሃሉ። ማጉያዎን በሚመች ደረጃ ያቆዩ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتوقف الموسيقى مؤقتًا. يُعزف أولًا اختبار هادئ؛ ولا ترتفع المسحات إلا بقدر ما يحتاجه الميكروفون. أبقِ المضخّم على مستوى مريح."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "গান থেমে যায়। প্রথমে একটি মৃদু পরীক্ষা বাজে; সুইপ কেবল মাইক্রোফোনের যতটা দরকার ততটাই জোরে হয়। অ্যাম্প্লিফায়ার আরামদায়ক লেভেলে রাখুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hudba se pozastaví. Nejdřív hraje tichý test; rozmítání zesílí jen tolik, kolik mikrofon potřebuje. Nechte zesilovač na příjemné hlasitosti."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Musikken sættes på pause. Først spilles en stille test; sweepene bliver kun så kraftige, som mikrofonen kræver. Hold forstærkeren på et behageligt niveau."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Musik pausiert. Zuerst läuft ein leiser Test; die Sweeps werden nur so laut, wie das Mikrofon es braucht. Lass deinen Verstärker auf einer angenehmen Lautstärke."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η μουσική σταματά. Πρώτα παίζει ένα ήπιο τεστ· οι σαρώσεις δυναμώνουν μόνο όσο χρειάζεται το μικρόφωνο. Κρατήστε τον ενισχυτή σε άνετη ένταση."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La música se pausa. Primero suena una prueba suave; los barridos solo suben lo que el micrófono necesita. Deja el amplificador a un volumen cómodo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "موسیقی متوقف می‌شود. اول یک آزمون آرام پخش می‌شود؛ جاروب‌ها فقط به اندازه نیاز میکروفون بلند می‌شوند. آمپلی‌فایر را در سطحی راحت نگه دارید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Musiikki pysähtyy. Ensin soi hiljainen testi; pyyhkäisyt voimistuvat vain sen verran kuin mikrofoni tarvitsee. Pidä vahvistin mukavalla tasolla."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hihinto muna ang musika. Mahinang test ang unang tutugtog; lalakas lang ang mga sweep hanggang sa kailangan ng mikropono. Panatilihin ang amplifier sa komportableng lakas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La musique se met en pause. Un test discret passe d’abord ; les balayages ne montent qu’autant que le micro en a besoin. Gardez votre ampli à un volume confortable."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સંગીત અટકે છે. પહેલાં ધીમું પરીક્ષણ વાગે છે; સ્વીપ માત્ર માઇક્રોફોનને જોઈએ એટલા જ મોટા થાય છે. એમ્પ્લિફાયરને આરામદાયક લેવલ પર રાખો."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Waƙa tana tsayawa. Gwaji a hankali yana kunnawa da farko; sautuka masu hawa suna ƙara ƙarfi gwargwadon abin da makirufo ke bukata kawai. Bar amplifaya a matakin da ya dace."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המוזיקה נעצרת. קודם מתנגנת בדיקה שקטה; הסריקות מתחזקות רק כמה שהמיקרופון צריך. השאירו את המגבר בעוצמה נוחה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संगीत रुक जाता है। पहले एक धीमा टेस्ट बजता है; स्वीप सिर्फ़ उतनी तेज़ होती हैं जितनी माइक्रोफ़ोन को ज़रूरत है। एम्प्लिफ़ायर को आरामदायक लेवल पर रखें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A zene szünetel. Először egy halk teszt szól; a sweepek csak annyira hangosak, amennyire a mikrofonnak kell. Tartsd az erősítőt kellemes hangerőn."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Musik dijeda. Tes pelan diputar lebih dulu; sapuan hanya sekeras yang dibutuhkan mikrofon. Biarkan amplifier pada volume yang nyaman."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La musica va in pausa. Prima suona un test a basso volume; gli sweep salgono solo quanto serve al microfono. Tieni l’amplificatore a un volume comodo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音楽は一時停止します。最初に小さなテスト音が鳴り、スイープはマイクに必要な音量までしか大きくなりません。アンプは快適な音量のままにしてください。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸಂಗೀತ ನಿಲ್ಲುತ್ತದೆ. ಮೊದಲು ಮೆಲ್ಲನೆಯ ಪರೀಕ್ಷೆ ಕೇಳುತ್ತದೆ; ಸ್ವೀಪ್‌ಗಳು ಮೈಕ್ರೊಫೋನ್‌ಗೆ ಬೇಕಾದಷ್ಟು ಮಾತ್ರ ಜೋರಾಗುತ್ತವೆ. ಆಂಪ್ಲಿಫೈಯರ್ ಅನ್ನು ಆರಾಮದಾಯಕ ಲೆವೆಲ್‌ನಲ್ಲಿಡಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음악이 일시 정지됩니다. 먼저 작은 테스트가 재생되고, 스윕은 마이크에 필요한 만큼만 커집니다. 앰프는 편안한 음량으로 두세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സംഗീതം നിർത്തും. ആദ്യം ഒരു പതിഞ്ഞ ടെസ്റ്റ് കേൾക്കും; മൈക്രോഫോണിന് ആവശ്യമുള്ളത്ര മാത്രമേ സ്വീപ്പുകൾ ഉച്ചത്തിലാകൂ. ആംപ്ലിഫയർ സുഖകരമായ ലെവലിൽ വയ്ക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "संगीत थांबते. आधी एक हळू चाचणी वाजते; स्वीप फक्त मायक्रोफोनला लागेल तितक्याच मोठ्या होतात. अँप्लिफायर आरामदायक आवाजावर ठेवा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Muzik dijeda. Ujian perlahan dimainkan dahulu; sapuan hanya sekuat yang diperlukan mikrofon. Kekalkan amplifier pada aras yang selesa."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Musikken settes på pause. Først spilles en stille test; sveipene blir bare så sterke som mikrofonen trenger. Hold forsterkeren på et behagelig nivå."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De muziek pauzeert. Eerst klinkt een zachte test; de sweeps worden maar zo luid als de microfoon nodig heeft. Laat je versterker op een prettig volume."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸੰਗੀਤ ਰੁਕ ਜਾਂਦਾ ਹੈ। ਪਹਿਲਾਂ ਇੱਕ ਹੌਲੀ ਜਾਂਚ ਵੱਜਦੀ ਹੈ; ਸਵੀਪ ਸਿਰਫ਼ ਓਨੇ ਉੱਚੇ ਹੁੰਦੇ ਹਨ ਜਿੰਨੇ ਮਾਈਕ੍ਰੋਫ਼ੋਨ ਨੂੰ ਲੋੜ ਹੈ। ਐਂਪਲੀਫ਼ਾਇਰ ਨੂੰ ਆਰਾਮਦਾਇਕ ਲੈਵਲ 'ਤੇ ਰੱਖੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Muzyka się zatrzymuje. Najpierw gra cichy test; przemiatania są tylko tak głośne, jak potrzebuje mikrofon. Zostaw wzmacniacz na wygodnej głośności."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A música pausa. Primeiro toca um teste baixo; as varreduras só ficam tão altas quanto o microfone precisa. Mantenha o amplificador num volume confortável."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A música fica em pausa. Primeiro toca um teste baixo; os varrimentos só sobem o que o microfone precisa. Mantenha o amplificador num volume confortável."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Muzica se oprește. Mai întâi se aude un test încet; baleiajele cresc doar cât are nevoie microfonul. Ține amplificatorul la un volum confortabil."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Musiken pausas. Först spelas ett tyst test; svepen blir bara så starka som mikrofonen behöver. Låt förstärkaren stå på en behaglig nivå."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Muziki unasimama kwa muda. Jaribio tulivu hucheza kwanza; sauti zinazopanda hupaa tu kadiri maikrofoni inavyohitaji. Acha amplifaya kwenye kiwango kizuri."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இசை இடைநிறுத்தப்படும். முதலில் மெல்லிய சோதனை ஒலிக்கும்; ஸ்வீப்கள் மைக்ரோஃபோனுக்குத் தேவையான அளவு மட்டுமே சத்தமாகும். ஆம்ப்ளிஃபயரை வசதியான நிலையில் வையுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సంగీతం ఆగుతుంది. ముందుగా నెమ్మదైన పరీక్ష వినిపిస్తుంది; స్వీప్‌లు మైక్రోఫోన్‌కు అవసరమైనంత మాత్రమే గట్టిగా ఉంటాయి. యాంప్లిఫైయర్‌ను సౌకర్యవంతమైన లెవెల్‌లో ఉంచండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพลงจะหยุดชั่วคราว เสียงทดสอบเบาๆ จะเล่นก่อน และสวีปจะดังเท่าที่ไมโครโฟนต้องการเท่านั้น ตั้งแอมป์ไว้ที่ระดับเสียงที่สบาย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Müzik duraklar. Önce sessiz bir test çalar; taramalar yalnızca mikrofonun ihtiyacı kadar yükselir. Amfinizi rahat bir seviyede tutun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Музика стає на паузу. Спершу звучить тихий тест; розгортки гучнішають лише настільки, наскільки потрібно мікрофону. Тримайте підсилювач на комфортній гучності."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "موسیقی رک جاتی ہے۔ پہلے ایک دھیما ٹیسٹ بجتا ہے؛ سویپس صرف اتنی بلند ہوتی ہیں جتنی مائیکروفون کو ضرورت ہو۔ ایمپلیفائر کو آرام دہ سطح پر رکھیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhạc tạm dừng. Một bài thử nhỏ phát trước; tiếng quét chỉ to vừa đủ cho micro. Giữ ampli ở mức âm lượng dễ chịu."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "音樂會暫停。先播放一段輕柔的測試音；掃頻只會達到咪高峰所需的音量。請讓擴音機保持在舒適的音量。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音乐会暂停。先播放一段轻柔的测试音；扫频只会达到麦克风所需的音量。请让功放保持在舒适的音量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "音樂會暫停。先播放一段輕柔的測試音；掃頻只會達到麥克風所需的音量。請讓擴大機保持在舒適的音量。"
          }
        }
      }
    },
    "UMIK-1 on a stand at ear height where you sit, pointing straight up (use its 90° calibration file). Keep the room quiet.": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "UMIK-1ን በመቆሚያ ላይ በሚቀመጡበት ቦታ በጆሮ ከፍታ፣ በቀጥታ ወደ ላይ ያድርጉ (የ90° የመለኪያ ፋይሉን ይጠቀሙ)። ክፍሉን ጸጥ ያድርጉ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ضع UMIK-1 على حامل بمستوى الأذن حيث تجلس، موجّهًا إلى الأعلى مباشرة (استخدم ملف معايرة 90°). حافظ على هدوء الغرفة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "UMIK-1 একটি স্ট্যান্ডে আপনার আসনে কানের উচ্চতায় সোজা উপরের দিকে রাখুন (এর 90° ক্যালিব্রেশন ফাইল ব্যবহার করুন)। ঘর শান্ত রাখুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "UMIK-1 na stojanu ve výšce uší tam, kde sedíte, mířící přímo nahoru (použijte jeho kalibrační soubor 90°). Udržujte v místnosti ticho."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "UMIK-1 på et stativ i ørehøjde, hvor du sidder, pegende lige op (brug dens 90°-kalibreringsfil). Hold rummet stille."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "UMIK-1 auf einem Stativ in Ohrhöhe an deinem Platz, senkrecht nach oben gerichtet (nimm seine 90°-Kalibrierdatei). Halte den Raum ruhig."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "UMIK-1 σε βάση στο ύψος των αυτιών εκεί που κάθεστε, στραμμένο ευθεία προς τα πάνω (χρησιμοποιήστε το αρχείο βαθμονόμησης 90°). Κρατήστε τον χώρο ήσυχο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "UMIK-1 en un soporte a la altura del oído donde te sientas, apuntando hacia arriba (usa su archivo de calibración de 90°). Mantén la sala en silencio."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "UMIK-1 را روی پایه‌ای هم‌سطح گوش در جای نشستنتان، رو به بالا قرار دهید (از فایل کالیبراسیون ۹۰ درجه آن استفاده کنید). اتاق را ساکت نگه دارید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "UMIK-1 telineessä korvien korkeudella istumapaikallasi, suoraan ylöspäin (käytä sen 90°:n kalibrointitiedostoa). Pidä huone hiljaisena."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "UMIK-1 sa stand na kapantay ng tainga kung saan ka nakaupo, nakaturo nang diretso pataas (gamitin ang 90° na calibration file nito). Panatilihing tahimik ang kuwarto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "UMIK-1 sur un pied à hauteur d’oreille à votre place, pointé droit vers le haut (utilisez son fichier d’étalonnage 90°). Gardez la pièce silencieuse."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "UMIK-1 ને સ્ટેન્ડ પર તમારી બેઠક પર કાનની ઊંચાઈએ, સીધું ઉપર તરફ રાખો (તેની 90° કેલિબ્રેશન ફાઇલ વાપરો). રૂમ શાંત રાખો."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "UMIK-1 a kan tsayawa a tsayin kunne inda kake zama, yana nuna sama kai tsaye (yi amfani da fayil ɗin daidaitawarsa na 90°). Bar ɗakin shiru."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "UMIK-1 על מעמד בגובה האוזניים במקום שבו אתם יושבים, מופנה ישר למעלה (השתמשו בקובץ הכיול של 90°). שמרו על שקט בחדר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "UMIK-1 को स्टैंड पर अपनी सीट पर कान की ऊँचाई पर, सीधा ऊपर की ओर रखें (उसकी 90° कैलिब्रेशन फ़ाइल इस्तेमाल करें)। कमरे को शांत रखें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "UMIK-1 állványon, fülmagasságban ott, ahol ülsz, egyenesen felfelé irányítva (használd a 90°-os kalibrációs fájlját). Legyen csend a szobában."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "UMIK-1 di atas stand setinggi telinga di tempat Anda duduk, menghadap lurus ke atas (pakai file kalibrasi 90°-nya). Jaga ruangan tetap tenang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "UMIK-1 su un supporto all’altezza delle orecchie dove ti siedi, rivolto verso l’alto (usa il file di calibrazione a 90°). Tieni la stanza in silenzio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "UMIK-1 をスタンドに付け、座る位置の耳の高さで真上に向けます（90° のキャリブレーションファイルを使用）。部屋は静かにしてください。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "UMIK-1 ಅನ್ನು ಸ್ಟ್ಯಾಂಡ್ ಮೇಲೆ ನೀವು ಕೂರುವಲ್ಲಿ ಕಿವಿಯ ಎತ್ತರದಲ್ಲಿ, ನೇರವಾಗಿ ಮೇಲಕ್ಕೆ ಇಡಿ (ಅದರ 90° ಕ್ಯಾಲಿಬ್ರೇಶನ್ ಫೈಲ್ ಬಳಸಿ). ಕೋಣೆಯನ್ನು ಶಾಂತವಾಗಿಡಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "UMIK-1을 스탠드에 달아 앉는 자리의 귀 높이에서 위쪽을 똑바로 향하게 하세요(90° 보정 파일 사용). 방을 조용히 해 주세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "UMIK-1 ഒരു സ്റ്റാൻഡിൽ നിങ്ങൾ ഇരിക്കുന്നിടത്ത് ചെവിയുടെ ഉയരത്തിൽ, നേരെ മുകളിലേക്ക് വയ്ക്കുക (അതിന്റെ 90° കാലിബ്രേഷൻ ഫയൽ ഉപയോഗിക്കുക). മുറി ശാന്തമാക്കി വയ്ക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "UMIK-1 स्टँडवर तुमच्या जागी कानाच्या उंचीवर, सरळ वर तोंड करून ठेवा (त्याची 90° कॅलिब्रेशन फाइल वापरा). खोली शांत ठेवा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "UMIK-1 pada dirian setinggi telinga di tempat anda duduk, menghala lurus ke atas (gunakan fail penentukuran 90°nya). Pastikan bilik senyap."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "UMIK-1 på et stativ i ørehøyde der du sitter, rettet rett opp (bruk 90°-kalibreringsfilen). Hold rommet stille."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "UMIK-1 op een standaard op oorhoogte waar je zit, recht omhoog gericht (gebruik het 90°-kalibratiebestand). Houd de ruimte stil."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "UMIK-1 ਨੂੰ ਸਟੈਂਡ 'ਤੇ ਆਪਣੀ ਸੀਟ 'ਤੇ ਕੰਨ ਦੀ ਉਚਾਈ 'ਤੇ, ਸਿੱਧਾ ਉੱਪਰ ਵੱਲ ਰੱਖੋ (ਉਸਦੀ 90° ਕੈਲੀਬ੍ਰੇਸ਼ਨ ਫ਼ਾਈਲ ਵਰਤੋ)। ਕਮਰਾ ਸ਼ਾਂਤ ਰੱਖੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "UMIK-1 na statywie na wysokości uszu w miejscu, gdzie siedzisz, skierowany prosto w górę (użyj pliku kalibracji 90°). Zachowaj ciszę w pomieszczeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "UMIK-1 num pedestal na altura do ouvido onde você senta, apontado para cima (use o arquivo de calibração de 90°). Mantenha a sala em silêncio."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "UMIK-1 num tripé à altura dos ouvidos onde se senta, virado para cima (use o ficheiro de calibração de 90°). Mantenha a sala em silêncio."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "UMIK-1 pe un stativ la înălțimea urechilor, unde stai, îndreptat drept în sus (folosește fișierul lui de calibrare de 90°). Păstrează liniștea în cameră."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "UMIK-1 på ett stativ i öronhöjd där du sitter, riktad rakt uppåt (använd dess 90°-kalibreringsfil). Håll rummet tyst."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "UMIK-1 juu ya stendi kwenye usawa wa sikio unapoketi, ikielekea juu moja kwa moja (tumia faili yake ya urekebishaji ya 90°). Weka chumba kimya."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "UMIK-1-ஐ ஸ்டாண்டில் நீங்கள் அமரும் இடத்தில் காது உயரத்தில், நேராக மேல்நோக்கி வையுங்கள் (அதன் 90° அளவுத்திருத்தக் கோப்பைப் பயன்படுத்துங்கள்). அறையை அமைதியாக வையுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "UMIK-1ను స్టాండ్‌పై మీరు కూర్చునే చోట చెవి ఎత్తులో, నేరుగా పైకి ఉంచండి (దాని 90° కాలిబ్రేషన్ ఫైల్ వాడండి). గదిని నిశ్శబ్దంగా ఉంచండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ติด UMIK-1 บนขาตั้งที่ระดับหูตรงที่คุณนั่ง หันขึ้นตรงๆ (ใช้ไฟล์คาลิเบรต 90° ของมัน) ให้ห้องเงียบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "UMIK-1'i oturduğunuz yerde kulak hizasında bir sehpaya, dümdüz yukarı bakacak şekilde koyun (90° kalibrasyon dosyasını kullanın). Odayı sessiz tutun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "UMIK-1 на стійці на рівні вух там, де ви сидите, спрямований прямо вгору (використовуйте його файл калібрування 90°). Тримайте в кімнаті тишу."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "UMIK-1 کو اپنی نشست پر کان کی اونچائی پر اسٹینڈ پر، سیدھا اوپر کی طرف رکھیں (اس کی 90° کیلیبریشن فائل استعمال کریں)۔ کمرے کو خاموش رکھیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt UMIK-1 trên chân đế ngang tai tại chỗ bạn ngồi, hướng thẳng lên (dùng tệp hiệu chuẩn 90° của nó). Giữ phòng yên tĩnh."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "把 UMIK-1 裝在腳架上，放在你座位的耳朵高度，垂直向上（使用它的 90° 校準檔案）。保持房間安靜。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把 UMIK-1 装在支架上，放在你座位的耳朵高度，竖直朝上（使用它的 90° 校准文件）。保持房间安静。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把 UMIK-1 裝在腳架上，放在你座位的耳朵高度，垂直朝上（使用它的 90° 校準檔案）。保持房間安靜。"
          }
        }
      }
    },
    "macOS asks once whether Vespertine may use the microphone. Choose Allow; it only listens while a measurement runs.": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS Vespertine ማይክሮፎኑን መጠቀም ይችል እንደሆነ አንድ ጊዜ ይጠይቃል። ፍቀድን ይምረጡ፤ የሚያዳምጠው ልኬት ሲካሄድ ብቻ ነው።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسأل macOS مرة واحدة هل يمكن لـ Vespertine استخدام الميكروفون. اختر السماح؛ فهو لا يستمع إلا أثناء القياس."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS একবার জিজ্ঞেস করে Vespertine মাইক্রোফোন ব্যবহার করতে পারবে কিনা। অনুমতি দিন বেছে নিন; এটি শুধু পরিমাপ চলার সময় শোনে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS se jednou zeptá, zda Vespertine smí používat mikrofon. Zvolte Povolit; poslouchá jen během měření."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS spørger én gang, om Vespertine må bruge mikrofonen. Vælg Tillad; den lytter kun, mens en måling kører."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS fragt einmal, ob Vespertine das Mikrofon verwenden darf. Wähle Erlauben; es hört nur während einer Messung zu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το macOS ρωτά μία φορά αν το Vespertine μπορεί να χρησιμοποιεί το μικρόφωνο. Επιλέξτε «Να επιτρέπεται»· ακούει μόνο κατά τη μέτρηση."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS pregunta una vez si Vespertine puede usar el micrófono. Elige Permitir; solo escucha mientras dura una medición."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS یک بار می‌پرسد آیا Vespertine می‌تواند از میکروفون استفاده کند. «اجازه دادن» را انتخاب کنید؛ فقط هنگام اندازه‌گیری گوش می‌دهد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS kysyy kerran, saako Vespertine käyttää mikrofonia. Valitse Salli; se kuuntelee vain mittauksen aikana."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Minsang magtatanong ang macOS kung puwedeng gamitin ng Vespertine ang mikropono. Piliin ang Payagan; nakikinig lang ito habang may sinusukat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS demande une fois si Vespertine peut utiliser le micro. Choisissez Autoriser ; il n’écoute que pendant une mesure."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "Vespertine માઇક્રોફોન વાપરી શકે કે નહીં તે macOS એક વાર પૂછે છે. મંજૂરી આપો પસંદ કરો; તે માત્ર માપન દરમિયાન સાંભળે છે."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS yana tambaya sau ɗaya ko Vespertine zai iya amfani da makirufo. Zaɓi Ba da izini; yana sauraro ne kawai lokacin da ake auna."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS שואלת פעם אחת אם Vespertine רשאית להשתמש במיקרופון. בחרו ״התר״; היא מאזינה רק בזמן מדידה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS एक बार पूछता है कि क्या Vespertine माइक्रोफ़ोन इस्तेमाल कर सकता है। अनुमति दें चुनें; यह सिर्फ़ माप के दौरान सुनता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A macOS egyszer megkérdezi, használhatja-e a Vespertine a mikrofont. Válaszd az Engedélyezést; csak mérés közben figyel."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS bertanya sekali apakah Vespertine boleh memakai mikrofon. Pilih Izinkan; aplikasi hanya mendengarkan saat pengukuran berjalan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS chiede una volta se Vespertine può usare il microfono. Scegli Consenti; ascolta solo durante una misura."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS が一度だけ、Vespertine がマイクを使ってよいか尋ねます。「許可」を選んでください。測定中だけ音を聞きます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "Vespertine ಮೈಕ್ರೊಫೋನ್ ಬಳಸಬಹುದೇ ಎಂದು macOS ಒಮ್ಮೆ ಕೇಳುತ್ತದೆ. ಅನುಮತಿಸಿ ಆಯ್ಕೆಮಾಡಿ; ಅಳತೆ ನಡೆಯುವಾಗ ಮಾತ್ರ ಅದು ಕೇಳುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS가 Vespertine의 마이크 사용 여부를 한 번 묻습니다. 허용을 선택하세요. 측정하는 동안에만 듣습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Vespertine-ന് മൈക്രോഫോൺ ഉപയോഗിക്കാമോ എന്ന് macOS ഒരിക്കൽ ചോദിക്കും. അനുവദിക്കുക തിരഞ്ഞെടുക്കുക; അളവെടുക്കുമ്പോൾ മാത്രമേ അത് കേൾക്കൂ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vespertine मायक्रोफोन वापरू शकते का, हे macOS एकदा विचारते. परवानगी द्या निवडा; ते फक्त मापन चालू असताना ऐकते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS bertanya sekali sama ada Vespertine boleh menggunakan mikrofon. Pilih Benarkan; ia hanya mendengar semasa pengukuran berjalan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS spør én gang om Vespertine kan bruke mikrofonen. Velg Tillat; den lytter bare mens en måling pågår."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS vraagt één keer of Vespertine de microfoon mag gebruiken. Kies Sta toe; hij luistert alleen tijdens een meting."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS ਇੱਕ ਵਾਰ ਪੁੱਛਦਾ ਹੈ ਕਿ ਕੀ Vespertine ਮਾਈਕ੍ਰੋਫ਼ੋਨ ਵਰਤ ਸਕਦਾ ਹੈ। ਇਜਾਜ਼ਤ ਦਿਓ ਚੁਣੋ; ਇਹ ਸਿਰਫ਼ ਮਾਪ ਦੌਰਾਨ ਸੁਣਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS raz pyta, czy Vespertine może używać mikrofonu. Wybierz Zezwól; słucha tylko w trakcie pomiaru."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O macOS pergunta uma vez se o Vespertine pode usar o microfone. Escolha Permitir; ele só escuta durante uma medição."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O macOS pergunta uma vez se o Vespertine pode usar o microfone. Escolha Permitir; só escuta durante uma medição."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS întreabă o dată dacă Vespertine poate folosi microfonul. Alege Permite; ascultă doar cât durează o măsurare."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS frågar en gång om Vespertine får använda mikrofonen. Välj Tillåt; den lyssnar bara medan en mätning pågår."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS huuliza mara moja kama Vespertine inaweza kutumia maikrofoni. Chagua Ruhusu; husikiliza tu wakati kipimo kinaendelea."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Vespertine மைக்ரோஃபோனைப் பயன்படுத்தலாமா என்று macOS ஒருமுறை கேட்கும். அனுமதி என்பதைத் தேர்ந்தெடுங்கள்; அளவீடு நடக்கும்போது மட்டுமே அது கேட்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Vespertine మైక్రోఫోన్ వాడవచ్చా అని macOS ఒకసారి అడుగుతుంది. అనుమతించు ఎంచుకోండి; కొలత జరుగుతున్నప్పుడు మాత్రమే అది వింటుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS จะถามหนึ่งครั้งว่า Vespertine ใช้ไมโครโฟนได้หรือไม่ เลือกอนุญาต มันจะฟังเฉพาะระหว่างการวัดเท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS, Vespertine'in mikrofonu kullanıp kullanamayacağını bir kez sorar. İzin Ver'i seçin; yalnızca ölçüm sırasında dinler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS один раз запитує, чи може Vespertine використовувати мікрофон. Виберіть «Дозволити»; він слухає лише під час вимірювання."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS ایک بار پوچھتا ہے کہ کیا Vespertine مائیکروفون استعمال کر سکتا ہے۔ اجازت دیں چنیں؛ یہ صرف پیمائش کے دوران سنتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS hỏi một lần xem Vespertine có được dùng micro không. Chọn Cho phép; ứng dụng chỉ nghe khi đang đo."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 會詢問一次 Vespertine 可否使用咪高峰。請選擇「允許」；它只在量度時收音。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 会询问一次 Vespertine 能否使用麦克风。请选择“允许”；它只在测量时收音。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 會詢問一次 Vespertine 能否使用麥克風。請選擇「允許」；它只在量測時收音。"
          }
        }
      }
    },
    "A speaker in the file has too many filters. Vespertine runs up to %lld per speaker.": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "በፋይሉ ውስጥ ያለ አንድ ድምፅ ማጉያ በጣም ብዙ ማጣሪያዎች አሉት። Vespertine ለእያንዳንዱ ድምፅ ማጉያ እስከ %lld ድረስ ያሄዳል።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحتوي إحدى السماعات في الملف على عدد كبير جدًا من المرشحات. يشغّل Vespertine ما يصل إلى %lld لكل سماعة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফাইলের একটি স্পিকারে অনেক বেশি ফিল্টার আছে। Vespertine প্রতি স্পিকারে সর্বোচ্চ %lld-টি চালায়।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproduktor v souboru má příliš mnoho filtrů. Vespertine zpracuje nejvýše %lld na reproduktor."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En højttaler i filen har for mange filtre. Vespertine kører op til %lld pr. højttaler."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Lautsprecher in der Datei hat zu viele Filter. Vespertine verarbeitet bis zu %lld pro Lautsprecher."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένα ηχείο στο αρχείο έχει πάρα πολλά φίλτρα. Το Vespertine εφαρμόζει έως %lld ανά ηχείο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un altavoz del archivo tiene demasiados filtros. Vespertine admite hasta %lld por altavoz."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یکی از بلندگوهای فایل بیش از حد فیلتر دارد. Vespertine حداکثر %lld فیلتر برای هر بلندگو اجرا می‌کند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiedoston kaiuttimella on liikaa suodattimia. Vespertine käsittelee enintään %lld suodatinta kaiutinta kohden."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Masyadong maraming filter ang isang speaker sa file. Hanggang %lld bawat speaker lang ang pinapatakbo ng Vespertine."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un haut-parleur du fichier a trop de filtres. Vespertine en applique jusqu’à %lld par haut-parleur."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ફાઇલમાં એક સ્પીકર પાસે ઘણા વધારે ફિલ્ટર છે. Vespertine દરેક સ્પીકર માટે વધુમાં વધુ %lld ફિલ્ટર ચલાવે છે."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Wata lasifika a cikin fayil ɗin tana da matatu da yawa. Vespertine yana gudanar da har zuwa %lld ga kowace lasifika."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לאחד הרמקולים בקובץ יש יותר מדי מסננים. Vespertine מפעיל עד %lld מסננים לכל רמקול."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ाइल के एक स्पीकर में बहुत ज़्यादा फ़िल्टर हैं। Vespertine हर स्पीकर के लिए अधिकतम %lld फ़िल्टर चलाता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fájlban egy hangszórónak túl sok szűrője van. A Vespertine hangszórónként legfeljebb %lld szűrőt futtat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ada speaker dalam file yang memiliki terlalu banyak filter. Vespertine menjalankan hingga %lld filter per speaker."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un altoparlante nel file ha troppi filtri. Vespertine ne gestisce fino a %lld per altoparlante."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイル内のスピーカーのフィルタが多すぎます。Vespertineで使えるのはスピーカーあたり最大%lld個です。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಫೈಲ್‌ನಲ್ಲಿರುವ ಒಂದು ಸ್ಪೀಕರ್‌ಗೆ ತುಂಬಾ ಹೆಚ್ಚು ಫಿಲ್ಟರ್‌ಗಳಿವೆ. Vespertine ಪ್ರತಿ ಸ್ಪೀಕರ್‌ಗೆ ಗರಿಷ್ಠ %lld ಫಿಲ್ಟರ್‌ಗಳನ್ನು ಚಲಾಯಿಸುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일에 필터가 너무 많은 스피커가 있습니다. Vespertine은 스피커당 최대 %lld개까지 실행합니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഫയലിലെ ഒരു സ്പീക്കറിന് വളരെയധികം ഫിൽട്ടറുകളുണ്ട്. Vespertine ഓരോ സ്പീക്കറിനും പരമാവധി %lld എണ്ണം പ്രവർത്തിപ്പിക്കുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "फाइलमधील एका स्पीकरला खूप जास्त फिल्टर आहेत. Vespertine प्रत्येक स्पीकरसाठी जास्तीत जास्त %lld चालवते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu pembesar suara dalam fail mempunyai terlalu banyak penapis. Vespertine menjalankan sehingga %lld bagi setiap pembesar suara."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En høyttaler i filen har for mange filtre. Vespertine kjører opptil %lld per høyttaler."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een luidspreker in het bestand heeft te veel filters. Vespertine gebruikt er maximaal %lld per luidspreker."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਫ਼ਾਈਲ ਵਿੱਚ ਇੱਕ ਸਪੀਕਰ ਦੇ ਬਹੁਤ ਜ਼ਿਆਦਾ ਫ਼ਿਲਟਰ ਹਨ। Vespertine ਹਰੇਕ ਸਪੀਕਰ ਲਈ ਵੱਧ ਤੋਂ ਵੱਧ %lld ਚਲਾਉਂਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Głośnik w pliku ma za dużo filtrów. Vespertine obsługuje maksymalnie %lld na głośnik."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um alto-falante no arquivo tem filtros demais. O Vespertine executa até %lld por alto-falante."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Um altifalante no ficheiro tem demasiados filtros. O Vespertine executa até %lld por altifalante."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un difuzor din fișier are prea multe filtre. Vespertine rulează cel mult %lld pe difuzor."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En högtalare i filen har för många filter. Vespertine kör upp till %lld per högtalare."
          }
        },
        "sw": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Spika moja katika faili ina vichujio vingi mno. Vespertine huendesha hadi kichujio %lld kwa kila spika."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Spika moja katika faili ina vichujio vingi mno. Vespertine huendesha hadi vichujio %lld kwa kila spika."
                }

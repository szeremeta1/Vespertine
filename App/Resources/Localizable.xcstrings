        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಅದು ಸರ್ವರ್ ವಿಳಾಸದಂತೆ ಕಾಣುತ್ತಿಲ್ಲ. smb://server/share ಪ್ರಯತ್ನಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버 주소가 아닌 것 같습니다. smb://server/share 형식으로 입력해 보십시오."

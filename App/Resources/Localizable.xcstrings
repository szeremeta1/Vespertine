    "That doesn’t look like a server address. Try smb://server/share.": {
      "extractionState": "manual",
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ይህ የአገልጋይ አድራሻ አይመስልም። smb://server/share ይሞክሩ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يبدو هذا عنوان خادم. جرّب smb://server/share."

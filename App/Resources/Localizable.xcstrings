        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "DSD સ્રોતોમાં તપાસવા માટે PCM વર્ડ લેન્થ હોતી નથી."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Majiyoyin DSD ba su da zurfin bit na PCM da za a duba."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "למקורות DSD אין אורך מילה של PCM לבדיקה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "DSD स्रोतों में जाँचने के लिए कोई PCM वर्ड लेंथ नहीं होती।"
          }
        },
        "hu": {
          "stringUnit": {

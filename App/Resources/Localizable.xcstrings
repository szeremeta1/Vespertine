        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הגישה למיקרופון מוגבלת ב-Mac הזה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस Mac पर माइक्रोफ़ोन एक्सेस प्रतिबंधित है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A mikrofonhozzáférés korlátozva van ezen a Mac gépen."

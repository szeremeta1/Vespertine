    "%@ as virtual speakers · Apple spatial renderer, personalized profile if set up": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ እንደ ምናባዊ ድምፅ ማጉያዎች · የApple spatial ማቅረቢያ፣ ከተዘጋጀ የግል መገለጫ"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ كسماعات افتراضية · أداة العرض المكاني من Apple، مع الملف الشخصي المخصص إن كان مُعدًّا"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ভার্চুয়াল স্পিকার হিসেবে %@ · Apple স্পেশিয়াল রেন্ডারার, সেট আপ করা থাকলে ব্যক্তিগতকৃত প্রোফাইল"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ jako virtuální reproduktory · prostorový renderer Apple, osobní profil, je-li nastaven"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ som virtuelle højttalere · Apples renderer til rumlig lyd, personlig profil hvis indstillet"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ als virtuelle Lautsprecher · Apples 3D-Renderer, personalisiertes Profil, falls eingerichtet"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ως εικονικά ηχεία · μηχανισμός χωρικού ήχου της Apple, εξατομικευμένο προφίλ αν έχει ρυθμιστεί"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ como altavoces virtuales · renderizador espacial de Apple, con perfil personalizado si está configurado"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ به‌صورت بلندگوهای مجازی · رندرکنندهٔ فضایی Apple، با نمایهٔ شخصی‌سازی‌شده در صورت تنظیم"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ virtuaalisina kaiuttimina · Applen tilaäänirenderöijä, henkilökohtainen profiili, jos käytössä"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bilang mga virtual speaker · spatial renderer ng Apple, personalized profile kung naka-set up"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ en haut-parleurs virtuels · moteur spatial d’Apple, profil personnalisé s’il est configuré"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ વર્ચ્યુઅલ સ્પીકર તરીકે · Apple સ્પેશિયલ રેન્ડરર, સેટ કરેલી હોય તો વ્યક્તિગત પ્રોફાઇલ"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a matsayin lasifikoki na kama-da-wane · mai sarrafa Spatial Audio na Apple, bayanan ku na musamman idan an saita"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ כרמקולים וירטואליים · מעבד השמע המרחבי של Apple, פרופיל מותאם אישית אם הוגדר"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ वर्चुअल स्पीकर के रूप में · Apple स्पेशियल रेंडरर, सेट अप होने पर वैयक्तिकृत प्रोफ़ाइल"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ virtuális hangszórókként · Apple térhatású renderelő, személyre szabott profillal, ha be van állítva"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sebagai speaker virtual · perender spasial Apple, profil pribadi jika sudah diatur"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ come altoparlanti virtuali · renderer spaziale di Apple, profilo personalizzato se configurato"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@を仮想スピーカーとして配置 · Appleの空間レンダラ、設定済みの場合はパーソナライズされたプロファイル"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ವರ್ಚುವಲ್ ಸ್ಪೀಕರ್‌ಗಳಾಗಿ · Apple ಸ್ಪೇಷಿಯಲ್ ರೆಂಡರರ್, ಹೊಂದಿಸಿದ್ದರೆ ವೈಯಕ್ತೀಕರಿಸಿದ ಪ್ರೊಫೈಲ್"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@을(를) 가상 스피커로 배치 · Apple 공간 렌더러, 설정한 경우 개인 맞춤형 프로필"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ വെർച്വൽ സ്പീക്കറുകളായി · Apple സ്പേഷ്യൽ റെൻഡറർ, സജ്ജമാക്കിയിട്ടുണ്ടെങ്കിൽ വ്യക്തിഗത പ്രൊഫൈൽ"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ व्हर्च्युअल स्पीकर म्हणून · Apple स्पेशियल रेंडरर, सेट केलेले असल्यास वैयक्तिकृत प्रोफाइल"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sebagai pembesar suara maya · pemapar ruang Apple, profil diperibadikan jika disediakan"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ som virtuelle høyttalere · Apples renderer for romlig lyd, personlig profil hvis konfigurert"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ als virtuele luidsprekers · ruimtelijke renderer van Apple, persoonlijk profiel indien ingesteld"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ਵਰਚੁਅਲ ਸਪੀਕਰਾਂ ਵਜੋਂ · Apple ਸਪੇਸ਼ੀਅਲ ਰੈਂਡਰਰ, ਜੇ ਸੈੱਟ ਹੋਵੇ ਤਾਂ ਨਿੱਜੀ ਪ੍ਰੋਫ਼ਾਈਲ"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ jako wirtualne głośniki · renderer przestrzenny Apple, spersonalizowany profil, jeśli jest skonfigurowany"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ como alto-falantes virtuais · renderizador espacial da Apple, com perfil personalizado se configurado"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ como altifalantes virtuais · renderizador espacial da Apple, perfil personalizado se configurado"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ca difuzoare virtuale · motorul de randare spațial Apple, profil personalizat dacă este configurat"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ som virtuella högtalare · Apples rumsliga renderare, personlig profil om den är inställd"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kama spika pepe · kichakataji cha Spatial Audio cha Apple, wasifu binafsi ikiwa umewekwa"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ மெய்நிகர் ஸ்பீக்கர்களாக · Apple ஸ்பேஷியல் ரெண்டரர், அமைத்திருந்தால் தனிப்பயனாக்கிய சுயவிவரம்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ వర్చువల్ స్పీకర్‌లుగా · Apple స్పేషియల్ రెండరర్, సెటప్ చేసి ఉంటే వ్యక్తిగతీకరించిన ప్రొఫైల్"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ เป็นลำโพงเสมือน · ตัวเรนเดอร์เสียงตามตำแหน่งของ Apple ใช้โปรไฟล์เฉพาะบุคคลหากตั้งค่าไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sanal hoparlörler olarak %@ · Apple uzamsal işleyicisi, ayarlandıysa kişiselleştirilmiş profil"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ як віртуальні динаміки · просторовий рендерер Apple, персоналізований профіль, якщо налаштовано"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ بطور ورچوئل اسپیکرز · Apple اسپیشل رینڈرر، اگر سیٹ اپ ہو تو ذاتی پروفائل"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ dưới dạng loa ảo · trình kết xuất không gian của Apple, dùng hồ sơ cá nhân hóa nếu đã thiết lập"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 作為虛擬揚聲器 · Apple 空間渲染器，如已設定則使用個人化設定檔"

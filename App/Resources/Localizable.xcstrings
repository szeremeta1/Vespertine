            "state": "translated",
            "value": "የ%@ ፍሬሞች ሳይነኩ በIEC 61937 ቡርስቶች ውስጥ፤ ሪሲቨሩ ዲኮድ ያደርጋል"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إطارات %@ دون تعديل في حزم IEC 61937؛ يفك جهاز الاستقبال الترميز"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "IEC 61937 বার্স্টে %@ ফ্রেম অপরিবর্তিত; রিসিভার ডিকোড করে"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rámce %@ nedotčené v blocích IEC 61937; dekóduje receiver"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-frames uberørte i IEC 61937-bursts; receiveren afkoder"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-Frames unverändert in IEC 61937-Bursts; der Receiver dekodiert"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πλαίσια %@ ανέγγιχτα σε ριπές IEC 61937· αποκωδικοποιεί ο δέκτης"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tramas %@ intactas en ráfagas IEC 61937; el receptor decodifica"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فریم‌های %@ دست‌نخورده در بسته‌های IEC 61937؛ گیرنده رمزگشایی می‌کند"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-kehykset koskemattomina IEC 61937 -purskeissa; vastaanotin purkaa"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ frame na hindi ginalaw sa mga IEC 61937 burst; ang receiver ang nagde-decode"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trames %@ intactes dans des salves IEC 61937 ; l’amplificateur décode"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "IEC 61937 બર્સ્ટમાં %@ ફ્રેમ અકબંધ; રિસીવર ડીકોડ કરે છે"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Firam na %@ ba a taɓa su ba a cikin bursts na IEC 61937; risiva ce ke warwarewa"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פריימי %@ ללא שינוי בפרצי IEC 61937; המקלט מפענח"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ फ़्रेम IEC 61937 बर्स्ट में बिना बदलाव के; रिसीवर डिकोड करता है"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-keretek érintetlenül, IEC 61937 csomagokban; a vevőkészülék dekódol"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Frame %@ tidak diubah dalam burst IEC 61937; receiver yang mendekode"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Frame %@ intatti in burst IEC 61937; decodifica il ricevitore"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@フレームをIEC 61937バーストでそのまま送信。レシーバーがデコードします"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ಫ್ರೇಮ್‌ಗಳು IEC 61937 ಬರ್ಸ್ಟ್‌ಗಳಲ್ಲಿ ಬದಲಾಗದೆ; ರಿಸೀವರ್ ಡೀಕೋಡ್ ಮಾಡುತ್ತದೆ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 프레임을 IEC 61937 버스트로 그대로 전송, 리시버가 디코딩"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ഫ്രെയിമുകൾ IEC 61937 ബർസ്റ്റുകളിൽ മാറ്റമില്ലാതെ; റിസീവർ ഡീകോഡ് ചെയ്യുന്നു"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "IEC 61937 बर्स्टमध्ये %@ फ्रेम अपरिवर्तित; रिसीव्हर डीकोड करतो"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bingkai %@ tidak diusik dalam letusan IEC 61937; penerima yang menyahkod"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-rammer urørt i IEC 61937-pakker; receiveren dekoder"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-frames onaangetast in IEC 61937-bursts; de receiver decodeert"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ਫ਼੍ਰੇਮ IEC 61937 ਬਰਸਟਾਂ ਵਿੱਚ ਬਿਨਾਂ ਛੇੜੇ; ਰਿਸੀਵਰ ਡੀਕੋਡ ਕਰਦਾ ਹੈ"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ramki %@ nienaruszone w pakietach IEC 61937; dekoduje amplituner"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quadros %@ intactos em rajadas IEC 61937; o receiver decodifica"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Tramas %@ intactas em rajadas IEC 61937; o recetor descodifica"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cadre %@ neatinse în rafale IEC 61937; receiverul decodează"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ramar orörda i IEC 61937-paket; receivern avkodar"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Fremu za %@ hazijaguswa katika mipasuko ya IEC 61937; resiva inasimbua"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ஃபிரேம்கள் IEC 61937 பர்ஸ்ட்களில் மாற்றமின்றி; ரிசீவர் டிகோட் செய்யும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ఫ్రేమ్‌లు IEC 61937 బర్స్ట్‌లలో మార్పు లేకుండా; రిసీవర్ డీకోడ్ చేస్తుంది"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เฟรม %@ ไม่ถูกแตะต้องในชุดข้อมูล IEC 61937 เครื่องรับจะถอดรหัสเอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "IEC 61937 paketlerinde dokunulmamış %@ çerçeveleri; kodu alıcı çözer"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Аудіокадри %@ без змін у пакетах IEC 61937; декодує ресивер"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "IEC 61937 برسٹس میں بغیر تبدیلی کے %@ فریمز؛ ریسیور ڈی کوڈ کرتا ہے"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khung %@ được giữ nguyên trong các cụm IEC 61937; bộ thu AV sẽ giải mã"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 幀以 IEC 61937 突發封包原封不動傳送；由擴音機解碼"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 帧在 IEC 61937 突发数据中保持不变；由接收器解码"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 訊框在 IEC 61937 突發資料中保持不變；由擴大機解碼"
          }
        }
      }
    },

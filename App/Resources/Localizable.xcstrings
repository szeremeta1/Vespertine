    "Read-only location · saved in Vespertine's library; the files aren't changed": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ለንባብ ብቻ የሆነ አካባቢ · በVespertine ቤተ-መጻሕፍት ውስጥ ተቀምጧል፤ ፋይሎቹ አይቀየሩም"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "موقع للقراءة فقط · محفوظ في مكتبة Vespertine؛ لا تتغير الملفات"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুধু-পড়ার অবস্থান · Vespertine-এর লাইব্রেরিতে সংরক্ষিত; ফাইলগুলো পরিবর্তন হয় না"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Umístění pouze pro čtení · uloženo v knihovně Vespertine; soubory se nemění"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrivebeskyttet placering · gemmes i Vespertines bibliotek; filerne ændres ikke"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreibgeschützter Ort · in der Mediathek von Vespertine gesichert; die Dateien werden nicht verändert"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τοποθεσία μόνο για ανάγνωση · αποθηκεύεται στη βιβλιοθήκη του Vespertine· τα αρχεία δεν αλλάζουν"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ubicación de solo lectura · se guarda en la biblioteca de Vespertine; los archivos no se modifican"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مکان فقط‌خواندنی · در کتابخانهٔ Vespertine ذخیره می‌شود؛ فایل‌ها تغییر نمی‌کنند"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vain luku -sijainti · tallennetaan Vespertinen kirjastoon; tiedostoja ei muuteta"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Read-only na lokasyon · naka-save sa library ng Vespertine; hindi binabago ang mga file"

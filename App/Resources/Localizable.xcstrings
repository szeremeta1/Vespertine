        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "DoP necesită o ieșire exclusivă, transparentă la nivel de bit"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "DoP kräver exklusiv, bittransparent utgång"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "DoP inahitaji utoaji wa kipekee unaopitisha biti bila kuzibadilisha"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "DoP-க்குப் பிரத்தியேகமான, பிட்-வெளிப்படையான வெளியீடு தேவை"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "DoPకి ప్రత్యేక, బిట్-ట్రాన్స్‌పరెంట్ అవుట్‌పుట్ అవసరం"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",

        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ക്യാപ്ചറുകൾ സേവ് ചെയ്തു, പക്ഷേ പ്രതികരണങ്ങൾ കണക്കാക്കാൻ കഴിഞ്ഞില്ല"

    "Bluetooth re-encodes audio with a lossy codec, so the output can't be bit-perfect.": {
      "extractionState": "manual",
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth ድምፅን ኪሳራ ባለው ኮዴክ እንደገና ኢንኮድ ያደርጋል፣ ስለዚህ ውፅዓቱ ቢት-ፍጹም ሊሆን አይችልም።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعيد Bluetooth ترميز الصوت بترميز مع فقد، لذا لا يمكن أن يكون المخرج مطابقًا للبتات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth একটি লসি কোডেক দিয়ে অডিও আবার এনকোড করে, তাই আউটপুট বিট-পারফেক্ট হতে পারে না।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth překóduje zvuk ztrátovým kodekem, takže výstup nemůže být bit-perfect."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth omkoder lyden med en tabsgivende codec, så outputtet kan ikke være bitperfekt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth kodiert Audio mit einem verlustbehafteten Codec neu, daher kann die Ausgabe nicht bit-perfekt sein."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Bluetooth επανακωδικοποιεί τον ήχο με codec με απώλειες, οπότε η έξοδος δεν μπορεί να είναι bit-perfect."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth re-encodes audio with a lossy codec, so the output can't be bit-perfect."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth vuelve a codificar el audio con un códec con pérdida, así que la salida no puede ser bit-perfect."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بلوتوث صدا را با یک کدک بااتلاف دوباره رمزگذاری می‌کند، بنابراین خروجی نمی‌تواند بیت‌به‌بیت باشد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth koodaa äänen uudelleen häviöllisellä koodekilla, joten ulostulo ei voi olla bittitarkka."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ine-encode muli ng Bluetooth ang audio gamit ang lossy na codec, kaya hindi maaaring maging bit-perfect ang output."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Bluetooth réencode l’audio avec un codec avec perte : la sortie ne peut donc pas être bit-perfect."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth ઑડિયોને લૉસી કોડેક વડે ફરી એન્કોડ કરે છે, તેથી આઉટપુટ બિટ-પરફેક્ટ હોઈ શકતું નથી."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth yana sake rufa sauti da codec mai asara, don haka fitarwa ba za ta iya zama bit-perfect ba."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth מקודד מחדש את השמע בקודק מאבד נתונים, ולכן הפלט אינו יכול להיות מדויק לסיבית."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth ऑडियो को एक लॉसी कोडेक से फिर से एन्कोड करता है, इसलिए आउटपुट बिट-परफ़ेक्ट नहीं हो सकता।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Bluetooth veszteséges kodekkel újrakódolja a hangot, így a kimenet nem lehet bit-perfect."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth meng-encode ulang audio dengan codec lossy, sehingga output tidak dapat bit-perfect."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il Bluetooth ricodifica l’audio con un codec lossy, quindi l’uscita non può essere bit-perfect."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetoothはオーディオをロッシーのコーデックで再エンコードするため、出力はビットパーフェクトにはなりません。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth ಆಡಿಯೋವನ್ನು ಲಾಸಿ ಕೋಡೆಕ್‌ನೊಂದಿಗೆ ಮರು-ಎನ್‌ಕೋಡ್ ಮಾಡುತ್ತದೆ, ಆದ್ದರಿಂದ ಔಟ್‌ಪುಟ್ ಬಿಟ್-ಪರ್ಫೆಕ್ಟ್ ಆಗಿರಲು ಸಾಧ್ಯವಿಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth는 오디오를 손실 코덱으로 다시 인코딩하므로 출력이 비트 퍼펙트가 될 수 없습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth ഒരു ലോസി കോഡെക് ഉപയോഗിച്ച് ഓഡിയോ വീണ്ടും എൻകോഡ് ചെയ്യുന്നു, അതിനാൽ ഔട്ട്‌പുട്ട് ബിറ്റ്-പെർഫെക്റ്റ് ആകില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth लॉसी कोडेकने ऑडिओ पुन्हा एन्कोड करते, त्यामुळे आउटपुट बिट-परफेक्ट असू शकत नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth mengekod semula audio dengan codec berkehilangan, jadi output tidak boleh bit-perfect."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth koder lyden på nytt med en tapsbasert kodek, så utgangen kan ikke være bitperfekt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth codeert audio opnieuw met een lossy codec, dus de uitvoer kan niet bitperfect zijn."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth ਆਡੀਓ ਨੂੰ ਇੱਕ ਲੌਸੀ ਕੋਡੇਕ ਨਾਲ ਦੁਬਾਰਾ ਐਨਕੋਡ ਕਰਦਾ ਹੈ, ਇਸ ਲਈ ਆਉਟਪੁੱਟ ਬਿੱਟ-ਪਰਫ਼ੈਕਟ ਨਹੀਂ ਹੋ ਸਕਦਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth ponownie koduje dźwięk stratnym kodekiem, więc wyjście nie może być bit-perfect."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Bluetooth recodifica o áudio com um codec com perdas, então a saída não pode ser bit-perfect."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Bluetooth volta a codificar o áudio com um codec com perdas, por isso a saída não pode ser bit-perfect."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth recodifică audio cu un codec cu pierderi, așa că ieșirea nu poate fi bit-perfect."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth kodar om ljudet med en codec med förlust, så utgången kan inte vara bitperfekt."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth husimba sauti upya kwa kodeki yenye upotevu, kwa hivyo sauti inayotoka haiwezi kuwa bit-perfect."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth ஆடியோவை இழப்புள்ள கோடெக் மூலம் மீண்டும் என்கோட் செய்கிறது, எனவே வெளியீடு பிட்-பெர்ஃபெக்டாக இருக்க முடியாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth ఆడియోను లాసీ కోడెక్‌తో మళ్లీ ఎన్‌కోడ్ చేస్తుంది, కాబట్టి అవుట్‌పుట్ బిట్-పర్ఫెక్ట్‌గా ఉండదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth เข้ารหัสเสียงใหม่ด้วยโคเดกแบบสูญเสียข้อมูล ขาออกจึงไม่สามารถเป็นบิตเพอร์เฟกต์ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth sesi kayıplı bir codec ile yeniden kodlar; bu yüzden çıkış bit-perfect olamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth перекодовує аудіо кодеком із втратами, тож вихід не може бути біт-у-біт."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بلوٹوتھ آڈیو کو لاسی کوڈیک سے دوبارہ انکوڈ کرتا ہے، اس لیے آؤٹ پٹ بٹ پرفیکٹ نہیں ہو سکتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth mã hóa lại âm thanh bằng codec có tổn hao, vì vậy đầu ra không thể bit-perfect."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "藍牙會以有損編解碼器重新編碼音訊，因此輸出無法做到位元完美。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "蓝牙会使用有损编解码器重新编码音频，因此输出无法做到比特完美。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "藍牙會使用有損編解碼器重新編碼音訊，因此輸出無法達到位元完美。"
          }
        }
      }
    },

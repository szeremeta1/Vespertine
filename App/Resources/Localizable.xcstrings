    "Head tracking and personalized profile as set in Control Center": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "የራስ እንቅስቃሴ ክትትልና የግል መገለጫ በControl Center እንደተዘጋጀው"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتبع حركة الرأس والملف الشخصي المخصص كما هو مضبوط في مركز التحكم"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কন্ট্রোল সেন্টারে সেট করা হেড ট্র্যাকিং ও ব্যক্তিগতকৃত প্রোফাইল"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sledování hlavy a osobní profil podle nastavení v Ovládacím centru"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hovedsporing og personlig profil som indstillet i Kontrolcenter"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopfbewegungserkennung und personalisiertes Profil wie im Kontrollzentrum eingestellt"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Παρακολούθηση κεφαλής και εξατομικευμένο προφίλ όπως έχουν ρυθμιστεί στο Κέντρο ελέγχου"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seguimiento de la cabeza y perfil personalizado según el centro de control"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ردیابی سر و نمایهٔ شخصی‌سازی‌شده طبق تنظیم در مرکز کنترل"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pään seuranta ja henkilökohtainen profiili Ohjauskeskuksen asetusten mukaan"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Head tracking at personalized profile ayon sa itinakda sa Control Center"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suivi de la tête et profil personnalisé selon le Centre de contrôle"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "Control Center માં સેટ કર્યા મુજબ હેડ ટ્રૅકિંગ અને વ્યક્તિગત પ્રોફાઇલ"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Bin motsin kai da bayanan ku na musamman kamar yadda aka saita a Control Center"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מעקב אחר תנועות הראש ופרופיל מותאם אישית כפי שהוגדרו במרכז הבקרה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कंट्रोल सेंटर में सेट की गई हेड ट्रैकिंग और वैयक्तिकृत प्रोफ़ाइल"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Fejkövetés és személyre szabott profil a Vezérlőközpont beállításai szerint"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelacakan kepala dan profil pribadi sesuai pengaturan di Pusat Kontrol"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rilevamento della testa e profilo personalizzato come impostati in Centro di Controllo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヘッドトラッキングとパーソナライズされたプロファイルはコントロールセンターの設定に従います"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಕಂಟ್ರೋಲ್ ಸೆಂಟರ್‌ನಲ್ಲಿ ಹೊಂದಿಸಿದಂತೆ ಹೆಡ್ ಟ್ರ್ಯಾಕಿಂಗ್ ಮತ್ತು ವೈಯಕ್ತೀಕರಿಸಿದ ಪ್ರೊಫೈಲ್"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "머리 추적 및 개인 맞춤형 프로필은 제어 센터 설정을 따름"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കൺട്രോൾ സെന്ററിൽ സജ്ജമാക്കിയതുപോലെ ഹെഡ് ട്രാക്കിംഗും വ്യക്തിഗത പ്രൊഫൈലും"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Control Center मध्ये सेट केल्याप्रमाणे हेड ट्रॅकिंग आणि वैयक्तिकृत प्रोफाइल"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Penjejakan kepala dan profil diperibadikan seperti yang ditetapkan dalam Pusat Kawalan"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hodesporing og personlig profil som innstilt i Kontrollsenter"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoofdtracking en persoonlijk profiel zoals ingesteld in het bedieningspaneel"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਹੈੱਡ ਟ੍ਰੈਕਿੰਗ ਅਤੇ ਨਿੱਜੀ ਪ੍ਰੋਫ਼ਾਈਲ, ਜਿਵੇਂ ਕੰਟਰੋਲ ਸੈਂਟਰ ਵਿੱਚ ਸੈੱਟ ਹੈ"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Śledzenie ruchów głowy i spersonalizowany profil zgodnie z ustawieniami w Centrum sterowania"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Rastreamento de cabeça e perfil personalizado conforme definidos na Central de Controle"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Seguimento da cabeça e perfil personalizado conforme definido na central de controlo"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Urmărirea capului și profilul personalizat conform setărilor din Centrul de control"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Huvudspårning och personlig profil enligt inställningen i Kontrollcenter"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ufuatiliaji wa kichwa na wasifu binafsi kama ilivyowekwa katika Control Center"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கட்டுப்பாட்டு மையத்தில் அமைத்தபடி தலை கண்காணிப்பும் தனிப்பயனாக்கிய சுயவிவரமும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కంట్రోల్ సెంటర్‌లో సెట్ చేసినట్లుగా హెడ్ ట్రాకింగ్, వ్యక్తిగతీకరించిన ప్రొఫైల్"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การติดตามศีรษะและโปรไฟล์เฉพาะบุคคลตามที่ตั้งไว้ในศูนย์ควบคุม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Denetim Merkezi’nde ayarlandığı şekilde baş takibi ve kişiselleştirilmiş profil"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відстеження рухів голови й персоналізований профіль — як налаштовано в Центрі керування"
          }
        },
        "ur": {
          "stringUnit": {

    "Follows the song before without a gap": {
      "comment": "Up Next, VoiceOver: this song joins the one before it gaplessly.",
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ቀዳሚውን ዘፈን ያለክፍተት ይከተላል"

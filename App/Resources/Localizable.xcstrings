    "Line %lld uses a filter type Vespertine doesn't have (%@). Peak, shelf, low-pass and high-pass filters are supported.": {
      "comment": "The filter type is a code from the file, e.g. “BP”.",
      "extractionState": "manual",
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "መስመር %lld Vespertine የሌለውን የማጣሪያ አይነት ይጠቀማል (%@)። ፒክ፣ ሼልፍ፣ ሎው-ፓስ እና ሃይ-ፓስ ማጣሪያዎች ይደገፋሉ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم السطر %1$lld نوع مرشح غير متوفر في Vespertine (%2$@). المرشحات المدعومة: الذروة والرف والتمرير المنخفض والتمرير المرتفع."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লাইন %1$lld এমন একটি ফিল্টার প্রকার ব্যবহার করে যা Vespertine-এ নেই (%2$@)। পিক, শেলফ, লো-পাস ও হাই-পাস ফিল্টার সমর্থিত।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Řádek %lld používá typ filtru, který Vespertine nemá (%@). Podporovány jsou filtry typu špička, šelf, dolní propust a horní propust."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Linje %lld bruger en filtertype, som Vespertine ikke har (%@). Top-, shelf-, lavpas- og højpasfiltre understøttes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeile %lld verwendet einen Filtertyp, den Vespertine nicht kennt (%@). Peak-, Shelf-, Tiefpass- und Hochpassfilter werden unterstützt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η γραμμή %lld χρησιμοποιεί τύπο φίλτρου που δεν διαθέτει το Vespertine (%@). Υποστηρίζονται φίλτρα κορυφής, shelf, βαθυπερατά και υψιπερατά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Line %lld uses a filter type Vespertine doesn't have (%@). Peak, shelf, low-pass and high-pass filters are supported."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La línea %lld usa un tipo de filtro que Vespertine no tiene (%@). Se admiten filtros de pico, shelf, paso bajo y paso alto."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "خط %lld از نوع فیلتری استفاده می‌کند که Vespertine ندارد (%@). فیلترهای قله، قفسه، پایین‌گذر و بالاگذر پشتیبانی می‌شوند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Rivillä %lld on suodintyyppi, jota Vespertinessä ei ole (%@). Huippu-, hylly-, alipäästö- ja ylipäästösuotimet ovat tuettuja."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Gumagamit ang linya %lld ng uri ng filter na wala sa Vespertine (%@). Sinusuportahan ang mga peak, shelf, low-pass at high-pass na filter."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La ligne %lld utilise un type de filtre que Vespertine ne propose pas (%@). Les filtres en crête, plateau, passe-bas et passe-haut sont pris en charge."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "લાઇન %lld એવો ફિલ્ટર પ્રકાર વાપરે છે જે Vespertine પાસે નથી (%@). પીક, શેલ્ફ, લો-પાસ અને હાઇ-પાસ ફિલ્ટર સપોર્ટેડ છે."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Layi %lld yana amfani da nau'in matata da Vespertine ba shi da shi (%@). Ana goyon bayan matatun peak, shelf, low-pass da high-pass."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שורה %1$lld משתמשת בסוג מסנן ש־Vespertine אינו תומך בו (%2$@). נתמכים מסנני שיא, מדף, מעביר נמוכים ומעביר גבוהים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पंक्ति %1$lld में ऐसे फ़िल्टर प्रकार का उपयोग है जो Vespertine में नहीं है (%2$@)। पीक, शेल्फ़, लो-पास और हाई-पास फ़िल्टर समर्थित हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fájl %lld. sora olyan szűrőtípust használ, amely a Vespertine-ben nincs meg (%@). A csúcs-, polc-, aluláteresztő és felüláteresztő szűrők támogatottak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Baris %lld menggunakan jenis filter yang tidak dimiliki Vespertine (%@). Filter peak, shelf, low-pass, dan high-pass didukung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La riga %lld usa un tipo di filtro che Vespertine non ha (%@). Sono supportati filtri peak, shelf, passa-basso e passa-alto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld行目は、Vespertineにないフィルタタイプ（%@）を使用しています。ピーク、シェルフ、ローパス、ハイパスの各フィルタに対応しています。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸಾಲು %lld Vespertine ನಲ್ಲಿ ಇಲ್ಲದ ಫಿಲ್ಟರ್ ಪ್ರಕಾರವನ್ನು (%@) ಬಳಸುತ್ತದೆ. ಪೀಕ್, ಶೆಲ್ಫ್, ಲೋ-ಪಾಸ್ ಮತ್ತು ಹೈ-ಪಾಸ್ ಫಿಲ್ಟರ್‌ಗಳು ಬೆಂಬಲಿತವಾಗಿವೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld번째 줄에서 Vespertine이 지원하지 않는 필터 유형(%@)을 사용합니다. 피크, 셸프, 로우패스 및 하이패스 필터가 지원됩니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld-ാം വരി Vespertine-ൽ ഇല്ലാത്ത ഒരു ഫിൽട്ടർ തരം (%@) ഉപയോഗിക്കുന്നു. പീക്ക്, ഷെൽഫ്, ലോ-പാസ്, ഹൈ-പാസ് ഫിൽട്ടറുകൾ പിന്തുണയ്ക്കുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ओळ %lld मध्ये Vespertine कडे नसलेला फिल्टर प्रकार वापरला आहे (%@). पीक, शेल्फ, लो-पास आणि हाय-पास फिल्टर समर्थित आहेत."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Baris %lld menggunakan jenis penapis yang tiada dalam Vespertine (%@). Penapis puncak, rak, laluan rendah dan laluan tinggi disokong."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Linje %lld bruker en filtertype Vespertine ikke har (%@). Topp-, shelf-, lavpass- og høypassfiltre støttes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Regel %lld gebruikt een filtertype dat Vespertine niet kent (%@). Piek-, shelf-, laagdoorlaat- en hoogdoorlaatfilters worden ondersteund."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਲਾਈਨ %1$lld ਇੱਕ ਅਜਿਹੀ ਫ਼ਿਲਟਰ ਕਿਸਮ ਵਰਤਦੀ ਹੈ ਜੋ Vespertine ਵਿੱਚ ਨਹੀਂ ਹੈ (%2$@)। ਪੀਕ, ਸ਼ੈਲਫ਼, ਲੋ-ਪਾਸ ਅਤੇ ਹਾਈ-ਪਾਸ ਫ਼ਿਲਟਰ ਸਮਰਥਿਤ ਹਨ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiersz %lld używa typu filtra, którego Vespertine nie obsługuje (%@). Obsługiwane są filtry szczytowe, półkowe, dolnoprzepustowe i górnoprzepustowe."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A linha %lld usa um tipo de filtro que o Vespertine não tem (%@). São aceitos filtros de pico, shelf, passa-baixa e passa-alta."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A linha %lld usa um tipo de filtro que o Vespertine não tem (%@). São suportados filtros de pico, prateleira, passa-baixo e passa-alto."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Linia %lld folosește un tip de filtru pe care Vespertine nu îl are (%@). Sunt acceptate filtrele de vârf, raft, trece-jos și trece-sus."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rad %lld använder en filtertyp som Vespertine inte har (%@). Topp-, shelving-, lågpass- och högpassfilter stöds."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Mstari %lld unatumia aina ya kichujio ambayo Vespertine haina (%@). Vichujio vya peak, shelf, low-pass na high-pass vinatumika."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வரி %1$lld, Vespertine-இல் இல்லாத வடிப்பான் வகையைப் பயன்படுத்துகிறது (%2$@). பீக், ஷெல்ஃப், லோ-பாஸ் மற்றும் ஹை-பாஸ் வடிப்பான்கள் ஆதரிக்கப்படுகின்றன."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "లైన్ %lld, Vespertineలో లేని ఫిల్టర్ రకాన్ని (%@) ఉపయోగిస్తుంది. పీక్, షెల్ఫ్, లో-పాస్, హై-పాస్ ఫిల్టర్‌లకు సపోర్ట్ ఉంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บรรทัดที่ %lld ใช้ชนิดฟิลเตอร์ที่ Vespertine ไม่มี (%@) รองรับฟิลเตอร์แบบพีก เชลฟ์ โลว์พาส และไฮพาส"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld. satır, Vespertine’de olmayan bir filtre türü kullanıyor (%@). Tepe, raf, alçak geçiren ve yüksek geçiren filtreler desteklenir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рядок %lld використовує тип фільтра, якого немає у Vespertine (%@). Підтримуються пікові, полицеві, низькочастотні й високочастотні фільтри."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "لائن %lld ایسی فلٹر قسم استعمال کرتی ہے جو Vespertine میں نہیں (%@)۔ پیک، شیلف، لو پاس اور ہائی پاس فلٹرز معاون ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dòng %lld dùng loại bộ lọc mà Vespertine không có (%@). Hỗ trợ các bộ lọc đỉnh, shelf, thông thấp và thông cao."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "第 %lld 行使用了 Vespertine 不支援的濾波器類型（%@）。支援峰值、擱架、低通和高通濾波器。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第 %lld 行使用了 Vespertine 不支持的滤波器类型（%@）。支持峰值、搁架、低通和高通滤波器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "第 %lld 行使用了 Vespertine 不支援的濾波器類型（%@）。支援峰值、架式、低通和高通濾波器。"
          }
        }
      }
    },

        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Importálás: szűrők REW-ből vagy más eszközből, Equalizer APO-szövegként vagy impulzusválaszként (WAV, AIFF, CAF, FLAC)."

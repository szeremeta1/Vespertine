        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hakuna kilichoingizwa: nakala zinahitaji %@ na Mac ina nafasi ya %@ iliyo wazi (Vespertine huacha %@ kama akiba). Pata nafasi zaidi, au tumia Ongeza Folda ili kucheza muziki pale ulipo."
          }

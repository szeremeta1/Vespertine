    "This file changed after the last tag edit. Undo was stopped to preserve the newer file; its earlier backup is still available.": {
      "extractionState": "manual",
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ይህ ፋይል ከመጨረሻው የመለያ ማስተካከያ በኋላ ተቀይሯል። አዲሱን ፋይል ለመጠበቅ መቀልበስ ቆሟል፤ ቀዳሚው ምትኬው አሁንም ይገኛል።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيّر هذا الملف بعد آخر تعديل للعلامات. تم إيقاف التراجع للحفاظ على الملف الأحدث؛ ولا تزال نسخته الاحتياطية السابقة متاحة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শেষ ট্যাগ সম্পাদনার পরে এই ফাইলটি বদলেছে। নতুন ফাইলটি রক্ষা করতে আগের অবস্থায় ফেরানো বন্ধ করা হয়েছে; এর আগের ব্যাকআপ এখনো পাওয়া যাবে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento soubor se po poslední úpravě tagů změnil. Vrácení bylo zastaveno, aby se zachoval novější soubor; jeho dřívější záloha je stále k dispozici."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne fil er ændret efter den seneste mærkeændring. Fortryd blev stoppet for at bevare den nyere fil; dens tidligere sikkerhedskopi er stadig tilgængelig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Datei wurde nach der letzten Tag-Bearbeitung geändert. Das Widerrufen wurde gestoppt, um die neuere Datei zu erhalten; ihr früheres Backup ist weiterhin verfügbar."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό το αρχείο άλλαξε μετά την τελευταία επεξεργασία ετικετών. Η αναίρεση διακόπηκε για να διατηρηθεί το νεότερο αρχείο· το προηγούμενο αντίγραφο ασφαλείας του είναι ακόμη διαθέσιμο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file changed after the last tag edit. Undo was stopped to preserve the newer file; its earlier backup is still available."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este archivo ha cambiado después de la última edición de etiquetas. Se ha detenido la opción de deshacer para conservar el archivo más reciente; su copia de seguridad anterior sigue disponible."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این فایل پس از آخرین ویرایش برچسب تغییر کرده است. واگرد برای حفظ فایل جدیدتر متوقف شد؛ پشتیبان قبلی آن همچنان در دسترس است."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä tiedosto on muuttunut viimeisimmän tagimuokkauksen jälkeen. Peruminen pysäytettiin uudemman tiedoston säilyttämiseksi; sen aiempi varmuuskopio on yhä käytettävissä."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagbago ang file na ito pagkatapos ng huling pag-edit ng tag. Inihinto ang pag-undo para mapanatili ang mas bagong file; available pa rin ang mas naunang backup nito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fichier a été modifié après la dernière modification des tags. L’annulation a été interrompue pour préserver le fichier plus récent ; sa sauvegarde antérieure reste disponible."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "છેલ્લા ટૅગ સંપાદન પછી આ ફાઇલ બદલાઈ છે. નવી ફાઇલ જાળવવા પૂર્વવત્ કરવાનું રોક્યું; તેનો અગાઉનો બૅકઅપ હજી ઉપલબ્ધ છે."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Wannan fayil ya canza bayan gyaran alamomi na ƙarshe. An dakatar da sokewa don kiyaye sabon fayil ɗin; tsohuwar ajiyarsa har yanzu tana nan."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קובץ זה השתנה לאחר עריכת התגיות האחרונה. הביטול הופסק כדי לשמור על הקובץ החדש יותר; הגיבוי הקודם שלו עדיין זמין."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पिछले टैग संपादन के बाद यह फ़ाइल बदल गई है। नई फ़ाइल को सुरक्षित रखने के लिए पहले जैसा करना रोक दिया गया; इसका पिछला बैकअप अब भी उपलब्ध है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a fájl a legutóbbi címkeszerkesztés óta megváltozott. A visszavonás leállt, hogy az újabb fájl megmaradjon; a korábbi biztonsági mentése továbbra is elérhető."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "File ini berubah setelah pengeditan tag terakhir. Pembatalan dihentikan untuk mempertahankan file yang lebih baru; cadangan sebelumnya masih tersedia."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo file è cambiato dopo l’ultima modifica dei tag. L’annullamento è stato interrotto per preservare il file più recente; il backup precedente è ancora disponibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルは最後のタグ編集のあとに変更されています。新しいファイルを保護するため、取り消しは中止されました。以前のバックアップは引き続き利用できます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಕೊನೆಯ ಟ್ಯಾಗ್ ಎಡಿಟ್‌ನ ನಂತರ ಈ ಫೈಲ್ ಬದಲಾಗಿದೆ. ಹೊಸ ಫೈಲ್ ಅನ್ನು ಸಂರಕ್ಷಿಸಲು ರದ್ದುಗೊಳಿಸುವಿಕೆಯನ್ನು ನಿಲ್ಲಿಸಲಾಗಿದೆ; ಅದರ ಹಿಂದಿನ ಬ್ಯಾಕಪ್ ಈಗಲೂ ಲಭ್ಯವಿದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마지막 태그 편집 이후에 이 파일이 변경되었습니다. 새로운 파일을 보존하기 위해 실행 취소가 중단되었습니다. 이전 백업은 계속 사용할 수 있습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അവസാന ടാഗ് എഡിറ്റിനുശേഷം ഈ ഫയൽ മാറി. പുതിയ ഫയൽ സംരക്ഷിക്കാൻ പഴയപടിയാക്കൽ നിർത്തി; അതിന്റെ മുമ്പത്തെ ബാക്കപ്പ് ഇപ്പോഴും ലഭ്യമാണ്."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "शेवटच्या टॅग संपादनानंतर ही फाइल बदलली. नवीन फाइल जपण्यासाठी पूर्ववत करणे थांबवले; तिचा आधीचा बॅकअप अजूनही उपलब्ध आहे."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Fail ini berubah selepas suntingan tag terakhir. Buat asal dihentikan untuk mengekalkan fail yang lebih baharu; sandaran awalnya masih tersedia."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne filen er endret etter forrige taggendring. Angring ble stoppet for å bevare den nyere filen; den tidligere sikkerhetskopien er fortsatt tilgjengelig."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit bestand is gewijzigd na de laatste tagwijziging. Herstellen is gestopt om het nieuwere bestand te behouden; de eerdere reservekopie is nog beschikbaar."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਪਿਛਲੀ ਟੈਗ ਸੋਧ ਤੋਂ ਬਾਅਦ ਇਹ ਫ਼ਾਈਲ ਬਦਲ ਗਈ। ਨਵੀਂ ਫ਼ਾਈਲ ਨੂੰ ਬਚਾਉਣ ਲਈ ਵਾਪਸ ਲੈਣਾ ਰੋਕ ਦਿੱਤਾ ਗਿਆ; ਇਸਦਾ ਪਹਿਲਾਂ ਵਾਲਾ ਬੈਕਅੱਪ ਹਾਲੇ ਵੀ ਉਪਲਬਧ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten plik zmienił się po ostatniej edycji tagów. Cofanie zostało zatrzymane, aby zachować nowszy plik; jego wcześniejsza kopia zapasowa jest nadal dostępna."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este arquivo mudou após a última edição de etiquetas. O desfazer foi interrompido para preservar o arquivo mais recente; o backup anterior dele continua disponível."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Este ficheiro foi alterado depois da última edição de etiquetas. A anulação foi interrompida para preservar o ficheiro mais recente; a cópia de segurança anterior continua disponível."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest fișier s-a modificat după ultima editare a etichetelor. Anularea a fost oprită pentru a păstra fișierul mai nou; copia de rezervă anterioară este încă disponibilă."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Filen ändrades efter den senaste taggredigeringen. Ångra stoppades för att bevara den nyare filen; dess tidigare säkerhetskopia finns fortfarande kvar."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Faili hii ilibadilika baada ya uhariri wa mwisho wa tagi. Kutendua kulisimamishwa ili kuhifadhi faili mpya zaidi; nakala rudufu yake ya awali bado inapatikana."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கடைசி டேக் திருத்தத்திற்குப் பிறகு இந்தக் கோப்பு மாறியுள்ளது. புதிய கோப்பைப் பாதுகாக்க செயல்தவிர்ப்பு நிறுத்தப்பட்டது; அதன் முந்தைய காப்புப் பிரதி இன்னும் கிடைக்கிறது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "చివరి ట్యాగ్ సవరణ తర్వాత ఈ ఫైల్ మారింది. కొత్త ఫైల్‌ను కాపాడటానికి అన్‌డూ ఆపివేయబడింది; దాని మునుపటి బ్యాకప్ ఇప్పటికీ అందుబాటులో ఉంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟล์นี้เปลี่ยนแปลงหลังการแก้ไขแท็กครั้งล่าสุด จึงหยุดการเลิกทำเพื่อรักษาไฟล์ที่ใหม่กว่า ข้อมูลสำรองก่อนหน้ายังคงใช้ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu dosya son etiket düzenlemesinden sonra değişti. Daha yeni dosyayı korumak için geri alma durduruldu; önceki yedeği hâlâ kullanılabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей файл змінився після останнього редагування тегів. Скасування зупинено, щоб зберегти новішу версію файлу; попередня резервна копія досі доступна."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آخری ٹیگ ترمیم کے بعد یہ فائل تبدیل ہوئی۔ نئی فائل محفوظ رکھنے کے لیے واپس لینا روک دیا گیا؛ اس کا پچھلا بیک اپ اب بھی دستیاب ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tệp này đã thay đổi sau lần sửa thẻ gần nhất. Đã dừng hoàn tác để giữ nguyên tệp mới hơn; bản sao lưu trước đó của tệp vẫn còn."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "此檔案在上次編輯標籤後已被更改。為保留較新的檔案，已停止還原；其較早的備份仍然可用。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此文件在上次标签编辑后发生了更改。为保护较新的文件，已停止撤销；它之前的备份仍然可用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此檔案在上次標籤編輯後已有變更。為保護較新的檔案，已停止還原；它先前的備份仍可使用。"
          }
        }
      }
    },
    "This folder contains an existing library source (%@). Add non-overlapping folders to preserve track and playlist ownership.": {
      "extractionState": "manual",
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ይህ አቃፊ ያለ የቤተ-መጻሕፍት ምንጭ (%@) ይዟል። የትራኮችንና የአጫዋች ዝርዝሮችን ባለቤትነት ለመጠበቅ የማይደራረቡ አቃፊዎችን ያክሉ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتوي هذا المجلد على مصدر مكتبة موجود (%@). أضف مجلدات غير متداخلة للحفاظ على ملكية المقطوعات وقوائم التشغيل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ফোল্ডারে একটি বিদ্যমান লাইব্রেরি উৎস (%@) আছে। ট্র্যাক ও প্লেলিস্টের মালিকানা অক্ষুণ্ণ রাখতে এমন ফোল্ডার যোগ করুন যেগুলো একটি আরেকটির মধ্যে পড়ে না।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tato složka obsahuje existující zdroj knihovny (%@). Přidávejte složky, které se nepřekrývají, aby zůstalo zachováno přiřazení skladeb a playlistů."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne mappe indeholder en eksisterende bibliotekskilde (%@). Tilføj mapper, der ikke overlapper, så numre og spillelister bevarer deres tilhørsforhold."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Ordner enthält eine vorhandene Mediathekquelle (%@). Füge Ordner hinzu, die sich nicht überschneiden, damit die Zuordnung von Titeln und Playlists erhalten bleibt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτός ο φάκελος περιέχει μια υπάρχουσα πηγή βιβλιοθήκης (%@). Προσθέστε φακέλους που δεν επικαλύπτονται, ώστε να διατηρηθεί η αντιστοίχιση κομματιών και λιστών αναπαραγωγής."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This folder contains an existing library source (%@). Add non-overlapping folders to preserve track and playlist ownership."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta carpeta contiene una fuente de biblioteca existente (%@). Añade carpetas que no se solapen para conservar a qué fuente pertenecen las pistas y las listas de reproducción."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این پوشه شامل یک منبع کتابخانهٔ موجود است (%@). برای حفظ مالکیت قطعه‌ها و فهرست‌های پخش، پوشه‌هایی بدون هم‌پوشانی اضافه کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä kansio sisältää olemassa olevan kirjastolähteen (%@). Lisää kansioita, jotka eivät mene päällekkäin, jotta raitojen ja soittolistojen omistus säilyy."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "May kasalukuyang source ng library sa folder na ito (%@). Magdagdag ng mga folder na hindi nagsasapawan para mapanatili kung kanino nabibilang ang mga track at playlist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce dossier contient une source de bibliothèque existante (%@). Ajoutez des dossiers qui ne se chevauchent pas, afin de préserver l’appartenance des morceaux et des playlists."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ ફોલ્ડરમાં હાલનો લાઇબ્રેરી સ્રોત છે (%@). ટ્રૅક અને પ્લેલિસ્ટની માલિકી જાળવવા એકબીજા પર ન આવતાં ફોલ્ડર ઉમેરો."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Wannan folda tana ɗauke da majiyar laburare da ke akwai (%@). Ƙara foldojin da ba su haɗu ba don kiyaye mallakar waƙoƙi da jerin waƙoƙi."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תיקייה זו מכילה מקור ספריה קיים (%@). הוסף תיקיות שאינן חופפות כדי לשמור על שיוך הרצועות ורשימות ההשמעה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस फ़ोल्डर में एक मौजूदा लाइब्रेरी स्रोत (%@) है। ट्रैक और प्लेलिस्ट का स्वामित्व बनाए रखने के लिए ऐसे फ़ोल्डर जोड़ें जो एक-दूसरे में शामिल न हों।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a mappa egy meglévő könyvtárforrást tartalmaz (%@). Egymással át nem fedő mappákat adjon hozzá, hogy a számok és lejátszási listák hozzárendelése megmaradjon."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Folder ini berisi sumber perpustakaan yang sudah ada (%@). Tambahkan folder yang tidak tumpang tindih untuk mempertahankan kepemilikan trek dan daftar putar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa cartella contiene una sorgente di libreria esistente (%@). Aggiungi cartelle che non si sovrappongano, per preservare l’appartenenza di brani e playlist."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このフォルダには既存のライブラリソース（%@）が含まれています。トラックとプレイリストの所属を保つため、重複しないフォルダを追加してください。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಫೋಲ್ಡರ್‌ನಲ್ಲಿ ಈಗಾಗಲೇ ಲೈಬ್ರರಿ ಮೂಲ (%@) ಇದೆ. ಟ್ರ್ಯಾಕ್ ಮತ್ತು ಪ್ಲೇಲಿಸ್ಟ್ ಮಾಲೀಕತ್ವವನ್ನು ಉಳಿಸಲು ಒಂದರೊಳಗೊಂದು ಬಾರದ ಫೋಲ್ಡರ್‌ಗಳನ್ನು ಸೇರಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 폴더에는 기존 보관함 소스(%@)가 포함되어 있습니다. 트랙과 플레이리스트의 소속을 유지하려면 겹치지 않는 폴더를 추가하십시오."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ ഫോൾഡറിൽ നിലവിലുള്ള ഒരു ലൈബ്രറി ഉറവിടം (%@) അടങ്ങിയിരിക്കുന്നു. ട്രാക്കുകളുടെയും പ്ലേലിസ്റ്റുകളുടെയും ഉടമസ്ഥത നിലനിർത്താൻ പരസ്പരം ഓവർലാപ്പ് ചെയ്യാത്ത ഫോൾഡറുകൾ ചേർക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या फोल्डरमध्ये विद्यमान लायब्ररी स्रोत आहे (%@). ट्रॅक आणि प्लेलिस्टची मालकी जपण्यासाठी एकमेकांवर न येणारे फोल्डर जोडा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Folder ini mengandungi sumber pustaka sedia ada (%@). Tambah folder yang tidak bertindih untuk mengekalkan pemilikan trek dan senarai main."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne mappen inneholder en eksisterende bibliotekkilde (%@). Legg til mapper som ikke overlapper, slik at spor og spillelister beholder tilhørigheten sin."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze map bevat een bestaande bibliotheekbron (%@). Voeg mappen toe die niet overlappen, zodat het eigendom van nummers en playlists behouden blijft."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ ਫ਼ੋਲਡਰ ਵਿੱਚ ਇੱਕ ਮੌਜੂਦਾ ਲਾਇਬ੍ਰੇਰੀ ਸਰੋਤ (%@) ਹੈ। ਟਰੈਕਾਂ ਅਤੇ ਪਲੇਲਿਸਟਾਂ ਦੀ ਮਲਕੀਅਤ ਬਰਕਰਾਰ ਰੱਖਣ ਲਈ ਅਜਿਹੇ ਫ਼ੋਲਡਰ ਜੋੜੋ ਜੋ ਇੱਕ-ਦੂਜੇ ਵਿੱਚ ਨਾ ਆਉਂਦੇ ਹੋਣ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten folder zawiera istniejące źródło biblioteki (%@). Dodawaj foldery, które się nie nakładają, aby zachować przynależność utworów i playlist."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta pasta contém uma fonte de biblioteca existente (%@). Adicione pastas que não se sobreponham para preservar a que fonte pertencem as faixas e as playlists."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta pasta contém uma origem de biblioteca existente (%@). Adicione pastas que não se sobreponham para preservar a pertença das faixas e playlists."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest dosar conține o sursă de bibliotecă existentă (%@). Adăugați dosare care nu se suprapun pentru a păstra apartenența pieselor și a playlisturilor."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här mappen innehåller en befintlig bibliotekskälla (%@). Lägg till mappar som inte överlappar för att behålla vilka spår och spellistor som hör till vilken källa."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Folda hii ina chanzo cha maktaba kilichopo (%@). Ongeza folda zisizoingiliana ili kuhifadhi umiliki wa nyimbo na orodha za nyimbo."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தக் கோப்புறையில் ஏற்கெனவே ஒரு லைப்ரரி மூலம் (%@) உள்ளது. டிராக் மற்றும் பிளேலிஸ்ட் உரிமையைப் பாதுகாக்க, ஒன்றோடொன்று மேலெழாத கோப்புறைகளைச் சேர்க்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ ఫోల్డర్‌లో ఇప్పటికే ఉన్న లైబ్రరీ మూలం (%@) ఉంది. ట్రాక్, ప్లేలిస్ట్ యాజమాన్యాన్ని కాపాడటానికి ఒకదానితో ఒకటి కలవని ఫోల్డర్‌లను జోడించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โฟลเดอร์นี้มีแหล่งที่มาของคลังที่มีอยู่แล้ว (%@) เพิ่มโฟลเดอร์ที่ไม่ซ้อนทับกันเพื่อรักษาความเป็นเจ้าของแทร็กและเพลย์ลิสต์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu klasör mevcut bir arşiv kaynağı içeriyor (%@). Parça ve çalma listesi sahipliğini korumak için örtüşmeyen klasörler ekleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця папка містить наявне джерело медіатеки (%@). Додавайте папки, що не перетинаються, щоб зберегти належність треків і плейлистів."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس فولڈر میں ایک موجودہ لائبریری ماخذ ہے (%@)۔ ٹریکس اور پلے لسٹس کی ملکیت برقرار رکھنے کے لیے ایسے فولڈرز شامل کریں جو ایک دوسرے سے نہ ٹکرائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thư mục này chứa một nguồn thư viện hiện có (%@). Hãy thêm các thư mục không chồng lấn để giữ nguyên quyền sở hữu bản nhạc và danh sách phát."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "此資料夾包含現有的資料庫來源（%@）。請加入不重疊的資料夾，以保留曲目和播放列表的歸屬。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此文件夹包含现有的资料库来源（%@）。请添加互不重叠的文件夹，以保留曲目和播放列表的归属。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此檔案夾包含現有的資料庫來源（%@）。請加入互不重疊的檔案夾，以保留曲目和播放列表的歸屬。"
          }
        }
      }
    },
    "This format came back bit-exact through %@ on %@. Checks Vespertine's software, not this device.": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ይህ ቅርጸት በ%@ በኩል ቢት በቢት ትክክል ሆኖ ተመልሷል (%@)። የሚፈትሸው የVespertineን ሶፍትዌር ነው እንጂ ይህን መሣሪያ አይደለም።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",

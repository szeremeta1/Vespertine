    "the VOBs end before the cells the IFO lists (a truncated copy)": {
      "comment": "Part of “This DVD-Video is damaged (…).”",
      "extractionState": "manual",
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "VOBዎቹ IFO ከሚዘረዝራቸው ሴሎች በፊት ያበቃሉ (የተቆረጠ ቅጂ)"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنتهي ملفات VOB قبل الخلايا التي يسردها IFO (نسخة مقتطعة)"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "IFO যে সেলগুলোর তালিকা দেয় তার আগেই VOB-গুলো শেষ হয়ে যায় (একটি অসম্পূর্ণ কপি)"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "soubory VOB končí před buňkami, které uvádí IFO (zkrácená kopie)"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "VOB-filerne slutter før de celler, IFO-filen angiver (en afkortet kopi)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "die VOBs enden vor den Zellen, die die IFO aufführt (eine abgeschnittene Kopie)"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "τα VOB τελειώνουν πριν από τα κελιά που αναφέρει το IFO (περικομμένο αντίγραφο)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "the VOBs end before the cells the IFO lists (a truncated copy)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "los VOB terminan antes de las celdas que indica el IFO (una copia truncada)"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فایل‌های VOB پیش از سلول‌هایی که IFO فهرست می‌کند تمام می‌شوند (یک نسخهٔ ناقص)"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "VOB-tiedostot päättyvät ennen IFO:n luettelemia soluja (katkaistu kopio)"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "nagtatapos ang mga VOB bago ang mga cell na nakalista sa IFO (isang putol na kopya)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "les VOB se terminent avant les cellules listées par l’IFO (une copie tronquée)"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "IFO જે સેલની યાદી આપે છે તે પહેલાં VOB પૂરી થઈ જાય છે (કપાયેલી કૉપિ)"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "VOB sun ƙare kafin sel da IFO ya lissafa (kwafi da ya yanke)"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קובצי ה־VOB מסתיימים לפני התאים ש־IFO מפרט (עותק קטוע)"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "IFO जिन सेल की सूची देता है, उनसे पहले ही VOB ख़त्म हो जाती हैं (एक अधूरी कॉपी)"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "a VOB-fájlok az IFO által felsorolt cellák előtt véget érnek (csonka másolat)"

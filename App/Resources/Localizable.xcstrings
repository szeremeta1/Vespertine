    "Fade out and in (the output changes format)": {
      "comment": "Signal path, next transition: the next song needs another sample rate or channel count, so the song fades out, the output is set up again, and the next one fades in.",
      "extractionState": "manual",
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ደብዝዞ ይወጣል እና ይገባል (ውጤቱ ቅርጸት ይቀይራል)"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تلاشٍ للخارج ثم للداخل (يتغيّر تنسيق الإخراج)"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফেড আউট ও ফেড ইন (আউটপুটের ফরম্যাট বদলায়)"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeslabení a zesílení (výstup mění formát)"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fader ud og ind (outputtet skifter format)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus- und Einblenden (die Ausgabe wechselt das Format)"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σβήσιμο και εμφάνιση (η έξοδος αλλάζει μορφή)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fundido de salida y de entrada (la salida cambia de formato)"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "محوشدن و ظاهرشدن (قالب خروجی عوض می‌شود)"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Häivytys pois ja sisään (lähdön muoto vaihtuu)"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Fade out at fade in (nagbabago ng format ang output)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fondu de sortie puis d’entrée (la sortie change de format)"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ફેડ આઉટ અને ફેડ ઇન (આઉટપુટનું ફોર્મેટ બદલાય છે)"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ragewa da ƙarawa (tsarin fitarwa yana canzawa)"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "דעיכה ועלייה (הפלט מחליף פורמט)"
          }
        },
        "hi": {

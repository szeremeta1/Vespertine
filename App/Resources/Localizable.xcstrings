    "Virtual track; edits stay in the library": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ምናባዊ ትራክ፤ ማስተካከያዎች በቤተ-መጻሕፍቱ ውስጥ ይቆያሉ"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مقطوعة افتراضية؛ تبقى التعديلات في المكتبة"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ভার্চুয়াল ট্র্যাক; সম্পাদনা লাইব্রেরিতেই থাকে"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Virtuální skladba; úpravy zůstávají v knihovně"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Virtuelt nummer; ændringer forbliver i biblioteket"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Virtueller Titel; Änderungen bleiben in der Mediathek"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εικονικό κομμάτι· οι αλλαγές μένουν στη βιβλιοθήκη"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pista virtual; las ediciones se quedan en la biblioteca"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "قطعهٔ مجازی؛ ویرایش‌ها در کتابخانه می‌مانند"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Virtuaalinen raita; muutokset pysyvät kirjastossa"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Virtual track; nananatili sa library ang mga pag-edit"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Piste virtuelle ; les modifications restent dans la bibliothèque"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "વર્ચ્યુઅલ ટ્રૅક; સંપાદનો લાઇબ્રેરીમાં જ રહે છે"

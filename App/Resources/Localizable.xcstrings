    "Output device: %@ plays while %@ isn’t connected": {
      "comment": "Tooltip. Both are audio output device names: the first plays in place of the second.",
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "የውፅዓት መሣሪያ፦ %2$@ ስላልተገናኘ %1$@ እያጫወተ ነው"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جهاز الإخراج: %@ يعمل ما دام %@ غير متصل"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আউটপুট ডিভাইস: %2$@ সংযুক্ত না থাকায় %1$@ চলছে"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Výstupní zařízení: %@ hraje místo nepřipojeného zařízení %@"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Outputenhed: %@ spiller, mens %@ ikke er forbundet"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgabegerät: %@ spielt, solange %@ nicht verbunden ist"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συσκευή εξόδου: %@ αντί για %@ (μη συνδεδεμένη)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dispositivo de salida: %@ reproduce mientras %@ no está conectado"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دستگاه خروجی: تا وقتی %2$@ وصل نیست، %1$@ پخش می‌کند"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ulostulolaite: %@ toistaa niin kauan kuin %@ ei ole yhdistetty"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Output device: nagpe-play ang %1$@ habang hindi nakakonekta ang %2$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Périphérique de sortie : %@ joue tant que %@ n’est pas connecté"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આઉટપુટ ડિવાઇસ: %2$@ કનેક્ટ ન હોવાથી %1$@ વાગી રહ્યું છે"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Na'urar fitar da sauti: %1$@ yana kunnawa yayin da ba a haɗa %2$@ ba"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התקן פלט: %@ מנגן כל עוד %@ אינו מחובר"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आउटपुट डिवाइस: %2$@ कनेक्ट न होने तक %1$@ चल रहा है"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimeneti eszköz: %@ játszik, amíg %@ nincs csatlakoztatva"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perangkat output: %1$@ memutar selama %2$@ tidak terhubung"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dispositivo di uscita: %@ riproduce mentre %@ non è connesso"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "出力デバイス: %@（%@が未接続のため代わりに再生中）"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಔಟ್‌ಪುಟ್ ಸಾಧನ: %2$@ ಸಂಪರ್ಕಗೊಂಡಿಲ್ಲದ ಕಾರಣ %1$@ ಪ್ಲೇ ಆಗುತ್ತಿದೆ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",

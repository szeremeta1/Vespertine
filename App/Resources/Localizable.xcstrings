    "DSD sources don't have a PCM word length to check.": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "የDSD ምንጮች የሚፈተሽ የPCM የቢት ጥልቀት የላቸውም።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تملك مصادر DSD طول كلمة PCM للتحقق منه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "DSD উৎসে যাচাই করার মতো কোনো PCM ওয়ার্ড লেংথ নেই।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdroje DSD nemají délku slova PCM, kterou by šlo zkontrolovat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "DSD-kilder har ingen PCM-ordlængde at kontrollere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "DSD-Quellen haben keine PCM-Wortbreite, die geprüft werden könnte."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι πηγές DSD δεν έχουν μήκος λέξης PCM για έλεγχο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fuentes DSD no tienen una longitud de palabra PCM que comprobar."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "منابع DSD طول واژهٔ PCM برای بررسی ندارند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "DSD-lähteillä ei ole tarkistettavaa PCM-sanapituutta."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang PCM word length na masusuri ang mga DSD source."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sources DSD n’ont pas de longueur de mot PCM à vérifier."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "DSD સ્રોતોમાં તપાસવા માટે PCM વર્ડ લેન્થ હોતી નથી."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Majiyoyin DSD ba su da zurfin bit na PCM da za a duba."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "למקורות DSD אין אורך מילה של PCM לבדיקה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "DSD स्रोतों में जाँचने के लिए कोई PCM वर्ड लेंथ नहीं होती।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A DSD-forrásoknak nincs ellenőrizhető PCM-szóhossza."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sumber DSD tidak memiliki panjang kata PCM untuk diperiksa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le sorgenti DSD non hanno una lunghezza di parola PCM da controllare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "DSDソースには、確認すべきPCMのワード長がありません。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "DSD ಮೂಲಗಳಿಗೆ ಪರಿಶೀಲಿಸಲು PCM ವರ್ಡ್ ಲೆಂಗ್ತ್ ಇರುವುದಿಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "DSD 소스에는 확인할 PCM 워드 길이가 없습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "DSD ഉറവിടങ്ങൾക്ക് പരിശോധിക്കാൻ PCM വേഡ് ലെങ്ത് ഇല്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "DSD स्रोतांना तपासण्यासाठी PCM वर्ड लेंथ नसते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sumber DSD tidak mempunyai panjang perkataan PCM untuk disemak."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "DSD-kilder har ingen PCM-ordlengde å sjekke."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "DSD-bronnen hebben geen PCM-woordlengte om te controleren."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "DSD ਸਰੋਤਾਂ ਵਿੱਚ ਜਾਂਚਣ ਲਈ ਕੋਈ PCM ਵਰਡ ਲੈਂਥ ਨਹੀਂ ਹੁੰਦੀ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Źródła DSD nie mają długości słowa PCM do sprawdzenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fontes DSD não têm um comprimento de palavra PCM para verificar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As origens DSD não têm um comprimento de palavra PCM para verificar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sursele DSD nu au o lungime de cuvânt PCM de verificat."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "DSD-källor har ingen PCM-ordlängd att kontrollera."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyanzo vya DSD havina urefu wa neno wa PCM wa kukagua."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "DSD மூலங்களில் சரிபார்க்க PCM வேர்டு நீளம் இல்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "DSD మూలాలకు తనిఖీ చేయడానికి PCM వర్డ్ లెంగ్త్ ఉండదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แหล่งที่มา DSD ไม่มีความยาวเวิร์ด PCM ให้ตรวจสอบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "DSD kaynaklarında denetlenecek bir PCM sözcük uzunluğu yoktur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Джерела DSD не мають розрядності PCM, яку можна перевірити."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "DSD ماخذات میں جانچنے کے لیے PCM ورڈ لینتھ نہیں ہوتی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nguồn DSD không có độ dài từ PCM để kiểm tra."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "DSD 音源沒有可檢查的 PCM 字長。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "DSD 来源没有可供检查的 PCM 字长。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "DSD 來源沒有可供檢查的 PCM 字長。"

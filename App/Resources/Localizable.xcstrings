        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "અહીં બધું એકસરખું છે: ફિલ્ટર કરવા જેવું કંઈ નથી."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",

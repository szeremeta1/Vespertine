    "In the signal now: the status reads ROOM CORRECTION.": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "አሁን በምልክቱ ውስጥ፦ ሁኔታው የክፍል ማስተካከያ ይላል።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في الإشارة الآن: تعرض الحالة تصحيح الغرفة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখন সিগন্যালে: স্ট্যাটাসে রুম কারেকশন দেখাচ্ছে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyní v signálu: stav hlásí KOREKCE MÍSTNOSTI."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "I signalet nu: statussen viser RUMKORREKTION."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jetzt im Signal: Der Status zeigt RAUMKORREKTUR."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στο σήμα τώρα: η κατάσταση γράφει ΔΙΟΡΘΩΣΗ ΔΩΜΑΤΙΟΥ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora en la señal: el estado muestra CORRECCIÓN DE SALA."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اکنون در سیگنال: وضعیت تصحیح اتاق را نشان می‌دهد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Signaalissa nyt: tila on HUONEKORJAUS."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nasa signal na ngayon: ROOM CORRECTION ang nakasaad sa status."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans le signal maintenant : l'état indique CORRECTION DE SALLE."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "હવે સિગ્નલમાં: સ્થિતિ રૂમ કરેક્શન બતાવે છે."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Yanzu yana cikin sigina: matsayin yana nuna ROOM CORRECTION."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "באות עכשיו: הסטטוס מציג תיקון חדר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अब सिग्नल में: स्थिति में रूम करेक्शन दिखता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Most a jelben: az állapot SZOBAKORREKCIÓ."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kini ada di sinyal: statusnya menampilkan KOREKSI RUANGAN."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ora nel segnale: lo stato indica CORREZIONE AMBIENTE."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いま信号に反映されています。ステータスには ルーム補正 と表示されます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈಗ ಸಿಗ್ನಲ್‌ನಲ್ಲಿ: ಸ್ಥಿತಿ ರೂಮ್ ಕರೆಕ್ಷನ್ ಎಂದು ತೋರಿಸುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 신호에 적용 중: 상태에 룸 보정이 표시됩니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇപ്പോൾ സിഗ്നലിൽ: സ്റ്റാറ്റസ് റൂം കറക്ഷൻ എന്ന് കാണിക്കുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आता सिग्नलमध्ये: स्थिती रूम करेक्शन दाखवते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dalam isyarat sekarang: status memaparkan PEMBETULAN BILIK."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "I signalet nå: statusen viser ROMKORRIGERING."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu in het signaal: de status toont RUIMTECORRECTIE."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਹੁਣ ਸਿਗਨਲ ਵਿੱਚ: ਸਥਿਤੀ ਵਿੱਚ ਰੂਮ ਕਰੈਕਸ਼ਨ ਦਿਸਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Teraz w sygnale: status pokazuje KOREKCJA POMIESZCZENIA."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No sinal agora: o status mostra CORREÇÃO DE SALA."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "No sinal agora: o estado mostra CORREÇÃO DE SALA."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acum în semnal: starea afișează CORECȚIA CAMEREI."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "I signalen nu: statusen visar RUMSKORRIGERING."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Sasa kwenye mawimbi: hali inaonyesha ROOM CORRECTION."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இப்போது சிக்னலில்: நிலை அறைத் திருத்தம் எனக் காட்டுகிறது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇప్పుడు సిగ్నల్‌లో: స్థితి రూమ్ కరెక్షన్ అని చూపిస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตอนนี้อยู่ในสัญญาณแล้ว: สถานะแสดง ปรับแก้ห้อง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şu an sinyalde: durum ODA DÜZELTMESİ yazıyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тепер у сигналі: у стані написано КОРЕКЦІЯ КІМНАТИ."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اب سگنل میں: اسٹیٹس میں روم کریکشن نظر آتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiện đang trong tín hiệu: trạng thái hiển thị HIỆU CHỈNH PHÒNG."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "現已作用於訊號：狀態顯示 房間校正。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现已作用于信号：状态显示 房间校正。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "現已作用於訊號：狀態顯示 房間校正。"
          }
        }
      }
    },

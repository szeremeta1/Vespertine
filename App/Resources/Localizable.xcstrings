    "Choose M3U or M3U8 playlists. Songs already in your library are added; nothing new is scanned.": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "M3U ወይም M3U8 አጫዋች ዝርዝሮችን ይምረጡ። ቀድሞ በቤተ-መጻሕፍትዎ ያሉ ዘፈኖች ይታከላሉ፤ ምንም አዲስ ነገር አይቃኝም።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر قوائم تشغيل M3U أو M3U8. تُضاف الأغاني الموجودة في مكتبتك بالفعل، ولا يتم فحص أي شيء جديد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "M3U বা M3U8 প্লেলিস্ট বেছে নিন। যে গানগুলো আগে থেকেই আপনার লাইব্রেরিতে আছে সেগুলো যোগ হয়; নতুন কিছু স্ক্যান করা হয় না।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte playlisty M3U nebo M3U8. Skladby, které už jsou v knihovně, se přidají; nic nového se neprohledává."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg M3U- eller M3U8-spillelister. Sange, der allerede er i dit bibliotek, tilføjes; intet nyt scannes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle M3U- oder M3U8-Playlists. Titel, die bereits in deiner Mediathek sind, werden hinzugefügt; nichts Neues wird gescannt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε λίστες αναπαραγωγής M3U ή M3U8. Προστίθενται τα τραγούδια που υπάρχουν ήδη στη βιβλιοθήκη σας· δεν σαρώνεται τίποτα καινούργιο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige listas de reproducción M3U o M3U8. Se añaden las canciones que ya están en tu biblioteca; no se escanea nada nuevo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فهرست‌های پخش M3U یا M3U8 را انتخاب کنید. آهنگ‌هایی که از قبل در کتابخانهٔ شما هستند افزوده می‌شوند؛ چیز تازه‌ای اسکن نمی‌شود."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse M3U- tai M3U8-soittolistoja. Kirjastossasi jo olevat kappaleet lisätään; mitään uutta ei skannata."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pumili ng mga playlist na M3U o M3U8. Idinadagdag ang mga kantang nasa library mo na; walang bagong ini-scan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez des playlists M3U ou M3U8. Les morceaux déjà présents dans votre bibliothèque sont ajoutés ; rien de nouveau n’est indexé."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "M3U અથવા M3U8 પ્લેલિસ્ટ પસંદ કરો. તમારી લાઇબ્રેરીમાં પહેલેથી હોય તેવાં ગીતો ઉમેરાય છે; કંઈ નવું સ્કૅન થતું નથી."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaɓi jerin waƙoƙi na M3U ko M3U8. Ana ƙara waƙoƙin da ke cikin laburarenku tuni; ba a binciken wani sabo."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחר רשימות השמעה בפורמט M3U או M3U8. שירים שכבר נמצאים בספריה שלך יתווספו; שום דבר חדש לא ייסרק."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "M3U या M3U8 प्लेलिस्ट चुनें। जो गीत पहले से आपकी लाइब्रेरी में हैं, वे जोड़े जाते हैं; कुछ भी नया स्कैन नहीं किया जाता।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válasszon M3U vagy M3U8 lejátszási listákat. A könyvtárában már meglévő dalok hozzáadódnak; új beolvasás nem történik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih daftar putar M3U atau M3U8. Lagu yang sudah ada di perpustakaan Anda akan ditambahkan; tidak ada yang dipindai ulang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli playlist M3U o M3U8. I brani già presenti nella libreria vengono aggiunti; non viene scansionato nulla di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "M3UまたはM3U8のプレイリストを選択してください。ライブラリにすでにある曲が追加されます。新たなスキャンは行いません。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "M3U ಅಥವಾ M3U8 ಪ್ಲೇಲಿಸ್ಟ್‌ಗಳನ್ನು ಆಯ್ಕೆಮಾಡಿ. ನಿಮ್ಮ ಲೈಬ್ರರಿಯಲ್ಲಿ ಈಗಾಗಲೇ ಇರುವ ಹಾಡುಗಳನ್ನು ಸೇರಿಸಲಾಗುತ್ತದೆ; ಹೊಸದಾಗಿ ಏನನ್ನೂ ಸ್ಕ್ಯಾನ್ ಮಾಡಲಾಗುವುದಿಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "M3U 또는 M3U8 플레이리스트를 선택하십시오. 보관함에 이미 있는 노래가 추가되며, 새로 스캔하지는 않습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "M3U അല്ലെങ്കിൽ M3U8 പ്ലേലിസ്റ്റുകൾ തിരഞ്ഞെടുക്കുക. ലൈബ്രറിയിൽ ഇതിനകമുള്ള പാട്ടുകൾ ചേർക്കും; പുതിയതൊന്നും സ്കാൻ ചെയ്യില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "M3U किंवा M3U8 प्लेलिस्ट निवडा. तुमच्या लायब्ररीत आधीपासून असलेली गाणी जोडली जातात; नवीन काहीही स्कॅन केले जात नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih senarai main M3U atau M3U8. Lagu yang sudah ada dalam pustaka anda ditambah; tiada apa-apa yang baharu diimbas."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg M3U- eller M3U8-spillelister. Sanger som allerede er i biblioteket ditt, legges til; ingenting nytt skannes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies M3U- of M3U8-playlists. Nummers die al in je bibliotheek staan, worden toegevoegd; er wordt niets nieuws gescand."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "M3U ਜਾਂ M3U8 ਪਲੇਲਿਸਟਾਂ ਚੁਣੋ। ਜੋ ਗੀਤ ਪਹਿਲਾਂ ਹੀ ਤੁਹਾਡੀ ਲਾਇਬ੍ਰੇਰੀ ਵਿੱਚ ਹਨ, ਉਹ ਜੋੜੇ ਜਾਂਦੇ ਹਨ; ਕੁਝ ਵੀ ਨਵਾਂ ਸਕੈਨ ਨਹੀਂ ਕੀਤਾ ਜਾਂਦਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz playlisty M3U lub M3U8. Utwory, które są już w bibliotece, zostaną dodane; nic nowego nie jest skanowane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha playlists M3U ou M3U8. As músicas que já estão na sua biblioteca são adicionadas; nada novo é escaneado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha playlists M3U ou M3U8. As músicas que já estão na biblioteca são adicionadas; nada de novo é analisado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alegeți playlisturi M3U sau M3U8. Melodiile care sunt deja în bibliotecă sunt adăugate; nu se scanează nimic nou."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj M3U- eller M3U8-spellistor. Låtar som redan finns i biblioteket läggs till; inget nytt skannas."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Chagua orodha za nyimbo za M3U au M3U8. Nyimbo ambazo tayari ziko kwenye maktaba yako zinaongezwa; hakuna kipya kinachochanganuliwa."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "M3U அல்லது M3U8 பிளேலிஸ்ட்களைத் தேர்வுசெய்யவும். ஏற்கெனவே உங்கள் லைப்ரரியில் உள்ள பாடல்கள் சேர்க்கப்படும்; புதிதாக எதுவும் ஸ்கேன் செய்யப்படாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "M3U లేదా M3U8 ప్లేలిస్ట్‌లను ఎంచుకోండి. మీ లైబ్రరీలో ఇప్పటికే ఉన్న పాటలు జోడించబడతాయి; కొత్తగా ఏదీ స్కాన్ చేయబడదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกเพลย์ลิสต์ M3U หรือ M3U8 เพลงที่อยู่ในคลังของคุณแล้วจะถูกเพิ่ม โดยไม่สแกนสิ่งใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "M3U veya M3U8 çalma listelerini seçin. Arşivinizde zaten bulunan şarkılar eklenir; yeni bir şey taranmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть плейлисти M3U або M3U8. Пісні, що вже є в медіатеці, буде додано; нові файли не скануються."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "M3U یا M3U8 پلے لسٹس منتخب کریں۔ جو گانے پہلے سے آپ کی لائبریری میں ہیں وہ شامل کر دیے جاتے ہیں؛ کوئی نئی چیز اسکین نہیں ہوتی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn danh sách phát M3U hoặc M3U8. Các bài hát đã có trong thư viện sẽ được thêm vào; không có gì mới được quét."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "請選擇 M3U 或 M3U8 播放列表。已在資料庫中的歌曲會被加入；不會掃描新檔案。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择 M3U 或 M3U8 播放列表。已在资料库中的歌曲会被添加，不会扫描新内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請選擇 M3U 或 M3U8 播放列表。已在資料庫中的歌曲會加入，不會掃描新的內容。"
          }
        }
      }
    },
    "Choose something to play. Vespertine will switch this device to each file's native format.": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "የሚያጫውቱትን ይምረጡ። Vespertine ይህንን መሣሪያ ወደ እያንዳንዱ ፋይል ተፈጥሯዊ ቅርጸት ይቀይረዋል።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر شيئًا لتشغيله. سيبدّل Vespertine هذا الجهاز إلى التنسيق الأصلي لكل ملف."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "চালানোর জন্য কিছু বেছে নিন। Vespertine এই ডিভাইসটিকে প্রতিটি ফাইলের নেটিভ ফরম্যাটে বদলে নেবে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte něco k přehrání. Vespertine přepne toto zařízení na nativní formát každého souboru."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg noget at afspille. Vespertine skifter denne enhed til hver fils oprindelige format."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle etwas zur Wiedergabe aus. Vespertine stellt dieses Gerät auf das native Format jeder Datei um."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε κάτι για αναπαραγωγή. Το Vespertine θα αλλάζει αυτή τη συσκευή στην εγγενή μορφή κάθε αρχείου."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige algo para reproducir. Vespertine cambiará este dispositivo al formato nativo de cada archivo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "چیزی برای پخش انتخاب کنید. Vespertine این دستگاه را به قالب بومی هر فایل تغییر می‌دهد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse jotain toistettavaa. Vespertine vaihtaa tämän laitteen kunkin tiedoston alkuperäiseen muotoon."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pumili ng ipe-play. Ililipat ng Vespertine ang device na ito sa native na format ng bawat file."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez quelque chose à écouter. Vespertine réglera cet appareil sur le format natif de chaque fichier."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "વગાડવા માટે કંઈક પસંદ કરો. Vespertine આ ડિવાઇસને દરેક ફાઇલના નેટિવ ફૉર્મેટ પર સ્વિચ કરશે."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaɓi abin da za a kunna. Vespertine zai sauya wannan na'urar zuwa tsarin asali na kowane fayil."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחר משהו לנגן. Vespertine יעביר התקן זה לפורמט המקורי של כל קובץ."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चलाने के लिए कुछ चुनें। Vespertine इस डिवाइस को हर फ़ाइल के नेटिव फ़ॉर्मैट पर स्विच करेगा।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válasszon valamit lejátszásra. A Vespertine ezt az eszközt minden fájl natív formátumára állítja át."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih sesuatu untuk diputar. Vespertine akan mengalihkan perangkat ini ke format native setiap file."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli qualcosa da riprodurre. Vespertine imposterà questo dispositivo sul formato nativo di ogni file."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再生するものを選択してください。Vespertineはこのデバイスを各ファイルのネイティブフォーマットに切り替えます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಪ್ಲೇ ಮಾಡಲು ಏನನ್ನಾದರೂ ಆರಿಸಿ. Vespertine ಈ ಸಾಧನವನ್ನು ಪ್ರತಿ ಫೈಲ್‌ನ ನೇಟಿವ್ ಫಾರ್ಮ್ಯಾಟ್‌ಗೆ ಬದಲಿಸುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재생할 항목을 선택하십시오. Vespertine이 이 기기를 각 파일의 네이티브 포맷으로 전환합니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പ്ലേ ചെയ്യാൻ എന്തെങ്കിലും തിരഞ്ഞെടുക്കുക. Vespertine ഈ ഉപകരണത്തെ ഓരോ ഫയലിന്റെയും നേറ്റീവ് ഫോർമാറ്റിലേക്ക് മാറ്റും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "प्ले करण्यासाठी काहीतरी निवडा. Vespertine हे डिव्हाइस प्रत्येक फाइलच्या नेटिव्ह फॉरमॅटवर स्विच करेल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih sesuatu untuk dimainkan. Vespertine akan menukar peranti ini kepada format asli setiap fail."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg noe å spille av. Vespertine bytter denne enheten til det opprinnelige formatet til hver fil."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies iets om af te spelen. Vespertine schakelt dit apparaat om naar het native formaat van elk bestand."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਚਲਾਉਣ ਲਈ ਕੁਝ ਚੁਣੋ। Vespertine ਇਸ ਡਿਵਾਈਸ ਨੂੰ ਹਰ ਫ਼ਾਈਲ ਦੇ ਨੇਟਿਵ ਫ਼ਾਰਮੈਟ ’ਤੇ ਬਦਲ ਦੇਵੇਗਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz coś do odtworzenia. Vespertine przełączy to urządzenie na natywny format każdego pliku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha algo para reproduzir. O Vespertine mudará este dispositivo para o formato nativo de cada arquivo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha algo para reproduzir. O Vespertine muda este dispositivo para o formato nativo de cada ficheiro."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alegeți ceva de redat. Vespertine va comuta acest dispozitiv la formatul nativ al fiecărui fișier."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj något att spela. Vespertine byter den här enheten till varje fils ursprungliga format."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Chagua kitu cha kucheza. Vespertine itabadilisha kifaa hiki kwenye fomati asilia ya kila faili."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இயக்க ஏதாவது ஒன்றைத் தேர்வுசெய்யவும். Vespertine இந்தச் சாதனத்தை ஒவ்வொரு கோப்பின் நேட்டிவ் வடிவத்திற்கும் மாற்றும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్లే చేయడానికి ఏదైనా ఎంచుకోండి. Vespertine ఈ పరికరాన్ని ప్రతి ఫైల్ నేటివ్ ఫార్మాట్‌కు మారుస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกสิ่งที่จะเล่น Vespertine จะเปลี่ยนอุปกรณ์นี้เป็นรูปแบบเนทีฟของแต่ละไฟล์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çalınacak bir şey seçin. Vespertine bu aygıtı her dosyanın yerel biçimine geçirir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть, що відтворити. Vespertine перемикатиме цей пристрій на нативний формат кожного файлу."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "چلانے کے لیے کچھ منتخب کریں۔ Vespertine اس ڈیوائس کو ہر فائل کے نیٹو فارمیٹ پر تبدیل کرے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy chọn nội dung để phát. Vespertine sẽ chuyển thiết bị này sang định dạng gốc của từng tệp."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇要播放的內容。Vespertine 會將此裝置切換至每個檔案的原生格式。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择要播放的内容。Vespertine 会将此设备切换为每个文件的原生格式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇要播放的內容。Vespertine 會將此裝置切換為每個檔案的原生格式。"
          }
        }
      }
    },

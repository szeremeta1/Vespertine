    "This room correction file was saved by a newer Vespertine.": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ይህ የክፍል ማስተካከያ ፋይል በአዲሱ የVespertine ስሪት ተቀምጧል።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حُفظ ملف تصحيح الغرفة هذا بواسطة إصدار أحدث من Vespertine."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই রুম কারেকশন ফাইলটি Vespertine-এর একটি নতুন সংস্করণ দিয়ে সংরক্ষিত।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento soubor korekce místnosti uložila novější verze Vespertine."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne rumkorrektionsfil blev gemt af en nyere Vespertine."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Raumkorrekturdatei wurde von einer neueren Vespertine-Version gesichert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό το αρχείο διόρθωσης δωματίου αποθηκεύτηκε από νεότερη έκδοση του Vespertine."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este archivo de corrección de sala lo guardó una versión más reciente de Vespertine."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این فایل تصحیح اتاق توسط نسخه جدیدتری از Vespertine ذخیره شده است."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämän huonekorjaustiedoston on tallentanut uudempi Vespertine."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Na-save ang room correction file na ito ng mas bagong Vespertine."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fichier de correction de salle a été enregistré par une version plus récente de Vespertine."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ રૂમ કરેક્શન ફાઇલ Vespertine ના નવા વર્ઝન દ્વારા સાચવાઈ હતી."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Sabon sigar Vespertine ne ya adana wannan fayil ɗin gyaran ɗaki."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קובץ תיקון החדר הזה נשמר על ידי גרסה חדשה יותר של Vespertine."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह रूम करेक्शन फ़ाइल Vespertine के नए संस्करण ने सहेजी थी।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezt a szobakorrekciós fájlt a Vespertine egy újabb verziója mentette."

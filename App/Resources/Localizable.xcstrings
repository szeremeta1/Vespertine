    "No codec-like cutoff, synthetic-looking shelf or upsampling wall found.": {
      "extractionState": "manual",
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ምንም የኮዴክ የሚመስል መቁረጫ፣ የተሠራ የሚመስል ሼልፍ ወይም የአፕሳምፕሊንግ ግድግዳ አልተገኘም።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُعثر على قطع يشبه الترميز، أو رف يبدو مُصطنعًا، أو جدار رفع معدل العينة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোডেক-সদৃশ কাটঅফ, কৃত্রিম-দেখতে শেলফ বা আপস্যাম্পলিং দেয়াল পাওয়া যায়নি।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nebyl nalezen žádný ořez typický pro kodek, syntetický šelf ani stěna po převzorkování."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der blev ikke fundet nogen codec-lignende afskæring, syntetisk udseende shelf eller opsamplingsmur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein codecartiger Abfall, kein synthetisch wirkendes Plateau und keine Upsampling-Kante gefunden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν βρέθηκε αποκοπή τύπου codec, πλατό που μοιάζει συνθετικό ή τείχος υπερδειγματοληψίας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No codec-like cutoff, synthetic-looking shelf or upsampling wall found."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha encontrado ningún corte propio de un códec, ninguna meseta de aspecto sintético ni ningún muro de sobremuestreo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هیچ برش شبیه کدک، قفسهٔ ساختگی یا دیوار افزایش نرخی پیدا نشد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Koodekin kaltaista rajausta, synteettiseltä näyttävää hyllyä tai ylösnäytteistyksen seinämää ei löytynyt."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang nahanap na cutoff na parang codec, shelf na mukhang synthetic o pader ng upsampling."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune coupure de type codec, aucun plateau d’apparence synthétique ni mur de suréchantillonnage détecté."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કોડેક જેવો કટઑફ, કૃત્રિમ દેખાતો શેલ્ફ અથવા અપસેમ્પલિંગની દીવાલ મળી નથી."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ba a sami yankewa irin na codec, shelf mai kama da na ƙirƙira ko bangon upsampling ba."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא נמצאו חיתוך דמוי קודק, מדף שנראה מלאכותי או קיר של דגימת־על."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई कोडेक जैसा कटऑफ़, कृत्रिम दिखने वाला शेल्फ़ या अपसैंपलिंग दीवार नहीं मिली।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem található kodekre jellemző vágás, szintetikusnak tűnő polc vagy felülmintavételezési fal."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ditemukan cutoff mirip codec, shelf yang tampak sintetis, atau dinding upsampling."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun taglio tipico di un codec, shelf dall’aspetto sintetico o muro da sovracampionamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コーデックのようなカットオフ、合成のように見えるシェルフ、アップサンプリングの壁は見つかりませんでした。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಕೋಡೆಕ್‌ನಂತಹ ಕಟ್‌ಆಫ್, ಕೃತಕವಾಗಿ ಕಾಣುವ ಶೆಲ್ಫ್ ಅಥವಾ ಅಪ್‌ಸ್ಯಾಂಪ್ಲಿಂಗ್ ಗೋಡೆ ಕಂಡುಬಂದಿಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코덱 같은 차단, 합성된 것으로 보이는 셸프 또는 업샘플링 벽이 발견되지 않았습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കോഡെക് പോലുള്ള കട്ട്ഓഫോ, കൃത്രിമമെന്ന് തോന്നുന്ന ഷെൽഫോ, അപ്‌സാമ്പ്ലിംഗ് മതിലോ കണ്ടെത്തിയില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कोडेकसारखा कटऑफ, कृत्रिम दिसणारा शेल्फ किंवा अपसॅम्पलिंगची भिंत आढळली नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada pemotongan seperti codec, rak yang kelihatan sintetik atau dinding pensampelan naik ditemui."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fant ingen kodeklignende avskjæring, syntetisk utseende shelf eller oppsamplingsvegg."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen codecachtige afsnijding, synthetisch ogend plateau of upsamplingwand gevonden."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੋਈ ਕੋਡੇਕ-ਵਰਗਾ ਕਟਆਫ਼, ਸਿੰਥੈਟਿਕ ਦਿਖਦੀ ਸ਼ੈਲਫ਼ ਜਾਂ ਅੱਪਸੈਂਪਲਿੰਗ ਕੰਧ ਨਹੀਂ ਮਿਲੀ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie znaleziono odcięcia typowego dla kodeka, syntetycznie wyglądającej półki ani ściany upsamplingu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum corte típico de codec, patamar de aparência sintética ou parede de upsampling encontrado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi encontrado nenhum corte típico de codec, patamar com aspeto sintético nem barreira de sobreamostragem."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu s-a găsit nicio tăietură tipică unui codec, niciun platou cu aspect sintetic și niciun zid de supraeșantionare."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen codec-liknande avskärning, syntetiskt utseende platå eller uppsamplingsvägg hittades."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hakuna mkato kama wa kodeki, rafu inayoonekana ya kutengenezwa au ukuta wa upsampling uliopatikana."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கோடெக் போன்ற கட்ஆஃப், செயற்கையாகத் தோன்றும் ஷெல்ஃப் அல்லது அப்சாம்பிளிங் சுவர் எதுவும் காணப்படவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కోడెక్ లాంటి కటాఫ్, కృత్రిమంగా కనిపించే షెల్ఫ్ లేదా అప్‌శాంప్లింగ్ గోడ ఏదీ కనుగొనబడలేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่พบจุดตัดแบบโคเดก ชั้นที่ดูสังเคราะห์ หรือกำแพงจากการอัปแซมเปิล"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Codec benzeri kesim, sentetik görünen raf veya yukarı örnekleme duvarı bulunamadı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не знайдено ні зрізу, схожого на кодек, ні синтетичної полиці, ні стіни передискретизації."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کوڈیک جیسا کٹ آف، مصنوعی دکھنے والا شیلف یا اپ سیمپلنگ کی دیوار نہیں ملی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không tìm thấy ngưỡng cắt giống codec, dải phẳng trông như tổng hợp hoặc bức tường nâng mẫu."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到類似編解碼器的截止、看似合成的擱架或升頻牆。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未发现类似编解码器的截止、看似合成的平台或升频墙。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未發現類似編解碼器的截止、看似合成的平台或升頻牆。"
          }
        }
      }
    },

        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Vespertine försöker igen om 30 minuter, eller när du väljer Anslut igen."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Vespertine itajaribu tena baada ya dakika 30, au utakapochagua Unganisha Upya."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Vespertine 30 நிமிடங்களில், அல்லது நீங்கள் ‘மீண்டும் இணை’ என்பதைத் தேர்வுசெய்யும்போது, மீண்டும் முயலும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Vespertine 30 నిమిషాల్లో, లేదా మీరు “మళ్లీ కనెక్ట్ చేయి” ఎంచుకున్నప్పుడు మళ్లీ ప్రయత్నిస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Vespertine จะลองอีกครั้งใน 30 นาที หรือเมื่อคุณเลือก เชื่อมต่อใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Vespertine 30 dakika sonra veya Yeniden Bağlan’ı seçtiğinizde yeniden dener."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Vespertine спробує знову через 30 хвилин або коли ви виберете «Під’єднати знову»."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Vespertine 30 منٹ بعد دوبارہ کوشش کرے گا، یا جب آپ “دوبارہ منسلک کریں” منتخب کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Vespertine sẽ thử lại sau 30 phút, hoặc khi bạn chọn Kết nối lại."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",

    "No 16-bit mode at %@ kHz; sent as %lld-bit (same samples, zero-padded)": {
      "comment": "Signal-path note; %@ is a sample rate, %lld a bit depth (24 or 32).",
      "extractionState": "manual",
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "በ%@ kHz 16-bit ሁነታ የለም፤ እንደ %lld-bit ተልኳል (ተመሳሳይ ናሙናዎች፣ በዜሮ የተሞሉ)"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد وضع 16 بت عند %@ kHz؛ أُرسل بدقة %lld بت (العينات نفسها، مبطّنة بالأصفار)"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kHz-এ কোনো 16-bit মোড নেই; %lld-bit হিসেবে পাঠানো হয়েছে (একই স্যাম্পল, জিরো-প্যাডেড)"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Při %@ kHz není k dispozici 16bitový režim; odesláno v %lld bitech (stejné vzorky, doplněno nulami)"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen 16-bit-tilstand ved %@ kHz; sendt som %lld-bit (samme samples, nulpolstret)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein 16-Bit-Modus bei %@ kHz; mit %lld Bit gesendet (gleiche Samples, mit Nullen aufgefüllt)"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν υπάρχει λειτουργία 16 bit στα %@ kHz· αποστολή ως %lld bit (ίδια δείγματα, συμπλήρωση με μηδενικά)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No 16-bit mode at %@ kHz; sent as %lld-bit (same samples, zero-padded)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay modo de 16 bits a %@ kHz; se envía en %lld bits (mismas muestras, rellenadas con ceros)"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "حالت ۱۶ بیتی در %@ kHz وجود ندارد؛ به‌صورت %lld بیتی ارسال می‌شود (همان نمونه‌ها، صفرپرشده)"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei 16-bittistä tilaa (%@ kHz); lähetetty %lld-bittisenä (samat näytteet, täytetty nollilla)"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang 16-bit mode sa %@ kHz; ipinadala bilang %lld-bit (parehong mga sample, zero-padded)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de mode 16 bits à %@ kHz ; envoyé en %lld bits (mêmes échantillons, complétés par des zéros)"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kHz પર 16-bit મોડ નથી; %lld-bit તરીકે મોકલ્યું (એ જ સેમ્પલ, શૂન્ય-પૅડ કરેલું)"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Babu yanayin bit 16 a %@ kHz; an aika a matsayin bit %lld (samfura iri ɗaya, an cike da sifili)"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין מצב 16 סיביות ב־%@ kHz; נשלח ב־%lld סיביות (אותן דגימות, מרופד באפסים)"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kHz पर कोई 16-bit मोड नहीं; %lld-bit के रूप में भेजा गया (वही सैंपल, ज़ीरो-पैडेड)"
          }
        },
        "hu": {

        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopierer musikk til én mappe, sortert etter artist og album. Originalene dine forblir som de er."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopieert muziek naar één map, geordend op artiest en album. Je originelen blijven zoals ze zijn."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸੰਗੀਤ ਨੂੰ ਇੱਕ ਫ਼ੋਲਡਰ ਵਿੱਚ ਕਾਪੀ ਕਰਦਾ ਹੈ, ਕਲਾਕਾਰ ਅਤੇ ਐਲਬਮ ਮੁਤਾਬਕ ਵਿਵਸਥਿਤ। ਤੁਹਾਡੀਆਂ ਮੂਲ ਫ਼ਾਈਲਾਂ ਜਿਵੇਂ ਹਨ, ਉਵੇਂ ਹੀ ਰਹਿੰਦੀਆਂ ਹਨ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopiuje muzykę do jednego folderu, porządkując ją według wykonawców i albumów. Oryginały pozostają nietknięte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",

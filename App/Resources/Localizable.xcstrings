          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vain %lld/%lld bitistä sisältää ääntä (täytetty nollilla)"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld lang sa %lld bit ang may audio (zero-padded)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls %lld bits sur %lld contiennent de l’audio (complétés par des zéros)"

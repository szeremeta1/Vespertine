    "Your existing files have been preserved. Retry after reconnecting the drive or choose another library folder.": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ያሉት ፋይሎችዎ ተጠብቀዋል። ድራይቩን እንደገና ካገናኙ በኋላ እንደገና ይሞክሩ ወይም ሌላ የቤተ-መጻሕፍት አቃፊ ይምረጡ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم الاحتفاظ بملفاتك الحالية. أعد المحاولة بعد إعادة توصيل القرص أو اختر مجلد مكتبة آخر."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার বিদ্যমান ফাইলগুলো সংরক্ষিত আছে। ড্রাইভটি আবার সংযুক্ত করে পুনরায় চেষ্টা করুন, অথবা অন্য একটি লাইব্রেরি ফোল্ডার বেছে নিন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše stávající soubory zůstaly zachovány. Po opětovném připojení disku to zkuste znovu, nebo vyberte jinou složku knihovny."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine eksisterende filer er bevaret. Prøv igen, når du har tilsluttet drevet igen, eller vælg en anden biblioteksmappe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine vorhandenen Dateien bleiben erhalten. Versuche es erneut, nachdem du das Laufwerk wieder angeschlossen hast, oder wähle einen anderen Mediathekordner."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα υπάρχοντα αρχεία σας διατηρήθηκαν. Δοκιμάστε ξανά αφού επανασυνδέσετε τον δίσκο ή επιλέξτε άλλον φάκελο βιβλιοθήκης."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus archivos se han conservado. Vuelve a intentarlo después de reconectar el disco o elige otra carpeta para la biblioteca."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فایل‌های فعلی شما حفظ شده‌اند. پس از اتصال دوبارهٔ درایو دوباره تلاش کنید یا پوشهٔ کتابخانهٔ دیگری انتخاب کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nykyiset tiedostosi on säilytetty. Yritä uudelleen, kun olet liittänyt aseman uudelleen, tai valitse toinen kirjastokansio."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Napanatili ang mga kasalukuyan mong file. Subukang muli pagkatapos ikonekta muli ang drive o pumili ng ibang folder ng library."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos fichiers existants ont été conservés. Réessayez après avoir reconnecté le disque, ou choisissez un autre dossier de bibliothèque."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારી હાલની ફાઇલો સાચવી રખાઈ છે. ડ્રાઇવ ફરી કનેક્ટ કર્યા પછી ફરી પ્રયાસ કરો અથવા બીજું લાઇબ્રેરી ફોલ્ડર પસંદ કરો."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "An kiyaye fayilolinku da ke akwai. Sake gwadawa bayan sake haɗa faifan ajiya ko zaɓi wata foldar laburare."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקבצים הקיימים שלך נשמרו. נסה שוב לאחר חיבור הכונן מחדש או בחר תיקיית ספריה אחרת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी मौजूदा फ़ाइलें सुरक्षित हैं। ड्राइव फिर से कनेक्ट करके दोबारा कोशिश करें, या कोई दूसरा लाइब्रेरी फ़ोल्डर चुनें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A meglévő fájljai megmaradtak. Próbálja újra a meghajtó újracsatlakoztatása után, vagy válasszon másik könyvtármappát."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "File Anda yang ada telah dipertahankan. Coba lagi setelah menghubungkan kembali drive, atau pilih folder perpustakaan lain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I file esistenti sono stati conservati. Riprova dopo aver ricollegato il disco, oppure scegli un’altra cartella per la libreria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "既存のファイルはそのまま残っています。ドライブを再接続してから再試行するか、別のライブラリフォルダを選択してください。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಈಗಿರುವ ಫೈಲ್‌ಗಳನ್ನು ಸಂರಕ್ಷಿಸಲಾಗಿದೆ. ಡ್ರೈವ್ ಮರುಸಂಪರ್ಕಿಸಿದ ನಂತರ ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ, ಅಥವಾ ಬೇರೆ ಲೈಬ್ರರಿ ಫೋಲ್ಡರ್ ಆರಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기존 파일은 그대로 유지되었습니다. 드라이브를 다시 연결한 후 다시 시도하거나 다른 보관함 폴더를 선택하십시오."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ നിലവിലെ ഫയലുകൾ സംരക്ഷിക്കപ്പെട്ടിരിക്കുന്നു. ഡ്രൈവ് വീണ്ടും കണക്റ്റ് ചെയ്തശേഷം വീണ്ടും ശ്രമിക്കുക, അല്ലെങ്കിൽ മറ്റൊരു ലൈബ്രറി ഫോൾഡർ തിരഞ്ഞെടുക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमच्या विद्यमान फाइल्स जपल्या आहेत. ड्राइव्ह पुन्हा जोडल्यानंतर पुन्हा प्रयत्न करा किंवा दुसरा लायब्ररी फोल्डर निवडा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Fail sedia ada anda telah dikekalkan. Cuba semula selepas menyambung semula pemacu atau pilih folder pustaka lain."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "De eksisterende filene dine er bevart. Prøv igjen etter at du har koblet til disken igjen, eller velg en annen bibliotekmappe."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bestaande bestanden zijn behouden. Probeer het opnieuw nadat je de schijf opnieuw hebt aangesloten, of kies een andere bibliotheekmap."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡੀਆਂ ਮੌਜੂਦਾ ਫ਼ਾਈਲਾਂ ਸੁਰੱਖਿਅਤ ਹਨ। ਡਰਾਈਵ ਮੁੜ ਜੋੜਨ ਤੋਂ ਬਾਅਦ ਦੁਬਾਰਾ ਕੋਸ਼ਿਸ਼ ਕਰੋ ਜਾਂ ਕੋਈ ਹੋਰ ਲਾਇਬ੍ਰੇਰੀ ਫ਼ੋਲਡਰ ਚੁਣੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Istniejące pliki zostały zachowane. Spróbuj ponownie po podłączeniu dysku lub wybierz inny folder biblioteki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus arquivos foram preservados. Tente novamente depois de reconectar o disco ou escolha outra pasta de biblioteca."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os ficheiros existentes foram preservados. Tente novamente depois de voltar a ligar o disco ou escolha outra pasta para a biblioteca."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fișierele existente au fost păstrate. Încercați din nou după ce reconectați discul sau alegeți alt dosar pentru bibliotecă."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina befintliga filer har bevarats. Försök igen efter att du har anslutit enheten igen, eller välj en annan biblioteksmapp."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Faili zako zilizopo zimehifadhiwa. Jaribu tena baada ya kuunganisha diski upya au chagua folda nyingine ya maktaba."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் தற்போதைய கோப்புகள் பாதுகாக்கப்பட்டுள்ளன. டிரைவை மீண்டும் இணைத்தபின் மீண்டும் முயலவும் அல்லது வேறொரு லைப்ரரி கோப்புறையைத் தேர்வுசெய்யவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ ప్రస్తుత ఫైల్‌లు భద్రంగా ఉన్నాయి. డ్రైవ్‌ను మళ్లీ కనెక్ట్ చేసిన తర్వాత మళ్లీ ప్రయత్నించండి, లేదా మరో లైబ్రరీ ఫోల్డర్‌ను ఎంచుకోండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟล์ที่มีอยู่ของคุณยังคงอยู่ ลองอีกครั้งหลังจากเชื่อมต่อไดรฟ์ใหม่ หรือเลือกโฟลเดอร์คลังอื่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mevcut dosyalarınız korundu. Diski yeniden bağladıktan sonra yeniden deneyin veya başka bir arşiv klasörü seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Наявні файли збережено. Під’єднайте диск знову й повторіть спробу або виберіть іншу папку медіатеки."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی موجودہ فائلیں محفوظ ہیں۔ ڈرائیو دوبارہ منسلک کرنے کے بعد دوبارہ کوشش کریں یا کوئی دوسرا لائبریری فولڈر منتخب کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các tệp hiện có của bạn đã được giữ nguyên. Hãy thử lại sau khi kết nối lại ổ đĩa hoặc chọn một thư mục thư viện khác."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "你現有的檔案已被保留。請在重新連接磁碟後再試，或選擇其他資料庫資料夾。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你现有的文件已被保留。请在重新连接磁盘后重试，或选择其他资料库文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你現有的檔案已被保留。請在重新連接磁碟後再試一次，或選擇其他資料庫檔案夾。"
          }
        }
      }
    },

        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostatní aplikace jsou na tomto zařízení ztlumeny. Klávesy hlasitosti a Ovládací centrum ho stále ovládají."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Andre apps gøres tavse på denne enhed. Lydstyrketaster og Kontrolcenter justerer den stadig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Andere Apps werden auf diesem Gerät stummgeschaltet. Lautstärketasten und Kontrollzentrum regeln es weiterhin."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι άλλες εφαρμογές σιωπούν σε αυτή τη συσκευή. Τα πλήκτρα έντασης και το Κέντρο ελέγχου εξακολουθούν να τη ρυθμίζουν."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las demás apps se silencian en este dispositivo. Las teclas de volumen y el centro de control siguen ajustándolo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برنامه‌های دیگر روی این دستگاه بی‌صدا می‌شوند. کلیدهای صدا و مرکز کنترل همچنان صدای آن را تنظیم می‌کنند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muut apit vaimennetaan tässä laitteessa. Äänenvoimakkuusnäppäimet ja Ohjauskeskus säätävät sitä edelleen."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinatatahimik ang ibang app sa device na ito. Naaayos pa rin ito ng mga volume key at ng Control Center."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les autres apps sont muettes sur cet appareil. Les touches de volume et le Centre de contrôle permettent toujours de le régler."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ ડિવાઇસ પર અન્ય ઍપ શાંત કરાય છે. વૉલ્યૂમ કી અને Control Center હજી પણ તેને ઍડજસ્ટ કરે છે."
          }

    "CUE track is outside %@: start %lld, length %lld, file length %lld frames": {
      "comment": "Positions and lengths in audio frames.",
      "extractionState": "manual",
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "የCUE ትራኩ ከ%@ ውጭ ነው፦ መጀመሪያ %lld፣ ርዝመት %lld፣ የፋይል ርዝመት %lld ፍሬሞች"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مقطوعة CUE خارج %1$@: البداية %2$lld، الطول %3$lld، طول الملف %4$lld إطار"
          }
        },
        "bn": {

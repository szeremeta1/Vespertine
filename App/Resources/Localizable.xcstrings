    "%@ didn’t come back. Choose another output, or press play once it’s connected.": {
      "comment": "%@ is the name of an audio output device.",
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ አልተመለሰም። ሌላ ውፅዓት ይምረጡ፣ ወይም ሲገናኝ አጫውትን ይጫኑ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يعد %@ متاحًا. اختر مخرجًا آخر، أو اضغط تشغيل بعد اتصاله."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ আর ফিরে আসেনি। অন্য একটি আউটপুট বেছে নিন, অথবা এটি সংযুক্ত হলে প্লে চাপুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: zařízení se znovu nepřipojilo. Zvolte jiný výstup, nebo zařízení připojte a stiskněte Přehrát."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kom ikke tilbage. Vælg et andet output, eller tryk på afspil, når den er forbundet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist nicht zurückgekehrt. Wähle eine andere Ausgabe oder starte die Wiedergabe, sobald das Gerät verbunden ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: δεν επανήλθε. Επιλέξτε άλλη έξοδο ή πατήστε αναπαραγωγή μόλις συνδεθεί."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no ha vuelto. Elige otra salida o pulsa Reproducir cuando esté conectado."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ برنگشت. خروجی دیگری انتخاب کنید یا پس از وصل شدن آن، دکمهٔ پخش را بزنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Laite %@ ei palannut. Valitse toinen ulostulo tai paina toistoa, kun laite on yhdistetty."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi bumalik ang %@. Pumili ng ibang output, o pindutin ang play kapag nakakonekta na ito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n’est pas revenu. Choisissez une autre sortie, ou appuyez sur Lecture une fois qu’il est connecté."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ પાછું આવ્યું નહીં. બીજું આઉટપુટ પસંદ કરો, અથવા તે કનેક્ટ થાય ત્યારે પ્લે દબાવો."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bai dawo ba. Zaɓi wata na'urar fitar da sauti, ko danna kunna da zarar an haɗa shi."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ לא חזר. בחר פלט אחר, או לחץ על ״נגן״ ברגע שהוא יחובר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ वापस कनेक्ट नहीं हुआ। कोई दूसरा आउटपुट चुनें, या इसके कनेक्ट होने पर प्ले दबाएँ।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: az eszköz nem csatlakozott újra. Válasszon másik kimenetet, vagy csatlakoztassa az eszközt, és nyomja meg a lejátszás gombot."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tidak tersambung kembali. Pilih output lain, atau tekan putar setelah tersambung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non è tornato disponibile. Scegli un’altra uscita, o premi Riproduci quando è connesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@が再接続されませんでした。別の出力を選択するか、接続されたら再生ボタンを押してください。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ಮರಳಿ ಬರಲಿಲ್ಲ. ಬೇರೆ ಔಟ್‌ಪುಟ್ ಆಯ್ಕೆಮಾಡಿ, ಅಥವಾ ಅದು ಸಂಪರ್ಕಗೊಂಡ ನಂತರ ಪ್ಲೇ ಒತ್ತಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 기기가 다시 연결되지 않았습니다. 다른 출력을 선택하거나, 연결된 후 재생을 누르십시오."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ തിരികെ വന്നില്ല. മറ്റൊരു ഔട്ട്‌പുട്ട് തിരഞ്ഞെടുക്കുക, അല്ലെങ്കിൽ അത് കണക്റ്റ് ചെയ്തശേഷം പ്ലേ അമർത്തുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ परत आले नाही. दुसरे आउटपुट निवडा, किंवा ते कनेक्ट झाल्यावर प्ले दाबा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tidak kembali. Pilih output lain, atau tekan main setelah ia disambungkan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kom ikke tilbake. Velg en annen utgang, eller trykk på spill av når den er tilkoblet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is niet teruggekomen. Kies een andere uitvoer of start het afspelen zodra het apparaat verbonden is."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ਵਾਪਸ ਨਹੀਂ ਆਇਆ। ਕੋਈ ਹੋਰ ਆਉਟਪੁੱਟ ਚੁਣੋ, ਜਾਂ ਇਸਦੇ ਕਨੈਕਟ ਹੋਣ ’ਤੇ ਚਲਾਓ ਦਬਾਓ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Urządzenie %@ nie wróciło. Wybierz inne wyjście lub naciśnij Odtwórz, gdy zostanie podłączone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não voltou. Escolha outra saída ou pressione Reproduzir quando estiver conectado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não voltou a ligar-se. Escolha outra saída ou prima Reproduzir quando estiver ligado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nu a revenit. Alegeți altă ieșire sau apăsați Redă după ce este conectat."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kom inte tillbaka. Välj en annan utgång eller tryck på spela när den är ansluten."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hakijarudi. Chagua kifaa kingine cha kutoa sauti, au bonyeza cheza kikishaunganishwa."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ மீண்டும் இணையவில்லை. வேறொரு வெளியீட்டைத் தேர்வுசெய்யவும், அல்லது அது இணைந்ததும் இயக்கு என்பதை அழுத்தவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ తిరిగి రాలేదు. మరో అవుట్‌పుట్‌ను ఎంచుకోండి, లేదా అది కనెక్ట్ అయ్యాక ప్లే నొక్కండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ไม่กลับมา เลือกอุปกรณ์ขาออกอื่น หรือกดเล่นเมื่อเชื่อมต่อแล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ geri gelmedi. Başka bir çıkış seçin veya bağlandığında çal düğmesine basın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося дочекатися пристрою: %@. Виберіть інший вихід або натисніть «Відтворити», щойно його буде під’єднано."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ واپس نہیں آیا۔ کوئی دوسرا آؤٹ پٹ منتخب کریں، یا اس کے منسلک ہونے کے بعد پلے دبائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",

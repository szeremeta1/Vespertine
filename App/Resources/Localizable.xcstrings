    "Your status appears while a song plays.": {
      "comment": "Settings › Online › Discord, status caption: the option is on and nothing is playing yet.",
      "extractionState": "manual",
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ዘፈን በሚጫወትበት ጊዜ ሁኔታዎ ይታያል።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر حالتك أثناء تشغيل أغنية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোনো গান চললে আপনার স্ট্যাটাস দেখা যায়।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Váš stav se zobrazí během přehrávání skladby."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din status vises, mens en sang spiller."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Status erscheint, während ein Titel läuft."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η κατάστασή σας εμφανίζεται όσο παίζει ένα τραγούδι."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu estado aparece mientras suena una canción."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "وضعیت شما هنگام پخش یک آهنگ نمایش داده می‌شود."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilasi näkyy, kun kappale soi."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Lalabas ang iyong status habang may kantang nagpe-play."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre statut s’affiche pendant la lecture d’un morceau."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ગીત વાગે ત્યારે તમારું સ્ટેટસ દેખાય છે."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Matsayinku yana bayyana yayin da ake kunna waƙa."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הסטטוס שלך יופיע בזמן שמתנגן שיר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी गाने के चलते समय आपका स्टेटस दिखता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az állapota akkor jelenik meg, amikor egy dal szól."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Status Anda muncul saat lagu diputar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo stato appare durante la riproduzione di un brano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "曲の再生中にステータスが表示されます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಹಾಡು ಪ್ಲೇ ಆಗುತ್ತಿರುವಾಗ ನಿಮ್ಮ ಸ್ಟೇಟಸ್ ಕಾಣಿಸುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노래가 재생되는 동안 상태가 표시됩니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒരു പാട്ട് പ്ലേ ചെയ്യുമ്പോൾ നിങ്ങളുടെ സ്റ്റാറ്റസ് ദൃശ്യമാകും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "गाणे वाजत असताना तुमचे स्टेटस दिसते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Status anda dipaparkan semasa lagu dimainkan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Statusen din vises mens en sang spilles."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je status verschijnt terwijl er een nummer speelt."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਜਦੋਂ ਕੋਈ ਗੀਤ ਚੱਲਦਾ ਹੈ ਤਾਂ ਤੁਹਾਡਾ ਸਟੇਟਸ ਦਿਖਾਈ ਦਿੰਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój status pojawia się podczas odtwarzania utworu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu status aparece enquanto uma música toca."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O seu estado aparece enquanto uma música está a tocar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Statusul dvs. apare cât timp se redă o melodie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din status visas medan en låt spelas."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hali yako huonekana wimbo unapocheza."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பாடல் இயங்கும்போது உங்கள் நிலை தோன்றும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పాట ప్లే అవుతున్నప్పుడు మీ స్టేటస్ కనిపిస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สถานะของคุณจะปรากฏขณะที่เพลงกำลังเล่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir şarkı çalarken durumunuz görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш статус з’являється, коли грає пісня."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "گانا چلنے پر آپ کا اسٹیٹس ظاہر ہوتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trạng thái của bạn sẽ xuất hiện khi một bài hát đang phát."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "播放歌曲時會顯示你的狀態。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "播放歌曲时会显示你的状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "播放歌曲時會顯示你的狀態。"
          }
        }
      }

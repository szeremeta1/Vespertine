    "Other players open this as a playlist of the same files.": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ሌሎች ማጫወቻዎች ይህንን የእነዚሁ ፋይሎች አጫዋች ዝርዝር አድርገው ይከፍቱታል።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تفتح مشغّلات الصوت الأخرى هذا الملف كقائمة تشغيل للملفات نفسها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অন্য মিউজিক প্লেয়ারগুলো এটিকে একই ফাইলগুলোর একটি প্লেলিস্ট হিসেবে খোলে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jiné přehrávače tento soubor otevřou jako playlist se stejnými soubory."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Andre afspillere åbner dette som en spilleliste med de samme filer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Andere Player öffnen dies als Playlist mit denselben Dateien."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Άλλα προγράμματα αναπαραγωγής το ανοίγουν ως λίστα αναπαραγωγής με τα ίδια αρχεία."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otros reproductores lo abren como una lista de reproducción con los mismos archivos."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پخش‌کننده‌های دیگر این را به‌صورت فهرست پخشی از همین فایل‌ها باز می‌کنند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muut soittimet avaavat tämän soittolistana, jossa on samat tiedostot."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Binubuksan ito ng ibang player bilang playlist ng parehong mga file."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les autres lecteurs l’ouvrent comme une playlist contenant les mêmes fichiers."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "અન્ય મ્યુઝિક પ્લેયર આને આ જ ફાઇલોના પ્લેલિસ્ટ તરીકે ખોલે છે."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Sauran manhajojin kunna waƙa suna buɗe wannan a matsayin jerin waƙoƙi na fayiloli iri ɗaya."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נגנים אחרים יפתחו קובץ זה כרשימת השמעה של אותם קבצים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दूसरे म्यूज़िक प्लेयर इसे उन्हीं फ़ाइलों की प्लेलिस्ट के रूप में खोलते हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Más lejátszók ugyanezen fájlok lejátszási listájaként nyitják meg."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemutar lain membuka ini sebagai daftar putar berisi file yang sama."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli altri player lo aprono come una playlist degli stessi file."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかのプレーヤーアプリでは、同じファイルのプレイリストとして開けます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇತರ ಪ್ಲೇಯರ್‌ಗಳು ಇದನ್ನು ಅದೇ ಫೈಲ್‌ಗಳ ಪ್ಲೇಲಿಸ್ಟ್ ಆಗಿ ತೆರೆಯುತ್ತವೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 플레이어 앱에서는 같은 파일로 구성된 플레이리스트로 열립니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മറ്റ് പ്ലെയറുകൾ ഇതേ ഫയലുകളുടെ ഒരു പ്ലേലിസ്റ്റായി ഇത് തുറക്കും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "इतर म्युझिक प्लेअर हे त्याच फाइल्सची प्लेलिस्ट म्हणून उघडतात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemain lain membuka fail ini sebagai senarai main bagi fail yang sama."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Andre avspillere åpner dette som en spilleliste med de samme filene."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Andere muziekspelers openen dit als een playlist met dezelfde bestanden."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਹੋਰ ਪਲੇਅਰ ਇਸਨੂੰ ਉਹਨਾਂ ਹੀ ਫ਼ਾਈਲਾਂ ਦੀ ਪਲੇਲਿਸਟ ਵਜੋਂ ਖੋਲ੍ਹਦੇ ਹਨ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inne odtwarzacze otworzą go jako playlistę z tymi samymi plikami."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Outros reprodutores abrem isto como uma playlist com os mesmos arquivos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Outros leitores abrem isto como uma playlist com os mesmos ficheiros."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alte playere deschid acest fișier ca playlist cu aceleași fișiere."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Andra musikspelare öppnar den som en spellista med samma filer."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Programu nyingine za kucheza muziki hufungua hii kama orodha ya nyimbo ya faili zilezile."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பிற பிளேயர்கள் இதை அதே கோப்புகளின் பிளேலிஸ்ட்டாகத் திறக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇతర ప్లేయర్‌లు దీన్ని అవే ఫైల్‌ల ప్లేలిస్ట్‌గా తెరుస్తాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แอปเล่นเพลงอื่นจะเปิดไฟล์นี้เป็นเพลย์ลิสต์ของไฟล์ชุดเดียวกัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diğer oynatıcılar bunu aynı dosyalardan oluşan bir çalma listesi olarak açar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Інші плеєри відкриють це як плейлист із тими самими файлами."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دوسرے پلیئرز اسے انہی فائلوں کی پلے لسٹ کے طور پر کھولتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các trình phát khác sẽ mở tệp này như một danh sách phát gồm cùng các tệp."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "其他播放器會將此檔案開啟為包含相同檔案的播放列表。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其他播放器会将其作为包含相同文件的播放列表打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "其他播放器會將其打開為包含相同檔案的播放列表。"
          }
        }
      }
    },

    "Only multichannel files (5.1, 7.1, …) can be exported for Spatial Audio.": {
      "extractionState": "manual",
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ለSpatial Audio ሊላኩ የሚችሉት ባለብዙ ቻናል ፋይሎች (5.1፣ 7.1፣ …) ብቻ ናቸው።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن التصدير للصوت المكاني إلا للملفات متعددة القنوات (5.1، 7.1، …)."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুধু মাল্টিচ্যানেল ফাইল (5.1, 7.1, …) স্পেশিয়াল অডিওর জন্য এক্সপোর্ট করা যায়।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro prostorový zvuk lze exportovat jen vícekanálové soubory (5.1, 7.1, …)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun flerkanalsfiler (5.1, 7.1, …) kan eksporteres til rumlig lyd."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Mehrkanaldateien (5.1, 7.1, …) können für 3D-Audio exportiert werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μόνο πολυκαναλικά αρχεία (5.1, 7.1, …) μπορούν να εξαχθούν για Χωρικό ήχο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only multichannel files (5.1, 7.1, …) can be exported for Spatial Audio."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo los archivos multicanal (5.1, 7.1…) se pueden exportar para audio espacial."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فقط فایل‌های چندکاناله (۵٫۱، ۷٫۱، …) را می‌توان برای صدای فضایی صادر کرد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vain monikanavaiset tiedostot (5.1, 7.1, …) voidaan viedä tilaääntä varten."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mga multichannel na file lang (5.1, 7.1, …) ang maaaring i-export para sa Spatial Audio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls les fichiers multicanaux (5.1, 7.1, …) peuvent être exportés pour l’audio spatial."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ફક્ત મલ્ટિચૅનલ ફાઇલો (5.1, 7.1, …) સ્પેશિયલ ઑડિયો માટે એક્સપોર્ટ કરી શકાય છે."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Fayiloli masu tashoshi da yawa kawai (5.1, 7.1, …) ne za a iya fitar da su don Spatial Audio."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רק קבצים רב־ערוציים (5.1, 7.1, …) ניתנים לייצוא לשמע מרחבי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल मल्टीचैनल फ़ाइलें (5.1, 7.1, …) स्पेशियल ऑडियो के लिए एक्सपोर्ट की जा सकती हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Térhatású hanghoz csak többcsatornás fájlok (5.1, 7.1, …) exportálhatók."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya file multisaluran (5.1, 7.1, …) yang dapat diekspor untuk Audio Spasial."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo i file multicanale (5.1, 7.1, …) possono essere esportati per l’audio spaziale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空間オーディオ用に書き出せるのは、マルチチャンネルファイル（5.1、7.1など）のみです。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಮಲ್ಟಿಚಾನೆಲ್ ಫೈಲ್‌ಗಳನ್ನು (5.1, 7.1, …) ಮಾತ್ರ ಸ್ಪೇಷಿಯಲ್ ಆಡಿಯೋಗಾಗಿ ರಫ್ತುಮಾಡಬಹುದು."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "멀티채널 파일(5.1, 7.1 등)만 공간 음향용으로 내보낼 수 있습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മൾട്ടിചാനൽ ഫയലുകൾ (5.1, 7.1, …) മാത്രമേ സ്പേഷ്യൽ ഓഡിയോയ്ക്കായി എക്സ്പോർട്ട് ചെയ്യാനാകൂ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "फक्त मल्टिचॅनेल फाइल्स (5.1, 7.1, …) स्पेशियल ऑडिओसाठी एक्सपोर्ट करता येतात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya fail berbilang saluran (5.1, 7.1, …) boleh dieksport untuk Audio Ruang."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare flerkanalsfiler (5.1, 7.1, …) kan eksporteres for romlig lyd."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen meerkanaalsbestanden (5.1, 7.1, …) kunnen worden geëxporteerd voor ruimtelijke audio."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਪੇਸ਼ੀਅਲ ਆਡੀਓ ਲਈ ਸਿਰਫ਼ ਮਲਟੀਚੈਨਲ ਫ਼ਾਈਲਾਂ (5.1, 7.1, …) ਹੀ ਐਕਸਪੋਰਟ ਕੀਤੀਆਂ ਜਾ ਸਕਦੀਆਂ ਹਨ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko pliki wielokanałowe (5.1, 7.1, …) mogą być eksportowane dla dźwięku przestrzennego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente arquivos multicanal (5.1, 7.1…) podem ser exportados para reprodução com Áudio Espacial."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Só os ficheiros multicanal (5.1, 7.1, …) podem ser exportados para reprodução com áudio espacial."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Doar fișierele multicanal (5.1, 7.1, …) pot fi exportate pentru Audio spațial."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bara flerkanalsfiler (5.1, 7.1 …) kan exporteras för rumsligt ljud."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Faili za chaneli nyingi pekee (5.1, 7.1, …) ndizo zinaweza kuhamishwa kwa ajili ya Spatial Audio."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மல்டிசேனல் கோப்புகளை (5.1, 7.1, …) மட்டுமே ஸ்பேஷியல் ஆடியோவுக்காக ஏற்றுமதிசெய்ய முடியும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మల్టీఛానెల్ ఫైల్‌లను (5.1, 7.1, …) మాత్రమే స్పేషియల్ ఆడియో కోసం ఎగుమతి చేయవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่งออกสำหรับเสียงตามตำแหน่งได้เฉพาะไฟล์หลายช่องสัญญาณ (5.1, 7.1, …) เท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzamsal Ses için yalnızca çok kanallı dosyalar (5.1, 7.1, …) dışa aktarılabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для просторового аудіо можна експортувати лише багатоканальні файли (5.1, 7.1, …)."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "صرف ملٹی چینل فائلیں (5.1، 7.1، …) اسپیشل آڈیو کے لیے برآمد کی جا سکتی ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ các tệp đa kênh (5.1, 7.1, …) mới có thể xuất cho Âm thanh không gian."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "只有多聲道檔案（5.1、7.1…）才能匯出為空間音訊。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有多声道文件（5.1、7.1 等）才能为空间音频导出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有多聲道檔案（5.1、7.1 等）才能輸出為空間音訊。"
          }
        }
      }
    },
    "Only the name in the sidebar changes; the folder stays as it is. Leave it empty for the default name.": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "የሚቀየረው በጎን አሞሌው ላይ ያለው ስም ብቻ ነው፤ አቃፊው እንዳለ ይቆያል። ነባሪውን ስም ለመጠቀም ባዶ ይተዉት።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتغير الاسم في الشريط الجانبي فقط؛ ويبقى المجلد كما هو. اتركه فارغًا لاستخدام الاسم الافتراضي."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুধু সাইডবারে দেখানো নামটি বদলায়; ফোল্ডারটি যেমন আছে তেমনই থাকে। ডিফল্ট নামের জন্য খালি রাখুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Změní se jen název v bočním panelu; složka zůstane, jak je. Ponecháte-li pole prázdné, použije se výchozí název."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun navnet i indholdsoversigten ændres; mappen forbliver, som den er. Lad feltet være tomt for at bruge standardnavnet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur der Name in der Seitenleiste ändert sich; der Ordner bleibt unverändert. Lass das Feld leer, um den Standardnamen zu verwenden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αλλάζει μόνο το όνομα στην πλαϊνή στήλη· ο φάκελος μένει όπως είναι. Αφήστε το κενό για το προεπιλεγμένο όνομα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo cambia el nombre en la barra lateral; la carpeta se queda como está. Déjalo vacío para usar el nombre por omisión."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فقط نام در نوار کناری تغییر می‌کند؛ پوشه همان‌طور که هست می‌ماند. برای نام پیش‌فرض، آن را خالی بگذارید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vain sivupalkin nimi muuttuu; kansio pysyy ennallaan. Jätä kenttä tyhjäksi, jos haluat käyttää oletusnimeä."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang pangalan lang sa sidebar ang nagbabago; nananatili ang folder kung ano ito. Iwanang blangko para sa default na pangalan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul le nom dans la barre latérale change ; le dossier reste tel quel. Laissez le champ vide pour utiliser le nom par défaut."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ફક્ત સાઇડબારમાંનું નામ બદલાય છે; ફોલ્ડર જેમ છે તેમ જ રહે છે. ડિફૉલ્ટ નામ માટે તેને ખાલી રાખો."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunan da ke gefen allo ne kawai ke canzawa; folda tana nan yadda take. Bar shi babu komai don amfani da sunan tsoho."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רק השם בסרגל הצד משתנה; התיקייה נשארת כפי שהיא. השאר ריק כדי להשתמש בשם ברירת המחדל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल साइडबार में दिखने वाला नाम बदलता है; फ़ोल्डर जैसा है वैसा ही रहता है। डिफ़ॉल्ट नाम के लिए इसे खाली छोड़ दें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak az oldalsávban látható név változik; a mappa változatlan marad. Az alapértelmezett névhez hagyja üresen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya nama di bar samping yang berubah; foldernya tetap seperti semula. Biarkan kosong untuk nama default."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia solo il nome nella barra laterale; la cartella resta com’è. Lascia vuoto per usare il nome predefinito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変わるのはサイドバーの名前だけで、フォルダはそのままです。空欄にするとデフォルトの名前になります。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸೈಡ್‌ಬಾರ್‌ನಲ್ಲಿನ ಹೆಸರು ಮಾತ್ರ ಬದಲಾಗುತ್ತದೆ; ಫೋಲ್ಡರ್ ಹಾಗೆಯೇ ಉಳಿಯುತ್ತದೆ. ಡೀಫಾಲ್ಟ್ ಹೆಸರಿಗಾಗಿ ಇದನ್ನು ಖಾಲಿ ಬಿಡಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사이드바의 이름만 바뀌며 폴더는 그대로 유지됩니다. 기본 이름을 사용하려면 비워 두십시오."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സൈഡ്‌ബാറിലെ പേര് മാത്രമേ മാറൂ; ഫോൾഡർ അതുപോലെ തുടരും. ഡിഫോൾട്ട് പേരിനായി ഇത് ശൂന്യമായി വിടുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "फक्त साइडबारमधील नाव बदलते; फोल्डर जसा आहे तसाच राहतो. डीफॉल्ट नावासाठी हे रिकामे ठेवा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya nama dalam bar sisi yang berubah; folder kekal seperti sedia ada. Biarkan kosong untuk nama lalai."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare navnet i sidepanelet endres; mappen forblir som den er. La feltet stå tomt for å bruke standardnavnet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen de naam in de navigatiekolom verandert; de map blijft zoals hij is. Laat het veld leeg voor de standaardnaam."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਿਰਫ਼ ਸਾਈਡਬਾਰ ਵਿਚਲਾ ਨਾਂ ਬਦਲਦਾ ਹੈ; ਫ਼ੋਲਡਰ ਜਿਵੇਂ ਹੈ ਉਵੇਂ ਹੀ ਰਹਿੰਦਾ ਹੈ। ਪੂਰਵ-ਨਿਰਧਾਰਿਤ ਨਾਂ ਲਈ ਇਸਨੂੰ ਖਾਲੀ ਛੱਡੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmienia się tylko nazwa na pasku bocznym; folder pozostaje bez zmian. Pozostaw puste, aby użyć nazwy domyślnej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só o nome na barra lateral muda; a pasta continua como está. Deixe em branco para usar o nome padrão."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Só muda o nome na barra lateral; a pasta fica como está. Deixe em branco para usar o nome predefinido."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se schimbă doar numele din bara laterală; dosarul rămâne așa cum este. Lăsați câmpul gol pentru numele implicit."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bara namnet i sidofältet ändras; mappen förblir som den är. Lämna tomt för standardnamnet."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Jina kwenye utepe wa pembeni pekee ndilo hubadilika; folda inabaki kama ilivyo. Liache wazi ili kutumia jina chaguomsingi."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பக்கப்பட்டியிலுள்ள பெயர் மட்டுமே மாறும்; கோப்புறை அப்படியே இருக்கும். இயல்புநிலைப் பெயருக்கு இதைக் காலியாக விடவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సైడ్‌బార్‌లోని పేరు మాత్రమే మారుతుంది; ఫోల్డర్ అలాగే ఉంటుంది. డిఫాల్ట్ పేరు కోసం దీన్ని ఖాళీగా వదిలేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จะเปลี่ยนเฉพาะชื่อในแถบด้านข้าง โฟลเดอร์จะยังคงเหมือนเดิม เว้นว่างไว้เพื่อใช้ชื่อเริ่มต้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca kenar çubuğundaki ad değişir; klasör olduğu gibi kalır. Varsayılan adı kullanmak için boş bırakın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зміниться лише назва на бічній панелі, сама папка залишиться без змін. Залиште поле порожнім, щоб використати типову назву."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "صرف سائیڈ بار میں نام بدلتا ہے؛ فولڈر جیسا ہے ویسا ہی رہتا ہے۔ ڈیفالٹ نام کے لیے اسے خالی چھوڑ دیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ tên trong thanh bên thay đổi; thư mục vẫn giữ nguyên. Để trống để dùng tên mặc định."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "只會更改側邊欄中的名稱；資料夾本身維持不變。留空即使用預設名稱。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只会更改边栏中的名称，文件夹保持不变。留空则使用默认名称。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只會更改側邊欄中的名稱，檔案夾會保持原樣。留空則使用預設名稱。"
          }
        }
      }
    },
    "Only the playing track": {
      "localizations": {

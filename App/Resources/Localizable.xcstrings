    "Dolby and DTS bitstreams are sent untouched": {
      "comment": "Why the equalizer doesn't apply to Dolby/DTS sent to a receiver. Lowercase start, follows “Not applied: ”.",
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "የDolby እና DTS ቢትስትሪሞች ሳይነኩ ይላካሉ"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُرسل تدفقات Dolby وDTS دون أي تعديل"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Dolby ও DTS বিটস্ট্রিম অপরিবর্তিত অবস্থায় পাঠানো হয়"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "bitstreamy Dolby a DTS se posílají beze změny"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dolby- og DTS-bitstreams sendes uændret"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dolby- und DTS-Bitstreams werden unverändert gesendet"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "τα bitstream Dolby και DTS αποστέλλονται αναλλοίωτα"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "los bitstreams de Dolby y DTS se envían sin modificar"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بیت‌استریم‌های Dolby و DTS بدون تغییر ارسال می‌شوند"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dolby- ja DTS-bittivirrat lähetetään muuttamattomina"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "ipinapadala nang walang binabago ang mga Dolby at DTS bitstream"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "les flux binaires Dolby et DTS sont envoyés tels quels"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "Dolby અને DTS બિટસ્ટ્રીમ અપરિવર્તિત મોકલવામાં આવે છે"
          }
        },
        "ha": {

    "Copy & organize into managed folder": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ቅዳና ወደ የሚተዳደር አቃፊ አደራጅ"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نسخ وتنظيم في المجلد المُدار"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পরিচালিত ফোল্ডারে কপি ও সাজান"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zkopírovat a uspořádat do spravované složky"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopier og organiser i administreret mappe"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In verwalteten Ordner kopieren & organisieren"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αντιγραφή και οργάνωση στον διαχειριζόμενο φάκελο"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiar y organizar en la carpeta gestionada"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کپی و سازمان‌دهی در پوشهٔ مدیریت‌شده"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopioi ja järjestä hallittuun kansioon"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopyahin at ayusin sa pinamamahalaang folder"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copier et organiser dans le dossier géré"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "વ્યવસ્થાપિત ફોલ્ડરમાં કૉપિ કરીને ગોઠવો"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Kwafa kuma tsara cikin foldar da ake sarrafawa"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "העתק וארגן בתיקייה המנוהלת"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रबंधित फ़ोल्डर में कॉपी और व्यवस्थित करें"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Másolás és rendezés a kezelt mappába"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Salin & atur ke folder terkelola"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia e organizza nella cartella gestita"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "管理フォルダにコピーして整理"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಕಲಿಸಿ ನಿರ್ವಹಿಸಲಾದ ಫೋಲ್ಡರ್‌ಗೆ ಸಂಘಟಿಸಿ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "관리 폴더로 복사 및 정리"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിയന്ത്രിത ഫോൾഡറിലേക്ക് പകർത്തി ക്രമീകരിക്കുക"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "व्यवस्थापित फोल्डरमध्ये कॉपी करून व्यवस्थित लावा"
          }
        },

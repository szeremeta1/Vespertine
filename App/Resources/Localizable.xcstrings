    "Sets how Vespertine blends songs and turns transitions on.": {
      "comment": "Shortcuts action description.",
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "Vespertine ዘፈኖችን እንዴት እንደሚያቀላቅል ያዘጋጃል እና ሽግግሮችን ያበራል።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحدد كيف يمزج Vespertine الأغاني ويشغّل الانتقالات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Vespertine কীভাবে গান মেশায় তা ঠিক করে এবং ট্রানজিশন চালু করে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastaví, jak Vespertine prolíná skladby, a zapne přechody."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Angiver, hvordan Vespertine blander sange, og slår overgange til."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legt fest, wie Vespertine Titel mischt, und schaltet Übergänge ein."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ορίζει πώς το Vespertine αναμειγνύει τα τραγούδια και ενεργοποιεί τις μεταβάσεις."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Define cómo mezcla Vespertine las canciones y activa las transiciones."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تعیین می‌کند Vespertine چگونه آهنگ‌ها را ترکیب کند و گذارها را روشن می‌کند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Määrittää, miten Vespertine sekoittaa kappaleet, ja laittaa siirtymät päälle."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Itinatakda kung paano hinahalo ng Vespertine ang mga kanta at ino-on ang mga transition."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Définit comment Vespertine enchaîne les morceaux et active les transitions."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "Vespertine ગીતો કેવી રીતે ભેળવે તે નક્કી કરે છે અને ટ્રાન્ઝિશન ચાલુ કરે છે."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Yana saita yadda Vespertine ke haɗa waƙoƙi kuma yana kunna sauye-sauye."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קובע איך Vespertine ממזג שירים ומפעיל את המעברים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तय करता है कि Vespertine गाने कैसे घोलता है और ट्रांज़िशन चालू करता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Beállítja, hogyan keveri a Vespertine a dalokat, és bekapcsolja az átmeneteket."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengatur cara Vespertine membaurkan lagu dan menyalakan transisi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta come Vespertine fonde i brani e attiva le transizioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Vespertineが曲をどうブレンドするかを設定し、トランジションをオンにします。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "Vespertine ಹಾಡುಗಳನ್ನು ಹೇಗೆ ಮಿಶ್ರಿಸುತ್ತದೆ ಎಂದು ಹೊಂದಿಸುತ್ತದೆ ಮತ್ತು ಟ್ರಾನ್ಸಿಷನ್‌ಗಳನ್ನು ಆನ್ ಮಾಡುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Vespertine이 곡을 블렌드하는 방식을 정하고 전환을 켭니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Vespertine പാട്ടുകൾ എങ്ങനെ മിശ്രണം ചെയ്യുന്നു എന്ന് ക്രമീകരിക്കുകയും ട്രാൻസിഷനുകൾ ഓണാക്കുകയും ചെയ്യുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vespertine गाणी कशी मिसळते ते ठरवते आणि ट्रान्झिशन चालू करते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menetapkan cara Vespertine mengadun lagu dan menghidupkan peralihan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Angir hvordan Vespertine blander sanger, og slår på overganger."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bepaalt hoe Vespertine nummers mengt en zet overgangen aan."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੈਅ ਕਰਦਾ ਹੈ ਕਿ Vespertine ਗੀਤ ਕਿਵੇਂ ਘੋਲਦਾ ਹੈ ਅਤੇ ਟ੍ਰਾਂਜ਼ੀਸ਼ਨ ਚਾਲੂ ਕਰਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustala, jak Vespertine łączy utwory, i włącza przejścia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Define como o Vespertine mistura as músicas e ativa as transições."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Define como o Vespertine mistura as músicas e ativa as transições."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Stabilește cum mixează Vespertine melodiile și pornește tranzițiile."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anger hur Vespertine blandar låtar och slår på övergångar."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Huweka jinsi Vespertine inavyochanganya nyimbo na huwasha mipito."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Vespertine பாடல்களை எப்படிக் கலக்கிறது என்பதை அமைத்து டிரான்சிஷன்களை இயக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Vespertine పాటలను ఎలా కలుపుతుందో సెట్ చేసి ట్రాన్సిషన్‌లను ఆన్ చేస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตั้งค่าว่า Vespertine ผสมเพลงอย่างไรและเปิดการเปลี่ยนเพลง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vespertine'in şarkıları nasıl karıştıracağını ayarlar ve geçişleri açar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Задає, як Vespertine змішує пісні, і вмикає переходи."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "طے کرتا ہے کہ Vespertine گانے کیسے ملاتا ہے اور ٹرانزیشن آن کرتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt cách Vespertine hòa trộn các bài và bật chuyển bài."
          }
        },
        "zh-HK": {
          "stringUnit": {

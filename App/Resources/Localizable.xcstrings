    "Keep the defaults for everything left. Setup Assistant in the Vespertine menu brings this back.": {
      "extractionState": "manual",
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ለቀሩት ሁሉ ነባሪዎቹን ያቆዩ። በVespertine ምናሌ ውስጥ ያለው «የማዋቀሪያ ረዳት» ይህንን መልሶ ያመጣል።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احتفظ بالإعدادات الافتراضية لكل ما تبقى. يعيدك “مساعد الإعداد” في قائمة Vespertine إلى هنا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বাকি সবকিছুর জন্য ডিফল্ট রাখুন। Vespertine মেনুর “সেটআপ সহকারী” থেকে এটি আবার খোলা যাবে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro vše ostatní ponechte výchozí hodnoty. Průvodce nastavením v nabídce Vespertine tuto obrazovku kdykoli znovu otevře."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Behold standardindstillingerne for resten. Indstillingsassistent i Vespertine-menuen bringer dig tilbage hertil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für alles Übrige die Standardwerte übernehmen. Über „Einrichtungsassistent“ im Menü „Vespertine“ kommst du jederzeit hierher zurück."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κρατήστε τις προεπιλογές για όλα τα υπόλοιπα. Ο Βοηθός ρύθμισης στο μενού Vespertine σάς φέρνει ξανά εδώ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the defaults for everything left. Setup Assistant in the Vespertine menu brings this back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantener los valores por omisión en todo lo demás. El Asistente de configuración del menú Vespertine te trae de vuelta aquí."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای بقیهٔ موارد پیش‌فرض‌ها را نگه دارید. «دستیار راه‌اندازی» در منوی Vespertine این صفحه را دوباره باز می‌کند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pidä oletukset kaikessa muussa. Saat tämän takaisin Vespertine-valikon Käyttöönottoapurilla."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Panatilihin ang mga default para sa lahat ng natitira. Mabubuksan ulit ito mula sa Setup Assistant sa Vespertine menu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserver les réglages par défaut pour le reste. L’Assistant de configuration du menu Vespertine vous ramène ici."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "બાકીની બધી બાબતો માટે ડિફૉલ્ટ રાખો. Vespertine મેનૂમાંનું “સેટઅપ સહાયક” આ ફરી ખોલે છે."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Bar tsoffin saituna don sauran duka. Mataimakin Saiti a menu na Vespertine yana dawo da wannan."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השאר את ברירות המחדל לכל השאר. ״מסייע ההגדרה״ בתפריט Vespertine יחזיר את המסך הזה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बाकी सब के लिए डिफ़ॉल्ट रहने दें। Vespertine मेनू में “सेटअप असिस्टेंट” से यह फिर खुल जाएगा।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A többi beállításnál maradnak az alapértékek. A Vespertine menü Beállítási asszisztens parancsával bármikor visszatérhet ide."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan default untuk semua yang tersisa. Asisten Pengaturan di menu Vespertine akan membuka ini kembali."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantieni le impostazioni predefinite per tutto il resto. Puoi tornare qui con Assistente configurazione nel menu Vespertine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残りはすべてデフォルトのままにします。Vespertineメニューの「設定アシスタント」からいつでもこの画面に戻れます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಉಳಿದ ಎಲ್ಲದಕ್ಕೂ ಡೀಫಾಲ್ಟ್ ಇರಲಿ. Vespertine ಮೆನುವಿನಲ್ಲಿರುವ “ಸೆಟಪ್ ಸಹಾಯಕ” ಇದನ್ನು ಮತ್ತೆ ತೆರೆಯುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나머지는 모두 기본값으로 둡니다. Vespertine 메뉴의 설정 지원에서 언제든지 다시 열 수 있습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ബാക്കിയുള്ളവയ്ക്കെല്ലാം ഡിഫോൾട്ട് നിലനിർത്തുക. Vespertine മെനുവിലെ “സജ്ജീകരണ സഹായി” ഇത് വീണ്ടും തുറക്കും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "उरलेल्या सर्वांसाठी डीफॉल्ट ठेवा. Vespertine मेनूमधील “सेटअप असिस्टंट” हे पुन्हा उघडते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kekalkan lalai untuk semua yang selebihnya. Pembantu Persediaan dalam menu Vespertine akan membuka ini semula."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Behold standardvalgene for resten. Oppsettassistent i Vespertine-menyen tar deg tilbake hit."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Behoud de standaardinstellingen voor de rest. Via ‘Configuratieassistent’ in het Vespertine-menu kom je hier terug."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਬਾਕੀ ਸਭ ਲਈ ਪੂਰਵ-ਨਿਰਧਾਰਿਤ ਰਹਿਣ ਦਿਓ। Vespertine ਮੀਨੂ ਵਿੱਚ ‘ਸੈੱਟਅੱਪ ਸਹਾਇਕ’ ਨਾਲ ਇਹ ਮੁੜ ਖੁੱਲ੍ਹ ਜਾਂਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dla całej reszty zostaw ustawienia domyślne. Asystent konfiguracji w menu Vespertine przywróci ten ekran."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Manter os padrões para todo o resto. O Assistente de Configuração no menu Vespertine traz você de volta aqui."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Manter as predefinições em tudo o resto. O Assistente de configuração no menu Vespertine volta a mostrar isto."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Păstrați valorile implicite pentru restul. Asistentul de configurare din meniul Vespertine vă readuce aici."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Behåll standardinställningarna för resten. Inställningsassistent i Vespertine-menyn tar dig tillbaka hit."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Acha chaguomsingi kwa vyote vilivyobaki. Msaidizi wa Kuweka Mipangilio katika menyu ya Vespertine hurejesha hatua hizi."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மீதமுள்ள அனைத்துக்கும் இயல்புநிலையையே வைத்திரு. Vespertine மெனுவில் உள்ள ‘அமைவு உதவி’ இதை மீண்டும் திறக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మిగిలిన వాటన్నింటికీ డిఫాల్ట్‌లను ఉంచండి. Vespertine మెనూలోని “సెటప్ అసిస్టెంట్” దీన్ని మళ్లీ తెరుస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ค่าเริ่มต้นสำหรับทุกอย่างที่เหลือ เปิดหน้านี้อีกครั้งได้จาก ผู้ช่วยตั้งค่า ในเมนู Vespertine"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalan her şey için varsayılanları koruyun. Vespertine menüsündeki Kurulum Yardımcısı bu ekranı yeniden açar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для решти залиште типові налаштування. Асистент налаштування в меню Vespertine поверне цей екран."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "باقی ہر چیز کے لیے ڈیفالٹس برقرار رکھیں۔ Vespertine مینو میں سیٹ اپ اسسٹنٹ اسے دوبارہ لے آتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ mặc định cho mọi thứ còn lại. Bạn có thể mở lại phần này bằng Trợ lý thiết lập trong menu Vespertine."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "其餘項目全部保留預設值。可從 Vespertine 選單中的「設定輔助程式」再次開啟此畫面。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其余设置全部保留默认值。可通过 Vespertine 菜单中的“设置助理”再次打开此向导。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "其餘項目全部保留預設值。可從 Vespertine 選單中的「設定輔助程式」再次開啟此畫面。"
          }
        }
      }
    },

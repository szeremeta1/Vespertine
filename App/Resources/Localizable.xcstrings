        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಡಿಸ್ಕ್ ಇಮೇಜ್‌ನಲ್ಲಿ ಆಡಿಯೋ ಫ್ರೇಮ್‌ಗಳು ಕಾಣೆಯಾಗಿವೆ ಅಥವಾ ಹಾನಿಗೊಂಡಿವೆ, ನಿಶ್ಯಬ್ದವಾಗಿ ಪ್ಲೇ ಮಾಡಲಾಗಿದೆ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "디스크 이미지에서 누락되었거나 손상된 프레임, 무음으로 재생됨"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഡിസ്ക് ഇമേജിലെ ഫ്രെയിമുകൾ നഷ്ടപ്പെട്ടതോ കേടായതോ ആണ്, നിശ്ശബ്ദതയായി പ്ലേ ചെയ്യുന്നു"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "डिस्क इमेजमधील ऑडिओ फ्रेम गहाळ किंवा खराब आहेत, शांततेच्या रूपात वाजवल्या जातात"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bingkai hilang atau rosak dalam imej cakera, dimainkan sebagai senyap"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Manglende eller skadede lydrammer i platebildet, spilt av som stillhet"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ontbrekende of beschadigde frames in de schijfkopie, afgespeeld als stilte"

        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ರೆಕಾರ್ಡಿಂಗ್ %@ ಫ್ರೇಮ್‌ಗಳನ್ನು ಕಳೆದುಕೊಂಡಿದೆ, ಆದ್ದರಿಂದ ಬಳಸಲಾಗದು."

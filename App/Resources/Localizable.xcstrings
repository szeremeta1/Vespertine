    "Can’t reach %@. Check that the server is on, and if you reach it through Tailscale or another VPN, that it’s connected.": {
      "comment": "A server's name or address.",
      "extractionState": "manual",
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ን ማግኘት አልተቻለም። አገልጋዩ መብራቱን፣ በTailscale ወይም በሌላ VPN የሚደርሱበት ከሆነም መገናኘቱን ያረጋግጡ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتعذر الوصول إلى %@. تحقق من أن الخادم قيد التشغيل، وإذا كنت تصل إليه عبر Tailscale أو VPN آخر، فتحقق من أنه متصل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-এ পৌঁছানো যাচ্ছে না। সার্ভার চালু আছে কি না দেখুন, এবং আপনি যদি Tailscale বা অন্য কোনো VPN-এর মাধ্যমে পৌঁছান, তবে সেটি সংযুক্ত আছে কি না।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ není dostupný. Zkontrolujte, zda je server zapnutý, a pokud se k němu připojujete přes Tailscale nebo jinou VPN, zda je připojená."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kan ikke nås. Kontroller, at serveren er tændt, og hvis du når den via Tailscale eller en anden VPN, at den er forbundet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist nicht erreichbar. Prüfe, ob der Server eingeschaltet ist und, falls du ihn über Tailscale oder ein anderes VPN erreichst, ob dieses verbunden ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν είναι δυνατή η πρόσβαση στο %@. Ελέγξτε ότι ο διακομιστής είναι ενεργός και, αν έχετε πρόσβαση σε αυτόν μέσω Tailscale ή άλλου VPN, ότι αυτό είναι συνδεδεμένο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can’t reach %@. Check that the server is on, and if you reach it through Tailscale or another VPN, that it’s connected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede acceder a %@. Comprueba que el servidor esté encendido y, si accedes a él a través de Tailscale u otra VPN, que esté conectada."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دسترسی به %@ ممکن نیست. بررسی کنید که سرور روشن باشد و اگر از طریق Tailscale یا VPN دیگری به آن دسترسی دارید، آن وصل باشد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Palvelinta %@ ei tavoiteta. Tarkista, että palvelin on päällä ja että Tailscale tai muu VPN, jonka kautta yhdistät, on yhdistetty."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi maabot ang %@. Tiyaking naka-on ang server, at kung inaabot mo ito sa pamamagitan ng Tailscale o ibang VPN, na nakakonekta ito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de joindre %@. Vérifiez que le serveur est allumé et, si vous y accédez via Tailscale ou un autre VPN, que celui-ci est connecté."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ સુધી પહોંચી શકાતું નથી. સર્વર ચાલુ છે કે નહીં તે તપાસો, અને તમે Tailscale અથવા બીજા VPN દ્વારા પહોંચતા હો, તો તે કનેક્ટ છે કે નહીં તે તપાસો."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ba a iya isa ga %@ ba. Duba cewa sabar tana kunne, kuma idan kuna isa gare ta ta Tailscale ko wani VPN, cewa an haɗa shi."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין גישה אל %@. ודא שהשרת פועל, ואם אתה מתחבר אליו דרך Tailscale או VPN אחר, ודא שהוא מחובר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ तक नहीं पहुँचा जा सका। जाँचें कि सर्वर चालू है, और अगर आप उस तक Tailscale या किसी दूसरे VPN से पहुँचते हैं, तो वह कनेक्ट है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nem érhető el. Ellenőrizze, hogy a szerver be van-e kapcsolva, és ha Tailscale-en vagy más VPN-en keresztül éri el, hogy az csatlakoztatva van-e."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat menjangkau %@. Pastikan server menyala, dan jika Anda menjangkaunya melalui Tailscale atau VPN lain, pastikan itu terhubung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile raggiungere %@. Verifica che il server sia acceso e, se lo raggiungi tramite Tailscale o un’altra VPN, che sia connessa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@に接続できません。サーバの電源が入っていること、またTailscaleや別のVPN経由で接続する場合は、それが接続されていることを確認してください。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ತಲುಪಲು ಸಾಧ್ಯವಿಲ್ಲ. ಸರ್ವರ್ ಆನ್ ಆಗಿದೆಯೇ, ಮತ್ತು ನೀವು Tailscale ಅಥವಾ ಬೇರೆ VPN ಮೂಲಕ ತಲುಪುತ್ತಿದ್ದರೆ ಅದು ಸಂಪರ್ಕಗೊಂಡಿದೆಯೇ ಎಂದು ಪರಿಶೀಲಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에 연결할 수 없습니다. 서버가 켜져 있는지, 그리고 Tailscale이나 다른 VPN을 통해 연결하는 경우 해당 VPN이 연결되어 있는지 확인하십시오."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-ൽ എത്താനാകുന്നില്ല. സെർവർ ഓണാണോ എന്നും, Tailscale അല്ലെങ്കിൽ മറ്റൊരു VPN വഴിയാണ് എത്തുന്നതെങ്കിൽ അത് കണക്റ്റ് ചെയ്തിട്ടുണ്ടോ എന്നും പരിശോധിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ पर्यंत पोहोचता येत नाही. सर्व्हर चालू आहे का ते तपासा, आणि तुम्ही Tailscale किंवा दुसऱ्या VPN द्वारे पोहोचत असल्यास, ते कनेक्ट आहे का ते तपासा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat mencapai %@. Pastikan pelayan dihidupkan, dan jika anda mencapainya melalui Tailscale atau VPN lain, pastikan ia bersambung."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan ikke nå %@. Sjekk at tjeneren er på, og hvis du når den via Tailscale eller en annen VPN, at den er tilkoblet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan %@ niet bereiken. Controleer of de server aan staat en, als je hem via Tailscale of een ander VPN bereikt, of dat verbonden is."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ਤੱਕ ਨਹੀਂ ਪਹੁੰਚਿਆ ਜਾ ਸਕਦਾ। ਜਾਂਚੋ ਕਿ ਸਰਵਰ ਚਾਲੂ ਹੈ, ਅਤੇ ਜੇ ਤੁਸੀਂ ਇਸ ਤੱਕ Tailscale ਜਾਂ ਕਿਸੇ ਹੋਰ VPN ਰਾਹੀਂ ਪਹੁੰਚਦੇ ਹੋ, ਤਾਂ ਕਿ ਉਹ ਕਨੈਕਟ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można połączyć się z %@. Sprawdź, czy serwer jest włączony, a jeśli łączysz się z nim przez Tailscale lub inną sieć VPN, czy jest ona połączona."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível acessar %@. Verifique se o servidor está ligado e, se você o acessa pelo Tailscale ou por outra VPN, se ela está conectada."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível aceder a %@. Verifique se o servidor está ligado e, se lhe acede através do Tailscale ou de outra VPN, se esta está ligada."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nu poate fi accesat. Verificați dacă serverul este pornit și, dacă îl accesați prin Tailscale sau alt VPN, dacă acesta este conectat."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det går inte att nå %@. Kontrollera att servern är på och, om du når den via Tailscale eller ett annat VPN, att det är anslutet."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Haiwezi kufikia %@. Hakikisha seva imewashwa, na ikiwa unaifikia kupitia Tailscale au VPN nyingine, kwamba imeunganishwa."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-ஐ அணுக முடியவில்லை. சர்வர் இயக்கத்தில் உள்ளதா என்றும், Tailscale அல்லது வேறொரு VPN மூலம் அணுகினால் அது இணைக்கப்பட்டுள்ளதா என்றும் சரிபார்க்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ని చేరుకోలేకపోయింది. సర్వర్ ఆన్‌లో ఉందో, మీరు Tailscale లేదా మరో VPN ద్వారా చేరుకుంటే అది కనెక్ట్ అయి ఉందో తనిఖీ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ติดต่อ %@ ไม่ได้ ตรวจสอบว่าเซิร์ฟเวอร์เปิดอยู่ และหากคุณเชื่อมต่อผ่าน Tailscale หรือ VPN อื่น ให้ตรวจสอบว่าเชื่อมต่ออยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sunucusuna erişilemiyor. Sunucunun açık olduğunu ve ona Tailscale veya başka bir VPN üzerinden erişiyorsanız bunun bağlı olduğunu denetleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдається зв’язатися з %@. Переконайтеся, що сервер увімкнено, а якщо ви підключаєтеся до нього через Tailscale чи інший VPN, — що з’єднання активне."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ تک رسائی نہیں ہو سکی۔ جانچ لیں کہ سرور آن ہے، اور اگر آپ اس تک Tailscale یا کسی دوسرے VPN کے ذریعے پہنچتے ہیں تو وہ منسلک ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể truy cập %@. Hãy kiểm tra máy chủ đã bật chưa, và nếu bạn truy cập qua Tailscale hoặc VPN khác, hãy kiểm tra kết nối đó."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "無法連接 %@。請檢查伺服器是否已開啟；如你經 Tailscale 或其他 VPN 連接，請檢查其是否已連接。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法访问 %@。请检查服务器是否已开启；如果你通过 Tailscale 或其他 VPN 访问它，请检查其是否已连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法連線到 %@。請檢查伺服器是否已開啟；如果你是透過 Tailscale 或其他 VPN 連線，請檢查其是否已連線。"
          }
        }
      }
    },
    "Changes the sound, so this output isn't bit-perfect while one is on.": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ድምፁን ይቀይራል፣ ስለዚህ አንዱ በበራ ጊዜ ይህ ውፅዓት ቢት-ፍጹም አይደለም።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يغيّر الصوت، لذا لا يكون هذا المخرج مطابقًا للبتات أثناء تشغيل أحدها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি শব্দ বদলায়, তাই এটি চালু থাকলে এই আউটপুট বিট-পারফেক্ট থাকে না।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mění zvuk, takže tento výstup není bit-perfect, dokud je ekvalizér zapnutý."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ændrer lyden, så dette output er ikke bitperfekt, mens en equalizer er slået til."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verändert den Klang, daher ist diese Ausgabe nicht bit-perfekt, solange einer aktiv ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αλλάζει τον ήχο, οπότε αυτή η έξοδος δεν είναι bit-perfect όσο είναι ενεργός."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia el sonido, así que esta salida no es bit-perfect mientras haya uno activado."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "صدا را تغییر می‌دهد، بنابراین تا وقتی یکی روشن است، این خروجی بیت‌به‌بیت نیست."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muuttaa ääntä, joten tämä ulostulo ei ole bittitarkka, kun taajuuskorjain on päällä."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Binabago nito ang tunog, kaya hindi bit-perfect ang output na ito habang may naka-on na equalizer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifie le son : cette sortie n’est donc pas bit-perfect lorsqu’un égaliseur est actif."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "અવાજ બદલે છે, તેથી ઇક્વલાઇઝર ચાલુ હોય ત્યારે આ આઉટપુટ બિટ-પરફેક્ટ રહેતું નથી."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Yana canza sautin, don haka wannan fitarwa ba bit-perfect ba ce yayin da ɗaya yake kunne."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "משנה את הצליל, ולכן פלט זה אינו מדויק לסיבית כל עוד אקולייזר פועל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह ध्वनि बदलता है, इसलिए इसके चालू रहते यह आउटपुट बिट-परफ़ेक्ट नहीं रहता।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Megváltoztatja a hangzást, így amíg be van kapcsolva, ez a kimenet nem bit-perfect."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengubah suara, sehingga output ini tidak bit-perfect selama ekualiser aktif."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifica il suono, quindi questa uscita non è bit-perfect mentre un equalizzatore è attivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音を変えるため、オンの間はこの出力はビットパーフェクトではありません。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇದು ಧ್ವನಿಯನ್ನು ಬದಲಾಯಿಸುತ್ತದೆ, ಆದ್ದರಿಂದ ಒಂದು ಆನ್ ಇರುವಾಗ ಈ ಔಟ್‌ಪುಟ್ ಬಿಟ್-ಪರ್ಫೆಕ್ಟ್ ಆಗಿರುವುದಿಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소리를 변경하므로, 켜져 있는 동안 이 출력은 비트 퍼펙트가 아닙니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ശബ്ദം മാറ്റുന്നു, അതിനാൽ ഒന്ന് ഓണായിരിക്കുമ്പോൾ ഈ ഔട്ട്‌പുട്ട് ബിറ്റ്-പെർഫെക്റ്റ് അല്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आवाज बदलतो, त्यामुळे इक्वलायझर चालू असताना हे आउटपुट बिट-परफेक्ट राहत नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengubah bunyi, jadi output ini tidak bit-perfect semasa penyama aktif."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Endrer lyden, så denne utgangen er ikke bitperfekt mens en equalizer er på."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wijzigt het geluid, dus deze uitvoer is niet bitperfect zolang er een aan staat."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਹ ਆਵਾਜ਼ ਬਦਲਦਾ ਹੈ, ਇਸ ਲਈ ਇਸਦੇ ਚਾਲੂ ਰਹਿਣ ਤੱਕ ਇਹ ਆਉਟਪੁੱਟ ਬਿੱਟ-ਪਰਫ਼ੈਕਟ ਨਹੀਂ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmienia brzmienie, więc gdy jest włączony, to wyjście nie jest bit-perfect."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Altera o som, então esta saída não é bit-perfect enquanto houver um ativado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Altera o som, por isso esta saída não é bit-perfect enquanto houver um ativado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifică sunetul, așa că această ieșire nu este bit-perfect cât timp unul este activat."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändrar ljudet, så den här utgången är inte bitperfekt medan en är på."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hubadilisha sauti, kwa hivyo kifaa hiki hakitoi bit-perfect kikiwa kimewashwa."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒலியை மாற்றும், எனவே ஒன்று ஆனில் இருக்கும்போது இந்த வெளியீடு பிட்-பெர்ஃபெக்டாக இருக்காது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇది ధ్వనిని మారుస్తుంది, కాబట్టి ఒకటి ఆన్‌లో ఉన్నప్పుడు ఈ అవుట్‌పుట్ బిట్-పర్ఫెక్ట్ కాదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปลี่ยนแปลงเสียง ขาออกนี้จึงไม่เป็นบิตเพอร์เฟกต์ขณะที่เปิดใช้อยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesi değiştirir; bu yüzden biri açıkken bu çıkış bit-perfect değildir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Змінює звук, тож поки еквалайзер увімкнено, цей вихід не біт-у-біт."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آواز کو بدلتا ہے، اس لیے جب تک کوئی آن ہو یہ آؤٹ پٹ بٹ پرفیکٹ نہیں رہتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thay đổi âm thanh, vì vậy đầu ra này không còn bit-perfect khi bộ chỉnh âm đang bật."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "會改變聲音，因此開啟後此輸出不再是位元完美。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会改变声音，因此打开均衡器时此输出不是比特完美。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "會改變聲音，因此開啟等化器時，此輸出不是位元完美。"
          }
        }
      }
    },
    "Channel bed through Vespertine": {
      "localizations": {

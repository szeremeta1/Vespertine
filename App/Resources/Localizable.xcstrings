    "The measurement needs an input device, an output device and channel numbers that are not negative.": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "መለኪያው የግብዓት መሣሪያ፣ የውጤት መሣሪያ እና አሉታዊ ያልሆኑ የቻናል ቁጥሮች ያስፈልገዋል።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج القياس إلى جهاز إدخال وجهاز إخراج وأرقام قنوات غير سالبة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পরিমাপের জন্য একটি ইনপুট ডিভাইস, একটি আউটপুট ডিভাইস এবং ঋণাত্মক নয় এমন চ্যানেল নম্বর দরকার।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Měření potřebuje vstupní zařízení, výstupní zařízení a nezáporná čísla kanálů."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Målingen kræver en inputenhed, en outputenhed og kanalnumre, der ikke er negative."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Messung braucht ein Eingabegerät, ein Ausgabegerät und nicht negative Kanalnummern."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η μέτρηση χρειάζεται συσκευή εισόδου, συσκευή εξόδου και μη αρνητικούς αριθμούς καναλιών."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La medición necesita un dispositivo de entrada, uno de salida y números de canal no negativos."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اندازه‌گیری به یک دستگاه ورودی، یک دستگاه خروجی و شماره‌های کانال نامنفی نیاز دارد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mittaus tarvitsee tulolaitteen, lähtölaitteen ja ei-negatiiviset kanavanumerot."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kailangan ng pagsukat ng input device, output device at mga numero ng channel na hindi negatibo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La mesure nécessite un appareil d'entrée, un appareil de sortie et des numéros de canal non négatifs."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "માપન માટે ઇનપુટ ડિવાઇસ, આઉટપુટ ડિવાઇસ અને ઋણ ન હોય તેવા ચેનલ નંબર જોઈએ."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Aunawa tana buƙatar na'urar shigarwa, na'urar fitarwa da lambobin tasha waɗanda ba su da korau."

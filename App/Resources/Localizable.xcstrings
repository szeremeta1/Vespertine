          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нічого не відтворюється, доки вибраний вами вихід не буде під’єднано знову."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جب تک آپ کا منتخب کردہ آؤٹ پٹ دوبارہ منسلک نہ ہو، کچھ نہیں چلے گا۔"

            "state": "translated",
            "value": "%@ Vespertine سی دقیقهٔ دیگر یا وقتی «اتصال مجدد» را انتخاب کنید، دوباره تلاش می‌کند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",

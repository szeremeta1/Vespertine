    "The steep cutoff at ~%@ kHz is this %@ kHz file's own anti-alias filter.": {
      "extractionState": "manual",
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "በ~%1$@ kHz ላይ ያለው ቁልቁለታማ መቁረጫ የዚህ የ%2$@ kHz ፋይል የራሱ anti-alias ማጣሪያ ነው።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "القطع الحاد عند ~%1$@ kHz هو مرشح منع التشوه الخاص بهذا الملف بمعدل %2$@ kHz."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "~%1$@ kHz-এ খাড়া কাটঅফটি এই %2$@ kHz ফাইলের নিজস্ব অ্যান্টি-অ্যালিয়াস ফিল্টার।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Strmý ořez na ~%@ kHz je vlastní antialiasingový filtr tohoto souboru %@ kHz."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den stejle afskæring ved ~%@ kHz er denne %@ kHz-fils eget anti-aliasing-filter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der steile Abfall bei ~%@ kHz ist der eigene Anti-Aliasing-Filter dieser %@-kHz-Datei."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η απότομη αποκοπή στα ~%1$@ kHz είναι το ίδιο το φίλτρο anti-alias αυτού του αρχείου %2$@ kHz."
          }
        },

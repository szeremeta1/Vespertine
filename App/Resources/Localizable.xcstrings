    "Checking the %@ speaker reaches the microphone": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "የ%@ ድምጽ ማጉያ ማይክሮፎኑ ጋር መድረሱን በመፈተሽ ላይ"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جارٍ التحقق من وصول صوت السماعة %@ إلى الميكروفون"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ স্পিকারের শব্দ মাইক্রোফোনে পৌঁছাচ্ছে কি না দেখা হচ্ছে"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrola, zda reproduktor %@ dosáhne k mikrofonu"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tjekker, at højttaleren %@ når mikrofonen"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe, ob der Lautsprecher %@ das Mikrofon erreicht"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Έλεγχος ότι το ηχείο %@ φτάνει στο μικρόφωνο"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprobando que el altavoz %@ llega al micrófono"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بررسی اینکه بلندگوی %@ به میکروفون می‌رسد"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarkistetaan, että kaiutin %@ kuuluu mikrofoniin"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinusuri kung naaabot ng %@ speaker ang mikropono"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérification que l'enceinte %@ atteint le micro"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ સ્પીકર માઇક્રોફોન સુધી પહોંચે છે કે નહીં તે તપાસી રહ્યા છીએ"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ana duba ko lasifikar %@ ta kai ga makirufo"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בודק שהרמקול %@ מגיע למיקרופון"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जाँच रहे हैं कि %@ स्पीकर माइक्रोफ़ोन तक पहुँच रहा है"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ellenőrzés: a(z) %@ hangszóró eljut-e a mikrofonig"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memeriksa apakah speaker %@ sampai ke mikrofon"

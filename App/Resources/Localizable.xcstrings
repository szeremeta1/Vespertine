    "Only turn this on if your DAC supports DoP. Otherwise DSD is converted to PCM.": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ይህንን የሚያበሩት DACዎ DoPን የሚደግፍ ከሆነ ብቻ ነው። አለበለዚያ DSD ወደ PCM ይቀየራል።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تشغّل هذا الخيار إلا إذا كان DAC لديك يدعم DoP. وإلا يتم تحويل DSD إلى PCM."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার DAC DoP সমর্থন করলেই কেবল এটি চালু করুন। অন্যথায় DSD-কে PCM-এ রূপান্তর করা হয়।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapněte jen tehdy, pokud váš DAC podporuje DoP. Jinak se DSD převádí na PCM."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå kun dette til, hvis din DAC understøtter DoP. Ellers konverteres DSD til PCM."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere dies nur, wenn dein DAC DoP unterstützt. Andernfalls wird DSD in PCM konvertiert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ενεργοποιήστε το μόνο αν το DAC σας υποστηρίζει DoP. Διαφορετικά, το DSD μετατρέπεται σε PCM."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actívalo solo si tu DAC es compatible con DoP. De lo contrario, el DSD se convierte a PCM."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فقط اگر DAC شما از DoP پشتیبانی می‌کند این را روشن کنید. در غیر این صورت DSD به PCM تبدیل می‌شود."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ota tämä käyttöön vain, jos DAC tukee DoP:tä. Muuten DSD muunnetaan PCM:ksi."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "I-on lang ito kung sinusuportahan ng DAC mo ang DoP. Kung hindi, kino-convert ang DSD sa PCM."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "N’activez cette option que si votre DAC prend en charge le DoP. Sinon, le DSD est converti en PCM."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારું DAC DoP ને સપોર્ટ કરતું હોય તો જ આ ચાલુ કરો. નહીં તો DSD ને PCM માં રૂપાંતરિત કરાય છે."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunna wannan kawai idan DAC ɗinku yana goyon bayan DoP. In ba haka ba ana canza DSD zuwa PCM."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפעל אפשרות זו רק אם ה־DAC שלך תומך ב־DoP. אחרת DSD מומר ל־PCM."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसे केवल तभी चालू करें जब आपका DAC DoP का समर्थन करता हो। अन्यथा DSD को PCM में बदला जाता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak akkor kapcsolja be, ha a DAC-ja támogatja a DoP-t. Ellenkező esetben a DSD PCM-mé alakul."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktifkan ini hanya jika DAC Anda mendukung DoP. Jika tidak, DSD dikonversi ke PCM."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attivalo solo se il tuo DAC supporta il DoP. Altrimenti il DSD viene convertito in PCM."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "DACがDoPに対応している場合のみオンにしてください。それ以外の場合、DSDはPCMに変換されます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ DAC DoP ಅನ್ನು ಬೆಂಬಲಿಸಿದರೆ ಮಾತ್ರ ಇದನ್ನು ಆನ್ ಮಾಡಿ. ಇಲ್ಲದಿದ್ದರೆ DSD ಅನ್ನು PCM ಗೆ ಪರಿವರ್ತಿಸಲಾಗುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "DAC가 DoP를 지원하는 경우에만 켜십시오. 그렇지 않으면 DSD는 PCM으로 변환됩니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ DAC, DoP പിന്തുണയ്ക്കുന്നുണ്ടെങ്കിൽ മാത്രം ഇത് ഓണാക്കുക. അല്ലെങ്കിൽ DSD, PCM-ലേക്ക് പരിവർത്തനം ചെയ്യും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमचा DAC DoP ला सपोर्ट करत असेल तरच हे चालू करा. अन्यथा DSD चे PCM मध्ये रूपांतर केले जाते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya aktifkan ini jika DAC anda menyokong DoP. Jika tidak, DSD ditukar kepada PCM."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå bare på dette hvis DAC-en din støtter DoP. Ellers konverteres DSD til PCM."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet dit alleen aan als je DAC DoP ondersteunt. Anders wordt DSD omgezet naar PCM."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸਨੂੰ ਸਿਰਫ਼ ਤਾਂ ਹੀ ਚਾਲੂ ਕਰੋ ਜੇ ਤੁਹਾਡਾ DAC DoP ਦਾ ਸਮਰਥਨ ਕਰਦਾ ਹੈ। ਨਹੀਂ ਤਾਂ DSD ਨੂੰ PCM ਵਿੱਚ ਬਦਲਿਆ ਜਾਂਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącz tylko wtedy, gdy Twój DAC obsługuje DoP. W przeciwnym razie DSD jest konwertowane na PCM."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só ative isto se o seu DAC for compatível com DoP. Caso contrário, o DSD é convertido em PCM."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative isto apenas se o DAC suportar DoP. Caso contrário, o DSD é convertido em PCM."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Activați această opțiune doar dacă DAC-ul acceptă DoP. Altfel, DSD este convertit în PCM."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivera bara detta om din DAC har stöd för DoP. Annars konverteras DSD till PCM."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Washa hii tu ikiwa DAC yako inatumia DoP. Vinginevyo DSD hugeuzwa kuwa PCM."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் DAC DoP-ஐ ஆதரித்தால் மட்டுமே இதை ஆன் செய்யவும். இல்லையெனில் DSD, PCM-ஆக மாற்றப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ DAC DoPని సపోర్ట్ చేస్తేనే దీన్ని ఆన్ చేయండి. లేకపోతే DSD, PCMగా మార్చబడుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดเฉพาะเมื่อ DAC ของคุณรองรับ DoP มิฉะนั้น DSD จะถูกแปลงเป็น PCM"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunu yalnızca DAC’niz DoP’yi destekliyorsa açın. Aksi takdirde DSD, PCM’e dönüştürülür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вмикайте це, лише якщо ваш ЦАП підтримує DoP. Інакше DSD перетворюється на PCM."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اسے صرف تب آن کریں جب آپ کا DAC، DoP کو سپورٹ کرتا ہو۔ ورنہ DSD کو PCM میں تبدیل کر دیا جاتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ bật tùy chọn này nếu DAC của bạn hỗ trợ DoP. Nếu không, DSD sẽ được chuyển đổi sang PCM."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "只在你的 DAC 支援 DoP 時才開啟此選項。否則 DSD 會轉換為 PCM。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅当你的 DAC 支持 DoP 时才打开此选项。否则 DSD 会被转换为 PCM。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請只在你的 DAC 支援 DoP 時才開啟此選項。否則 DSD 會轉換為 PCM。"
          }
        }
      }
    },

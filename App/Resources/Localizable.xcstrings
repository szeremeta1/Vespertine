          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectado, mas não há nenhuma pasta “%@” nesse compartilhamento."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ligado, mas não existe nenhuma pasta “%@” nessa partilha."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectat, dar în partajare nu există dosarul „%@”."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ansluten, men det finns ingen mapp ”%@” i resursen."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Imeunganishwa, lakini hakuna folda “%@” katika folda hiyo ya mtandao."

    "The timing tones didn't come through the microphone, so the capture can't be aligned.": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "የጊዜ ቃናዎቹ በማይክሮፎኑ በኩል አልመጡም፣ ስለዚህ ቀረጻው ሊጣጣም አይችልም።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تصل نغمات التوقيت عبر الميكروفون، لذا لا يمكن محاذاة التسجيل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "টাইমিং টোনগুলো মাইক্রোফোনের মধ্য দিয়ে আসেনি, তাই ক্যাপচারটি সারিবদ্ধ করা যাচ্ছে না।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Časovací tóny nedorazily přes mikrofon, takže záznam nelze zarovnat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidstonerne kom ikke igennem mikrofonen, så optagelsen kan ikke justeres."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zeittöne kamen nicht über das Mikrofon an, daher lässt sich die Aufnahme nicht ausrichten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι τόνοι χρονισμού δεν πέρασαν από το μικρόφωνο, επομένως η καταγραφή δεν μπορεί να ευθυγραμμιστεί."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los tonos de sincronización no llegaron por el micrófono, así que la captura no se puede alinear."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "صداهای زمان‌بندی از میکروفون نرسیدند، بنابراین ضبط قابل هم‌ترازی نیست."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoitusäänet eivät tulleet mikrofonin kautta, joten tallennetta ei voi kohdistaa."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi dumaan sa mikropono ang mga timing tone, kaya hindi maiayos ang capture."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les tonalités de synchronisation ne sont pas passées par le micro ; la capture ne peut donc pas être alignée."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ટાઇમિંગ ટોન માઇક્રોફોન દ્વારા આવ્યા નહીં, તેથી કેપ્ચરને સંરેખિત કરી શકાતું નથી."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Sautunan lokaci ba su shigo ta makirufo ba, don haka ba za a iya daidaita ɗaukar ba."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "צלילי התזמון לא עברו דרך המיקרופון, ולכן אי אפשר ליישר את ההקלטה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टाइमिंग टोन माइक्रोफ़ोन से नहीं आईं, इसलिए कैप्चर संरेखित नहीं हो सकता।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az időzítő hangok nem jutottak át a mikrofonon, így a felvételt nem lehet igazítani."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada waktu tidak masuk lewat mikrofon sehingga rekaman tidak dapat disejajarkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I toni di sincronizzazione non sono arrivati dal microfono, quindi l'acquisizione non può essere allineata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイミング音がマイクに入らなかったため、収録の位置合わせができません。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಟೈಮಿಂಗ್ ಟೋನ್‌ಗಳು ಮೈಕ್ರೊಫೋನ್ ಮೂಲಕ ಬರಲಿಲ್ಲ, ಆದ್ದರಿಂದ ಕ್ಯಾಪ್ಚರ್ ಅನ್ನು ಹೊಂದಿಸಲಾಗದು."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "타이밍 톤이 마이크로 들어오지 않아 캡처를 정렬할 수 없습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ടൈമിംഗ് ടോണുകൾ മൈക്രോഫോണിലൂടെ വന്നില്ല, അതിനാൽ ക്യാപ്ചർ ക്രമീകരിക്കാനാവില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "टायमिंग टोन मायक्रोफोनमधून आल्या नाहीत, म्हणून कॅप्चर संरेखित करता येत नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada masa tidak masuk melalui mikrofon, jadi tangkapan tidak dapat diselaraskan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidstonene kom ikke gjennom mikrofonen, så opptaket kan ikke justeres."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De tijdtonen kwamen niet via de microfoon binnen, dus de opname kan niet worden uitgelijnd."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਟਾਈਮਿੰਗ ਟੋਨ ਮਾਈਕ੍ਰੋਫ਼ੋਨ ਰਾਹੀਂ ਨਹੀਂ ਆਈਆਂ, ਇਸ ਲਈ ਕੈਪਚਰ ਨੂੰ ਇਕਸਾਰ ਨਹੀਂ ਕੀਤਾ ਜਾ ਸਕਦਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tony synchronizacyjne nie dotarły przez mikrofon, więc nagrania nie można wyrównać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os tons de sincronização não chegaram pelo microfone, então a captura não pode ser alinhada."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os tons de sincronização não chegaram pelo microfone, por isso a captura não pode ser alinhada."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Tonurile de sincronizare nu au ajuns prin microfon, deci captura nu poate fi aliniată."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidstonerna kom inte fram via mikrofonen, så inspelningen kan inte justeras."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Toni za muda hazikupita kwenye maikrofoni, kwa hivyo rekodi haiwezi kupangiliwa."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நேர ஒலிகள் மைக்ரோஃபோன் வழியாக வரவில்லை, எனவே பதிவை சீரமைக்க முடியாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "టైమింగ్ టోన్లు మైక్రోఫోన్ ద్వారా రాలేదు, కాబట్టి క్యాప్చర్‌ను సరిచేయలేము."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เสียงจังหวะไม่ผ่านไมโครโฟน จึงจัดแนวการบันทึกไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamanlama tonları mikrofondan gelmedi; bu yüzden kayıt hizalanamıyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Часові тони не надійшли через мікрофон, тому запис не можна вирівняти."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ٹائمنگ ٹونز مائیکروفون سے نہیں آئیں، اس لیے کیپچر کو ہم آہنگ نہیں کیا جا سکتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các âm báo thời gian không đi qua micro nên không thể căn chỉnh bản ghi."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "定時音沒有透過麥克風傳入，因此無法對齊擷取內容。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "定时音没有通过麦克风传入，因此无法对齐采集内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "定時音沒有透過麥克風傳入，因此無法對齊擷取內容。"
          }
        }
      }
    },
    "The timing tones were smeared by something else in the room (an echo, a voice or another sound).": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "የጊዜ ቃናዎቹ በክፍሉ ውስጥ በሌላ ነገር ደብዝዘዋል (ማሚቶ፣ ድምጽ ወይም ሌላ ድምፅ)።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تشوّهت نغمات التوقيت بسبب شيء آخر في الغرفة (صدى أو صوت أو ضوضاء أخرى)."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ঘরের অন্য কিছুর কারণে টাইমিং টোনগুলো ঝাপসা হয়ে গেছে (প্রতিধ্বনি, কণ্ঠস্বর বা অন্য শব্দ)।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Časovací tóny byly rozmazány něčím jiným v místnosti (ozvěnou, hlasem nebo jiným zvukem)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidstonerne blev udtværet af noget andet i rummet (et ekko, en stemme eller en anden lyd)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zeittöne wurden durch etwas anderes im Raum verwischt (ein Echo, eine Stimme oder ein anderes Geräusch)."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι τόνοι χρονισμού θάμπωσαν από κάτι άλλο στο δωμάτιο (ηχώ, φωνή ή άλλος ήχος)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los tonos de sincronización se vieron distorsionados por algo más en la sala (un eco, una voz u otro sonido)."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "صداهای زمان‌بندی توسط چیز دیگری در اتاق مخدوش شدند (پژواک، صحبت یا صدایی دیگر)."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jokin muu huoneessa sotki ajoitusäänet (kaiku, ääni tai muu ääni)."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nalabo ang mga timing tone dahil sa iba pang bagay sa kuwarto (echo, boses o ibang tunog)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les tonalités de synchronisation ont été brouillées par autre chose dans la pièce (un écho, une voix ou un autre son)."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "રૂમમાં બીજી કોઈ વસ્તુથી ટાઇમિંગ ટોન ઝાંખા થઈ ગયા (પડઘો, અવાજ કે બીજો ધ્વનિ)."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Wani abu dabam a cikin ɗakin ya ɓata sautunan lokaci (amsa-amo, murya ko wani sauti)."
          }
        },
        "he": {
          "stringUnit": {

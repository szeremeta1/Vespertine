    "The file decoded as digital silence, so there's nothing to analyze.": {
      "extractionState": "manual",
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ፋይሉ እንደ ዲጂታል ጸጥታ ዲኮድ ስለተደረገ የሚተነተን ነገር የለም።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فُكّ ترميز الملف كصمت رقمي، لذا لا يوجد ما يمكن تحليله."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফাইলটি ডিজিটাল নীরবতা হিসেবে ডিকোড হয়েছে, তাই বিশ্লেষণ করার মতো কিছু নেই।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Soubor se dekódoval jako digitální ticho, takže není co analyzovat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Filen blev afkodet som digital stilhed, så der er intet at analysere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei wurde als digitale Stille dekodiert, daher gibt es nichts zu analysieren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το αρχείο αποκωδικοποιήθηκε ως ψηφιακή σιωπή, οπότε δεν υπάρχει κάτι για ανάλυση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file decoded as digital silence, so there's nothing to analyze."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo se ha decodificado como silencio digital, así que no hay nada que analizar."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فایل به‌صورت سکوت دیجیتال رمزگشایی شد، بنابراین چیزی برای تحلیل نیست."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiedosto purkautui digitaaliseksi hiljaisuudeksi, joten analysoitavaa ei ole."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Na-decode ang file bilang digital na katahimikan, kaya walang masusuri."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier a été décodé comme un silence numérique : il n’y a donc rien à analyser."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ફાઇલ ડિજિટલ શાંતિ તરીકે ડીકોડ થઈ, તેથી વિશ્લેષણ કરવા જેવું કંઈ નથી."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Fayil ɗin ya warware a matsayin shiru na dijital, don haka babu abin da za a yi nazari."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקובץ פוענח כשקט דיגיטלי, ולכן אין מה לנתח."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ाइल डिजिटल मौन के रूप में डिकोड हुई, इसलिए विश्लेषण के लिए कुछ नहीं है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fájl digitális csendként dekódolódott, így nincs mit elemezni."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "File didekode sebagai senyap digital, sehingga tidak ada yang dapat dianalisis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il file è stato decodificato come silenzio digitale, quindi non c’è nulla da analizzare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルはデジタル無音としてデコードされたため、解析する内容がありません。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಫೈಲ್ ಡಿಜಿಟಲ್ ನಿಶ್ಯಬ್ದವಾಗಿ ಡೀಕೋಡ್ ಆಗಿದೆ, ಆದ್ದರಿಂದ ವಿಶ್ಲೇಷಿಸಲು ಏನೂ ಇಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일이 디지털 무음으로 디코딩되어 분석할 내용이 없습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഫയൽ ഡിജിറ്റൽ നിശ്ശബ്ദതയായി ഡീകോഡ് ചെയ്തു, അതിനാൽ വിശകലനം ചെയ്യാൻ ഒന്നുമില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "फाइल डिजिटल शांतता म्हणून डीकोड झाली, त्यामुळे विश्लेषण करण्यासारखे काही नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Fail dinyahkod sebagai senyap digital, jadi tiada apa-apa untuk dianalisis."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Filen ble dekodet som digital stillhet, så det er ingenting å analysere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het bestand is gedecodeerd als digitale stilte, dus er valt niets te analyseren."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਫ਼ਾਈਲ ਡਿਜੀਟਲ ਚੁੱਪ ਵਜੋਂ ਡੀਕੋਡ ਹੋਈ, ਇਸ ਲਈ ਵਿਸ਼ਲੇਸ਼ਣ ਲਈ ਕੁਝ ਨਹੀਂ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plik zdekodował się jako cyfrowa cisza, więc nie ma czego analizować."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo foi decodificado como silêncio digital, então não há nada para analisar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O ficheiro foi descodificado como silêncio digital, por isso não há nada para analisar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fișierul a fost decodat ca liniște digitală, așa că nu există nimic de analizat."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Filen avkodades som digital tystnad, så det finns inget att analysera."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Faili ilisimbuliwa kama ukimya wa kidijitali, kwa hivyo hakuna cha kuchambua."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கோப்பு டிஜிட்டல் அமைதியாக டிகோட் ஆனது, எனவே பகுப்பாய்வுசெய்ய எதுவுமில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఫైల్ డిజిటల్ నిశ్శబ్దంగా డీకోడ్ అయింది, కాబట్టి విశ్లేషించడానికి ఏమీ లేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟล์ถอดรหัสออกมาเป็นความเงียบแบบดิจิทัล จึงไม่มีอะไรให้วิเคราะห์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosyanın kodu dijital sessizlik olarak çözüldü; analiz edilecek bir şey yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл декодувався як цифрова тиша, тож аналізувати нічого."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فائل ڈیجیٹل خاموشی کے طور پر ڈی کوڈ ہوئی، اس لیے تجزیہ کرنے کے لیے کچھ نہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tệp được giải mã thành im lặng kỹ thuật số, vì vậy không có gì để phân tích."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案解碼後為數碼靜音，因此沒有可分析的內容。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该文件解码后为数字静音，因此没有可分析的内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此檔案解碼後為數位靜音，因此沒有可分析的內容。"
          }
        }
      }
    },

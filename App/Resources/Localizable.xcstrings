          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कमरे में किसी और चीज़ से टाइमिंग टोन धुंधली हो गईं (गूँज, आवाज़ या कोई और ध्वनि)।"
          }
        },
        "hu": {

    "Hardware volume on the device; samples are untouched": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "በመሣሪያው ላይ የሃርድዌር የድምፅ መጠን፤ ናሙናዎቹ አይነኩም"

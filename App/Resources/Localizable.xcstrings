    "“%@” is on a network share that isn’t connected. Vespertine reconnects automatically when the server is reachable.": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» ያልተገናኘ የአውታረ መረብ ማጋሪያ ላይ ነው። አገልጋዩ ሲገኝ Vespertine በራሱ እንደገና ይገናኛል።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” موجودة على مشاركة شبكة غير متصلة. يعيد Vespertine الاتصال تلقائيًا عندما يصبح الخادم متاحًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” এমন একটি নেটওয়ার্ক শেয়ারে আছে যা সংযুক্ত নয়। সার্ভারে পৌঁছানো গেলেই Vespertine নিজে থেকে আবার সংযোগ করে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Skladba „%@“ je na síťovém sdílení, které není připojené. Vespertine se automaticky znovu připojí, jakmile bude server dostupný."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” ligger på en netværksdeling, der ikke er forbundet. Vespertine opretter automatisk forbindelse igen, når serveren kan nås."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ befindet sich auf einer Netzwerkfreigabe, die nicht verbunden ist. Vespertine stellt die Verbindung automatisch wieder her, sobald der Server erreichbar ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το «%@» βρίσκεται σε κοινόχρηστο φάκελο δικτύου που δεν είναι συνδεδεμένος. Το Vespertine θα επανασυνδεθεί αυτόματα όταν ο διακομιστής είναι προσβάσιμος."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” está en un recurso compartido de red que no está conectado. Vespertine se vuelve a conectar automáticamente cuando el servidor esté disponible."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» روی یک اشتراک شبکه است که وصل نیست. Vespertine هر وقت سرور در دسترس باشد، خودکار دوباره وصل می‌شود."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "”%@” on verkkojaossa, johon ei ole yhteyttä. Vespertine muodostaa yhteyden automaattisesti uudelleen, kun palvelin on tavoitettavissa."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang “%@” ay nasa network share na hindi nakakonekta. Awtomatikong kumokonekta muli ang Vespertine kapag naaabot na ang server."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » se trouve sur un partage réseau qui n’est pas connecté. Vespertine se reconnecte automatiquement dès que le serveur est accessible."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” એવા નેટવર્ક શેર પર છે જે કનેક્ટ થયેલ નથી. સર્વર ઉપલબ્ધ થાય ત્યારે Vespertine આપમેળે ફરી કનેક્ટ કરે છે."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” yana kan folda ta cibiyar sadarwa wadda ba a haɗa ba. Vespertine zai sake haɗawa da kansa idan an sami sabar."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” נמצא בשיתוף רשת שאינו מחובר. Vespertine יתחבר מחדש באופן אוטומטי כשהשרת יהיה זמין."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” एक ऐसे नेटवर्क शेयर पर है जो कनेक्ट नहीं है। सर्वर उपलब्ध होते ही Vespertine अपने आप फिर से कनेक्ट हो जाता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A következő szám egy nem csatlakoztatott hálózati megosztáson van: „%@”. A Vespertine automatikusan újracsatlakozik, amint a szerver elérhető."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” berada di share jaringan yang tidak terhubung. Vespertine terhubung kembali secara otomatis saat server dapat dijangkau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” si trova su una condivisione di rete non connessa. Vespertine si riconnette automaticamente quando il server è raggiungibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」は接続されていないネットワーク共有上にあります。サーバに接続できるようになると、Vespertineが自動的に再接続します。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” ಸಂಪರ್ಕಗೊಳ್ಳದ ನೆಟ್‌ವರ್ಕ್ ಶೇರ್‌ನಲ್ಲಿದೆ. ಸರ್ವರ್ ತಲುಪಬಹುದಾದಾಗ Vespertine ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಮರುಸಂಪರ್ಕಿಸುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%@’ 항목은 연결되지 않은 네트워크 공유에 있습니다. 서버에 연결할 수 있게 되면 Vespertine이 자동으로 다시 연결합니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” കണക്റ്റ് ചെയ്തിട്ടില്ലാത്ത ഒരു നെറ്റ്‌വർക്ക് ഷെയറിലാണ്. സെർവർ ലഭ്യമാകുമ്പോൾ Vespertine സ്വയം വീണ്ടും കണക്റ്റ് ചെയ്യും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” अशा नेटवर्क शेअरवर आहे जो कनेक्ट केलेला नाही. सर्व्हर उपलब्ध झाल्यावर Vespertine आपोआप पुन्हा कनेक्ट करते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” berada pada perkongsian rangkaian yang tidak bersambung. Vespertine menyambung semula secara automatik apabila pelayan boleh dicapai."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» ligger på en nettverksdeling som ikke er tilkoblet. Vespertine kobler til automatisk igjen når tjeneren kan nås."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%@’ staat op een netwerkshare die niet verbonden is. Vespertine maakt automatisch opnieuw verbinding zodra de server bereikbaar is."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” ਇੱਕ ਅਜਿਹੇ ਨੈੱਟਵਰਕ ਸ਼ੇਅਰ ’ਤੇ ਹੈ ਜੋ ਕਨੈਕਟ ਨਹੀਂ ਹੈ। ਸਰਵਰ ਤੱਕ ਪਹੁੰਚ ਹੁੰਦਿਆਂ ਹੀ Vespertine ਆਪਣੇ-ਆਪ ਮੁੜ ਕਨੈਕਟ ਕਰ ਲੈਂਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” znajduje się w zasobie sieciowym, który nie jest połączony. Vespertine połączy się ponownie automatycznie, gdy serwer będzie dostępny."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” está em um compartilhamento de rede que não está conectado. O Vespertine reconecta automaticamente quando o servidor estiver acessível."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” está numa partilha de rede que não está ligada. O Vespertine volta a ligar-se automaticamente quando o servidor estiver acessível."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” se află pe o partajare de rețea care nu este conectată. Vespertine se reconectează automat când serverul este accesibil."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "”%@” finns på en nätverksresurs som inte är ansluten. Vespertine ansluter igen automatiskt när servern går att nå."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” iko kwenye folda ya mtandao ambayo haijaunganishwa. Vespertine huunganisha upya yenyewe seva ikipatikana."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” இணைக்கப்படாத நெட்வொர்க் பகிர்வில் உள்ளது. சர்வரை அணுக முடிந்ததும் Vespertine தானாகவே மீண்டும் இணைக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” కనెక్ట్ కాని నెట్‌వర్క్ షేర్‌లో ఉంది. సర్వర్ అందుబాటులోకి వచ్చినప్పుడు Vespertine ఆటోమేటిక్‌గా మళ్లీ కనెక్ట్ అవుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” อยู่ในแชร์เครือข่ายที่ไม่ได้เชื่อมต่อ Vespertine จะเชื่อมต่อใหม่โดยอัตโนมัติเมื่อติดต่อเซิร์ฟเวอร์ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” bağlı olmayan bir ağ paylaşımında. Sunucuya erişilebildiğinde Vespertine otomatik olarak yeniden bağlanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» розташовано на мережевому ресурсі, який не під’єднано. Vespertine під’єднається автоматично, щойно сервер стане доступним."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” ایک ایسے نیٹ ورک شیئر پر ہے جو منسلک نہیں۔ سرور دستیاب ہوتے ہی Vespertine خود بخود دوبارہ منسلک ہو جاتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” nằm trên một chia sẻ mạng chưa được kết nối. Vespertine sẽ tự động kết nối lại khi có thể truy cập máy chủ."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」位於未連接的網絡共享上。伺服器可連上時，Vespertine 會自動重新連接。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”位于未连接的网络共享上。服务器可访问时，Vespertine 会自动重新连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」位於未連線的網路共享上。伺服器可連線時，Vespertine 會自動重新連線。"
          }
        }
      }
    },
    "“%@” was moved or deleted. Updating the library to find it…": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» ተንቀሳቅሷል ወይም ተሰርዟል። እሱን ለማግኘት ቤተ-መጻሕፍቱ እየተዘመነ ነው…"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم نقل “%@” أو حذفها. جارٍ تحديث المكتبة للعثور عليها…"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” সরানো বা মুছে ফেলা হয়েছে। এটি খুঁজে পেতে লাইব্রেরি আপডেট করা হচ্ছে…"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Skladba „%@“ byla přesunuta nebo smazána. Knihovna se aktualizuje, aby ji bylo možné najít…"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” er blevet flyttet eller slettet. Opdaterer biblioteket for at finde den…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ wurde bewegt oder gelöscht. Die Mediathek wird aktualisiert, um die Datei zu finden …"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το «%@» μετακινήθηκε ή διαγράφηκε. Ενημέρωση της βιβλιοθήκης για τον εντοπισμό του…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” se ha movido o eliminado. Actualizando la biblioteca para encontrarlo…"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» جابه‌جا یا حذف شده است. در حال به‌روزرسانی کتابخانه برای یافتن آن…"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "”%@” on siirretty tai poistettu. Päivitetään kirjastoa sen löytämiseksi…"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Inilipat o na-delete ang “%@”. Ina-update ang library para mahanap ito…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » a été déplacé ou supprimé. Mise à jour de la bibliothèque pour le retrouver…"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” ખસેડાયું અથવા ડિલીટ થયું છે. તેને શોધવા માટે લાઇબ્રેરી અપડેટ કરી રહ્યાં છીએ…"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "An matsar ko an share “%@”. Ana sabunta laburare don nemo shi…"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” הועבר או נמחק. מעדכן את הספריה כדי למצוא אותו…"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” को हटा दिया गया है या कहीं और ले जाया गया है। इसे ढूँढने के लिए लाइब्रेरी अपडेट की जा रही है…"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A következő számot áthelyezték vagy törölték: „%@”. A Vespertine frissíti a könyvtárat, hogy megtalálja…"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” telah dipindahkan atau dihapus. Memperbarui perpustakaan untuk menemukannya…"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” è stato spostato o eliminato. Aggiornamento della libreria per ritrovarlo…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」は移動または削除されました。ライブラリをアップデートして探しています…"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” ಅನ್ನು ಸರಿಸಲಾಗಿದೆ ಅಥವಾ ಅಳಿಸಲಾಗಿದೆ. ಅದನ್ನು ಹುಡುಕಲು ಲೈಬ್ರರಿಯನ್ನು ಅಪ್‌ಡೇಟ್ ಮಾಡಲಾಗುತ್ತಿದೆ…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%@’ 항목이 이동되었거나 삭제되었습니다. 찾기 위해 보관함을 업데이트하는 중…"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” നീക്കുകയോ ഇല്ലാതാക്കുകയോ ചെയ്തു. അത് കണ്ടെത്താൻ ലൈബ്രറി അപ്ഡേറ്റ് ചെയ്യുന്നു…"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” हलवले किंवा हटवले गेले. ते शोधण्यासाठी लायब्ररी अपडेट करत आहे…"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” telah dialihkan atau dipadam. Mengemas kini pustaka untuk mencarinya…"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» er flyttet eller slettet. Oppdaterer biblioteket for å finne den …"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%@’ is verplaatst of verwijderd. De bibliotheek wordt bijgewerkt om het bestand te vinden…"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” ਨੂੰ ਹਿਲਾਇਆ ਜਾਂ ਮਿਟਾਇਆ ਗਿਆ ਸੀ। ਇਸਨੂੰ ਲੱਭਣ ਲਈ ਲਾਇਬ੍ਰੇਰੀ ਅੱਪਡੇਟ ਕੀਤੀ ਜਾ ਰਹੀ ਹੈ…"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plik „%@” został przeniesiony lub usunięty. Aktualizowanie biblioteki, aby go odnaleźć…"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” foi movido ou apagado. Atualizando a biblioteca para encontrá-lo…"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” foi movido ou apagado. A atualizar a biblioteca para o encontrar…"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” a fost mutat sau șters. Se actualizează biblioteca pentru a-l găsi…"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "”%@” har flyttats eller raderats. Uppdaterar biblioteket för att hitta den …"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” imehamishwa au imefutwa. Inasasisha maktaba ili kuipata…"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” நகர்த்தப்பட்டது அல்லது நீக்கப்பட்டது. அதைக் கண்டறிய லைப்ரரி புதுப்பிக்கப்படுகிறது…"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” తరలించబడింది లేదా తొలగించబడింది. దాన్ని కనుగొనడానికి లైబ్రరీని అప్‌డేట్ చేస్తోంది…"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” ถูกย้ายหรือลบ กำลังอัปเดตคลังเพื่อค้นหา…"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” taşındı veya silindi. Bulmak için arşiv güncelleniyor…"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» переміщено або видалено. Медіатека оновлюється, щоб знайти файл…"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” منتقل یا حذف کر دیا گیا۔ اسے تلاش کرنے کے لیے لائبریری اپ ڈیٹ ہو رہی ہے…"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” đã bị di chuyển hoặc xóa. Đang cập nhật thư viện để tìm tệp…"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」已被移動或刪除。正在更新資料庫以尋找此檔案…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”已被移动或删除。正在更新资料库以找到它…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」已被搬移或刪除。正在更新資料庫以找出它…"
          }
        }
      }
    },
    "“Put it back as it was” restores each device Vespertine switched to the sample rate and bit depth it had before, so other apps (and tools like LosslessSwitcher) take over from where they left off.": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "«እንደነበረው መልስ» Vespertine የቀየረውን እያንዳንዱን መሣሪያ ወደ ቀድሞው የናሙና ፍጥነትና የቢት ጥልቀት ይመልሳል፣ ስለዚህ ሌሎች መተግበሪያዎች (እና እንደ LosslessSwitcher ያሉ መሣሪያዎች) ካቆሙበት ይቀጥላሉ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعيد خيار “إرجاعه كما كان” كل جهاز بدّله Vespertine إلى معدل العينة وعمق البت اللذين كانا لديه من قبل، لتتابع التطبيقات الأخرى (وأدوات مثل LosslessSwitcher) من حيث توقفت."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "“যেমন ছিল তেমন ফিরিয়ে দিন” Vespertine যে ডিভাইসগুলো বদলেছিল সেগুলোকে আগের স্যাম্পল রেট ও বিট ডেপথে ফিরিয়ে দেয়, যাতে অন্য অ্যাপগুলো (এবং LosslessSwitcher-এর মতো টুল) যেখানে ছেড়েছিল সেখান থেকেই কাজ শুরু করতে পারে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "„Vrátit do původního stavu“ obnoví u každého zařízení, které Vespertine přepnul, vzorkovací frekvenci a bitovou hloubku, které mělo předtím, takže ostatní aplikace (a nástroje jako LosslessSwitcher) navážou tam, kde skončily."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "“Sæt den tilbage, som den var” gendanner den samplingfrekvens og bitdybde, som hver enhed, Vespertine skiftede, havde før, så andre apps (og værktøjer som LosslessSwitcher) kan fortsætte, hvor de slap."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Wie zuvor wiederherstellen“ setzt jedes Gerät, das Vespertine umgestellt hat, auf die vorherige Abtastrate und Bittiefe zurück, sodass andere Apps (und Tools wie LosslessSwitcher) dort weitermachen, wo sie aufgehört haben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η επιλογή «Επαναφορά όπως ήταν» επαναφέρει κάθε συσκευή που άλλαξε το Vespertine στον ρυθμό δειγματοληψίας και στο βάθος bit που είχε πριν, ώστε οι άλλες εφαρμογές (και εργαλεία όπως το LosslessSwitcher) να συνεχίσουν από εκεί που είχαν μείνει."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“Dejarlo como estaba” devuelve cada dispositivo que Vespertine cambió a la frecuencia de muestreo y la profundidad de bits que tenía antes, para que otras apps (y herramientas como LosslessSwitcher) continúen donde lo dejaron."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "«بازگرداندن به حالت قبل» هر دستگاهی را که Vespertine تغییر داده به نرخ نمونه‌برداری و عمق بیتی که پیش‌تر داشت برمی‌گرداند تا برنامه‌های دیگر (و ابزارهایی مانند LosslessSwitcher) از همان جایی که بودند ادامه دهند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "”Palauta ennalleen” palauttaa jokaiselle laitteelle, jonka Vespertine vaihtoi, sen aiemman näytteenottotaajuuden ja bittisyvyyden, jotta muut apit (ja työkalut, kuten LosslessSwitcher) voivat jatkaa siitä, mihin ne jäivät."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ibinabalik ng “Ibalik sa dati” ang bawat device na pinalitan ng Vespertine sa sample rate at bit depth nito dati, para maipagpatuloy ng ibang app (at ng mga tool gaya ng LosslessSwitcher) kung saan sila huminto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Remettre tel qu’il était » rétablit, sur chaque appareil modifié par Vespertine, la fréquence d’échantillonnage et la résolution qu’il avait auparavant, afin que les autres apps (et des outils comme LosslessSwitcher) reprennent là où ils s’étaient arrêtés."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "“જેમ હતું તેમ પાછું મૂકો” Vespertine એ બદલેલા દરેક ડિવાઇસનો સેમ્પલ રેટ અને બિટ ડેપ્થ પહેલાં જેવાં હતાં તેવાં પાછાં લાવે છે, જેથી અન્ય ઍપ (અને LosslessSwitcher જેવાં સાધનો) જ્યાં અટક્યાં હતાં ત્યાંથી આગળ ચાલે."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "“Mayar da shi yadda yake” yana dawo da kowace na'ura da Vespertine ya canza zuwa ƙimar samfuri da zurfin bit da take da su a da, don sauran manhajoji (da kayan aiki kamar LosslessSwitcher) su ci gaba daga inda suka tsaya."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האפשרות “החזר למצב הקודם” מחזירה כל התקן ש־Vespertine שינה לקצב הדגימה ולעומק הסיביות שהיו לו קודם, כדי שיישומים אחרים (וכלים כמו LosslessSwitcher) ימשיכו מהנקודה שבה עצרו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“जैसा था वैसा लौटाएँ” हर उस डिवाइस को, जिसे Vespertine ने बदला था, उसके पहले वाले सैंपल रेट और बिट डेप्थ पर लौटा देता है, ताकि दूसरे ऐप (और LosslessSwitcher जैसे टूल) वहीं से काम संभालें जहाँ उन्होंने छोड़ा था।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az „Eredeti állapot visszaállítása” minden olyan eszköznél, amelyet a Vespertine átállított, visszaállítja a korábbi mintavételi frekvenciát és bitmélységet, így más appok (és például a LosslessSwitcher) ott folytathatják, ahol abbahagyták."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "“Kembalikan seperti semula” memulihkan setiap perangkat yang diubah Vespertine ke laju sampel dan kedalaman bit sebelumnya, sehingga app lain (dan alat seperti LosslessSwitcher) dapat melanjutkan dari posisi terakhirnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“Ripristina com’era” riporta ogni dispositivo modificato da Vespertine alla frequenza di campionamento e alla profondità di bit che aveva prima, così le altre app (e strumenti come LosslessSwitcher) riprendono da dove erano rimaste."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「元の状態に戻す」を選ぶと、Vespertineが切り替えた各デバイスを以前のサンプルレートとビット深度に戻すため、ほかのアプリ（やLosslessSwitcherなどのツール）が中断したところから引き継げます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "“ಹಿಂದಿನಂತೆ ಮರಳಿ ಇರಿಸಿ” ಆಯ್ಕೆಯು Vespertine ಬದಲಿಸಿದ ಪ್ರತಿ ಸಾಧನವನ್ನು ಅದರ ಹಿಂದಿನ ಸ್ಯಾಂಪಲ್ ರೇಟ್ ಮತ್ತು ಬಿಟ್ ಡೆಪ್ತ್‌ಗೆ ಮರುಸ್ಥಾಪಿಸುತ್ತದೆ, ಆದ್ದರಿಂದ ಇತರ ಆ್ಯಪ್‌ಗಳು (ಮತ್ತು LosslessSwitcher ನಂತಹ ಟೂಲ್‌ಗಳು) ಅವು ನಿಲ್ಲಿಸಿದಲ್ಲಿಂದ ಮುಂದುವರಿಯುತ್ತವೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘원래대로 되돌리기’를 선택하면 Vespertine이 전환한 각 기기를 이전의 샘플 레이트와 비트 심도로 복원하므로, 다른 앱(및 LosslessSwitcher 같은 도구)이 중단한 지점부터 이어서 사용할 수 있습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "“മുമ്പത്തെപ്പോലെ തിരികെ വയ്ക്കുക” എന്നത് Vespertine മാറ്റിയ ഓരോ ഉപകരണത്തെയും മുമ്പുണ്ടായിരുന്ന സാമ്പിൾ റേറ്റിലേക്കും ബിറ്റ് ഡെപ്തിലേക്കും പുനഃസ്ഥാപിക്കുന്നു, അതിനാൽ മറ്റ് ആപ്പുകൾക്ക് (LosslessSwitcher പോലുള്ള ടൂളുകൾക്കും) അവ നിർത്തിയിടത്തുനിന്ന് തുടരാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "“जसे होते तसे परत ठेवा” हे Vespertine ने बदललेल्या प्रत्येक डिव्हाइसचा सॅम्पल रेट आणि बिट डेप्थ पूर्वीप्रमाणे पुनर्संचयित करते, म्हणजे इतर ॲप्स (आणि LosslessSwitcher सारखी साधने) जिथे थांबली होती तिथून पुढे चालू ठेवतात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "“Kembalikan seperti asal” memulihkan setiap peranti yang ditukar oleh Vespertine kepada kadar sampel dan kedalaman bit yang dimilikinya sebelum ini, supaya app lain (dan alat seperti LosslessSwitcher) menyambung dari tempat ia berhenti."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "«Sett den tilbake slik den var» gjenoppretter samplingsfrekvensen og bitdybden hver enhet Vespertine byttet, hadde før, slik at andre apper (og verktøy som LosslessSwitcher) kan fortsette der de slapp."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "‘Herstel zoals het was’ zet elk apparaat dat Vespertine heeft omgeschakeld terug op de samplefrequentie en bitdiepte van daarvoor, zodat andere apps (en tools zoals LosslessSwitcher) verdergaan waar ze gebleven waren."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "“ਜਿਵੇਂ ਸੀ ਉਵੇਂ ਵਾਪਸ ਰੱਖੋ” ਹਰ ਉਸ ਡਿਵਾਈਸ ਨੂੰ, ਜਿਸਨੂੰ Vespertine ਨੇ ਬਦਲਿਆ ਸੀ, ਉਸਦੇ ਪਹਿਲਾਂ ਵਾਲੇ ਸੈਂਪਲ ਰੇਟ ਅਤੇ ਬਿੱਟ ਡੈਪਥ ’ਤੇ ਵਾਪਸ ਲੈ ਆਉਂਦਾ ਹੈ, ਤਾਂ ਜੋ ਹੋਰ ਐਪਾਂ (ਅਤੇ LosslessSwitcher ਵਰਗੇ ਟੂਲ) ਉੱਥੋਂ ਹੀ ਸੰਭਾਲ ਲੈਣ ਜਿੱਥੇ ਉਹਨਾਂ ਨੇ ਛੱਡਿਆ ਸੀ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„Przywróć poprzedni stan” przywraca każdemu urządzeniu przełączonemu przez Vespertine poprzednią częstotliwość próbkowania i rozdzielczość bitową, aby inne aplikacje (i narzędzia takie jak LosslessSwitcher) mogły kontynuować od tego miejsca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“Restaurar como estava” devolve cada dispositivo que o Vespertine alterou à taxa de amostragem e à profundidade de bits que tinha antes, para que outros apps (e ferramentas como o LosslessSwitcher) continuem de onde pararam."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "“Repor como estava” devolve a cada dispositivo que o Vespertine alterou a taxa de amostragem e a profundidade de bits que tinha antes, para que as outras apps (e ferramentas como o LosslessSwitcher) continuem a partir de onde ficaram."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "„Readu-l cum era” restabilește pentru fiecare dispozitiv comutat de Vespertine rata de eșantionare și adâncimea de biți pe care le avea înainte, astfel încât celelalte aplicații (și instrumente precum LosslessSwitcher) să continue de unde au rămas."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "”Återställ som det var” återställer varje enhet som Vespertine bytte till den samplingsfrekvens och det bitdjup den hade innan, så att andra appar (och verktyg som LosslessSwitcher) kan fortsätta där de slutade."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "“Kirudishe kama kilivyokuwa” hurejesha kila kifaa ambacho Vespertine ilikibadilisha kwenye kiwango cha sampuli na kina cha biti kilichokuwa nacho awali, ili programu nyingine (na zana kama LosslessSwitcher) ziendelee pale zilipoachia."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "“முன்பு இருந்தபடி திருப்பி வை” என்பது, Vespertine மாற்றிய ஒவ்வொரு சாதனத்தையும் அதன் முந்தைய மாதிரி வீதம் மற்றும் பிட் ஆழத்திற்கு மீட்டமைக்கும், அதனால் பிற ஆப்ஸ் (மற்றும் LosslessSwitcher போன்ற கருவிகள்) விட்ட இடத்திலிருந்து தொடரும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "“మునుపటిలాగే తిరిగి ఉంచు” అనేది Vespertine మార్చిన ప్రతి పరికరాన్ని దానికి ముందు ఉన్న శాంపిల్ రేట్, బిట్ డెప్త్‌కు తిరిగి తెస్తుంది, కాబట్టి ఇతర యాప్‌లు (LosslessSwitcher వంటి టూల్‌లు కూడా) అవి ఆపిన చోటు నుండి కొనసాగుతాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "“คืนค่าเหมือนเดิม” จะคืนอัตราสุ่มตัวอย่างและความลึกบิตเดิมให้กับแต่ละอุปกรณ์ที่ Vespertine เปลี่ยนไว้ แอปอื่น (และเครื่องมืออย่าง LosslessSwitcher) จึงทำงานต่อจากจุดที่ค้างไว้ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“Önceki hâline getir” seçeneği, Vespertine’in değiştirdiği her aygıtı önceki örnekleme hızına ve bit derinliğine döndürür; böylece diğer uygulamalar (ve LosslessSwitcher gibi araçlar) kaldıkları yerden devam eder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Повернути як було» відновлює для кожного пристрою, який перемикав Vespertine, попередні частоту дискретизації та розрядність, тож інші програми (і такі інструменти, як LosslessSwitcher) продовжують з того місця, де зупинилися."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "“جیسا تھا ویسا واپس کریں” ہر اس ڈیوائس کو جسے Vespertine نے تبدیل کیا، اس کے پچھلے سیمپل ریٹ اور بٹ ڈیپتھ پر بحال کر دیتا ہے، تاکہ دوسری ایپس (اور LosslessSwitcher جیسے ٹولز) وہیں سے کام سنبھالیں جہاں چھوڑا تھا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "“Trả lại như cũ” khôi phục từng thiết bị mà Vespertine đã chuyển về tần số lấy mẫu và độ sâu bit trước đó, để các ứng dụng khác (và các công cụ như LosslessSwitcher) tiếp tục từ chỗ chúng đã dừng."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "「回復原狀」會將 Vespertine 切換過的每個裝置還原至之前的取樣率和位元深度，讓其他 App（以及 LosslessSwitcher 等工具）從原來的狀態接手。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“恢复原样”会将 Vespertine 切换过的每个设备恢复到之前的采样率和位深度，以便其他 App（以及 LosslessSwitcher 等工具）从原来的状态接手。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「恢復原狀」會將 Vespertine 切換過的每個裝置恢復為先前的取樣率和位元深度，讓其他 App（以及 LosslessSwitcher 等工具）從原本的狀態接手。"
          }
        }
      }
    },

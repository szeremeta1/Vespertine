          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "IFO പട്ടികപ്പെടുത്തുന്ന സെല്ലുകൾക്ക് മുമ്പേ VOB-കൾ അവസാനിക്കുന്നു (അപൂർണ്ണമായ പകർപ്പ്)"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "IFO ज्या सेलची यादी देतो त्यांच्या आधीच VOB संपतात (अपूर्ण प्रत)"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",

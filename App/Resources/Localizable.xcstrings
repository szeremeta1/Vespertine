        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pumupunta sa bawat speaker ayon sa posisyon ang multichannel na musika."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La musique multicanal est envoyée à chaque haut-parleur selon sa position."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "મલ્ટિચૅનલ સંગીત સ્થાન મુજબ દરેક સ્પીકર પર જાય છે."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Waƙoƙi masu tashoshi da yawa suna zuwa kowace lasifika bisa matsayi."

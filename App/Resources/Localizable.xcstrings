    "same album under different credits or disc titles": {
      "extractionState": "manual",
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ተመሳሳይ አልበም በተለያዩ ክሬዲቶች ወይም የዲስክ ርዕሶች"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الألبوم نفسه تحت أسماء فنانين أو عناوين أقراص مختلفة"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ভিন্ন ক্রেডিট বা ডিস্ক শিরোনামের অধীনে একই অ্যালবাম"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "stejné album pod různými autory nebo názvy disků"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "samme album under forskellige kreditteringer eller disktitler"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "dasselbe Album unter verschiedenen Mitwirkenden oder CD-Titeln"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "το ίδιο άλμπουμ με διαφορετικούς συντελεστές ή τίτλους δίσκων"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "same album under different credits or disc titles"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "el mismo álbum con distintos créditos o títulos de disco"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یک آلبوم با اعتبارها یا عنوان‌های دیسک متفاوت"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "sama albumi eri tekijätiedoilla tai levynimillä"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "parehong album sa ilalim ng magkakaibang credit o pamagat ng disc"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "même album sous des crédits ou titres de disque différents"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "અલગ ક્રેડિટ અથવા ડિસ્ક શીર્ષકો હેઠળ એ જ આલ્બમ"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "kundi ɗaya ƙarƙashin sunayen mawaƙa ko taken faifai daban-daban"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אותו אלבום תחת קרדיטים או כותרות דיסק שונים"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अलग-अलग क्रेडिट या डिस्क शीर्षकों के तहत एक ही एल्बम"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "ugyanaz az album eltérő közreműködőkkel vagy lemezcímekkel"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "album yang sama dengan kredit atau judul disk berbeda"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "stesso album con crediti o titoli del disco diversi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クレジットやディスクタイトルが異なる同じアルバム"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಬೇರೆ ಬೇರೆ ಕ್ರೆಡಿಟ್‌ಗಳು ಅಥವಾ ಡಿಸ್ಕ್ ಶೀರ್ಷಿಕೆಗಳ ಅಡಿಯಲ್ಲಿ ಒಂದೇ ಆಲ್ಬಮ್"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "크레딧이나 디스크 제목이 다른 같은 앨범"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "വ്യത്യസ്ത ക്രെഡിറ്റുകളിലോ ഡിസ്ക് ശീർഷകങ്ങളിലോ ഒരേ ആൽബം"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "वेगवेगळ्या क्रेडिट किंवा डिस्क शीर्षकांखाली तोच अल्बम"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "album yang sama di bawah kredit atau tajuk cakera yang berbeza"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "samme album under ulike krediteringer eller platetitler"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "hetzelfde album onder verschillende vermeldingen of schijftitels"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਵੱਖ-ਵੱਖ ਕ੍ਰੈਡਿਟਾਂ ਜਾਂ ਡਿਸਕ ਸਿਰਲੇਖਾਂ ਹੇਠ ਇੱਕੋ ਐਲਬਮ"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "ten sam album pod różnymi wykonawcami lub tytułami płyt"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "o mesmo álbum com créditos ou títulos de disco diferentes"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "o mesmo álbum com créditos ou títulos de disco diferentes"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "același album cu credite sau titluri de disc diferite"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "samma album under olika medverkande eller skivtitlar"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "albamu ileile chini ya wasanii au majina ya diski tofauti"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வெவ்வேறு கிரெடிட்கள் அல்லது டிஸ்க் தலைப்புகளின் கீழ் ஒரே ஆல்பம்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "విభిన్న క్రెడిట్‌లు లేదా డిస్క్ శీర్షికల కింద అదే ఆల్బమ్"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อัลบั้มเดียวกันภายใต้เครดิตหรือชื่อแผ่นที่ต่างกัน"
          }
        },
        "tr": {

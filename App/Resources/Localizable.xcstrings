        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze SACD-schijfkopie heeft geen audiogebied dat Vespertine kan afspelen."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ SACD ਇਮੇਜ ਵਿੱਚ ਕੋਈ ਅਜਿਹਾ ਆਡੀਓ ਖੇਤਰ ਨਹੀਂ ਜੋ Vespertine ਚਲਾ ਸਕੇ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",

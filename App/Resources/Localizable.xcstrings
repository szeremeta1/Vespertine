    "No zero padding: %lld of %lld bits are in use.": {
      "extractionState": "manual",
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ምንም የዜሮ መሙላት የለም፦ ከ%2$lld ቢቶች %1$lld ጥቅም ላይ ናቸው።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد تبطين بالأصفار: %1$lld من %2$lld بت مستخدمة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোনো জিরো প্যাডিং নেই: %2$lld বিটের মধ্যে %1$lld বিট ব্যবহৃত।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez doplnění nulami: využito je %lld z %lld bitů."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen nulpolstring: %lld af %lld bit er i brug."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Nullauffüllung: %lld von %lld Bits werden genutzt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Καμία συμπλήρωση με μηδενικά: χρησιμοποιούνται %1$lld από τα %2$lld bit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No zero padding: %1$lld of %#@bits@ %#@verb@ in use."
          },
          "substitutions": {
            "bits": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg bit"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg bits"
                    }
                  }
                }
              }
            },
            "verb": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "is"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "are"
                    }
                  }
                }
              }
            }
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin relleno de ceros: se usan %lld de %lld bits."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بدون صفرپرکردن: %lld از %lld بیت در حال استفاده‌اند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei nollatäyttöä: %lld/%lld bitistä on käytössä."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang zero padding: %lld sa %lld bit ang ginagamit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun complément de zéros : %lld bits sur %lld sont utilisés."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "શૂન્ય પૅડિંગ નથી: %2$lld માંથી %1$lld બિટ વપરાશમાં છે."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Babu cike da sifili: bit %lld cikin %lld ana amfani da su."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין ריפוד באפסים: %1$lld מתוך %2$lld סיביות בשימוש."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई ज़ीरो पैडिंग नहीं: %2$lld में से %1$lld बिट उपयोग में हैं।"
          }
        },
        "hu": {
          "stringUnit": {

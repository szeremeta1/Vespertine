    "Discord isn’t open. Your status appears once it is.": {
      "comment": "Settings › Online › Discord, status caption: the Discord app isn't running on this Mac.",
      "extractionState": "manual",
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "Discord አልተከፈተም። ሲከፈት ሁኔታዎ ይታያል።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Discord غير مفتوح. ستظهر حالتك بمجرد فتحه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Discord খোলা নেই। খোলা হলেই আপনার স্ট্যাটাস দেখা যাবে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Discord není otevřený. Váš stav se zobrazí, jakmile ho otevřete."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Discord er ikke åben. Din status vises, så snart den er."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Discord ist nicht geöffnet. Dein Status erscheint, sobald es geöffnet ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Discord δεν είναι ανοιχτό. Η κατάστασή σας θα εμφανιστεί μόλις ανοίξει."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Discord no está abierto. Tu estado aparecerá en cuanto lo esté."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Discord باز نیست. وضعیت شما به‌محض باز شدن آن نمایش داده می‌شود."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Discord ei ole auki. Tilasi näkyy heti, kun se on."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi bukas ang Discord. Lalabas ang iyong status kapag nabuksan na ito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Discord n’est pas ouvert. Votre statut s’affichera dès qu’il le sera."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "Discord ખુલ્લું નથી. તે ખૂલતાં જ તમારું સ્ટેટસ દેખાશે."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Discord ba a buɗe yake ba. Matsayinku zai bayyana da zarar an buɗe shi."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Discord אינו פתוח. הסטטוס שלך יופיע ברגע שהוא ייפתח."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Discord खुला नहीं है। उसके खुलते ही आपका स्टेटस दिखने लगेगा।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Discord nincs megnyitva. Az állapota a megnyitása után jelenik meg."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Discord tidak terbuka. Status Anda akan muncul setelah Discord dibuka."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Discord non è aperto. Il tuo stato apparirà non appena lo sarà."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Discordが開いていません。開くとステータスが表示されます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "Discord ತೆರೆದಿಲ್ಲ. ಅದು ತೆರೆದ ತಕ್ಷಣ ನಿಮ್ಮ ಸ್ಟೇಟಸ್ ಕಾಣಿಸುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Discord가 열려 있지 않습니다. Discord가 열리면 상태가 표시됩니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Discord തുറന്നിട്ടില്ല. അത് തുറന്നാലുടൻ നിങ്ങളുടെ സ്റ്റാറ്റസ് ദൃശ്യമാകും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Discord उघडलेले नाही. ते उघडताच तुमचे स्टेटस दिसेल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Discord tidak dibuka. Status anda dipaparkan sebaik sahaja ia dibuka."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Discord er ikke åpen. Statusen din vises så snart den er det."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Discord is niet geopend. Je status verschijnt zodra het is geopend."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "Discord ਖੁੱਲ੍ਹਾ ਨਹੀਂ ਹੈ। ਇਸਦੇ ਖੁੱਲ੍ਹਦੇ ਹੀ ਤੁਹਾਡਾ ਸਟੇਟਸ ਦਿਖਾਈ ਦੇਵੇਗਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Discord nie jest otwarty. Twój status pojawi się, gdy go otworzysz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Discord não está aberto. Seu status aparecerá assim que ele for aberto."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Discord não está aberto. O seu estado aparece assim que estiver."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Discord nu este deschis. Statusul dvs. va apărea după ce îl deschideți."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Discord är inte öppet. Din status visas så snart det är det."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Discord haijafunguliwa. Hali yako itaonekana itakapofunguliwa."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Discord திறக்கப்படவில்லை. அது திறந்ததும் உங்கள் நிலை தோன்றும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Discord తెరవబడలేదు. అది తెరిచిన వెంటనే మీ స్టేటస్ కనిపిస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Discord ไม่ได้เปิดอยู่ สถานะของคุณจะปรากฏเมื่อเปิด Discord"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Discord açık değil. Açıldığında durumunuz görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Discord не відкрито. Ваш статус з’явиться, щойно його буде відкрито."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Discord کھلا نہیں ہے۔ اس کے کھلتے ہی آپ کا اسٹیٹس ظاہر ہو جائے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",

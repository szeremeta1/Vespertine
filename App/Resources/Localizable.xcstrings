    "Output: %@ at %lld Hz, speakers on channels 1–%lld in the standard order (unverified wiring)": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ውጤት፦ %@ በ%lld Hz፣ ድምፅ ማጉያዎች በመደበኛ ቅደም ተከተል በቻናሎች 1–%lld ላይ (ሽቦው አልተረጋገጠም)"
          }

          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有扬声器分配给输出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有喇叭分配給輸出。"
          }
        }
      }
    },
    "No speaker layout is set up, so channels go out in standard order. Set one up to place each channel on its speaker.": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ምንም የድምፅ ማጉያ አቀማመጥ ስላልተዘጋጀ ቻናሎች በመደበኛ ቅደም ተከተል ይወጣሉ። እያንዳንዱን ቻናል በድምፅ ማጉያው ላይ ለማስቀመጥ አንዱን ያዘጋጁ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم إعداد توزيع للسماعات، لذا تخرج القنوات بالترتيب القياسي. اضبط توزيعًا لوضع كل قناة على سماعتها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোনো স্পিকার লেআউট সেট আপ করা নেই, তাই চ্যানেলগুলো সাধারণ ক্রমে যায়। প্রতিটি চ্যানেল তার স্পিকারে রাখতে একটি লেআউট সেট আপ করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Není nastavené žádné rozložení reproduktorů, takže kanály jdou ve standardním pořadí. Nastavte ho, chcete-li každý kanál umístit do jeho reproduktoru."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der er ikke indstillet et højttalerlayout, så kanalerne sendes ud i standardrækkefølge. Indstil et for at placere hver kanal på sin højttaler."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist keine Lautsprecheranordnung eingerichtet, daher werden die Kanäle in Standardreihenfolge ausgegeben. Richte eine ein, um jeden Kanal seinem Lautsprecher zuzuordnen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν έχει ρυθμιστεί διάταξη ηχείων, οπότε τα κανάλια βγαίνουν με την τυπική σειρά. Ρυθμίστε μία για να τοποθετηθεί κάθε κανάλι στο ηχείο του."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay ninguna disposición de altavoces configurada, así que los canales salen en el orden estándar. Configura una para enviar cada canal a su altavoz."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هیچ چیدمان بلندگویی تنظیم نشده است، بنابراین کانال‌ها به ترتیب استاندارد خارج می‌شوند. برای قرار گرفتن هر کانال روی بلندگوی خودش، یک چیدمان تنظیم کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaiutinasettelua ei ole määritetty, joten kanavat lähtevät vakiojärjestyksessä. Määritä asettelu, niin jokainen kanava sijoitetaan omaan kaiuttimeensa."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang naka-set up na layout ng speaker, kaya lumalabas ang mga channel sa karaniwang pagkakasunod-sunod. Mag-set up ng isa para mailagay ang bawat channel sa speaker nito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune configuration de haut-parleurs n’est définie : les canaux sont donc envoyés dans l’ordre standard. Configurez-en une pour placer chaque canal sur son haut-parleur."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કોઈ સ્પીકર લેઆઉટ સેટ કરેલો નથી, તેથી ચૅનલો માનક ક્રમમાં જાય છે. દરેક ચૅનલને તેના સ્પીકર પર મૂકવા લેઆઉટ સેટ કરો."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ba a saita tsarin lasifikoki ba, don haka tashoshi suna fita a tsari na yau da kullum. Saita ɗaya don sanya kowace tasha a kan lasifikarta."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא הוגדרה פריסת רמקולים, ולכן הערוצים יוצאים בסדר הסטנדרטי. הגדר פריסה כדי למקם כל ערוץ ברמקול שלו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई स्पीकर लेआउट सेट अप नहीं है, इसलिए चैनल मानक क्रम में जाते हैं। हर चैनल को उसके स्पीकर पर रखने के लिए लेआउट सेट अप करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nincs beállítva hangszóró-elrendezés, ezért a csatornák szabványos sorrendben szólnak. Állítson be egyet, hogy minden csatorna a saját hangszórójára kerüljön."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada tata letak speaker yang diatur, sehingga saluran dikeluarkan dalam urutan standar. Atur tata letak untuk menempatkan setiap saluran di speakernya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è configurata alcuna disposizione degli altoparlanti, quindi i canali escono in ordine standard. Configurane una per portare ogni canale al suo altoparlante."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スピーカーレイアウトが設定されていないため、チャンネルは標準の順序で出力されます。各チャンネルを対応するスピーカーに配置するには、レイアウトを設定してください。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಯಾವುದೇ ಸ್ಪೀಕರ್ ಲೇಔಟ್ ಹೊಂದಿಸಿಲ್ಲ, ಆದ್ದರಿಂದ ಚಾನೆಲ್‌ಗಳು ಪ್ರಮಾಣಿತ ಕ್ರಮದಲ್ಲಿ ಹೋಗುತ್ತವೆ. ಪ್ರತಿ ಚಾನೆಲ್ ಅನ್ನು ಅದರ ಸ್ಪೀಕರ್‌ನಲ್ಲಿ ಇರಿಸಲು ಒಂದನ್ನು ಹೊಂದಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스피커 레이아웃이 설정되지 않았으므로 채널이 표준 순서로 출력됩니다. 각 채널을 해당 스피커에 배치하려면 레이아웃을 설정하십시오."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സ്പീക്കർ ലേഔട്ട് സജ്ജമാക്കിയിട്ടില്ല, അതിനാൽ ചാനലുകൾ സാധാരണ ക്രമത്തിൽ പോകുന്നു. ഓരോ ചാനലും അതിന്റെ സ്പീക്കറിൽ സ്ഥാപിക്കാൻ ഒന്ന് സജ്ജമാക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कोणतीही स्पीकर मांडणी सेट केलेली नाही, त्यामुळे चॅनेल मानक क्रमाने जातात. प्रत्येक चॅनेल त्याच्या स्पीकरवर लावण्यासाठी मांडणी सेट करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada susun atur pembesar suara disediakan, jadi saluran dihantar dalam susunan standard. Sediakan satu untuk meletakkan setiap saluran pada pembesar suaranya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er ikke konfigurert noe høyttaleroppsett, så kanalene sendes ut i standardrekkefølge. Konfigurer et for å plassere hver kanal på sin høyttaler."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is geen luidsprekerindeling ingesteld, dus de kanalen gaan in standaardvolgorde naar buiten. Stel er een in om elk kanaal op zijn luidspreker te plaatsen."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੋਈ ਸਪੀਕਰ ਲੇਆਉਟ ਸੈੱਟ ਨਹੀਂ ਹੈ, ਇਸ ਲਈ ਚੈਨਲ ਮਿਆਰੀ ਕ੍ਰਮ ਵਿੱਚ ਜਾਂਦੇ ਹਨ। ਹਰ ਚੈਨਲ ਨੂੰ ਉਸਦੇ ਸਪੀਕਰ ’ਤੇ ਰੱਖਣ ਲਈ ਇੱਕ ਲੇਆਉਟ ਸੈੱਟ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie skonfigurowano układu głośników, więc kanały wychodzą w standardowej kolejności. Skonfiguruj go, aby każdy kanał trafiał do swojego głośnika."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum layout de alto-falantes está configurado, então os canais saem na ordem padrão. Configure um para enviar cada canal ao seu alto-falante."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há nenhuma disposição de altifalantes configurada, por isso os canais saem na ordem padrão. Configure uma para colocar cada canal no respetivo altifalante."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu este configurată nicio dispunere a difuzoarelor, așa că canalele ies în ordinea standard. Configurați una pentru a plasa fiecare canal pe difuzorul său."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen högtalarlayout är inställd, så kanalerna går ut i standardordning. Ställ in en för att placera varje kanal på sin högtalare."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hakuna mpangilio wa spika uliowekwa, kwa hivyo chaneli hutoka kwa mpangilio wa kawaida. Weka mmoja ili kuweka kila chaneli kwenye spika yake."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஸ்பீக்கர் அமைப்பு எதுவும் அமைக்கப்படவில்லை, எனவே சேனல்கள் நிலையான வரிசையில் வெளியேறும். ஒவ்வொரு சேனலையும் அதன் ஸ்பீக்கரில் வைக்க ஒன்றை அமைக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "స్పీకర్ లేఅవుట్ ఏదీ సెటప్ చేయలేదు, కాబట్టి ఛానెల్‌లు ప్రామాణిక క్రమంలో వెళ్తాయి. ప్రతి ఛానెల్‌ను దాని స్పీకర్‌పై ఉంచడానికి ఒకటి సెటప్ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่ได้ตั้งค่ารูปแบบลำโพง ช่องสัญญาณจึงส่งออกตามลำดับมาตรฐาน ตั้งค่ารูปแบบเพื่อวางแต่ละช่องสัญญาณบนลำโพงของตัวเอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoparlör düzeni ayarlanmadığından kanallar standart sırayla çıkar. Her kanalı kendi hoparlörüne yerleştirmek için bir düzen ayarlayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розкладку динаміків не налаштовано, тож канали виводяться в стандартному порядку. Налаштуйте її, щоб кожен канал потрапляв на свій динамік."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کوئی اسپیکر ترتیب سیٹ اپ نہیں، اس لیے چینلز معیاری ترتیب میں جاتے ہیں۔ ہر چینل کو اس کے اسپیکر پر رکھنے کے لیے ایک ترتیب سیٹ اپ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa thiết lập bố cục loa, vì vậy các kênh được xuất theo thứ tự tiêu chuẩn. Hãy thiết lập bố cục để đặt từng kênh vào loa của nó."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未設定揚聲器佈局，因此聲道會按標準次序輸出。設定佈局即可將每個聲道送至對應的揚聲器。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未设置扬声器布局，因此声道按标准顺序输出。设置布局后，即可将每个声道放到对应的扬声器上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未設定揚聲器配置，因此聲道會依標準順序輸出。設定配置後，即可將每個聲道放到對應的揚聲器上。"
          }
        }
      }
    },
    "No strobe while Dim Flashing Lights is on.": {
      "comment": "Visualizer: why the strobe option is unavailable (the macOS accessibility setting Dim Flashing Lights).",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Stroboskop, solange „Blinkende Lichter abdunkeln“ an ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de stroboscope quand « Atténuer les lumières clignotantes » est activé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin estroboscopio mientras «Atenuar luces intermitentes» esté activado."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Niente stroboscopio con “Attenua luci lampeggianti” attivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem estroboscópio enquanto “Atenuar luzes piscantes” estiver ativado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem estroboscópio enquanto “Atenuar luzes intermitentes” estiver ativo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen stroboscoop zolang ‘Dim knipperende lichten’ aan staat."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget stroboskop när Dämpa blinkande ljus är på."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Intet stroboskop, mens Dæmp blinkende lys er slået til."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen stroboskop mens Demp blinkende lys er på."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei stroboa, kun Himmennä välkkyviä valoja on päällä."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez stroboskopu, gdy włączone jest Przyciemnij migające światła."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez stroboskopu, když je zapnuté Ztlumit blikající světla."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nincs villogás, amíg a Villogó fények tompítása be van kapcsolva."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fără stroboscop cât timp Atenuare lumini intermitente este activată."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yanıp Sönen Işıkları Karart açıkken çakar yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Без стробоскопа, поки ввімкнено «Приглушення миготливого світла»."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χωρίς στροβοσκόπιο όσο είναι ενεργή η Μείωση φώτων που αναβοσβήνουν."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「点滅する光を暗くする」がオンのあいだはストロボは使えません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "깜박이는 빛 어둡게 하기가 켜져 있는 동안에는 스트로브를 쓸 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“减弱闪烁的光线”打开时不使用频闪。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「調暗閃爍的光線」開啟時不使用閃光。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không nháy khi Làm mờ đèn nhấp nháy đang bật."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada strobo saat Redupkan Cahaya Berkedip aktif."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada strob semasa Malapkan Cahaya Berkelip dihidupkan."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang strobe habang naka-on ang Dim Flashing Lights."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hakuna mwako wakati Fifisha Taa Zinazomulika umewashwa."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Babu walƙiya yayin da Rage Fitilun Walƙiya ke kunne."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",

    "The files hold %lld filters; room correction takes one per speaker, up to six (5.1).": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ፋይሎቹ %lld ማጣሪያዎች ይዘዋል፤ የክፍል ማስተካከያ ለእያንዳንዱ ድምፅ ማጉያ አንድ ይወስዳል፣ እስከ ስድስት (5.1)።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحتوي الملفات على %lld مرشحات؛ يأخذ تصحيح الغرفة مرشحًا واحدًا لكل سماعة، حتى ستة (5.1)."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফাইলগুলিতে %lldটি ফিল্টার আছে; রুম কারেকশন প্রতিটি স্পিকারে একটি নেয়, সর্বোচ্চ ছয়টি (5.1)।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Soubory obsahují filtry: %lld; korekce místnosti bere jeden na reproduktor, nejvýše šest (5.1)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Filerne indeholder %lld filtre; rumkorrektion tager ét pr. højttaler, højst seks (5.1)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Dateien enthalten %lld Filter; die Raumkorrektur nimmt einen pro Lautsprecher, höchstens sechs (5.1)."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα αρχεία έχουν %lld φίλτρα· η διόρθωση χώρου παίρνει ένα ανά ηχείο, έως έξι (5.1)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos contienen %lld filtros; la corrección de sala usa uno por altavoz, hasta seis (5.1)."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فایل‌ها %lld فیلتر دارند؛ تصحیح اتاق برای هر بلندگو یکی برمی‌دارد، حداکثر شش (۵.۱)."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiedostoissa on %lld suodatinta; huonekorjaus käyttää yhtä kaiutinta kohden, enintään kuusi (5.1)."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "May %lld filter ang mga file; isa bawat speaker ang ginagamit ng room correction, hanggang anim (5.1)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers contiennent %lld filtres ; la correction de pièce en prend un par enceinte, six au plus (5.1)."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ફાઇલોમાં %lld ફિલ્ટર છે; રૂમ કરેક્શન દરેક સ્પીકર માટે એક લે છે, વધુમાં વધુ છ (5.1)."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Fayilolin suna da matatu %lld; gyaran ɗaki yana ɗaukar ɗaya ga kowane lasifika, har zuwa shida (5.1)."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בקבצים יש %lld מסננים; תיקון החדר לוקח אחד לכל רמקול, עד שישה (5.1)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ाइलों में %lld फ़िल्टर हैं; रूम करेक्शन हर स्पीकर के लिए एक लेता है, अधिकतम छह (5.1)।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fájlokban %lld szűrő van; a térkorrekció hangszórónként egyet használ, legfeljebb hatot (5.1)."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "File berisi %lld filter; koreksi ruangan memakai satu per speaker, hingga enam (5.1)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I file contengono %lld filtri; la correzione ambientale ne usa uno per diffusore, fino a sei (5.1)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルには %lld 個のフィルターがあります。ルーム補正はスピーカー 1 台につき 1 個、最大 6 個（5.1）までです。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಫೈಲ್‌ಗಳಲ್ಲಿ %lld ಫಿಲ್ಟರ್‌ಗಳಿವೆ; ರೂಮ್ ಕರೆಕ್ಷನ್ ಪ್ರತಿ ಸ್ಪೀಕರ್‌ಗೆ ಒಂದನ್ನು ತೆಗೆದುಕೊಳ್ಳುತ್ತದೆ, ಗರಿಷ್ಠ ಆರು (5.1)."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일에 필터가 %lld개 있습니다. 룸 보정은 스피커당 하나, 최대 여섯 개(5.1)까지 사용합니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഫയലുകളിൽ %lld ഫിൽട്ടറുകളുണ്ട്; റൂം കറക്ഷൻ ഓരോ സ്പീക്കറിനും ഒന്ന് എടുക്കും, പരമാവധി ആറ് (5.1)."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "फाइल्समध्ये %lld फिल्टर आहेत; रूम करेक्शन प्रत्येक स्पीकरसाठी एक घेते, जास्तीत जास्त सहा (5.1)."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Fail mengandungi %lld penapis; pembetulan bilik mengambil satu bagi setiap pembesar suara, sehingga enam (5.1)."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Filene inneholder %lld filtre; romkorrigeringen tar ett per høyttaler, opptil seks (5.1)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De bestanden bevatten %lld filters; ruimtecorrectie neemt er één per luidspreker, hoogstens zes (5.1)."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਫ਼ਾਈਲਾਂ ਵਿੱਚ %lld ਫ਼ਿਲਟਰ ਹਨ; ਰੂਮ ਕਰੈਕਸ਼ਨ ਹਰ ਸਪੀਕਰ ਲਈ ਇੱਕ ਲੈਂਦਾ ਹੈ, ਵੱਧ ਤੋਂ ਵੱਧ ਛੇ (5.1)।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pliki zawierają filtry: %lld; korekcja pomieszczenia bierze jeden na głośnik, najwyżej sześć (5.1)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os arquivos têm %lld filtros; a correção de sala usa um por caixa, até seis (5.1)."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os ficheiros têm %lld filtros; a correção de sala usa um por coluna, até seis (5.1)."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fișierele conțin %lld filtre; corecția camerei ia câte unul pe difuzor, cel mult șase (5.1)."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Filerna innehåller %lld filter; rumskorrigeringen tar ett per högtalare, högst sex (5.1)."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Faili zina vichujio %lld; usahihishaji wa chumba huchukua kimoja kwa kila spika, hadi sita (5.1)."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கோப்புகளில் %lld ஃபில்டர்கள் உள்ளன; அறைத் திருத்தம் ஒரு ஸ்பீக்கருக்கு ஒன்று எடுக்கும், அதிகபட்சம் ஆறு (5.1)."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఫైల్‌లలో %lld ఫిల్టర్‌లు ఉన్నాయి; రూమ్ కరెక్షన్ ఒక్కో స్పీకర్‌కు ఒకటి తీసుకుంటుంది, గరిష్ఠంగా ఆరు (5.1)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟล์มีฟิลเตอร์ %lld ตัว การปรับแก้ห้องใช้ลำโพงละหนึ่งตัว ได้สูงสุดหกตัว (5.1)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosyalarda %lld filtre var; oda düzeltmesi hoparlör başına bir tane alır, en fazla altı (5.1)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Файли містять фільтрів: %lld; корекція кімнати бере по одному на динамік, щонайбільше шість (5.1)."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فائلوں میں %lld فلٹر ہیں؛ روم کریکشن ہر اسپیکر کے لیے ایک لیتا ہے، زیادہ سے زیادہ چھ (5.1)۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các tệp chứa %lld bộ lọc; hiệu chỉnh phòng dùng một bộ lọc cho mỗi loa, tối đa sáu (5.1)."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "這些檔案包含 %lld 個濾波器；房間校正每個揚聲器用一個，最多六個（5.1）。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些文件包含 %lld 个滤波器；房间校正每个扬声器用一个，最多六个（5.1）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些檔案包含 %lld 個濾波器；房間校正每個揚聲器用一個，最多六個（5.1）。"
          }
        }
      }
    },

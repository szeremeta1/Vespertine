    "Folders are added whole when referencing": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "በማገናኘት ጊዜ አቃፊዎች በሙሉ ይታከላሉ"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُضاف المجلدات كاملة عند الإحالة إليها في مكانها"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রেফারেন্স করার সময় পুরো ফোল্ডার যোগ করা হয়"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Při odkazování se složky přidávají celé"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mapper tilføjes i deres helhed, når der henvises"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Referenzieren werden Ordner vollständig hinzugefügt"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Με την αναφορά, οι φάκελοι προστίθενται ολόκληροι"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al usar referencias, las carpetas se añaden completas"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هنگام ارجاع، پوشه‌ها به‌طور کامل افزوده می‌شوند"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kansiot lisätään kokonaisina, kun viitataan paikallaan"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Buong folder ang idinadagdag kapag nire-reference sa kinalalagyan"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les dossiers sont ajoutés entiers en mode référence"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "મૂળ જગ્યાએ રાખતી વખતે ફોલ્ડર આખાં ઉમેરાય છે"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ana ƙara foldoji gaba ɗaya idan ana nuni a inda suke"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תיקיות מתווספות בשלמותן בעת הפניה במקום"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रेफ़रेंस करते समय पूरे फ़ोल्डर जोड़े जाते हैं"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hivatkozáskor a mappák egészben adódnak hozzá"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Folder ditambahkan secara utuh saat dirujuk"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con il riferimento, le cartelle vengono aggiunte per intero"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "参照で追加する場合、フォルダは丸ごと追加されます"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇರುವಲ್ಲೇ ಉಲ್ಲೇಖಿಸುವಾಗ ಫೋಲ್ಡರ್‌ಗಳನ್ನು ಸಂಪೂರ್ಣವಾಗಿ ಸೇರಿಸಲಾಗುತ್ತದೆ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "참조로 추가할 때는 폴더 전체가 추가됩니다"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "റഫറൻസ് ചെയ്യുമ്പോൾ ഫോൾഡറുകൾ മുഴുവനായി ചേർക്കും"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "मूळ जागी ठेवताना फोल्डर संपूर्ण जोडले जातात"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Folder ditambah sepenuhnya apabila dirujuk di tempat"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Mapper legges til i sin helhet ved referanse"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bij verwijzen worden mappen in hun geheel toegevoegd"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਮੌਜੂਦਾ ਥਾਂ ਤੋਂ ਵਰਤਣ ਵੇਲੇ ਫ਼ੋਲਡਰ ਪੂਰੇ ਜੋੜੇ ਜਾਂਦੇ ਹਨ"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przy pozostawieniu na miejscu foldery są dodawane w całości"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao referenciar, as pastas são adicionadas inteiras"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao referenciar, as pastas são adicionadas por inteiro"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "La referențiere, dosarele sunt adăugate integral"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mappar läggs till i sin helhet vid referens"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Folda huongezwa nzima unaporejelea mahali zilipo"
          }
        },
        "ta": {
          "stringUnit": {

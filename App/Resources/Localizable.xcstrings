    "The input and output clocks differ by %@ parts per million, more than a measurement can correct.": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "የግብዓትና የውጤት ሰዓቶች በ%@ ፓርትስ ፐር ሚሊዮን ይለያያሉ፣ ይህም መለካት ሊያስተካክለው ከሚችለው በላይ ነው።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تختلف ساعتا الإدخال والإخراج بمقدار %@ جزءًا في المليون، وهو أكثر مما يستطيع القياس تصحيحه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ইনপুট ও আউটপুট ক্লক %@ পার্টস পার মিলিয়ন আলাদা, যা পরিমাপ ঠিক করতে পারে তার চেয়ে বেশি।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vstupní a výstupní hodiny se liší o %@ dílů na milion, což měření nedokáže vyrovnat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indgangs- og udgangsuret afviger med %@ dele pr. million, mere end en måling kan rette."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eingangs- und Ausgangstakt weichen um %@ ppm voneinander ab, mehr als eine Messung ausgleichen kann."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα ρολόγια εισόδου και εξόδου διαφέρουν κατά %@ μέρη ανά εκατομμύριο, περισσότερο από όσο μπορεί να διορθώσει μια μέτρηση."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los relojes de entrada y salida difieren en %@ partes por millón, más de lo que una medición puede corregir."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ساعت‌های ورودی و خروجی %@ قسمت در میلیون اختلاف دارند، بیش از آنچه اندازه‌گیری بتواند جبران کند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tulo- ja lähtökellot poikkeavat toisistaan %@ miljoonasosaa, enemmän kuin mittaus voi korjata."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Magkaiba ng %@ parts per million ang input at output clock, higit sa kayang itama ng isang pagsukat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les horloges d'entrée et de sortie diffèrent de %@ parties par million, plus que ce qu'une mesure peut corriger."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ઇનપુટ અને આઉટપુટ ક્લોક %@ પાર્ટ્સ પર મિલિયનથી અલગ છે, જે માપન સુધારી શકે તેનાથી વધુ છે."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Agogon shigarwa da fitarwa sun bambanta da sassa %@ a cikin miliyan, fiye da yadda aunawa zai iya gyarawa."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שעוני הקלט והפלט שונים ב-%@ חלקים למיליון, יותר ממה שמדידה יכולה לתקן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इनपुट और आउटपुट क्लॉक में %@ पार्ट्स पर मिलियन का अंतर है, जो माप सुधार सकने से अधिक है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A bemeneti és a kimeneti óra %@ ppm-mel tér el, többel, mint amit egy mérés korrigálni tud."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Clock input dan output berbeda %@ bagian per juta, lebih dari yang dapat dikoreksi pengukuran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I clock di ingresso e uscita differiscono di %@ parti per milione, più di quanto una misurazione possa correggere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力と出力のクロックが %@ ppm ずれており、測定で補正できる範囲を超えています。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇನ್‌ಪುಟ್ ಮತ್ತು ಔಟ್‌ಪುಟ್ ಕ್ಲಾಕ್‌ಗಳು ಮಿಲಿಯನ್‌ಗೆ %@ ಭಾಗಗಳಷ್ಟು ಭಿನ್ನವಾಗಿವೆ, ಇದು ಅಳತೆ ಸರಿಪಡಿಸಬಲ್ಲುದಕ್ಕಿಂತ ಹೆಚ್ಚು."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입력과 출력 클럭이 백만분율 %@만큼 차이 나며, 측정으로 보정할 수 있는 범위를 넘습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇൻപുട്ട്, ഔട്ട്പുട്ട് ക്ലോക്കുകൾ ദശലക്ഷത്തിൽ %@ ഭാഗം വ്യത്യാസപ്പെടുന്നു, അളവിന് തിരുത്താവുന്നതിലും കൂടുതൽ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "इनपुट आणि आउटपुट क्लॉकमध्ये प्रति दशलक्ष %@ भागांचा फरक आहे, जो मापन दुरुस्त करू शकते त्यापेक्षा जास्त आहे."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jam input dan output berbeza %@ bahagian per juta, lebih daripada yang boleh dibetulkan oleh ukuran."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Inngangs- og utgangsklokkene avviker med %@ deler per million, mer enn en måling kan rette opp."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De invoer- en uitvoerklokken verschillen %@ delen per miljoen, meer dan een meting kan corrigeren."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਨਪੁੱਟ ਅਤੇ ਆਊਟਪੁੱਟ ਕਲਾਕ ਵਿੱਚ ਪ੍ਰਤੀ ਮਿਲੀਅਨ %@ ਭਾਗਾਂ ਦਾ ਫ਼ਰਕ ਹੈ, ਜੋ ਮਾਪ ਠੀਕ ਕਰ ਸਕਣ ਤੋਂ ਵੱਧ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zegary wejścia i wyjścia różnią się o %@ części na milion, więcej, niż pomiar może skorygować."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os clocks de entrada e saída diferem em %@ partes por milhão, mais do que uma medição consegue corrigir."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os relógios de entrada e saída diferem em %@ partes por milhão, mais do que uma medição consegue corrigir."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceasurile de intrare și de ieșire diferă cu %@ părți pe milion, mai mult decât poate corecta o măsurare."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingångs- och utgångsklockorna skiljer sig med %@ miljondelar, mer än en mätning kan korrigera."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Saa za pembejeo na pato zinatofautiana kwa sehemu %@ kwa milioni, zaidi ya kipimo kinachoweza kusahihisha."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உள்ளீடு மற்றும் வெளியீட்டு கடிகாரங்கள் மில்லியனுக்கு %@ பங்குகள் வேறுபடுகின்றன; இது அளவீடு சரிசெய்யக்கூடியதை விட அதிகம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇన్‌పుట్ మరియు అవుట్‌పుట్ క్లాక్‌లు మిలియన్‌కు %@ భాగాలు తేడాగా ఉన్నాయి, కొలత సరిదిద్దగలదాని కంటే ఎక్కువ."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นาฬิกาอินพุตและเอาต์พุตต่างกัน %@ ส่วนในล้านส่วน มากเกินกว่าที่การวัดจะแก้ไขได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Giriş ve çıkış saatleri milyonda %@ kadar farklı; bu, bir ölçümün düzeltebileceğinden fazla."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Годинники входу та виходу розходяться на %@ частин на мільйон — більше, ніж може скоригувати вимірювання."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ان پٹ اور آؤٹ پٹ کلاک میں %@ پارٹس پر ملین کا فرق ہے، جو پیمائش درست کر سکنے سے زیادہ ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xung nhịp đầu vào và đầu ra lệch nhau %@ phần triệu, nhiều hơn mức một phép đo có thể hiệu chỉnh."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入與輸出時鐘相差百萬分之 %@，超出量度所能校正的範圍。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入与输出时钟相差百万分之 %@，超出测量所能校正的范围。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入與輸出時鐘相差百萬分之 %@，超出量測所能校正的範圍。"
          }
        }
      }
    },
    "The level check couldn't settle on a level.": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "የደረጃ ፍተሻው በአንድ ደረጃ ላይ ሊረጋጋ አልቻለም።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر على فحص المستوى الاستقرار على مستوى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লেভেল পরীক্ষা কোনো লেভেলে স্থির হতে পারেনি।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrola úrovně se nedokázala ustálit na úrovni."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Niveautjekket kunne ikke lande på et niveau."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Pegelprüfung konnte sich nicht auf einen Pegel einigen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο έλεγχος στάθμης δεν μπόρεσε να καταλήξει σε μια στάθμη."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La comprobación de nivel no logró fijar un nivel."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بررسی سطح نتوانست روی یک سطح ثابت شود."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tasotarkistus ei löytänyt sopivaa tasoa."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi nakahanap ng level ang level check."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contrôle du niveau n'a pas réussi à se stabiliser sur un niveau."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "લેવલ તપાસ કોઈ લેવલ પર સ્થિર થઈ શકી નથી."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Duba matakin ya kasa tsayawa a kan wani mataki."
          }
        },
        "he": {

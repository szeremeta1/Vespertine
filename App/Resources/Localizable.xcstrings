    "That doesn’t look like a server address. Try smb://server/share.": {
      "extractionState": "manual",
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ይህ የአገልጋይ አድራሻ አይመስልም። smb://server/share ይሞክሩ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يبدو هذا عنوان خادم. جرّب smb://server/share."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি সার্ভারের ঠিকানা বলে মনে হচ্ছে না। smb://server/share চেষ্টা করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto nevypadá jako adresa serveru. Zkuste smb://server/sdileni."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det ligner ikke en serveradresse. Prøv smb://server/deling."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das sieht nicht wie eine Serveradresse aus. Versuche smb://server/freigabe."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό δεν μοιάζει με διεύθυνση διακομιστή. Δοκιμάστε smb://server/share."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That doesn’t look like a server address. Try smb://server/share."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eso no parece la dirección de un servidor. Prueba con smb://servidor/recurso."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این شبیه نشانی سرور نیست. smb://server/share را امتحان کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä ei näytä palvelimen osoitteelta. Kokeile smb://palvelin/jako."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mukhang hindi iyan address ng server. Subukan ang smb://server/share."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela ne ressemble pas à une adresse de serveur. Essayez smb://serveur/partage."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ સર્વરનું સરનામું લાગતું નથી. smb://server/share અજમાવો."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Wannan bai yi kama da adireshin sabar ba. Gwada smb://server/share."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "זה לא נראה כמו כתובת שרת. נסה smb://server/share."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह सर्वर का पता नहीं लगता। smb://server/share आज़माएँ।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez nem tűnik szervercímnek. Próbálja így: smb://szerver/megosztas."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Itu tidak terlihat seperti alamat server. Coba smb://server/share."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",

          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El diseño de la medición necesita una frecuencia de muestreo, un barrido de al menos un segundo y un hueco de al menos 0,3 s alrededor del barrido."
          }
        },
        "fa": {
          "stringUnit": {

    "Connected, but the share’s contents can’t be read.": {
      "extractionState": "manual",
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ተገናኝቷል፣ ግን የማጋሪያው ይዘት ሊነበብ አይችልም።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم الاتصال، لكن تتعذر قراءة محتويات المشاركة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সংযুক্ত, কিন্তু শেয়ারের বিষয়বস্তু পড়া যাচ্ছে না।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Připojeno, ale obsah sdílení nelze přečíst."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Forbundet, men delingens indhold kan ikke læses."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbunden, aber der Inhalt der Freigabe kann nicht gelesen werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συνδέθηκε, αλλά δεν είναι δυνατή η ανάγνωση των περιεχομένων του κοινόχρηστου φακέλου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connected, but the share’s contents can’t be read."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectado, pero no se puede leer el contenido del recurso compartido."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "وصل شد، اما محتوای اشتراک قابل خواندن نیست."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yhdistetty, mutta jaon sisältöä ei voi lukea."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nakakonekta, pero hindi mabasa ang laman ng share."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecté, mais le contenu du partage ne peut pas être lu."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કનેક્ટ થયું, પણ શેરની સામગ્રી વાંચી શકાતી નથી."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "An haɗa, amma ba za a iya karanta abubuwan da ke cikin folda ta cibiyar sadarwa ba."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מחובר, אך לא ניתן לקרוא את תוכן השיתוף."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कनेक्ट है, लेकिन शेयर की सामग्री पढ़ी नहीं जा सकती।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csatlakozva, de a megosztás tartalma nem olvasható."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terhubung, tetapi isi share tidak dapat dibaca."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Connesso, ma il contenuto della condivisione non può essere letto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続しましたが、共有の内容を読み込めません。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸಂಪರ್ಕಗೊಂಡಿದೆ, ಆದರೆ ಶೇರ್‌ನ ವಿಷಯಗಳನ್ನು ಓದಲು ಸಾಧ್ಯವಿಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결되었지만 공유의 내용을 읽을 수 없습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കണക്റ്റ് ചെയ്തു, പക്ഷേ ഷെയറിലെ ഉള്ളടക്കം വായിക്കാനാകുന്നില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कनेक्ट झाले, पण शेअरमधील सामग्री वाचता येत नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bersambung, tetapi kandungan perkongsian tidak dapat dibaca."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilkoblet, men innholdet i delingen kan ikke leses."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbonden, maar de inhoud van de share kan niet worden gelezen."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕਨੈਕਟ ਹੈ, ਪਰ ਸ਼ੇਅਰ ਦੀ ਸਮੱਗਰੀ ਪੜ੍ਹੀ ਨਹੀਂ ਜਾ ਸਕਦੀ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połączono, ale nie można odczytać zawartości zasobu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectado, mas não é possível ler o conteúdo do compartilhamento."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ligado, mas não é possível ler o conteúdo da partilha."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectat, dar conținutul partajării nu poate fi citit."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ansluten, men resursens innehåll kan inte läsas."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Imeunganishwa, lakini maudhui ya folda ya mtandao hayawezi kusomwa."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இணைக்கப்பட்டது, ஆனால் பகிர்வின் உள்ளடக்கத்தைப் படிக்க முடியவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కనెక్ట్ అయింది, కానీ షేర్ కంటెంట్‌ను చదవడం సాధ్యం కాదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เชื่อมต่อแล้ว แต่อ่านเนื้อหาของแชร์ไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlanıldı, ancak paylaşımın içeriği okunamıyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "З’єднання встановлено, але вміст ресурсу неможливо прочитати."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "منسلک ہو گیا، لیکن شیئر کا مواد پڑھا نہیں جا سکتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã kết nối, nhưng không thể đọc nội dung của chia sẻ."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "已連接，但無法讀取共享的內容。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已连接，但无法读取共享的内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已連線，但無法讀取共享的內容。"
          }

            "value": "연결되었지만 해당 공유에 ‘%@’ 폴더가 없습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കണക്റ്റ് ചെയ്തു, പക്ഷേ ആ ഷെയറിൽ “%@” എന്ന ഫോൾഡറില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कनेक्ट झाले, पण त्या शेअरमध्ये “%@” नावाचा फोल्डर नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bersambung, tetapi tiada folder “%@” dalam perkongsian itu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilkoblet, men det finnes ingen mappe «%@» i den delingen."

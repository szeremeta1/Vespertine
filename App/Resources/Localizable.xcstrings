      }
    },
    "%@ Vespertine tries again in 30 minutes, or when you choose Reconnect.": {
      "comment": "Starts with the reason the share couldn't connect.",
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Vespertine በ30 ደቂቃ ውስጥ ወይም «እንደገና አገናኝ»ን ሲመርጡ እንደገና ይሞክራል።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ سيحاول Vespertine مجددًا بعد 30 دقيقة، أو عندما تختار “إعادة الاتصال”."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Vespertine 30 মিনিট পরে আবার চেষ্টা করবে, অথবা যখন আপনি “পুনরায় সংযোগ করুন” বেছে নেবেন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Vespertine to zkusí znovu za 30 minut nebo až zvolíte Znovu připojit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",

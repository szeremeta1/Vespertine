        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ O Vespertine volta a tentar dentro de 30 minutos ou quando escolher Voltar a ligar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Vespertine încearcă din nou peste 30 de minute sau când alegeți Reconectează."

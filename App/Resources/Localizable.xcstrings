            "value": "Không phát gì cho đến khi đầu ra bạn đã chọn được kết nối lại."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "在你所選的輸出裝置重新連接之前，不會播放任何內容。"
          }
        },
        "zh-Hans": {

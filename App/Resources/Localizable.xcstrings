        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbonden, maar er is geen map ‘%@’ in die share."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕਨੈਕਟ ਹੈ, ਪਰ ਉਸ ਸ਼ੇਅਰ ਵਿੱਚ “%@” ਨਾਂ ਦਾ ਕੋਈ ਫ਼ੋਲਡਰ ਨਹੀਂ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",

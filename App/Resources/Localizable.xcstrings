    "Searches your drives and checks every file's real format.": {
      "extractionState": "manual",
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "አንጻፊዎችዎን ይፈልጋል፤ የእያንዳንዱን ፋይል እውነተኛ ቅርጸትም ይፈትሻል።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبحث في أقراصك ويتحقق من التنسيق الحقيقي لكل ملف."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার ড্রাইভগুলো খোঁজে এবং প্রতিটি ফাইলের আসল ফরম্যাট যাচাই করে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prohledá vaše disky a ověří skutečný formát každého souboru."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gennemsøger dine drev og tjekker hver fils reelle format."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Durchsucht deine Laufwerke und prüft das echte Format jeder Datei."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αναζητά στους δίσκους σας και ελέγχει την πραγματική μορφή κάθε αρχείου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Searches your drives and checks every file's real format."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca en tus discos y comprueba el formato real de cada archivo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دیسک‌هایتان را جست‌وجو می‌کند و قالب واقعی هر فایل را بررسی می‌کند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käy läpi asemasi ja tarkistaa jokaisen tiedoston todellisen formaatin."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinahanap sa mga drive mo at sinusuri ang tunay na format ng bawat file."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parcourt vos disques et vérifie le format réel de chaque fichier."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારી ડ્રાઇવ શોધે છે અને દરેક ફાઇલનું સાચું ફૉર્મેટ તપાસે છે."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Yana bincika faifanku kuma yana duba ainihin tsarin kowane fayil."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מחפש בכוננים שלך ובודק את הפורמט האמיתי של כל קובץ."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी ड्राइव खोजता है और हर फ़ाइल का असली फ़ॉर्मैट जाँचता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Átnézi a meghajtókat, és ellenőrzi minden fájl valódi formátumát."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mencari di drive Anda dan memeriksa format asli setiap file."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerca nei tuoi dischi e verifica il formato reale di ogni file."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドライブを検索し、すべてのファイルの実際のフォーマットを確認します。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಡ್ರೈವ್‌ಗಳನ್ನು ಹುಡುಕಿ, ಪ್ರತಿ ಫೈಲ್‌ನ ನಿಜವಾದ ಫಾರ್ಮ್ಯಾಟ್ ಪರಿಶೀಲಿಸುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "드라이브를 검색하고 모든 파일의 실제 포맷을 확인합니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ ഡ്രൈവുകൾ തിരഞ്ഞ് ഓരോ ഫയലിന്റെയും യഥാർത്ഥ ഫോർമാറ്റ് പരിശോധിക്കുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमच्या ड्राइव्ह शोधते आणि प्रत्येक फाइलचा खरा फॉरमॅट तपासते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mencari dalam pemacu anda dan menyemak format sebenar setiap fail."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Søker gjennom diskene dine og sjekker det reelle formatet på hver fil."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Doorzoekt je schijven en controleert het echte formaat van elk bestand."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡੀਆਂ ਡਰਾਈਵਾਂ ਖੋਜਦਾ ਹੈ ਅਤੇ ਹਰ ਫ਼ਾਈਲ ਦਾ ਅਸਲ ਫ਼ਾਰਮੈਟ ਜਾਂਚਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeszukuje dyski i sprawdza rzeczywisty format każdego pliku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesquisa seus discos e verifica o formato real de cada arquivo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesquisa os discos e verifica o formato real de cada ficheiro."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Caută pe discuri și verifică formatul real al fiecărui fișier."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Söker igenom dina enheter och kontrollerar varje fils verkliga format."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hutafuta kwenye hifadhi zako na kukagua fomati halisi ya kila faili."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் டிரைவ்களைத் தேடி, ஒவ்வொரு கோப்பின் உண்மையான வடிவத்தையும் சரிபார்க்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ డ్రైవ్‌లను వెతికి, ప్రతి ఫైల్ అసలు ఫార్మాట్‌ను తనిఖీ చేస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ค้นหาในไดรฟ์ของคุณและตรวจสอบรูปแบบจริงของทุกไฟล์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Disklerinizi tarar ve her dosyanın gerçek biçimini denetler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Шукає на ваших дисках і перевіряє справжній формат кожного файлу."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی ڈرائیوز تلاش کرتا ہے اور ہر فائل کا اصل فارمیٹ جانچتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tìm kiếm trên các ổ đĩa và kiểm tra định dạng thực của từng tệp."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "搜尋你的磁碟，並檢查每個檔案的實際格式。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "搜索你的驱动器，并检查每个文件的真实格式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "搜尋你的磁碟，並檢查每個檔案的實際格式。"
          }
        }
      }

          "stringUnit": {
            "state": "translated",
            "value": "macOS tinh chỉnh loa tích hợp của máy Mac bằng xử lý riêng, vì vậy nhạc không thể đến loa ở dạng bit-perfect."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 會以自己的處理調校 Mac 內置的揚聲器，因此音樂無法以位元完美方式送達。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 会用自己的处理来调校 Mac 自带的扬声器，因此音乐无法以比特完美方式到达扬声器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 會以自己的處理來調校 Mac 內建的揚聲器，因此音樂無法以位元完美方式送達揚聲器。"
          }
        }
      }
    },

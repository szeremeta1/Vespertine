    },
    "Play music from a NAS, a file server or another Mac, at home or from anywhere over Tailscale or a VPN. Vespertine keeps the share connected and indexes it in the background.": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ሙዚቃን ከNAS፣ ከፋይል አገልጋይ ወይም ከሌላ Mac፣ ከቤት ወይም ከየትኛውም ቦታ በTailscale ወይም በVPN ያጫውቱ። Vespertine ማጋሪያውን እንደተገናኘ ያቆየዋል፣ ከበስተጀርባም ኢንዴክስ ያደርገዋል።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شغّل الموسيقى من NAS أو خادم ملفات أو Mac آخر، في المنزل أو من أي مكان عبر Tailscale أو VPN. يُبقي Vespertine المشاركة متصلة ويفهرسها في الخلفية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "NAS, ফাইল সার্ভার বা অন্য একটি Mac থেকে মিউজিক চালান, বাড়িতে অথবা Tailscale বা VPN-এর মাধ্যমে যেকোনো জায়গা থেকে। Vespertine শেয়ারটি সংযুক্ত রাখে এবং ব্যাকগ্রাউন্ডে এটি ইনডেক্স করে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přehrávejte hudbu z NAS, souborového serveru nebo jiného Macu, doma nebo odkudkoli přes Tailscale či VPN. Vespertine udržuje sdílení připojené a indexuje ho na pozadí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Afspil musik fra en NAS, en filserver eller en anden Mac – derhjemme eller hvor som helst via Tailscale eller en VPN. Vespertine holder delingen forbundet og indekserer den i baggrunden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spiele Musik von einem NAS, einem Dateiserver oder einem anderen Mac ab, zu Hause oder von überall über Tailscale oder ein VPN. Vespertine hält die Freigabe verbunden und indexiert sie im Hintergrund."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αναπαραγάγετε μουσική από NAS, διακομιστή αρχείων ή άλλο Mac, στο σπίτι ή από οπουδήποτε μέσω Tailscale ή VPN. Το Vespertine διατηρεί τον κοινόχρηστο φάκελο συνδεδεμένο και τον ευρετηριάζει στο παρασκήνιο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproduce música desde un NAS, un servidor de archivos u otro Mac, en casa o desde cualquier lugar a través de Tailscale o una VPN. Vespertine mantiene conectado el recurso compartido y lo indexa en segundo plano."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "موسیقی را از NAS، یک سرور فایل یا Mac دیگری پخش کنید؛ در خانه یا از هر جایی از طریق Tailscale یا VPN. Vespertine اتصال اشتراک را حفظ می‌کند و آن را در پس‌زمینه فهرست‌بندی می‌کند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Toista musiikkia NAS-laitteelta, tiedostopalvelimelta tai toiselta Macilta – kotona tai missä tahansa Tailscalen tai VPN:n kautta. Vespertine pitää jaon yhdistettynä ja indeksoi sen taustalla."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mag-play ng musika mula sa NAS, file server o ibang Mac, sa bahay o kahit saan sa pamamagitan ng Tailscale o VPN. Pinapanatiling nakakonekta ng Vespertine ang share at ini-index ito sa background."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écoutez de la musique depuis un NAS, un serveur de fichiers ou un autre Mac, chez vous ou depuis n’importe où via Tailscale ou un VPN. Vespertine maintient le partage connecté et l’indexe en arrière-plan."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "NAS, ફાઇલ સર્વર અથવા બીજા Mac પરથી સંગીત વગાડો, ઘરે અથવા Tailscale કે VPN દ્વારા ગમે ત્યાંથી. Vespertine શેરને કનેક્ટ રાખે છે અને બૅકગ્રાઉન્ડમાં તેનું ઇન્ડેક્સિંગ કરે છે."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunna waƙoƙi daga NAS, sabar fayil ko wata Mac, a gida ko daga ko'ina ta Tailscale ko VPN. Vespertine yana kiyaye haɗin folda ta cibiyar sadarwa kuma yana yi mata fihirisa a bango."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השמע מוזיקה מ־NAS, משרת קבצים או מ־Mac אחר, בבית או מכל מקום דרך Tailscale או VPN. Vespertine שומר על החיבור לשיתוף ומאנדקס אותו ברקע."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "NAS, फ़ाइल सर्वर या किसी दूसरे Mac से संगीत चलाएँ, घर पर या Tailscale या VPN के ज़रिए कहीं से भी। Vespertine शेयर को कनेक्ट रखता है और बैकग्राउंड में उसे इंडेक्स करता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Játsszon le zenét NAS-ról, fájlszerverről vagy másik Macről, otthon vagy bárhonnan Tailscale-en vagy VPN-en keresztül. A Vespertine csatlakoztatva tartja a megosztást, és a háttérben indexeli."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Putar musik dari NAS, server file, atau Mac lain, di rumah atau dari mana saja melalui Tailscale atau VPN. Vespertine menjaga share tetap terhubung dan mengindeksnya di latar belakang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riproduci musica da un NAS, un file server o un altro Mac, a casa o ovunque tramite Tailscale o una VPN. Vespertine mantiene la condivisione connessa e la indicizza in background."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "NAS、ファイルサーバ、または別のMacの音楽を、自宅で、あるいはTailscaleやVPN経由でどこからでも再生できます。Vespertineは共有を接続したまま保ち、バックグラウンドでインデックスを作成します。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಮನೆಯಲ್ಲಿ ಅಥವಾ Tailscale ಅಥವಾ VPN ಮೂಲಕ ಎಲ್ಲಿಂದ ಬೇಕಾದರೂ, NAS, ಫೈಲ್ ಸರ್ವರ್ ಅಥವಾ ಇನ್ನೊಂದು Mac ನಿಂದ ಸಂಗೀತ ಪ್ಲೇ ಮಾಡಿ. Vespertine ಶೇರ್ ಅನ್ನು ಸಂಪರ್ಕದಲ್ಲಿ ಇರಿಸುತ್ತದೆ ಮತ್ತು ಹಿನ್ನೆಲೆಯಲ್ಲಿ ಅದನ್ನು ಇಂಡೆಕ್ಸ್ ಮಾಡುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "NAS, 파일 서버 또는 다른 Mac의 음악을 집에서, 또는 Tailscale이나 VPN을 통해 어디서든 재생할 수 있습니다. Vespertine이 공유 연결을 유지하고 백그라운드에서 색인을 생성합니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "വീട്ടിലിരുന്നോ, Tailscale അല്ലെങ്കിൽ VPN വഴി എവിടെനിന്നും, ഒരു NAS-ൽ നിന്നോ ഫയൽ സെർവറിൽ നിന്നോ മറ്റൊരു Mac-ൽ നിന്നോ സംഗീതം പ്ലേ ചെയ്യുക. Vespertine ഷെയർ കണക്റ്റ് ചെയ്ത നിലയിൽ നിലനിർത്തുകയും പശ്ചാത്തലത്തിൽ ഇൻഡക്സ് ചെയ്യുകയും ചെയ്യുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "NAS, फाइल सर्व्हर किंवा दुसऱ्या Mac वरून संगीत प्ले करा, घरी किंवा Tailscale किंवा VPN द्वारे कुठूनही. Vespertine शेअर कनेक्ट ठेवते आणि पार्श्वभूमीत त्याचे इंडेक्सिंग करते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mainkan muzik dari NAS, pelayan fail atau Mac lain, di rumah atau dari mana-mana sahaja melalui Tailscale atau VPN. Vespertine memastikan perkongsian kekal bersambung dan mengindeksnya di latar belakang."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Spill musikk fra en NAS, en filtjener eller en annen Mac – hjemme eller hvor som helst via Tailscale eller en VPN. Vespertine holder delingen tilkoblet og indekserer den i bakgrunnen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Speel muziek af van een NAS, een bestandsserver of een andere Mac, thuis of overal via Tailscale of een VPN. Vespertine houdt de share verbonden en indexeert deze op de achtergrond."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਘਰ ਵਿੱਚ, ਜਾਂ Tailscale ਜਾਂ VPN ਰਾਹੀਂ ਕਿਤੋਂ ਵੀ, ਕਿਸੇ NAS, ਫ਼ਾਈਲ ਸਰਵਰ ਜਾਂ ਕਿਸੇ ਹੋਰ Mac ਤੋਂ ਸੰਗੀਤ ਚਲਾਓ। Vespertine ਸ਼ੇਅਰ ਨੂੰ ਕਨੈਕਟ ਰੱਖਦਾ ਹੈ ਅਤੇ ਬੈਕਗ੍ਰਾਊਂਡ ਵਿੱਚ ਇਸਨੂੰ ਇੰਡੈਕਸ ਕਰਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odtwarzaj muzykę z serwera NAS, serwera plików lub innego Maca, w domu lub z dowolnego miejsca przez Tailscale lub VPN. Vespertine utrzymuje połączenie z zasobem i indeksuje go w tle."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproduza músicas de um NAS, de um servidor de arquivos ou de outro Mac, em casa ou de qualquer lugar pelo Tailscale ou por uma VPN. O Vespertine mantém o compartilhamento conectado e o indexa em segundo plano."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproduza música de um NAS, de um servidor de ficheiros ou de outro Mac, em casa ou em qualquer lugar através do Tailscale ou de uma VPN. O Vespertine mantém a partilha ligada e indexa-a em segundo plano."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Redați muzică de pe un NAS, un server de fișiere sau alt Mac, acasă sau de oriunde prin Tailscale sau VPN. Vespertine menține partajarea conectată și o indexează în fundal."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spela musik från en NAS, en filserver eller en annan Mac, hemma eller var som helst via Tailscale eller VPN. Vespertine håller resursen ansluten och indexerar den i bakgrunden."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Cheza muziki kutoka NAS, seva ya faili au Mac nyingine, nyumbani au kutoka popote kupitia Tailscale au VPN. Vespertine huweka folda ya mtandao ikiwa imeunganishwa na kuiorodhesha chinichini."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வீட்டில், அல்லது Tailscale அல்லது VPN மூலம் எங்கிருந்தும், NAS, கோப்பு சர்வர் அல்லது மற்றொரு Mac-இலிருந்து இசையை இயக்கவும். Vespertine பகிர்வை இணைப்பில் வைத்திருந்து பின்னணியில் அதை அட்டவணைப்படுத்தும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇంట్లో అయినా, లేదా Tailscale లేదా VPN ద్వారా ఎక్కడి నుండైనా, NAS, ఫైల్ సర్వర్ లేదా మరో Mac నుండి సంగీతాన్ని ప్లే చేయండి. Vespertine షేర్‌ను కనెక్ట్ చేసి ఉంచి, బ్యాక్‌గ్రౌండ్‌లో దాన్ని ఇండెక్స్ చేస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เล่นเพลงจาก NAS เซิร์ฟเวอร์ไฟล์ หรือ Mac เครื่องอื่น ที่บ้านหรือจากที่ใดก็ได้ผ่าน Tailscale หรือ VPN Vespertine จะคงการเชื่อมต่อแชร์ไว้และทำดัชนีในเบื้องหลัง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Evde ya da Tailscale veya VPN üzerinden her yerden bir NAS’tan, dosya sunucusundan veya başka bir Mac’ten müzik çalın. Vespertine paylaşımı bağlı tutar ve arka planda dizinler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відтворюйте музику з NAS, файлового сервера або іншого Mac — удома чи будь-де через Tailscale або VPN. Vespertine підтримує з’єднання з ресурсом та індексує його у фоновому режимі."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "NAS، فائل سرور یا کسی دوسرے Mac سے موسیقی چلائیں، گھر پر یا کہیں سے بھی Tailscale یا VPN کے ذریعے۔ Vespertine شیئر کو منسلک رکھتا ہے اور پس منظر میں اس کی انڈیکسنگ کرتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phát nhạc từ NAS, máy chủ tệp hoặc một máy Mac khác, tại nhà hoặc từ bất cứ đâu qua Tailscale hay VPN. Vespertine giữ kết nối với chia sẻ và lập chỉ mục cho nó trong nền."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "播放來自 NAS、檔案伺服器或另一部 Mac 的音樂，無論在家中，或透過 Tailscale 或 VPN 從任何地方連接。Vespertine 會保持共享連接，並在背景為其建立索引。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在家中，或通过 Tailscale 或 VPN 在任何地方播放 NAS、文件服务器或另一台 Mac 上的音乐。Vespertine 会保持共享连接，并在后台为其建立索引。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在家中，或透過 Tailscale 或 VPN 在任何地方播放 NAS、檔案伺服器或另一部 Mac 上的音樂。Vespertine 會保持共享的連線，並在背景中製作索引。"
          }
        }
      }
    },

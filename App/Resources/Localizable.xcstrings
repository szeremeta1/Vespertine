    "DSD goes out natively over DoP, uncorrected.": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "DSD ሳይስተካከል በDoP በቀጥታ ይወጣል።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يخرج DSD أصليًا عبر DoP دون تصحيح."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "DSD কোনো কারেকশন ছাড়াই DoP দিয়ে নেটিভভাবে যায়।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "DSD odchází nativně přes DoP, bez korekce."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "DSD sendes direkte via DoP, ukorrigeret."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "DSD geht nativ über DoP hinaus, unkorrigiert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το DSD βγαίνει εγγενώς μέσω DoP, χωρίς διόρθωση."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El DSD sale de forma nativa por DoP, sin corregir."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "DSD به‌صورت بومی از طریق DoP و بدون تصحیح خارج می‌شود."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "DSD lähtee natiivisti DoP:n kautta korjaamattomana."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Native na lumalabas ang DSD sa DoP, nang walang correction."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le DSD sort en natif via DoP, sans correction."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "DSD કરેક્શન વગર DoP પર નેટિવ રીતે જાય છે."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "DSD yana fita kai tsaye ta DoP, ba tare da gyara ba."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "DSD יוצא באופן טבעי דרך DoP, ללא תיקון."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "DSD बिना करेक्शन के DoP पर नेटिव रूप में जाता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A DSD natívan, DoP-n megy ki, korrekció nélkül."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "DSD keluar secara native lewat DoP, tanpa koreksi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il DSD esce in modo nativo via DoP, senza correzione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "DSD は補正されずに DoP でネイティブ出力されます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "DSD ಕರೆಕ್ಷನ್ ಇಲ್ಲದೆ DoP ಮೂಲಕ ನೇಟಿವ್ ಆಗಿ ಹೋಗುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "DSD는 보정 없이 DoP로 네이티브 출력됩니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "DSD കറക്ഷനില്ലാതെ DoP വഴി നേറ്റീവായി പോകുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "DSD करेक्शनशिवाय DoP वरून नेटिव्ह स्वरूपात जाते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "DSD keluar secara asli melalui DoP, tanpa pembetulan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "DSD går ut direkte via DoP, ukorrigert."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "DSD gaat native via DoP naar buiten, niet gecorrigeerd."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "DSD ਬਿਨਾਂ ਕਰੈਕਸ਼ਨ ਦੇ DoP ਰਾਹੀਂ ਨੇਟਿਵ ਤੌਰ 'ਤੇ ਜਾਂਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "DSD wychodzi natywnie przez DoP, bez korekcji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O DSD sai nativamente via DoP, sem correção."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O DSD sai nativamente por DoP, sem correção."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "DSD iese nativ prin DoP, necorectat."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "DSD går ut direkt via DoP, okorrigerat."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "DSD inatoka moja kwa moja kupitia DoP, bila kusahihishwa."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "DSD திருத்தமின்றி DoP வழியாக நேட்டிவாக வெளியேறுகிறது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "DSD కరెక్షన్ లేకుండా DoP ద్వారా నేటివ్‌గా వెళ్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "DSD ส่งออกแบบเนทีฟผ่าน DoP โดยไม่ปรับแก้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "DSD, DoP üzerinden doğal haliyle, düzeltilmeden çıkar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "DSD виходить нативно через DoP, без корекції."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "DSD بغیر تصحیح کے DoP کے ذریعے اصل حالت میں جاتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "DSD được xuất nguyên bản qua DoP, không hiệu chỉnh."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "DSD 經 DoP 原生輸出，不作校正。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "DSD 通过 DoP 原生输出，不做校正。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "DSD 透過 DoP 原生輸出，不做校正。"
          }
        }
      }
    },

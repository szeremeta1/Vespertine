        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "DoP-এর জন্য এক্সক্লুসিভ, বিট-ট্রান্সপারেন্ট আউটপুট প্রয়োজন"
          }
        },
        "cs": {

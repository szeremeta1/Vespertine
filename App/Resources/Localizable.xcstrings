            "value": "Se caută albumul %lld din %lld…"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Slår upp album %lld av %lld …"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Inatafuta albamu %lld kati ya %lld…"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஆல்பங்கள் தேடப்படுகின்றன: %2$lld-இல் %1$lld…"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఆల్బమ్‌లను వెతుకుతోంది… (%1$lld/%2$lld)"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กำลังค้นหาอัลบั้ม %lld จาก %lld…"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$lld albümden %1$lld tanesi aranıyor…"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пошук альбому %lld з %lld…"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$lld میں سے البم %1$lld تلاش ہو رہا ہے…"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang tra cứu album %lld trên %lld…"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "正在查詢第 %lld 張專輯（共 %lld 張）…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在查找第 %lld 张专辑（共 %lld 张）…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在查詢第 %lld 張專輯（共 %lld 張）…"
          }
        }
      }
    },
    "Lookups only happen when you ask for them. Nothing is sent in the background.": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ፍለጋዎች የሚካሄዱት ሲጠይቁ ብቻ ነው። ከበስተጀርባ ምንም ነገር አይላክም።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تتم عمليات البحث إلا عندما تطلبها. لا يُرسَل أي شيء في الخلفية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি চাইলেই কেবল খোঁজা হয়। ব্যাকগ্রাউন্ডে কিছুই পাঠানো হয় না।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyhledávání probíhá jen tehdy, když o něj požádáte. Na pozadí se nic neodesílá."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Opslag sker kun, når du beder om dem. Intet sendes i baggrunden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abfragen erfolgen nur, wenn du sie anforderst. Im Hintergrund wird nichts gesendet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι αναζητήσεις γίνονται μόνο όταν τις ζητάτε. Τίποτα δεν αποστέλλεται στο παρασκήνιο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las búsquedas solo se hacen cuando las pides. No se envía nada en segundo plano."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "جست‌وجوها فقط وقتی انجام می‌شوند که شما بخواهید. هیچ چیزی در پس‌زمینه فرستاده نمی‌شود."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hakuja tehdään vain, kun pyydät niitä. Mitään ei lähetetä taustalla."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naghahanap lang kapag hiniling mo. Walang ipinapadala sa background."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les recherches n’ont lieu que lorsque vous les demandez. Rien n’est envoyé en arrière-plan."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે કહો ત્યારે જ શોધ થાય છે. બૅકગ્રાઉન્ડમાં કંઈ મોકલાતું નથી."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ana nema ne kawai idan kun buƙata. Ba a aika komai a bango."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חיפושים מתבצעים רק כשאתה מבקש אותם. שום דבר לא נשלח ברקע."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खोज केवल तभी होती है जब आप कहते हैं। बैकग्राउंड में कुछ भी नहीं भेजा जाता।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Keresés csak akkor történik, ha Ön kéri. A háttérben semmi sem kerül elküldésre."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pencarian hanya dilakukan saat Anda memintanya. Tidak ada yang dikirim di latar belakang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le ricerche avvengono solo quando le richiedi. Non viene inviato nulla in background."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検索はリクエストしたときにだけ行われます。バックグラウンドで送信されるものはありません。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ಕೇಳಿದಾಗ ಮಾತ್ರ ಹುಡುಕಾಟಗಳು ನಡೆಯುತ್ತವೆ. ಹಿನ್ನೆಲೆಯಲ್ಲಿ ಏನನ್ನೂ ಕಳುಹಿಸಲಾಗುವುದಿಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검색은 요청할 때만 수행됩니다. 백그라운드에서 전송되는 것은 없습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ ആവശ്യപ്പെടുമ്പോൾ മാത്രമേ തിരയലുകൾ നടക്കൂ. പശ്ചാത്തലത്തിൽ ഒന്നും അയയ്ക്കില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही सांगितल्यावरच शोध घेतला जातो. पार्श्वभूमीत काहीही पाठवले जात नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Carian hanya berlaku apabila anda memintanya. Tiada apa-apa dihantar di latar belakang."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Oppslag skjer bare når du ber om dem. Ingenting sendes i bakgrunnen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er wordt alleen iets opgezocht als je erom vraagt. Er wordt niets op de achtergrond verstuurd."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਖੋਜਾਂ ਸਿਰਫ਼ ਉਦੋਂ ਹੁੰਦੀਆਂ ਹਨ ਜਦੋਂ ਤੁਸੀਂ ਕਹਿੰਦੇ ਹੋ। ਬੈਕਗ੍ਰਾਊਂਡ ਵਿੱਚ ਕੁਝ ਵੀ ਨਹੀਂ ਭੇਜਿਆ ਜਾਂਦਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyszukiwania odbywają się tylko na Twoje żądanie. Nic nie jest wysyłane w tle."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As buscas só acontecem quando você pede. Nada é enviado em segundo plano."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As pesquisas só acontecem quando as pede. Nada é enviado em segundo plano."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Căutările au loc doar când le cereți. Nu se trimite nimic în fundal."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Uppslag görs bara när du ber om dem. Inget skickas i bakgrunden."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Utafutaji hufanyika tu unapoomba. Hakuna kinachotumwa chinichini."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் கேட்கும்போது மட்டுமே தேடல்கள் நடக்கும். பின்னணியில் எதுவும் அனுப்பப்படாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు అడిగినప్పుడు మాత్రమే వెతుకులాట జరుగుతుంది. బ్యాక్‌గ్రౌండ్‌లో ఏదీ పంపబడదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การค้นหาจะเกิดขึ้นเฉพาะเมื่อคุณสั่งเท่านั้น ไม่มีสิ่งใดถูกส่งในเบื้องหลัง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aramalar yalnızca siz istediğinizde yapılır. Arka planda hiçbir şey gönderilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пошук виконується лише на ваш запит. У фоновому режимі нічого не надсилається."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تلاش صرف تب ہوتی ہے جب آپ کہیں۔ پس منظر میں کچھ نہیں بھیجا جاتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc tra cứu chỉ diễn ra khi bạn yêu cầu. Không có gì được gửi trong nền."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "只有在你要求時才會進行查詢。不會在背景傳送任何資料。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只在你请求时才会查找。不会在后台发送任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有在你要求時才會查詢。不會在背景中傳送任何內容。"
          }
        }
      }
    },

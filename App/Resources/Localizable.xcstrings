    "The microphone and speaker clocks disagree by %@ ppm, more than the measurement can correct.": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "የማይክሮፎኑና የድምጽ ማጉያው ሰዓቶች በ%@ ppm ይለያያሉ፣ ይህም መለካት ሊያስተካክለው ከሚችለው በላይ ነው።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تختلف ساعتا الميكروفون والسماعة بمقدار %@ ppm، وهو أكثر مما يستطيع القياس تصحيحه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মাইক্রোফোন ও স্পিকারের ক্লক %@ ppm ভিন্ন, যা পরিমাপ ঠিক করতে পারে তার চেয়ে বেশি।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hodiny mikrofonu a reproduktoru se liší o %@ ppm, což měření nedokáže vyrovnat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofonens og højttalerens ure afviger med %@ ppm, mere end en måling kan rette."
          }
        },
        "de": {
          "stringUnit": {

    "%@ placed as virtual speakers around you and rendered for %@.": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ በዙሪያዎ እንደ ምናባዊ ድምፅ ማጉያዎች ተቀምጠው ለ%@ ቀርበዋል።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ موضوعة كسماعات افتراضية حولك ومعروضة لـ %2$@."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ আপনার চারপাশে ভার্চুয়াল স্পিকার হিসেবে রাখা হয়েছে এবং %2$@-এর জন্য রেন্ডার করা হয়েছে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ rozmístěno jako virtuální reproduktory kolem vás a vykresleno pro %@."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ placeret som virtuelle højttalere omkring dig og gengivet til %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ als virtuelle Lautsprecher um dich herum platziert und für %@ gerendert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ τοποθετημένα ως εικονικά ηχεία γύρω σας και αποδοσμένα για %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ situados como altavoces virtuales a tu alrededor y procesados para %2$@."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ به‌صورت بلندگوهای مجازی در اطراف شما قرار گرفته و برای %@ رندر شده است."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sijoitettuna virtuaalisiksi kaiuttimiksi ympärillesi ja renderöitynä laitteelle %@."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Inilagay ang %@ bilang mga virtual speaker sa paligid mo at ni-render para sa %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ placés en haut-parleurs virtuels autour de vous et rendus pour %@."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ને તમારી આસપાસ વર્ચ્યુઅલ સ્પીકર તરીકે મૂક્યું અને %2$@ માટે રેન્ડર કર્યું."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "An sanya %@ a matsayin lasifikoki na kama-da-wane a kewaye da ku kuma an sarrafa su don %@."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ממוקמים כרמקולים וירטואליים סביבך ומעובדים עבור %2$@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ को आपके चारों ओर वर्चुअल स्पीकर के रूप में रखा गया और %2$@ के लिए रेंडर किया गया।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ virtuális hangszórókként elhelyezve Ön körül, renderelve ehhez: %@."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ditempatkan sebagai speaker virtual di sekitar Anda dan dirender untuk %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ posizionati come altoparlanti virtuali intorno a te e renderizzati per %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@をあなたの周りに仮想スピーカーとして配置し、%2$@向けにレンダリングしています。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ಅನ್ನು ನಿಮ್ಮ ಸುತ್ತಲೂ ವರ್ಚುವಲ್ ಸ್ಪೀಕರ್‌ಗಳಾಗಿ ಇರಿಸಿ %2$@ ಗಾಗಿ ರೆಂಡರ್ ಮಾಡಲಾಗಿದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@을(를) 사용자 주위에 가상 스피커로 배치하고 %2$@에 맞게 렌더링합니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ നിങ്ങൾക്ക് ചുറ്റും വെർച്വൽ സ്പീക്കറുകളായി സ്ഥാപിച്ച് %2$@-നായി റെൻഡർ ചെയ്തു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ तुमच्या भोवती व्हर्च्युअल स्पीकर म्हणून ठेवले आणि %2$@ साठी रेंडर केले."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ diletakkan sebagai pembesar suara maya di sekeliling anda dan dirender untuk %@."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ plassert som virtuelle høyttalere rundt deg og gjengitt for %@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ geplaatst als virtuele luidsprekers om je heen en gerenderd voor %@."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ਨੂੰ ਤੁਹਾਡੇ ਆਲੇ-ਦੁਆਲੇ ਵਰਚੁਅਲ ਸਪੀਕਰਾਂ ਵਜੋਂ ਰੱਖਿਆ ਗਿਆ ਅਤੇ %2$@ ਲਈ ਰੈਂਡਰ ਕੀਤਾ ਗਿਆ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Układ %@ umieszczony jako wirtualne głośniki wokół Ciebie i renderowany dla: %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ posicionados como alto-falantes virtuais ao seu redor e renderizados para %2$@."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ colocado como altifalantes virtuais à sua volta e renderizado para %@."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ plasat ca difuzoare virtuale în jurul dvs. și randat pentru %@."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ placerade som virtuella högtalare runt dig och renderade för %@."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ zimewekwa kama spika pepe kukuzunguka na kuchakatwa kwa %@."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ உங்களைச் சுற்றி மெய்நிகர் ஸ்பீக்கர்களாக வைக்கப்பட்டு %2$@-க்கு ரெண்டர் செய்யப்பட்டது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ మీ చుట్టూ వర్చువల్ స్పీకర్‌లుగా ఉంచబడి, %2$@ కోసం రెండర్ చేయబడింది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ถูกวางเป็นลำโพงเสมือนรอบตัวคุณและเรนเดอร์สำหรับ %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ çevrenize sanal hoparlörler olarak yerleştirildi ve %2$@ için işlendi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ розміщено як віртуальні динаміки довкола вас і відрендерено для %@."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ آپ کے گرد ورچوئل اسپیکرز کے طور پر رکھا گیا اور %@ کے لیے رینڈر کیا گیا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ được đặt thành loa ảo xung quanh bạn và được kết xuất cho %@."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 已作為虛擬揚聲器置於你周圍，並為 %2$@ 渲染。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 作为虚拟扬声器环绕在你周围，并为 %@ 渲染。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 作為虛擬揚聲器環繞在你周圍，並為 %@ 渲染。"
          }
        }
      }
    },

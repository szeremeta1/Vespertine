    "Select one or more tracks to view and edit their tags.": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "መለያዎቻቸውን ለማየትና ለማርትዕ አንድ ወይም ከዚያ በላይ ትራኮችን ይምረጡ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدد مقطوعة أو أكثر لعرض علاماتها وتعديلها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ট্যাগ দেখতে ও সম্পাদনা করতে এক বা একাধিক ট্র্যাক নির্বাচন করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte jednu nebo více skladeb, chcete-li zobrazit a upravit jejich tagy."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg et eller flere numre for at se og redigere deres mærker."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle einen oder mehrere Titel aus, um ihre Tags anzuzeigen und zu bearbeiten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε ένα ή περισσότερα κομμάτια για να δείτε και να επεξεργαστείτε τις ετικέτες τους."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona una o varias pistas para ver y editar sus etiquetas."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای دیدن و ویرایش برچسب‌ها، یک یا چند قطعه را انتخاب کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse yksi tai useampi raita, niin voit tarkastella ja muokata niiden tageja."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pumili ng isa o higit pang track para tingnan at i-edit ang mga tag nila."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez un ou plusieurs morceaux pour afficher et modifier leurs tags."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ટૅગ જોવા અને સંપાદિત કરવા માટે એક અથવા વધુ ટ્રૅક પસંદ કરો."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaɓi waƙa ɗaya ko fiye don dubawa da gyara alamominsu."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחר רצועה אחת או יותר כדי להציג ולערוך את התגיות שלהן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टैग देखने और संपादित करने के लिए एक या अधिक ट्रैक चुनें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válasszon ki egy vagy több számot a címkéik megtekintéséhez és szerkesztéséhez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih satu atau beberapa trek untuk melihat dan mengedit tagnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleziona uno o più brani per visualizzarne e modificarne i tag."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タグを表示・編集するには、トラックを1つ以上選択してください。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಟ್ಯಾಗ್‌ಗಳನ್ನು ನೋಡಲು ಮತ್ತು ಎಡಿಟ್ ಮಾಡಲು ಒಂದು ಅಥವಾ ಹೆಚ್ಚು ಟ್ರ್ಯಾಕ್‌ಗಳನ್ನು ಆಯ್ಕೆಮಾಡಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "태그를 보고 편집하려면 하나 이상의 트랙을 선택하십시오."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ടാഗുകൾ കാണാനും എഡിറ്റ് ചെയ്യാനും ഒന്നോ അതിലധികമോ ട്രാക്കുകൾ തിരഞ്ഞെടുക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "टॅग पाहण्यासाठी आणि संपादित करण्यासाठी एक किंवा अधिक ट्रॅक निवडा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih satu atau lebih trek untuk melihat dan mengedit tagnya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg ett eller flere spor for å vise og redigere taggene deres."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecteer een of meer nummers om de tags te bekijken en te wijzigen."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਟੈਗ ਦੇਖਣ ਅਤੇ ਸੋਧਣ ਲਈ ਇੱਕ ਜਾਂ ਵੱਧ ਟਰੈਕ ਚੁਣੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaznacz jeden lub więcej utworów, aby wyświetlić i edytować ich tagi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione uma ou mais faixas para ver e editar as etiquetas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione uma ou mais faixas para ver e editar as etiquetas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Selectați una sau mai multe piese pentru a vedea și edita etichetele."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Markera ett eller flera spår för att visa och redigera deras taggar."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Chagua wimbo mmoja au zaidi ili kuona na kuhariri tagi zake."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "டேக்குகளைப் பார்க்கவும் திருத்தவும் ஒன்று அல்லது அதற்கு மேற்பட்ட டிராக்குகளைத் தேர்ந்தெடுக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ట్యాగ్‌లను చూడటానికి, సవరించడానికి ఒకటి లేదా అంతకంటే ఎక్కువ ట్రాక్‌లను ఎంచుకోండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกแทร็กอย่างน้อยหนึ่งแทร็กเพื่อดูและแก้ไขแท็ก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etiketlerini görüntülemek ve düzenlemek için bir veya daha fazla parça seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть один або кілька треків, щоб переглянути й відредагувати їхні теги."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ٹیگز دیکھنے اور ان میں ترمیم کے لیے ایک یا زیادہ ٹریکس منتخب کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn một hoặc nhiều bản nhạc để xem và sửa thẻ."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇一首或多首曲目以檢視及編輯其標籤。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择一首或多首曲目以查看和编辑其标签。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選取一首或多首曲目以檢視和編輯其標籤。"
          }
        }
      }
    },
    "Select or play a track to analyze it.": {
      "localizations": {
        "am": {

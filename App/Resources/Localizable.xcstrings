    "Measure with a UMIK-1 or import REW filters to correct your room.": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ክፍልዎን ለማስተካከል በUMIK-1 ይለኩ ወይም የREW ማጣሪያዎችን ያስገቡ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قِس باستخدام UMIK-1 أو استورد مرشحات REW لتصحيح غرفتك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার ঘর ঠিক করতে UMIK-1 দিয়ে মাপুন বা REW ফিল্টার ইমপোর্ট করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Změřte místnost mikrofonem UMIK-1 nebo importujte filtry z REW."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mål med en UMIK-1, eller importer REW-filtre for at korrigere dit rum."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Miss mit einem UMIK-1 oder importiere REW-Filter, um deinen Raum zu korrigieren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μετρήστε με ένα UMIK-1 ή εισαγάγετε φίλτρα REW για να διορθώσετε τον χώρο σας."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mide con un UMIK-1 o importa filtros de REW para corregir tu sala."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای تصحیح اتاقتان با UMIK-1 اندازه بگیرید یا فیلترهای REW را وارد کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mittaa UMIK-1:llä tai tuo REW-suodattimia korjataksesi huoneesi."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sumukat gamit ang UMIK-1 o mag-import ng mga filter ng REW para itama ang iyong kuwarto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesurez avec un UMIK-1 ou importez des filtres REW pour corriger votre pièce."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારો રૂમ સુધારવા UMIK-1 થી માપો અથવા REW ફિલ્ટર ઇમ્પોર્ટ કરો."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Auna da UMIK-1 ko shigo da matatun REW don gyara ɗakinka."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מדדו עם UMIK-1 או ייבאו מסנני REW כדי לתקן את החדר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने कमरे को ठीक करने के लिए UMIK-1 से मापें या REW फ़िल्टर इंपोर्ट करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mérj UMIK-1-gyel, vagy importálj REW-szűrőket a szobád korrigálásához."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukur dengan UMIK-1 atau impor filter REW untuk mengoreksi ruangan Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Misura con un UMIK-1 o importa filtri REW per correggere la tua stanza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "UMIK-1 で測定するか、REW のフィルターを読み込んで部屋を補正します。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",

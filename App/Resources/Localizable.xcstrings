    "%@ Vespertine tries again in 30 minutes, or when you choose Reconnect.": {
      "comment": "Starts with the reason the share couldn't connect.",
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Vespertine በ30 ደቂቃ ውስጥ ወይም «እንደገና አገናኝ»ን ሲመርጡ እንደገና ይሞክራል።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ سيحاول Vespertine مجددًا بعد 30 دقيقة، أو عندما تختار “إعادة الاتصال”."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Vespertine 30 মিনিট পরে আবার চেষ্টা করবে, অথবা যখন আপনি “পুনরায় সংযোগ করুন” বেছে নেবেন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Vespertine to zkusí znovu za 30 minut nebo až zvolíte Znovu připojit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Vespertine prøver igen om 30 minutter, eller når du vælger Opret forbindelse igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Vespertine versucht es in 30 Minuten erneut oder wenn du „Erneut verbinden“ wählst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Το Vespertine θα προσπαθήσει ξανά σε 30 λεπτά ή όταν επιλέξετε «Επανασύνδεση»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Vespertine lo volverá a intentar dentro de 30 minutos o cuando elijas Reconectar."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Vespertine سی دقیقهٔ دیگر یا وقتی «اتصال مجدد» را انتخاب کنید، دوباره تلاش می‌کند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Vespertine yrittää uudelleen 30 minuutin kuluttua tai kun valitset Yhdistä uudelleen."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Susubukan muli ng Vespertine sa loob ng 30 minuto, o kapag pinili mo ang Kumonekta Muli."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Vespertine réessaiera dans 30 minutes, ou lorsque vous choisirez Se reconnecter."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Vespertine 30 મિનિટ પછી ફરી પ્રયાસ કરશે, અથવા જ્યારે તમે “ફરી કનેક્ટ કરો” પસંદ કરો ત્યારે."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Vespertine zai sake gwadawa bayan mintuna 30, ko idan kuka zaɓi Sake Haɗawa."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Vespertine ינסה שוב בעוד 30 דקות, או כשתבחר ״התחבר מחדש״."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Vespertine 30 मिनट में फिर से कोशिश करेगा, या तब जब आप “फिर से कनेक्ट करें” चुनेंगे।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ A Vespertine 30 perc múlva újra megpróbálja, vagy amikor az Újracsatlakozás lehetőséget választja."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Vespertine mencoba lagi dalam 30 menit, atau saat Anda memilih Hubungkan Ulang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Vespertine riproverà tra 30 minuti, o quando scegli Riconnetti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Vespertineは30分後、または「再接続」を選択したときに再試行します。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Vespertine 30 ನಿಮಿಷಗಳಲ್ಲಿ, ಅಥವಾ ನೀವು “ಮರುಸಂಪರ್ಕಿಸಿ” ಆಯ್ಕೆಮಾಡಿದಾಗ ಮತ್ತೆ ಪ್ರಯತ್ನಿಸುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Vespertine이 30분 후 또는 다시 연결을 선택하면 다시 시도합니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Vespertine 30 മിനിറ്റിനുള്ളിൽ, അല്ലെങ്കിൽ നിങ്ങൾ വീണ്ടും കണക്റ്റ് ചെയ്യുക തിരഞ്ഞെടുക്കുമ്പോൾ, വീണ്ടും ശ്രമിക്കും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Vespertine 30 मिनिटांनी पुन्हा प्रयत्न करेल, किंवा तुम्ही “पुन्हा कनेक्ट करा” निवडल्यावर."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Vespertine akan mencuba lagi dalam 30 minit, atau apabila anda memilih Sambung Semula."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Vespertine prøver igjen om 30 minutter, eller når du velger Koble til på nytt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Vespertine probeert het over 30 minuten opnieuw, of wanneer je ‘Maak opnieuw verbinding’ kiest."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Vespertine 30 ਮਿੰਟਾਂ ਵਿੱਚ, ਜਾਂ ਜਦੋਂ ਤੁਸੀਂ ‘ਮੁੜ ਕਨੈਕਟ ਕਰੋ’ ਚੁਣੋਗੇ, ਦੁਬਾਰਾ ਕੋਸ਼ਿਸ਼ ਕਰੇਗਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Vespertine spróbuje ponownie za 30 minut lub gdy wybierzesz Połącz ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ O Vespertine tentará novamente em 30 minutos ou quando você escolher Reconectar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ O Vespertine volta a tentar dentro de 30 minutos ou quando escolher Voltar a ligar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Vespertine încearcă din nou peste 30 de minute sau când alegeți Reconectează."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Vespertine försöker igen om 30 minuter, eller när du väljer Anslut igen."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Vespertine itajaribu tena baada ya dakika 30, au utakapochagua Unganisha Upya."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Vespertine 30 நிமிடங்களில், அல்லது நீங்கள் ‘மீண்டும் இணை’ என்பதைத் தேர்வுசெய்யும்போது, மீண்டும் முயலும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Vespertine 30 నిమిషాల్లో, లేదా మీరు “మళ్లీ కనెక్ట్ చేయి” ఎంచుకున్నప్పుడు మళ్లీ ప్రయత్నిస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Vespertine จะลองอีกครั้งใน 30 นาที หรือเมื่อคุณเลือก เชื่อมต่อใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Vespertine 30 dakika sonra veya Yeniden Bağlan’ı seçtiğinizde yeniden dener."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Vespertine спробує знову через 30 хвилин або коли ви виберете «Під’єднати знову»."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Vespertine 30 منٹ بعد دوبارہ کوشش کرے گا، یا جب آپ “دوبارہ منسلک کریں” منتخب کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Vespertine sẽ thử lại sau 30 phút, hoặc khi bạn chọn Kết nối lại."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Vespertine 會在 30 分鐘後再試，或在你選擇「重新連接」時重試。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Vespertine 将在 30 分钟后重试，或在你选取“重新连接”时重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Vespertine 會在 30 分鐘後或你選擇「重新連線」時再試一次。"
          }
        }
      }
    },
    "%@ was disconnected. Playback paused.": {
      "comment": "%@ is the name of an audio output device.",
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ተቋርጧል። መጫወቱ ለአፍታ ቆሟል።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم فصل %@. تم إيقاف التشغيل مؤقتًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-এর সংযোগ বিচ্ছিন্ন হয়েছে। প্লেব্যাক থামানো হয়েছে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: odpojeno. Přehrávání je pozastaveno."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ blev afbrudt. Afspilningen er sat på pause."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verbindung zu %@ wurde getrennt. Wiedergabe angehalten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: η σύνδεση διακόπηκε. Η αναπαραγωγή τέθηκε σε παύση."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se ha desconectado. Reproducción en pausa."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اتصال %@ قطع شد. پخش متوقف شد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Laitteen %@ yhteys katkesi. Toisto keskeytettiin."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadiskonekta ang %@. Naka-pause ang playback."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a été déconnecté. Lecture mise en pause."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ડિસ્કનેક્ટ થયું. પ્લેબૅક થોભાવ્યું."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "An cire haɗin %@. An dakatar da kunnawa."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החיבור אל %@ נותק. ההשמעה הושהתה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ डिस्कनेक्ट हो गया। प्लेबैक रोक दिया गया है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: a kapcsolat megszakadt. A lejátszás szünetel."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ terputus. Pemutaran dijeda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è stato disconnesso. Riproduzione in pausa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の接続が解除されました。再生を一時停止しました。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ಸಂಪರ್ಕ ಕಡಿತಗೊಂಡಿದೆ. ಪ್ಲೇಬ್ಯಾಕ್ ವಿರಾಮಗೊಳಿಸಲಾಗಿದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 연결이 해제되었습니다. 재생이 일시 정지되었습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ വിച്ഛേദിക്കപ്പെട്ടു. പ്ലേബാക്ക് താൽക്കാലികമായി നിർത്തി."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ डिस्कनेक्ट झाले. प्लेबॅक पॉज केला."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sambungan %@ telah terputus. Main balik dijeda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ble frakoblet. Avspillingen er satt på pause."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De verbinding met %@ is verbroken. Afspelen gepauzeerd."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ਡਿਸਕਨੈਕਟ ਹੋ ਗਿਆ। ਪਲੇਬੈਕ ਰੋਕ ਦਿੱਤਾ ਗਿਆ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Urządzenie %@ zostało odłączone. Odtwarzanie wstrzymane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ foi desconectado. Reprodução pausada."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ foi desligado. Reprodução em pausa."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a fost deconectat. Redarea este în pauză."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kopplades från. Uppspelningen pausades."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kimetenganishwa. Uchezaji umesitishwa."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ துண்டிக்கப்பட்டது. இயக்கம் இடைநிறுத்தப்பட்டது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ డిస్‌కనెక్ట్ అయింది. ప్లేబ్యాక్ పాజ్ చేయబడింది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ถูกตัดการเชื่อมต่อ หยุดการเล่นชั่วคราวแล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bağlantısı kesildi. Oynatma duraklatıldı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ від’єднано. Відтворення призупинено."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ منقطع ہو گیا۔ پلے بیک روک دیا گیا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ đã bị ngắt kết nối. Đã tạm dừng phát."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已中斷連接。播放已暫停。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已断开连接。播放已暂停。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已中斷連線。播放已暫停。"
          }
        }
      }
    },

        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج تخطيط القياس إلى معدل عينة، ومسح لا تقل مدته عن ثانية، وفاصل لا يقل عن 0.3 ثانية حول المسح."
          }

        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A mérés nem fedi le a korrekciós tartományt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengukuran tidak mencakup rentang koreksi."

          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ફિલ્ટરમાં એવા સેમ્પલ છે જે સંખ્યા નથી."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Matatar tana da samfuran da ba lambobi ba ne."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "במסנן יש דגימות שאינן מספרים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़िल्टर में ऐसे सैंपल हैं जो संख्याएँ नहीं हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szűrő olyan mintákat tartalmaz, amelyek nem számok."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Filter memiliki sampel yang bukan angka."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il filtro contiene campioni che non sono numeri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フィルタに数値ではないサンプルが含まれています。"

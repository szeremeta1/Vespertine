    "The server didn’t accept that name and password.": {
      "extractionState": "manual",
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "አገልጋዩ ያንን ስምና የይለፍ ቃል አልተቀበለም።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يقبل الخادم هذا الاسم وكلمة السر."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সার্ভার ওই নাম ও পাসওয়ার্ড গ্রহণ করেনি।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Server toto jméno a heslo nepřijal."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Serveren accepterede ikke det navn og den adgangskode."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat diesen Namen und dieses Passwort nicht akzeptiert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο διακομιστής δεν αποδέχτηκε αυτό το όνομα και το συνθηματικό."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server didn’t accept that name and password."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor no ha aceptado ese nombre y esa contraseña."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "سرور آن نام و گذرواژه را نپذیرفت."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Palvelin ei hyväksynyt tätä nimeä ja salasanaa."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi tinanggap ng server ang pangalan at password na iyon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur n’a pas accepté ce nom et ce mot de passe."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સર્વરે તે નામ અને પાસવર્ડ સ્વીકાર્યાં નહીં."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Sabar ba ta karɓi wannan suna da kalmar sirri ba."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השרת לא קיבל את השם והסיסמה האלה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सर्वर ने वह नाम और पासवर्ड स्वीकार नहीं किया।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szerver nem fogadta el ezt a nevet és jelszót."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Server tidak menerima nama dan kata sandi tersebut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il server non ha accettato il nome e la password."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバはその名前とパスワードを受け付けませんでした。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸರ್ವರ್ ಆ ಹೆಸರು ಮತ್ತು ಪಾಸ್‌ವರ್ಡ್ ಅನ್ನು ಸ್ವೀಕರಿಸಲಿಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버가 해당 이름과 암호를 승인하지 않았습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സെർവർ ആ പേരും പാസ്‌വേഡും സ്വീകരിച്ചില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सर्व्हरने ते नाव आणि पासवर्ड स्वीकारले नाहीत."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelayan tidak menerima nama dan kata laluan itu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tjeneren godtok ikke det navnet og passordet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De server heeft die naam en dat wachtwoord niet geaccepteerd."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਰਵਰ ਨੇ ਉਹ ਨਾਂ ਅਤੇ ਪਾਸਵਰਡ ਸਵੀਕਾਰ ਨਹੀਂ ਕੀਤਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Serwer nie zaakceptował tej nazwy i hasła."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor não aceitou esse nome e essa senha."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor não aceitou esse nome e palavra-passe."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Serverul nu a acceptat acest nume și această parolă."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Servern godtog inte namnet och lösenordet."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Seva haikukubali jina na nenosiri hilo."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சர்வர் அந்தப் பெயரையும் கடவுச்சொல்லையும் ஏற்கவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సర్వర్ ఆ పేరు, పాస్‌వర్డ్‌ను అంగీకరించలేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เซิร์ฟเวอร์ไม่ยอมรับชื่อและรหัสผ่านนั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucu bu adı ve parolayı kabul etmedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер не прийняв це ім’я та пароль."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سرور نے وہ نام اور پاس ورڈ قبول نہیں کیا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy chủ không chấp nhận tên và mật khẩu đó."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器不接受該用户名稱和密碼。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器不接受该用户名和密码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器不接受該使用者名稱和密碼。"
          }
        }
      }
    },

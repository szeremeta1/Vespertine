          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte um DAC a qualquer momento e ele aparecerá aqui."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ligue um DAC a qualquer momento e ele aparece aqui."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectați oricând un DAC și va apărea aici."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anslut en DAC när som helst så visas den här."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Chomeka DAC wakati wowote na itaonekana hapa."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எப்போது வேண்டுமானாலும் DAC-ஐ இணையுங்கள், அது இங்கே தோன்றும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఎప్పుడైనా DACను ప్లగ్ ఇన్ చేయండి, అది ఇక్కడ కనిపిస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เสียบ DAC ได้ทุกเมื่อ แล้วอุปกรณ์จะปรากฏที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İstediğiniz zaman bir DAC takın, burada görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Під’єднайте ЦАП будь-коли, і він з’явиться тут."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کسی بھی وقت DAC لگائیں اور وہ یہاں ظاہر ہو جائے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cắm DAC vào bất cứ lúc nào và thiết bị sẽ xuất hiện ở đây."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "隨時接上 DAC，它便會在這裡出現。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "随时接入 DAC，它就会出现在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隨時接上 DAC，它就會出現在這裡。"
          }
        }
      }
    },
    "Point Vespertine at your music, wherever it lives: this Mac, an external drive or a server on your network.": {
      "extractionState": "manual",
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ሙዚቃዎ የትም ይሁን Vespertineን ወደዚያ ይጠቁሙ፦ ይህ Mac፣ ውጫዊ አንጻፊ ወይም በአውታረ መረብዎ ላይ ያለ አገልጋይ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وجّه Vespertine إلى موسيقاك أينما كانت: هذا الـ Mac، أو قرص خارجي، أو خادم على شبكتك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার মিউজিক যেখানেই থাকুক, Vespertine-কে সেখানে দেখিয়ে দিন: এই Mac, একটি এক্সটার্নাল ড্রাইভ বা আপনার নেটওয়ার্কের কোনো সার্ভার।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukažte Vespertine, kde je vaše hudba: v tomto Macu, na externím disku nebo na serveru ve vaší síti."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vis Vespertine, hvor din musik ligger: på denne Mac, et eksternt drev eller en server på dit netværk."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeig Vespertine, wo deine Musik liegt: auf diesem Mac, einem externen Laufwerk oder einem Server in deinem Netzwerk."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δείξτε στο Vespertine πού βρίσκεται η μουσική σας: σε αυτό το Mac, σε εξωτερικό δίσκο ή σε διακομιστή στο δίκτυό σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Point Vespertine at your music, wherever it lives: this Mac, an external drive or a server on your network."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica a Vespertine dónde está tu música: en este Mac, en un disco externo o en un servidor de tu red."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "به Vespertine نشان دهید موسیقی‌تان کجاست: همین Mac، یک دیسک خارجی یا سروری در شبکه‌تان."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näytä Vespertinelle, missä musiikkisi on: tällä Macilla, ulkoisella asemalla tai verkkosi palvelimella."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ituro sa Vespertine ang musika mo, nasaan man ito: sa Mac na ito, sa external drive o sa server sa network mo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indiquez à Vespertine où se trouve votre musique : sur ce Mac, sur un disque externe ou sur un serveur de votre réseau."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારું સંગીત જ્યાં પણ હોય, Vespertine ને ત્યાં બતાવો: આ Mac, બાહ્ય ડ્રાઇવ કે તમારા નેટવર્ક પરનું સર્વર."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Nuna wa Vespertine waƙoƙinku, duk inda suke: wannan Mac, faifai na waje ko sabar a cibiyar sadarwarku."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפנה את Vespertine למוזיקה שלך, היכן שהיא נמצאת: ב־Mac זה, בכונן חיצוני או בשרת ברשת שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vespertine को बताएँ कि आपका संगीत कहाँ है, चाहे वह इस Mac पर हो, किसी बाहरी ड्राइव पर या आपके नेटवर्क के किसी सर्वर पर।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mutassa meg a Vespertine-nek, hol van a zenéje: ezen a Macen, egy külső meghajtón vagy egy szerveren a hálózaton."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tunjukkan Vespertine di mana musik Anda berada: di Mac ini, drive eksternal, atau server di jaringan Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica a Vespertine dove si trova la tua musica: su questo Mac, su un disco esterno o su un server della tua rete."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMac、外付けドライブ、ネットワーク上のサーバなど、音楽がどこにあってもVespertineに場所を伝えましょう。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಸಂಗೀತ ಎಲ್ಲೇ ಇರಲಿ, Vespertine ಗೆ ಅದನ್ನು ತೋರಿಸಿ: ಈ Mac, ಬಾಹ್ಯ ಡ್ರೈವ್ ಅಥವಾ ನಿಮ್ಮ ನೆಟ್‌ವರ್ಕ್‌ನಲ್ಲಿರುವ ಸರ್ವರ್."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac, 외장 드라이브, 네트워크의 서버 등 음악이 어디에 있든 Vespertine에 위치를 알려주십시오."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ സംഗീതം എവിടെയായാലും Vespertine-ന് അത് കാണിച്ചുകൊടുക്കുക: ഈ Mac, ഒരു എക്‌സ്റ്റേണൽ ഡ്രൈവ് അല്ലെങ്കിൽ നിങ്ങളുടെ നെറ്റ്‌വർക്കിലെ ഒരു സെർവർ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमचे संगीत कुठेही असो, Vespertine ला तिथे न्या: हा Mac, बाह्य ड्राइव्ह किंवा तुमच्या नेटवर्कवरील सर्व्हर."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tunjukkan Vespertine di mana muzik anda berada: Mac ini, pemacu luaran atau pelayan pada rangkaian anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vis Vespertine hvor musikken din ligger: på denne Macen, en ekstern disk eller en tjener på nettverket ditt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat Vespertine weten waar je muziek staat: op deze Mac, een externe schijf of een server in je netwerk."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡਾ ਸੰਗੀਤ ਜਿੱਥੇ ਵੀ ਹੋਵੇ, Vespertine ਨੂੰ ਉੱਥੇ ਦਿਖਾਓ: ਇਹ Mac, ਕੋਈ ਬਾਹਰੀ ਡਰਾਈਵ ਜਾਂ ਤੁਹਾਡੇ ਨੈੱਟਵਰਕ ’ਤੇ ਕੋਈ ਸਰਵਰ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wskaż Vespertine, gdzie jest Twoja muzyka: na tym Macu, na dysku zewnętrznym lub na serwerze w sieci."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostre ao Vespertine onde estão suas músicas: neste Mac, em um disco externo ou em um servidor da sua rede."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Indique ao Vespertine onde está a sua música: neste Mac, num disco externo ou num servidor da sua rede."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Indicați-i lui Vespertine unde se află muzica: pe acest Mac, pe un disc extern sau pe un server din rețea."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visa Vespertine var din musik finns: på den här datorn, en extern enhet eller en server i nätverket."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ielekeze Vespertine kwenye muziki wako, popote ulipo: Mac hii, hifadhi ya nje au seva kwenye mtandao wako."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் இசை எங்கிருந்தாலும் Vespertine-க்கு அதைக் காட்டுங்கள்: இந்த Mac, வெளிப்புற டிரைவ் அல்லது உங்கள் நெட்வொர்க்கில் உள்ள சர்வர்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ సంగీతం ఎక్కడ ఉన్నా Vespertineకు చూపించండి: ఈ Mac, ఎక్స్‌టర్నల్ డ్రైవ్ లేదా మీ నెట్‌వర్క్‌లోని సర్వర్."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บอก Vespertine ว่าเพลงของคุณอยู่ที่ไหน ไม่ว่าจะเป็น Mac เครื่องนี้ ไดรฟ์ภายนอก หรือเซิร์ฟเวอร์บนเครือข่ายของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vespertine’e müziğinizin nerede olduğunu gösterin: bu Mac, harici bir disk veya ağınızdaki bir sunucu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Покажіть Vespertine, де ваша музика: на цьому Mac, на зовнішньому диску чи на сервері у вашій мережі."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Vespertine کو بتائیں کہ آپ کی موسیقی کہاں ہے: یہ Mac، کوئی بیرونی ڈرائیو یا آپ کے نیٹ ورک پر کوئی سرور۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ cho Vespertine biết nhạc của bạn ở đâu: trên máy Mac này, ổ đĩa ngoài hay máy chủ trong mạng của bạn."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "告訴 Vespertine 你的音樂在哪裡，無論是這部 Mac、外置磁碟，還是網絡上的伺服器。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "告诉 Vespertine 你的音乐在哪里，无论是在这台 Mac、外置驱动器，还是网络中的服务器上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "告訴 Vespertine 你的音樂在哪裡，無論是在這部 Mac、外接磁碟，還是網路上的伺服器。"
          }
        }
      }
    },

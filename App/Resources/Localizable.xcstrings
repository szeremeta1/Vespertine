    "%@ was disconnected. Playback paused.": {
      "comment": "%@ is the name of an audio output device.",
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ተቋርጧል። መጫወቱ ለአፍታ ቆሟል።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم فصل %@. تم إيقاف التشغيل مؤقتًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-এর সংযোগ বিচ্ছিন্ন হয়েছে। প্লেব্যাক থামানো হয়েছে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: odpojeno. Přehrávání je pozastaveno."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ blev afbrudt. Afspilningen er sat på pause."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verbindung zu %@ wurde getrennt. Wiedergabe angehalten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: η σύνδεση διακόπηκε. Η αναπαραγωγή τέθηκε σε παύση."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se ha desconectado. Reproducción en pausa."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اتصال %@ قطع شد. پخش متوقف شد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Laitteen %@ yhteys katkesi. Toisto keskeytettiin."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadiskonekta ang %@. Naka-pause ang playback."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a été déconnecté. Lecture mise en pause."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ડિસ્કનેક્ટ થયું. પ્લેબૅક થોભાવ્યું."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "An cire haɗin %@. An dakatar da kunnawa."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החיבור אל %@ נותק. ההשמעה הושהתה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ डिस्कनेक्ट हो गया। प्लेबैक रोक दिया गया है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: a kapcsolat megszakadt. A lejátszás szünetel."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ terputus. Pemutaran dijeda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è stato disconnesso. Riproduzione in pausa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の接続が解除されました。再生を一時停止しました。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ಸಂಪರ್ಕ ಕಡಿತಗೊಂಡಿದೆ. ಪ್ಲೇಬ್ಯಾಕ್ ವಿರಾಮಗೊಳಿಸಲಾಗಿದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 연결이 해제되었습니다. 재생이 일시 정지되었습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ വിച്ഛേദിക്കപ്പെട്ടു. പ്ലേബാക്ക് താൽക്കാലികമായി നിർത്തി."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ डिस्कनेक्ट झाले. प्लेबॅक पॉज केला."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sambungan %@ telah terputus. Main balik dijeda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ble frakoblet. Avspillingen er satt på pause."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De verbinding met %@ is verbroken. Afspelen gepauzeerd."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ਡਿਸਕਨੈਕਟ ਹੋ ਗਿਆ। ਪਲੇਬੈਕ ਰੋਕ ਦਿੱਤਾ ਗਿਆ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Urządzenie %@ zostało odłączone. Odtwarzanie wstrzymane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ foi desconectado. Reprodução pausada."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ foi desligado. Reprodução em pausa."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a fost deconectat. Redarea este în pauză."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kopplades från. Uppspelningen pausades."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kimetenganishwa. Uchezaji umesitishwa."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ துண்டிக்கப்பட்டது. இயக்கம் இடைநிறுத்தப்பட்டது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ డిస్‌కనెక్ట్ అయింది. ప్లేబ్యాక్ పాజ్ చేయబడింది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ถูกตัดการเชื่อมต่อ หยุดการเล่นชั่วคราวแล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bağlantısı kesildi. Oynatma duraklatıldı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ від’єднано. Відтворення призупинено."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ منقطع ہو گیا۔ پلے بیک روک دیا گیا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ đã bị ngắt kết nối. Đã tạm dừng phát."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已中斷連接。播放已暫停。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已断开连接。播放已暂停。"
          }
        },
        "zh-Hant": {
          "stringUnit": {

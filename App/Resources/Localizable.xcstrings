        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Waƙa ta kama-da-wane; gyare-gyare suna nan a laburare"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רצועה וירטואלית; עריכות נשמרות בספריה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वर्चुअल ट्रैक; संपादन लाइब्रेरी में ही रहते हैं"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Virtuális szám; a szerkesztések a könyvtárban maradnak"

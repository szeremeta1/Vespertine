    "%@ · per speaker: delay, level, 64-bit filters": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · ለእያንዳንዱ ድምፅ ማጉያ፦ መዘግየት፣ ደረጃ፣ 64-ቢት ማጣሪያዎች"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · لكل سماعة: تأخير ومستوى ومرشحات 64 بت"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · প্রতিটি স্পিকারে: ডিলে, লেভেল, 64-বিট ফিল্টার"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · pro každý reproduktor: zpoždění, úroveň, 64bitové filtry"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · pr. højttaler: forsinkelse, niveau, 64-bit-filtre"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · pro Lautsprecher: Verzögerung, Pegel, 64-Bit-Filter"

    "Writes %@ to %lld files · backup retained for undo": {
      "comment": "First value: the tag format, e.g. ID3v2 tags",
      "localizations": {
        "am": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%@ን ወደ %lld ፋይል ይጽፋል · ለመቀልበስ ምትኬ ይቀመጣል"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%@ን ወደ %lld ፋይሎች ይጽፋል · ለመቀልበስ ምትኬ ይቀመጣል"
                }
              }
            }
          }
        },
        "ar": {
          "variations": {
            "plural": {
              "zero": {

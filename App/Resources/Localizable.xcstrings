    "Only %lld of %lld bits carry audio (zero-padded)": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ከ%#@n@ ድምፅ የሚይዙት %1$lld ብቻ ናቸው (በዜሮ የተሞሉ)"
          },
          "substitutions": {
            "n": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg ቢት"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg ቢቶች"
                    }
                  }
                }
              }
            }
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld فقط من أصل %2$lld بت تحمل الصوت (مبطّنة بالأصفار)"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$lld বিটের মধ্যে মাত্র %1$lld বিটে অডিও আছে (জিরো-প্যাডেড)"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvuk nese jen %lld z %lld bitů (doplněno nulami)"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun %lld af %lld bit indeholder lyd (nulpolstret)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur %lld von %lld Bits enthalten Audio (mit Nullen aufgefüllt)"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μόνο τα %1$lld από τα %2$lld bit περιέχουν ήχο (συμπλήρωση με μηδενικά)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo %1$lld de %2$lld bits contienen audio (rellenado con ceros)"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فقط %lld از %lld بیت صدا دارند (صفرپرشده)"
          }
        },
        "fi": {

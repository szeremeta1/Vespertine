    "What the imported correction does to each speaker.": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "የገባው ማስተካከያ በእያንዳንዱ ድምፅ ማጉያ ላይ የሚያደርገው።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما يفعله التصحيح المستورد بكل سماعة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ইমপোর্ট করা কারেকশন প্রতিটি স্পিকারে কী করে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Co importovaná korekce dělá s každým reproduktorem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvad den importerede korrektion gør ved hver højttaler."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was die importierte Korrektur mit jedem Lautsprecher macht."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τι κάνει η εισαγόμενη διόρθωση σε κάθε ηχείο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que la corrección importada hace a cada altavoz."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کاری که تصحیح واردشده با هر بلندگو می‌کند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitä tuotu korjaus tekee kullekin kaiuttimelle."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang ginagawa ng na-import na correction sa bawat speaker."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que la correction importée fait à chaque enceinte."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ઇમ્પોર્ટ કરેલું કરેક્શન દરેક સ્પીકર પર શું કરે છે."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Abin da gyaran da aka shigo da shi yake yi wa kowane lasifika."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מה התיקון המיובא עושה לכל רמקול."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इंपोर्ट किया गया करेक्शन हर स्पीकर पर क्या करता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit csinál az importált korrekció az egyes hangszórókkal."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apa yang dilakukan koreksi yang diimpor pada setiap speaker."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Che cosa fa la correzione importata a ogni diffusore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み込んだ補正が各スピーカーに与える効果。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಆಮದು ಮಾಡಿದ ಕರೆಕ್ಷನ್ ಪ್ರತಿ ಸ್ಪೀಕರ್‌ಗೆ ಏನು ಮಾಡುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가져온 보정이 각 스피커에 주는 효과입니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇംപോർട്ട് ചെയ്ത കറക്ഷൻ ഓരോ സ്പീക്കറിലും ചെയ്യുന്നത്."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "इम्पोर्ट केलेले करेक्शन प्रत्येक स्पीकरवर काय करते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kesan pembetulan yang diimport pada setiap pembesar suara."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hva den importerte korrigeringen gjør med hver høyttaler."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat de geïmporteerde correctie met elke luidspreker doet."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇੰਪੋਰਟ ਕੀਤਾ ਕਰੈਕਸ਼ਨ ਹਰ ਸਪੀਕਰ 'ਤੇ ਕੀ ਕਰਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Co zaimportowana korekcja robi z każdym głośnikiem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que a correção importada faz em cada caixa."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O que a correção importada faz a cada coluna."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce face corecția importată fiecărui difuzor."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vad den importerade korrigeringen gör med varje högtalare."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kile usahihishaji ulioingizwa unachofanya kwa kila spika."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இறக்குமதி செய்த திருத்தம் ஒவ்வொரு ஸ்பீக்கருக்கும் என்ன செய்கிறது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "దిగుమతి చేసిన కరెక్షన్ ప్రతి స్పీకర్‌పై ఏమి చేస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สิ่งที่การปรับแก้ที่นำเข้าทำกับลำโพงแต่ละตัว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İçe aktarılan düzeltmenin her hoparlöre yaptığı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Що імпортована корекція робить із кожним динаміком."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "درآمد شدہ تصحیح ہر اسپیکر کے ساتھ کیا کرتی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tác dụng của bản hiệu chỉnh đã nhập lên từng loa."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "匯入的校正對每個揚聲器的作用。"

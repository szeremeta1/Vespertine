        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η γραμμή %lld αναφέρει ένα κανάλι που το Vespertine δεν γνωρίζει (%@). Χρησιμοποιήστε L, R, C, LFE, RL, RR, SL, SR ή έναν αριθμό καναλιού."
          }
        },
        "es": {
          "stringUnit": {

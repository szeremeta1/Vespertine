        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಕ್ಯಾಪ್ಚರ್‌ಗಳನ್ನು ಉಳಿಸಲಾಗಿದೆ, ಆದರೆ ಪ್ರತಿಕ್ರಿಯೆಗಳನ್ನು ಲೆಕ್ಕಿಸಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ"
          }
        },
        "ko": {
          "stringUnit": {

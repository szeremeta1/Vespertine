    "The file has no filters. Choose an AutoEQ “ParametricEQ.txt” or an Equalizer APO configuration.": {
      "extractionState": "manual",
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ፋይሉ ምንም ማጣሪያዎች የሉትም። የAutoEQ «ParametricEQ.txt» ወይም የEqualizer APO ውቅረት ይምረጡ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يحتوي الملف على مرشحات. اختر ملف AutoEQ “ParametricEQ.txt” أو إعدادًا من Equalizer APO."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফাইলটিতে কোনো ফিল্টার নেই। AutoEQ-এর “ParametricEQ.txt” বা একটি Equalizer APO কনফিগারেশন বেছে নিন।"
          }
        },
        "cs": {
          "stringUnit": {

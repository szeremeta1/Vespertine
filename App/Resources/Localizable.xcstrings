    "16-bit source sent as 16-bit at %@ kHz": {
      "comment": "Signal-path note for the “Match 16-bit sources” setting; %@ is a sample rate.",
      "extractionState": "manual",
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "16-bit ምንጭ በ%@ kHz እንደ 16-bit ተልኳል"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مصدر 16 بت يُرسَل بدقة 16 بت عند %@ kHz"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "16-bit সোর্স %@ kHz-এ 16-bit হিসেবে পাঠানো হয়েছে"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "16bitový zdroj odeslán v 16 bitech při %@ kHz"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "16-bit-kilde sendt som 16-bit ved %@ kHz"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "16-Bit-Quelle mit 16 Bit bei %@ kHz gesendet"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πηγή 16 bit, αποστολή ως 16 bit στα %@ kHz"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "16-bit source sent as 16-bit at %@ kHz"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuente de 16 bits enviada en 16 bits a %@ kHz"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "منبع ۱۶ بیتی به‌صورت ۱۶ بیتی در %@ kHz ارسال می‌شود"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "16-bittinen lähde lähetetty 16-bittisenä (%@ kHz)"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ipinadala ang 16-bit na source bilang 16-bit sa %@ kHz"

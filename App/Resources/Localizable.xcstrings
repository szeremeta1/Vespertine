    "Only %lld of %lld bits carry audio (zero-padded)": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ከ%#@n@ ድምፅ የሚይዙት %1$lld ብቻ ናቸው (በዜሮ የተሞሉ)"
          },
          "substitutions": {
            "n": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {

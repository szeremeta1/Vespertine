    "Standard channel-layout mix (centre and surrounds folded in)": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "መደበኛ የቻናል አቀማመጥ ሚክስ (ማዕከልና ሰራውንዶች ተደባልቀው)"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مزج قياسي حسب توزيع القنوات (مع دمج القناة الوسطى والمحيطية)"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সাধারণ চ্যানেল-লেআউট মিক্স (সেন্টার ও সারাউন্ড মিশিয়ে)"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardní mix podle rozložení kanálů (středový a prostorové kanály vmíchány)"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardmiks efter kanallayout (center og surround foldet ind)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standard-Downmix nach Kanalanordnung (Center und Surround-Kanäle eingemischt)"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τυπική μίξη διάταξης καναλιών (το κεντρικό και τα surround ενσωματώνονται)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mezcla estándar según la disposición de canales (central y envolventes integrados)"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "میکس استاندارد چیدمان کانال (مرکز و فراگیرها ادغام می‌شوند)"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vakiomiksaus kanava-asettelun mukaan (keski- ja tilakanavat yhdistetty)"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Karaniwang mix ayon sa channel layout (isinama ang center at mga surround)"
          }
        },
        "fr": {

    "Disconnected. Choose Reconnect to use it again.": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ተቋርጧል። እንደገና ለመጠቀም «እንደገና አገናኝ»ን ይምረጡ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "غير متصل. اختر “إعادة الاتصال” لاستخدامها مجددًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সংযোগ বিচ্ছিন্ন। আবার ব্যবহার করতে “পুনরায় সংযোগ করুন” বেছে নিন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpojeno. Chcete-li sdílení znovu použít, zvolte Znovu připojit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Afbrudt. Vælg Opret forbindelse igen for at bruge den igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Getrennt. Wähle „Erneut verbinden“, um sie wieder zu verwenden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αποσυνδέθηκε. Επιλέξτε «Επανασύνδεση» για να τον χρησιμοποιήσετε ξανά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desconectado. Elige Reconectar para volver a usarlo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "قطع شد. برای استفادهٔ دوباره، «اتصال مجدد» را انتخاب کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yhteys katkaistu. Ota se uudelleen käyttöön valitsemalla Yhdistä uudelleen."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadiskonekta. Piliin ang Kumonekta Muli para magamit itong muli."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déconnecté. Choisissez Se reconnecter pour l’utiliser à nouveau."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ડિસ્કનેક્ટ થયું. ફરી વાપરવા માટે “ફરી કનેક્ટ કરો” પસંદ કરો."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "An cire haɗi. Zaɓi Sake Haɗawa don sake amfani da shi."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מנותק. בחר ״התחבר מחדש״ כדי להשתמש בו שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डिस्कनेक्ट है। इसे फिर से उपयोग करने के लिए “फिर से कनेक्ट करें” चुनें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Leválasztva. Az újbóli használathoz válassza az Újracsatlakozás lehetőséget."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terputus. Pilih Hubungkan Ulang untuk menggunakannya lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnessa. Scegli Riconnetti per usarla di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続が解除されました。再び使うには「再接続」を選択してください。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸಂಪರ್ಕ ಕಡಿತಗೊಂಡಿದೆ. ಇದನ್ನು ಮತ್ತೆ ಬಳಸಲು “ಮರುಸಂಪರ್ಕಿಸಿ” ಆಯ್ಕೆಮಾಡಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결이 해제되었습니다. 다시 사용하려면 다시 연결을 선택하십시오."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "വിച്ഛേദിച്ചു. വീണ്ടും ഉപയോഗിക്കാൻ വീണ്ടും കണക്റ്റ് ചെയ്യുക തിരഞ്ഞെടുക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "डिस्कनेक्ट केले. पुन्हा वापरण्यासाठी “पुन्हा कनेक्ट करा” निवडा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sambungan terputus. Pilih Sambung Semula untuk menggunakannya lagi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Frakoblet. Velg Koble til på nytt for å bruke den igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinding verbroken. Kies ‘Maak opnieuw verbinding’ om de share weer te gebruiken."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਡਿਸਕਨੈਕਟ ਹੈ। ਇਸਨੂੰ ਦੁਬਾਰਾ ਵਰਤਣ ਲਈ ‘ਮੁੜ ਕਨੈਕਟ ਕਰੋ’ ਚੁਣੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odłączony. Wybierz Połącz ponownie, aby znowu go używać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desconectado. Escolha Reconectar para usá-lo novamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Desligada. Escolha Voltar a ligar para a usar novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deconectat. Alegeți Reconectează pentru a o folosi din nou."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Frånkopplad. Välj Anslut igen för att använda den igen."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Imetenganishwa. Chagua Unganisha Upya ili kuitumia tena."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "துண்டிக்கப்பட்டது. மீண்டும் பயன்படுத்த ‘மீண்டும் இணை’ என்பதைத் தேர்வுசெய்யவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "డిస్‌కనెక్ట్ అయింది. దీన్ని మళ్లీ ఉపయోగించడానికి “మళ్లీ కనెక్ట్ చేయి” ఎంచుకోండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตัดการเชื่อมต่อแล้ว เลือก เชื่อมต่อใหม่ เพื่อใช้งานอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantı kesildi. Yeniden kullanmak için Yeniden Bağlan’ı seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Від’єднано. Виберіть «Під’єднати знову», щоб знову ним користуватися."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "منقطع۔ اسے دوبارہ استعمال کرنے کے لیے “دوبارہ منسلک کریں” منتخب کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã ngắt kết nối. Chọn Kết nối lại để sử dụng lại."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "已中斷連接。選擇「重新連接」即可再次使用。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已断开连接。选取“重新连接”以再次使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已中斷連線。選擇「重新連線」即可再次使用。"
          }
        }
      }
    },

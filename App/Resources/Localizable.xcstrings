    "Keep local copies of music played from shares": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ከማጋሪያዎች የተጫወቱ ሙዚቃዎችን አካባቢያዊ ቅጂዎች አቆይ"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الاحتفاظ بنسخ محلية من الموسيقى المشغّلة من المشاركات"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শেয়ার থেকে চালানো মিউজিকের লোকাল কপি রাখুন"
          }
        },
        "cs": {

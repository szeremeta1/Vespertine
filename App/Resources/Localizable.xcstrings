    "The measurement doesn't cover the correction range.": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "መለኪያው የማስተካከያ ክልሉን አይሸፍንም።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يغطي القياس نطاق التصحيح."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পরিমাপ কারেকশনের পরিসর কভার করে না।"

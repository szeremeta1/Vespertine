    "Allow digital volume when the device has no hardware control": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "መሣሪያው የሃርድዌር መቆጣጠሪያ ከሌለው ዲጂታል የድምፅ መጠንን ፍቀድ"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السماح بمستوى الصوت الرقمي عندما لا يوفر الجهاز تحكمًا في العتاد"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ডিভাইসে হার্ডওয়্যার নিয়ন্ত্রণ না থাকলে ডিজিটাল ভলিউমের অনুমতি দিন"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Povolit digitální hlasitost, pokud zařízení nemá hardwarové ovládání"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillad digital lydstyrke, når enheden ikke har hardwarebetjening"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Digitale Lautstärke erlauben, wenn das Gerät keine Hardwaresteuerung hat"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Να επιτρέπεται ψηφιακή ένταση όταν η συσκευή δεν έχει έλεγχο υλικού"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir volumen digital cuando el dispositivo no tiene control por hardware"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اجازهٔ تنظیم دیجیتال صدا وقتی دستگاه کنترل سخت‌افزاری ندارد"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Salli digitaalinen äänenvoimakkuus, kun laitteessa ei ole laitteistosäädintä"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Payagan ang digital volume kapag walang hardware control ang device"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriser le volume numérique lorsque l’appareil n’a pas de réglage matériel"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ડિવાઇસમાં હાર્ડવેર નિયંત્રણ ન હોય ત્યારે ડિજિટલ વૉલ્યૂમને મંજૂરી આપો"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ba da damar ƙarar dijital idan na'urar ba ta da sarrafawar na'ura"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר עוצמת קול דיגיטלית כאשר להתקן אין בקרת חומרה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डिवाइस में हार्डवेयर नियंत्रण न होने पर डिजिटल वॉल्यूम की अनुमति दें"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Digitális hangerő engedélyezése, ha az eszköznek nincs hardveres vezérlése"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izinkan volume digital jika perangkat tidak memiliki kontrol perangkat keras"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti il volume digitale quando il dispositivo non ha un controllo hardware"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスにハードウェアの音量調節がない場合はデジタル音量を許可"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸಾಧನಕ್ಕೆ ಹಾರ್ಡ್‌ವೇರ್ ನಿಯಂತ್ರಣ ಇಲ್ಲದಿದ್ದಾಗ ಡಿಜಿಟಲ್ ವಾಲ್ಯೂಮ್ ಅನುಮತಿಸಿ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기에 하드웨어 음량 조절이 없을 때 디지털 음량 허용"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഉപകരണത്തിന് ഹാർഡ്‌വെയർ നിയന്ത്രണം ഇല്ലാത്തപ്പോൾ ഡിജിറ്റൽ വോളിയം അനുവദിക്കുക"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "डिव्हाइसला हार्डवेअर नियंत्रण नसल्यास डिजिटल व्हॉल्यूमला परवानगी द्या"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Benarkan kelantangan digital apabila peranti tiada kawalan perkakasan"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillat digitalt volum når enheten ikke har maskinvarekontroll"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta digitaal volume toe als het apparaat geen hardwareregeling heeft"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਜਦੋਂ ਡਿਵਾਈਸ ਵਿੱਚ ਹਾਰਡਵੇਅਰ ਕੰਟਰੋਲ ਨਾ ਹੋਵੇ ਤਾਂ ਡਿਜੀਟਲ ਵੌਲਿਊਮ ਦੀ ਇਜਾਜ਼ਤ ਦਿਓ"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zezwalaj na głośność cyfrową, gdy urządzenie nie ma regulacji sprzętowej"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir volume digital quando o dispositivo não tem controle por hardware"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir volume digital quando o dispositivo não tem controlo de hardware"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite volumul digital când dispozitivul nu are control hardware"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillåt digital volym när enheten saknar hårdvarureglage"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruhusu kiwango cha sauti cha kidijitali kifaa kisipokuwa na kidhibiti cha maunzi"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சாதனத்தில் வன்பொருள் கட்டுப்பாடு இல்லாதபோது டிஜிட்டல் ஒலியளவை அனுமதி"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పరికరానికి హార్డ్‌వేర్ నియంత్రణ లేనప్పుడు డిజిటల్ వాల్యూమ్‌ను అనుమతించు"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อนุญาตระดับเสียงแบบดิจิทัลเมื่ออุปกรณ์ไม่มีการควบคุมด้วยฮาร์ดแวร์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aygıtta donanım denetimi yoksa dijital ses düzeyine izin ver"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозволити цифрову гучність, якщо пристрій не має апаратного регулювання"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جب ڈیوائس میں ہارڈویئر کنٹرول نہ ہو تو ڈیجیٹل والیوم کی اجازت دیں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép âm lượng kỹ thuật số khi thiết bị không có điều khiển phần cứng"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "裝置沒有硬件音量控制時，允許使用數碼音量"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备没有硬件音量控制时允许使用数字音量"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "裝置沒有硬體音量控制時允許使用數位音量"
          }
        }
      }
    },
    "Also accepts \\\\server\\share, nfs://server/export and https://server/path (WebDAV). A folder after the share name limits Vespertine to that folder.": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",

    "Nothing plays until the output you chose is connected again.": {
      "comment": "Settings note under the fallback picker.",
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "የመረጡት ውፅዓት እንደገና እስኪገናኝ ድረስ ምንም አይጫወትም።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يُشغَّل أي شيء حتى يتصل المخرج الذي اخترته من جديد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার বেছে নেওয়া আউটপুট আবার সংযুক্ত না হওয়া পর্যন্ত কিছুই চলবে না।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokud se zvolený výstup znovu nepřipojí, nic se nepřehrává."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Intet afspilles, før det valgte output er forbundet igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bis die von dir gewählte Ausgabe wieder verbunden ist, wird nichts wiedergegeben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν παίζει τίποτα μέχρι να συνδεθεί ξανά η έξοδος που επιλέξατε."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se reproduce nada hasta que la salida que elegiste vuelva a estar conectada."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تا وقتی خروجی‌ای که انتخاب کرده‌اید دوباره وصل نشود، چیزی پخش نمی‌شود."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitään ei toisteta, ennen kuin valitsemasi ulostulo on taas yhdistetty."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang magpe-play hanggang muling makonekta ang output na pinili mo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n’est lu tant que la sortie choisie n’est pas de nouveau connectée."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે પસંદ કરેલું આઉટપુટ ફરી કનેક્ટ ન થાય ત્યાં સુધી કંઈ વાગશે નહીં."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Babu abin da zai kunna har sai an sake haɗa na'urar da kuka zaɓa."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שום דבר לא יושמע עד שהפלט שבחרת יחובר שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब तक आपका चुना गया आउटपुट फिर से कनेक्ट नहीं होता, कुछ नहीं चलेगा।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",

    "24-bit at two sample rates, a 16-bit file and a gapless pair.": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "24-bit በሁለት የናሙና ፍጥነቶች፣ አንድ 16-bit ፋይል እና ያለክፍተት የሚጫወቱ ጥንድ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "24 بت عند معدلَي عينة، وملف 16 بت، وزوج متصل دون فجوات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "দুটি স্যাম্পল রেটে 24-bit, একটি 16-bit ফাইল এবং একটি গ্যাপলেস জোড়া।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "24 bitů při dvou vzorkovacích frekvencích, 16bitový soubor a dvojice bez mezery."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "24-bit ved to samplingfrekvenser, en 16-bit-fil og et par uden pause."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "24 Bit bei zwei Abtastraten, eine 16-Bit-Datei und ein lückenloses Paar."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "24 bit σε δύο ρυθμούς δειγματοληψίας, ένα αρχείο 16 bit και ένα ζεύγος χωρίς κενό."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "24 bits a dos frecuencias de muestreo, un archivo de 16 bits y un par sin pausas."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "۲۴ بیتی در دو نرخ نمونه‌برداری، یک فایل ۱۶ بیتی و یک جفت بی‌فاصله."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "24-bittinen kahdella näytteenottotaajuudella, 16-bittinen tiedosto ja saumaton pari."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "24-bit sa dalawang sample rate, isang 16-bit na file at isang gapless na pares."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "24 bits à deux fréquences d’échantillonnage, un fichier 16 bits et une paire sans blanc."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "બે સેમ્પલ રેટ પર 24-bit, એક 16-bit ફાઇલ અને એક ગૅપલેસ જોડી."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Bit 24 a ƙimar samfuri biyu, fayil na bit 16 da biyu ba tare da tazara ba."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "24 סיביות בשני קצבי דגימה, קובץ של 16 סיביות וזוג רצועות ללא הפסקה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दो सैंपल रेट पर 24-bit, एक 16-bit फ़ाइल और एक गैपलेस जोड़ी।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "24 bit két mintavételi frekvencián, egy 16 bites fájl és egy szünet nélküli pár."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "24-bit pada dua laju sampel, satu file 16-bit, dan sepasang trek tanpa jeda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "24 bit a due frequenze di campionamento, un file a 16 bit e una coppia senza pause."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2つのサンプルレートでの24ビット、16ビットのファイル、ギャップレスのペア。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಎರಡು ಸ್ಯಾಂಪಲ್ ರೇಟ್‌ಗಳಲ್ಲಿ 24-bit, ಒಂದು 16-bit ಫೈಲ್ ಮತ್ತು ಒಂದು ಗ್ಯಾಪ್‌ಲೆಸ್ ಜೋಡಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 가지 샘플 레이트의 24비트, 16비트 파일 하나 및 갭리스 쌍 하나."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "രണ്ട് സാമ്പിൾ റേറ്റുകളിൽ 24-bit, ഒരു 16-bit ഫയൽ, ഒരു ഗ്യാപ്‌ലെസ് ജോഡി."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "दोन सॅम्पल रेटवर 24-bit, एक 16-bit फाइल आणि एक गॅपलेस जोडी."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "24-bit pada dua kadar sampel, satu fail 16-bit dan sepasang trek tanpa jeda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "24-bit ved to samplingsfrekvenser, en 16-bit-fil og et sømløst par."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "24 bit bij twee samplefrequenties, een 16-bits bestand en een naadloos paar."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਦੋ ਸੈਂਪਲ ਰੇਟਾਂ ’ਤੇ 24-bit, ਇੱਕ 16-bit ਫ਼ਾਈਲ ਅਤੇ ਬਿਨਾਂ ਵਿੱਥ ਵਾਲੀ ਇੱਕ ਜੋੜੀ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "24 bity przy dwóch częstotliwościach próbkowania, plik 16-bitowy i para bez przerwy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "24 bits em duas taxas de amostragem, um arquivo de 16 bits e um par sem intervalo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "24 bits em duas frequências de amostragem, um ficheiro de 16 bits e um par sem pausas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "24 de biți la două rate de eșantionare, un fișier pe 16 biți și o pereche fără pauză."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "24 bitar vid två samplingsfrekvenser, en 16-bitarsfil och ett sömlöst par."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Biti 24 kwa viwango viwili vya sampuli, faili ya biti 16 na jozi isiyo na pengo."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இரண்டு மாதிரி வீதங்களில் 24-bit, ஒரு 16-bit கோப்பு, ஓர் இடைவெளியற்ற ஜோடி."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "రెండు శాంపిల్ రేట్‌లలో 24-bit, ఒక 16-bit ఫైల్, ఒక గ్యాప్‌లెస్ జత."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "24 บิตที่อัตราสุ่มตัวอย่างสองค่า ไฟล์ 16 บิตหนึ่งไฟล์ และคู่เพลงแบบไม่มีช่องว่าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İki örnekleme hızında 24 bit, bir 16 bit dosya ve bir boşluksuz çift."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "24 біт на двох частотах дискретизації, 16-бітний файл і пара без пауз."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دو سیمپل ریٹس پر 24-bit، ایک 16-bit فائل اور ایک بلا وقفہ جوڑا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "24 bit ở hai tần số lấy mẫu, một tệp 16 bit và một cặp phát liền mạch."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "兩種取樣率下的 24 位元、一個 16 位元檔案和一組無間隙銜接的曲目。"
          }
        },
        "zh-Hans": {

    "This is a DVD-Audio disc. Vespertine plays DVD-Video LPCM, not DVD-Audio (MLP or DVD-Audio PCM).": {
      "extractionState": "manual",
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ይህ የDVD-Audio ዲስክ ነው። Vespertine DVD-Video LPCMን ያጫውታል፣ DVD-Audioን (MLP ወይም DVD-Audio PCM) አይደለም።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا قرص DVD-Audio. يشغّل Vespertine صوت DVD-Video LPCM، وليس DVD-Audio (MLP أو DVD-Audio PCM)."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি একটি DVD-Audio ডিস্ক। Vespertine DVD-Video LPCM চালায়, DVD-Audio (MLP বা DVD-Audio PCM) নয়।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto je disk DVD-Audio. Vespertine přehrává DVD-Video LPCM, ne DVD-Audio (MLP nebo DVD-Audio PCM)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette er en DVD-Audio-disk. Vespertine afspiller DVD-Video LPCM, ikke DVD-Audio (MLP eller DVD-Audio PCM)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies ist eine DVD-Audio-Disc. Vespertine spielt DVD-Video-LPCM ab, nicht DVD-Audio (MLP oder DVD-Audio-PCM)."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτός είναι δίσκος DVD-Audio. Το Vespertine αναπαράγει DVD-Video LPCM, όχι DVD-Audio (MLP ή DVD-Audio PCM)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a DVD-Audio disc. Vespertine plays DVD-Video LPCM, not DVD-Audio (MLP or DVD-Audio PCM)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este es un disco DVD-Audio. Vespertine reproduce DVD-Video LPCM, no DVD-Audio (MLP o DVD-Audio PCM)."

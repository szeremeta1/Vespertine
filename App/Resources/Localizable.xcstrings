    "Converted from DSD": {
      "comment": "Notice (badge, menu-bar line): the DSD music was converted to PCM for this output. DSD stays untranslated.",
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ከDSD ተቀይሯል"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "محوَّل من DSD"
          }

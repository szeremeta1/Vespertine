    "Sample rates, DSD, surround and every other detail are in Settings › Playback.": {
      "extractionState": "manual",
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "የናሙና ተመኖች፣ DSD፣ ሰራውንድ እና ሌሎች ዝርዝሮች ሁሉ በቅንብሮች › መጫወት ውስጥ ናቸው።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "معدلات أخذ العينات و DSD والصوت المحيطي وكل التفاصيل الأخرى موجودة في الإعدادات › التشغيل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্যাম্পল রেট, DSD, সারাউন্ড আর বাকি সব খুঁটিনাটি সেটিংস › প্লেব্যাক-এ পাবেন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vzorkovací frekvence, DSD, prostorový zvuk a všechny další podrobnosti najdete v Nastavení › Přehrávání."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Samplingfrekvenser, DSD, surround og alle andre detaljer finder du i Indstillinger › Afspilning."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abtastraten, DSD, Surround und alle weiteren Details findest du unter Einstellungen › Wiedergabe."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι ρυθμοί δειγματοληψίας, το DSD, ο surround ήχος και κάθε άλλη λεπτομέρεια βρίσκονται στις Ρυθμίσεις › Αναπαραγωγή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sample rates, DSD, surround and every other detail are in Settings › Playback."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las frecuencias de muestreo, el DSD, el sonido envolvente y todos los demás detalles están en Ajustes › Reproducción."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نرخ‌های نمونه‌برداری، DSD، صدای فراگیر و همهٔ جزئیات دیگر در تنظیمات › پخش هستند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näytteenottotaajuudet, DSD, surround ja kaikki muut yksityiskohdat löytyvät kohdasta Asetukset › Toisto."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nasa Settings › Playback ang mga sample rate, DSD, surround at lahat ng iba pang detalye."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fréquences d’échantillonnage, DSD, son surround et tous les autres détails se trouvent dans Réglages › Lecture."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સેમ્પલ રેટ, DSD, સરાઉન્ડ અને બાકીની બધી વિગતો સેટિંગ્સ › પ્લેબૅકમાં છે."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ƙimar samfuri, DSD, surround da duk sauran bayanai suna cikin Saituna › Kunnawa."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קצבי דגימה, DSD, צליל היקפי וכל שאר הפרטים נמצאים ב״הגדרות״ › ״השמעה״."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सैंपल रेट, DSD, सराउंड और बाकी सारी बारीकियाँ सेटिंग्ज़ › प्लेबैक में हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A mintavételi frekvenciák, a DSD, a térhangzás és minden más részlet a Beállítások › Lejátszás alatt található."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Laju sampel, DSD, surround, dan semua detail lainnya ada di Pengaturan › Pemutaran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Frequenze di campionamento, DSD, surround e ogni altro dettaglio si trovano in Impostazioni › Riproduzione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サンプルレート、DSD、サラウンドなどの詳細は、「設定」›「再生」にあります。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸ್ಯಾಂಪಲ್ ರೇಟ್‌ಗಳು, DSD, ಸರೌಂಡ್ ಮತ್ತು ಇತರ ಎಲ್ಲಾ ವಿವರಗಳು ಸೆಟ್ಟಿಂಗ್‌ಗಳು › ಪ್ಲೇಬ್ಯಾಕ್ ನಲ್ಲಿವೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "샘플링 레이트, DSD, 서라운드 및 기타 모든 세부 사항은 설정 › 재생에 있습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സാമ്പിൾ റേറ്റുകൾ, DSD, സറൗണ്ട് എന്നിവയും മറ്റെല്ലാ വിശദാംശങ്ങളും ക്രമീകരണങ്ങൾ › പ്ലേബാക്ക് എന്നതിലുണ്ട്."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सॅम्पल रेट, DSD, सराउंड आणि इतर सर्व तपशील सेटिंग्ज › प्लेबॅक मध्ये आहेत."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kadar sampel, DSD, bunyi sekeliling dan semua butiran lain terdapat dalam Seting › Main Balik."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Samplingsfrekvenser, DSD, surround og alle andre detaljer finner du i Innstillinger › Avspilling."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Samplefrequenties, DSD, surround en alle andere details vind je in Instellingen › Afspelen."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸੈਂਪਲ ਰੇਟ, DSD, ਸਰਾਊਂਡ ਅਤੇ ਬਾਕੀ ਸਾਰੇ ਵੇਰਵੇ ਸੈਟਿੰਗਾਂ › ਪਲੇਬੈਕ ਵਿੱਚ ਹਨ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Częstotliwości próbkowania, DSD, dźwięk przestrzenny i wszystkie pozostałe szczegóły znajdziesz w Ustawieniach › Odtwarzanie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Taxas de amostragem, DSD, surround e todos os outros detalhes estão em Ajustes › Reprodução."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Frequências de amostragem, DSD, surround e todos os outros detalhes estão em Definições › Reprodução."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ratele de eșantionare, DSD, sunetul surround și toate celelalte detalii se află în Configurări › Redare."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Samplingsfrekvenser, DSD, surround och alla andra detaljer finns i Inställningar › Uppspelning."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Viwango vya sampuli, DSD, sauti ya mzunguko na kila undani mwingine viko katika Mipangilio › Uchezaji."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சாம்பிள் ரேட்டுகள், DSD, சரவுண்ட் உள்ளிட்ட மற்ற எல்லா விவரங்களும் அமைப்புகள் › இயக்கம் என்பதில் உள்ளன."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "శాంపుల్ రేట్‌లు, DSD, సరౌండ్ ఇంకా ఇతర వివరాలన్నీ సెట్టింగ్‌లు › ప్లేబ్యాక్‌లో ఉన్నాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อัตราการสุ่มตัวอย่าง DSD เสียงรอบทิศทาง และรายละเอียดอื่นๆ ทั้งหมดอยู่ใน การตั้งค่า › การเล่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Örnekleme hızları, DSD, surround ve diğer tüm ayrıntılar Ayarlar › Oynatma bölümündedir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Частоти дискретизації, DSD, об’ємний звук і всі інші деталі — у Параметрах › Відтворення."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سیمپل ریٹس، DSD، سراؤنڈ اور باقی تمام تفصیلات سیٹنگز › پلے بیک میں ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tần số lấy mẫu, DSD, âm thanh vòm và mọi chi tiết khác nằm trong Cài đặt › Phát lại."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "取樣率、DSD、環迴立體聲及其他所有細節，都在「設定」›「播放」中。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "采样率、DSD、环绕声及其他所有细节，都在“设置” › “播放”中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "取樣率、DSD、環繞聲及其他所有細節，都在「設定」›「播放」中。"
          }
        }
      }

    "%lld-channel %lld-bit LPCM at %lld kHz exceeds DVD-Video's limit": {
      "comment": "Why DVD audio can't be played.",
      "extractionState": "manual",
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld-ቻናል %lld-bit LPCM በ%lld kHz የDVD-Video ገደብን ያልፋል"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "LPCM بـ %lld قناة و%lld بت عند %lld kHz يتجاوز حد DVD-Video"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld-চ্যানেল %lld-bit LPCM %lld kHz-এ DVD-Video-র সীমা ছাড়িয়ে যায়"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "LPCM s %lld kanály a %lld bity při %lld kHz překračuje limit DVD-Video"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld-kanals %lld-bit LPCM ved %lld kHz overskrider DVD-Videos grænse"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld-Kanal-LPCM mit %lld Bit bei %lld kHz überschreitet das Limit von DVD-Video"

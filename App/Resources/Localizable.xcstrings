        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك إضافة المزيد في أي وقت."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যেকোনো সময় আরও যোগ করতে পারবেন।"
          }
        },
        "cs": {

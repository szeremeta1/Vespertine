        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "For flerkanalsmusikk. Av sender alle kanaler til høyttalerne på denne enheten."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor meerkanaalsmuziek. ‘Uit’ stuurt elk kanaal naar de luidsprekers van dit apparaat."

    "Line %@ of the calibration file has a frequency that isn't above 0 Hz.": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "የልኬት ፋይሉ መስመር %@ ከ0 Hz በላይ ያልሆነ ድግግሞሽ አለው።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السطر %@ من ملف المعايرة يحتوي على تردد ليس أعلى من 0 Hz."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ক্যালিব্রেশন ফাইলের %@ নম্বর লাইনে এমন ফ্রিকোয়েন্সি আছে যা 0 Hz-এর বেশি নয়।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Řádek %@ kalibračního souboru má frekvenci, která není vyšší než 0 Hz."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Linje %@ i kalibreringsfilen har en frekvens, der ikke er over 0 Hz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeile %@ der Kalibrierungsdatei enthält eine Frequenz, die nicht über 0 Hz liegt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η γραμμή %@ του αρχείου βαθμονόμησης έχει συχνότητα που δεν είναι πάνω από 0 Hz."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La línea %@ del archivo de calibración tiene una frecuencia que no es superior a 0 Hz."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "خط %@ فایل کالیبراسیون فرکانسی دارد که بالاتر از 0 Hz نیست."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalibrointitiedoston rivin %@ taajuus ei ole yli 0 Hz."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang linya %@ ng calibration file ay may frequency na hindi mataas sa 0 Hz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La ligne %@ du fichier d'étalonnage a une fréquence qui n'est pas supérieure à 0 Hz."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કેલિબ્રેશન ફાઇલની લાઇન %@ માં 0 Hz થી વધુ ન હોય એવી આવૃત્તિ છે."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Layi na %@ na fayil ɗin daidaitawa yana da mita da ba ya sama da 0 Hz."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בשורה %@ בקובץ הכיול יש תדר שאינו גבוה מ-0 Hz."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैलिब्रेशन फ़ाइल की पंक्ति %@ में ऐसी आवृत्ति है जो 0 Hz से ऊपर नहीं है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kalibrációs fájl %@. sorában a frekvencia nem nagyobb 0 Hz-nél."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Baris %@ pada file kalibrasi memiliki frekuensi yang tidak di atas 0 Hz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La riga %@ del file di calibrazione ha una frequenza non superiore a 0 Hz."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャリブレーションファイルの %@ 行目の周波数が 0 Hz を超えていません。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಕ್ಯಾಲಿಬ್ರೇಶನ್ ಫೈಲ್‌ನ %@ ನೇ ಸಾಲಿನಲ್ಲಿ 0 Hz ಗಿಂತ ಹೆಚ್ಚಿಲ್ಲದ ಆವರ್ತನವಿದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보정 파일 %@번째 줄의 주파수가 0 Hz보다 크지 않습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കാലിബ്രേഷൻ ഫയലിലെ %@-ാം വരിയിൽ 0 Hz-ന് മുകളിലല്ലാത്ത ആവൃത്തിയാണ്."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कॅलिब्रेशन फाइलच्या ओळ %@ मध्ये 0 Hz पेक्षा जास्त नसलेली वारंवारता आहे."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Baris %@ fail penentukuran mempunyai frekuensi yang tidak melebihi 0 Hz."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Linje %@ i kalibreringsfilen har en frekvens som ikke er over 0 Hz."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Regel %@ van het kalibratiebestand heeft een frequentie die niet boven 0 Hz ligt."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੈਲੀਬ੍ਰੇਸ਼ਨ ਫ਼ਾਈਲ ਦੀ ਲਾਈਨ %@ ਵਿੱਚ 0 Hz ਤੋਂ ਉੱਪਰ ਨਾ ਹੋਣ ਵਾਲੀ ਆਵਿਰਤੀ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiersz %@ pliku kalibracyjnego ma częstotliwość nie większą niż 0 Hz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A linha %@ do arquivo de calibração tem uma frequência que não é maior que 0 Hz."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",

    "Multichannel area of a disc image; edits stay in the library": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "የዲስክ ኢሜጅ የባለብዙ ቻናል ክፍል፤ ማስተካከያዎች በቤተ-መጻሕፍቱ ውስጥ ይቆያሉ"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المنطقة متعددة القنوات في صورة قرص؛ تبقى التعديلات في المكتبة"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ডিস্ক ইমেজের মাল্টিচ্যানেল অংশ; সম্পাদনা লাইব্রেরিতেই থাকে"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vícekanálová oblast obrazu disku; úpravy zůstávají v knihovně"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Flerkanalsområde på et diskbillede; ændringer forbliver i biblioteket"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mehrkanalbereich eines Disc-Images; Änderungen bleiben in der Mediathek"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πολυκαναλική περιοχή ειδώλου δίσκου· οι αλλαγές μένουν στη βιβλιοθήκη"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Área multicanal de una imagen de disco; las ediciones se quedan en la biblioteca"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ناحیهٔ چندکانالهٔ یک ایمیج دیسک؛ ویرایش‌ها در کتابخانه می‌مانند"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Levykuvan monikanava-alue; muutokset pysyvät kirjastossa"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Multichannel area ng disc image; nananatili sa library ang mga pag-edit"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zone multicanal d’une image disque ; les modifications restent dans la bibliothèque"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ડિસ્ક ઇમેજનો મલ્ટિચૅનલ વિસ્તાર; સંપાદનો લાઇબ્રેરીમાં જ રહે છે"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Yankin tashoshi da yawa na kwafin faifai; gyare-gyare suna nan a laburare"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האזור הרב־ערוצי של תמונת דיסק; עריכות נשמרות בספריה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डिस्क इमेज का मल्टीचैनल क्षेत्र; संपादन लाइब्रेरी में ही रहते हैं"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Lemezkép többcsatornás területe; a szerkesztések a könyvtárban maradnak"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Area multisaluran dari image disk; pengeditan tetap di perpustakaan"

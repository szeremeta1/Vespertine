            "state": "translated",
            "value": "Plik „%@” został przeniesiony lub usunięty. Aktualizowanie biblioteki, aby go odnaleźć…"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” foi movido ou apagado. Atualizando a biblioteca para encontrá-lo…"

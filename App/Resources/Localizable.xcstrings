        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” ಅನ್ನು ಸರಿಸಲಾಗಿದೆ ಅಥವಾ ಅಳಿಸಲಾಗಿದೆ. ಅದನ್ನು ಹುಡುಕಲು ಲೈಬ್ರರಿಯನ್ನು ಅಪ್‌ಡೇಟ್ ಮಾಡಲಾಗುತ್ತಿದೆ…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%@’ 항목이 이동되었거나 삭제되었습니다. 찾기 위해 보관함을 업데이트하는 중…"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” നീക്കുകയോ ഇല്ലാതാക്കുകയോ ചെയ്തു. അത് കണ്ടെത്താൻ ലൈബ്രറി അപ്ഡേറ്റ് ചെയ്യുന്നു…"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” हलवले किंवा हटवले गेले. ते शोधण्यासाठी लायब्ररी अपडेट करत आहे…"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” telah dialihkan atau dipadam. Mengemas kini pustaka untuk mencarinya…"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» er flyttet eller slettet. Oppdaterer biblioteket for å finne den …"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%@’ is verplaatst of verwijderd. De bibliotheek wordt bijgewerkt om het bestand te vinden…"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” ਨੂੰ ਹਿਲਾਇਆ ਜਾਂ ਮਿਟਾਇਆ ਗਿਆ ਸੀ। ਇਸਨੂੰ ਲੱਭਣ ਲਈ ਲਾਇਬ੍ਰੇਰੀ ਅੱਪਡੇਟ ਕੀਤੀ ਜਾ ਰਹੀ ਹੈ…"
          }
        },
        "pl": {

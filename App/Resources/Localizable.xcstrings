        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਡਿਸਕ ਇਮੇਜ ਵਿੱਚ ਆਡੀਓ ਫ਼੍ਰੇਮ ਗੁੰਮ ਜਾਂ ਖ਼ਰਾਬ ਹਨ, ਚੁੱਪ ਵਜੋਂ ਚਲਾਏ ਗਏ"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brakujące lub uszkodzone ramki w obrazie płyty, odtwarzane jako cisza"
          }
        },
        "pt-BR": {

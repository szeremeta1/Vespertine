    "Everything here is alike: nothing to filter by.": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "እዚህ ያለው ሁሉ ተመሳሳይ ነው፦ የሚያጣራበት ነገር የለም።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل شيء هنا متشابه: لا يوجد ما يمكن التصفية حسبه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখানে সবকিছু একই রকম: ফিল্টার করার মতো কিছু নেই।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vše zde je stejné: není podle čeho filtrovat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt her er ens: Der er intet at filtrere efter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier ist alles gleich: Es gibt nichts zu filtern."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όλα εδώ είναι ίδια: δεν υπάρχει κάτι για φιλτράρισμα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí todo es igual: no hay nada por lo que filtrar."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "همه‌چیز در اینجا یکسان است: چیزی برای فیلتر کردن نیست."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaikki tässä on samanlaista: ei mitään suodatettavaa."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Magkakapareho ang lahat dito: walang mapag-fi-filter-an."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout est identique ici : rien à filtrer."

    "Nothing to choose with the other filters as they are.": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ሌሎቹ ማጣሪያዎች እንዳሉ ከሆኑ የሚመረጥ ነገር የለም።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد ما يمكن اختياره مع عوامل التصفية الأخرى كما هي."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অন্য ফিল্টারগুলো যেমন আছে তাতে বেছে নেওয়ার মতো কিছু নেই।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Při současném nastavení ostatních filtrů není z čeho vybírat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der er intet at vælge med de andre filtre, som de er nu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit den anderen Filtern in ihrer jetzigen Form gibt es nichts zur Auswahl."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν υπάρχει κάτι για επιλογή με τα άλλα φίλτρα όπως είναι."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay nada que elegir con los demás filtros tal como están."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "با فیلترهای دیگر به شکل فعلی، چیزی برای انتخاب نیست."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muilla suodattimilla ei ole mitään valittavaa nykyisellään."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang mapipili sa kasalukuyang ayos ng ibang mga filter."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien à choisir avec les autres filtres tels qu’ils sont."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "અન્ય ફિલ્ટર હાલ જેમ છે તે મુજબ પસંદ કરવા જેવું કંઈ નથી."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Babu abin da za a zaɓa da sauran matatu yadda suke."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין מה לבחור עם המסננים האחרים במצבם הנוכחי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बाकी फ़िल्टर जैसे हैं, उनके साथ चुनने के लिए कुछ नहीं है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A többi szűrő jelenlegi beállításával nincs miből választani."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada yang bisa dipilih dengan filter lain seperti saat ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Niente da scegliere con gli altri filtri così come sono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のほかのフィルタでは選べる項目がありません。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇತರ ಫಿಲ್ಟರ್‌ಗಳು ಈಗಿರುವಂತೆ ಇದ್ದರೆ ಆರಿಸಲು ಏನೂ ಇಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 다른 필터 설정으로는 선택할 항목이 없습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മറ്റ് ഫിൽട്ടറുകൾ ഇപ്പോഴുള്ളതുപോലെ ആയിരിക്കുമ്പോൾ തിരഞ്ഞെടുക്കാൻ ഒന്നുമില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "इतर फिल्टर सध्या जसे आहेत त्यानुसार निवडण्यासारखे काही नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada apa-apa untuk dipilih dengan penapis lain seperti sedia ada."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er ingenting å velge med de andre filtrene slik de er nå."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met de andere filters zoals ze nu zijn, valt er niets te kiezen."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਹੋਰ ਫ਼ਿਲਟਰਾਂ ਦੀ ਮੌਜੂਦਾ ਸਥਿਤੀ ਵਿੱਚ ਚੁਣਨ ਲਈ ਕੁਝ ਨਹੀਂ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przy obecnych ustawieniach pozostałych filtrów nie ma czego wybrać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada para escolher com os outros filtros como estão."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada para escolher com os outros filtros tal como estão."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu există nimic de ales cu celelalte filtre așa cum sunt."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget att välja med de andra filtren som de är nu."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hakuna cha kuchagua kwa vichujio vingine jinsi vilivyo."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பிற வடிப்பான்கள் இப்போதுள்ளபடி இருக்கும்போது தேர்வுசெய்ய எதுவுமில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇతర ఫిల్టర్‌లు ఇప్పుడున్నట్లుగా ఉంటే ఎంచుకోవడానికి ఏమీ లేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีตัวเลือกเมื่อใช้ตัวกรองอื่นตามที่เป็นอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diğer filtreler bu hâldeyken seçilecek bir şey yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "За поточних інших фільтрів вибрати нічого."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دوسرے فلٹرز کی موجودہ حالت میں منتخب کرنے کے لیے کچھ نہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có gì để chọn với các bộ lọc khác như hiện tại."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "在其他篩選條件現時的設定下，沒有可選擇的項目。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在其他过滤条件保持不变的情况下，没有可选择的项目。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在其他篩選條件維持不變的情況下，沒有可選擇的項目。"
          }
        }
      }
    },
    "Nothing was imported: the copies need %@ and the Mac has %@ free (Vespertine keeps %@ spare). Free up some space, or use Add Folder to play the music where it is.": {
      "comment": "Sizes such as “2.1 GB”. “Add Folder” is the command that adds a folder to the library without copying it.",
      "extractionState": "manual",
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ምንም አልገባም፦ ቅጂዎቹ %1$@ ያስፈልጋቸዋል፣ Mac ደግሞ %2$@ ነፃ ቦታ አለው (Vespertine %3$@ ትርፍ ያስቀራል)። የተወሰነ ቦታ ያስለቅቁ፣ ወይም ሙዚቃውን ባለበት ለማጫወት «አቃፊ አክል»ን ይጠቀሙ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم استيراد أي شيء: تحتاج النسخ إلى %1$@ والمساحة المتاحة على الـ Mac هي %2$@ (يحتفظ Vespertine بمساحة احتياطية قدرها %3$@). حرّر بعض المساحة، أو استخدم “إضافة مجلد” لتشغيل الموسيقى في مكانها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কিছুই ইমপোর্ট করা হয়নি: কপিগুলোর জন্য %1$@ প্রয়োজন এবং Mac-এ %2$@ খালি আছে (Vespertine %3$@ বাড়তি রাখে)। কিছু জায়গা খালি করুন, অথবা মিউজিক যেখানে আছে সেখান থেকেই চালাতে “ফোল্ডার যোগ করুন” ব্যবহার করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic nebylo importováno: kopie potřebují %@ a Mac má volných %@ (Vespertine si ponechává rezervu %@). Uvolněte místo, nebo použijte Přidat složku a přehrávejte hudbu tam, kde je."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Intet blev importeret: Kopierne kræver %@, og Mac'en har %@ ledig (Vespertine holder %@ i reserve). Frigør noget plads, eller brug Tilføj mappe for at afspille musikken, hvor den ligger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wurde nichts importiert: Die Kopien benötigen %@, und auf dem Mac sind %@ frei (Vespertine hält %@ frei). Gib Speicherplatz frei oder verwende „Ordner hinzufügen“, um die Musik an ihrem Speicherort abzuspielen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν εισήχθη τίποτα: τα αντίγραφα χρειάζονται %1$@ και το Mac έχει %2$@ ελεύθερα (το Vespertine κρατά %3$@ ως απόθεμα). Ελευθερώστε λίγο χώρο ή χρησιμοποιήστε την «Προσθήκη φακέλου» για να παίζετε τη μουσική από εκεί όπου βρίσκεται."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing was imported: the copies need %@ and the Mac has %@ free (Vespertine keeps %@ spare). Free up some space, or use Add Folder to play the music where it is."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha importado nada: las copias necesitan %@ y el Mac tiene %@ libres (Vespertine reserva %@). Libera algo de espacio o usa Añadir carpeta para reproducir la música donde está."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "چیزی وارد نشد: کپی‌ها به %@ نیاز دارند و Mac فقط %@ فضای آزاد دارد (Vespertine %@ را خالی نگه می‌دارد). مقداری فضا آزاد کنید یا با «افزودن پوشه» موسیقی را در همان جایی که هست پخش کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitään ei tuotu: kopiot tarvitsevat %@, ja Macilla on vapaana %@ (Vespertine pitää %@ varalla). Vapauta tilaa tai toista musiikki sen nykyisestä sijainnista käyttämällä Lisää kansio -toimintoa."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang na-import: kailangan ng mga kopya ang %@ at %@ ang libre sa Mac (nagtatabi ang Vespertine ng %@ na reserba). Magbakante ng espasyo, o gamitin ang Magdagdag ng Folder para i-play ang musika kung nasaan ito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n’a été importé : les copies nécessitent %@ et le Mac dispose de %@ d’espace libre (Vespertine garde %@ de réserve). Libérez de l’espace, ou utilisez Ajouter un dossier pour lire la musique là où elle se trouve."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કંઈ ઇમ્પોર્ટ થયું નથી: કૉપિ માટે %@ જોઈએ અને Mac પર %@ જગ્યા ખાલી છે (Vespertine %@ અનામત રાખે છે). થોડી જગ્યા ખાલી કરો, અથવા સંગીત જ્યાં છે ત્યાંથી વગાડવા “ફોલ્ડર ઉમેરો” વાપરો."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ba a shigo da komai ba: kwafin suna buƙatar %@ kuma Mac ɗin tana da sarari %@ (Vespertine yana barin %@ a ajiye). Samar da sarari, ko yi amfani da Ƙara Folda don kunna waƙoƙin a inda suke."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שום דבר לא יובא: העותקים דורשים %1$@ וב־Mac פנויים %2$@ (Vespertine שומר %3$@ כרזרבה). פנה מעט שטח, או השתמש ב״הוסף תיקייה״ כדי לנגן את המוזיקה במקומה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ भी इंपोर्ट नहीं हुआ: कॉपी के लिए %1$@ चाहिए और Mac पर %2$@ खाली है (Vespertine %3$@ अतिरिक्त रखता है)। कुछ जगह खाली करें, या संगीत को उसकी जगह से ही चलाने के लिए “फ़ोल्डर जोड़ें” का उपयोग करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Semmi sem lett importálva: a másolatokhoz %@ kell, a Macen %@ szabad (a Vespertine %@ tartalékot hagy). Szabadítson fel helyet, vagy használja a Mappa hozzáadása parancsot, hogy a zenét a helyén játssza le."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada yang diimpor: salinan membutuhkan %@ dan Mac hanya memiliki %@ ruang kosong (Vespertine menyisakan cadangan %@). Kosongkan sebagian ruang, atau gunakan Tambahkan Folder untuk memutar musik di lokasinya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato importato nulla: le copie richiedono %@ e il Mac ha %@ liberi (Vespertine tiene %@ di riserva). Libera spazio, oppure usa Aggiungi cartella per riprodurre la musica dove si trova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何も読み込まれませんでした: コピーには%@必要ですが、Macの空き容量は%@です（Vespertineは%@の余裕を残します）。空き容量を増やすか、「フォルダを追加」を使って音楽をその場所のまま再生してください。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಏನನ್ನೂ ಆಮದುಮಾಡಲಾಗಿಲ್ಲ: ನಕಲುಗಳಿಗೆ %@ ಬೇಕು ಮತ್ತು Mac ನಲ್ಲಿ %@ ಖಾಲಿ ಇದೆ (Vespertine %@ ಹೆಚ್ಚುವರಿಯಾಗಿ ಇಡುತ್ತದೆ). ಸ್ವಲ್ಪ ಸ್ಥಳವನ್ನು ಖಾಲಿ ಮಾಡಿ, ಅಥವಾ ಸಂಗೀತವನ್ನು ಅದು ಇರುವಲ್ಲೇ ಪ್ಲೇ ಮಾಡಲು “ಫೋಲ್ಡರ್ ಸೇರಿಸಿ” ಬಳಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아무것도 가져오지 않았습니다. 복사본에 %@이(가) 필요하지만 Mac의 여유 공간은 %@입니다(Vespertine은 %@의 여유 공간을 남겨둠). 공간을 확보하거나, 폴더 추가를 사용하여 음악을 원래 위치에서 재생하십시오."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒന്നും ഇംപോർട്ട് ചെയ്തില്ല: പകർപ്പുകൾക്ക് %@ വേണം, Mac-ൽ %@ ഒഴിവുണ്ട് (Vespertine %@ കരുതിവയ്ക്കുന്നു). കുറച്ച് സ്ഥലം ഒഴിവാക്കുക, അല്ലെങ്കിൽ സംഗീതം ഇരിക്കുന്നിടത്തുനിന്ന് പ്ലേ ചെയ്യാൻ ഫോൾഡർ ചേർക്കുക ഉപയോഗിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "काहीही इम्पोर्ट केले नाही: प्रतींसाठी %@ लागेल आणि Mac वर %@ जागा मोकळी आहे (Vespertine %@ राखीव ठेवते). थोडी जागा मोकळी करा, किंवा संगीत आहे तिथूनच प्ले करण्यासाठी “फोल्डर जोडा” वापरा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada apa-apa yang diimport: salinan memerlukan %@ dan Mac mempunyai %@ ruang kosong (Vespertine mengekalkan %@ sebagai simpanan). Kosongkan sedikit ruang, atau gunakan Tambah Folder untuk memainkan muzik di tempat asalnya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingenting ble importert: Kopiene krever %@, og Macen har %@ ledig (Vespertine holder av %@ i reserve). Frigjør litt plass, eller bruk Legg til mappe for å spille musikken der den ligger."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is niets geïmporteerd: de kopieën hebben %@ nodig en de Mac heeft %@ vrij (Vespertine houdt %@ vrij). Maak wat ruimte vrij of gebruik ‘Voeg map toe’ om de muziek af te spelen waar die staat."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੁਝ ਵੀ ਇੰਪੋਰਟ ਨਹੀਂ ਕੀਤਾ ਗਿਆ: ਕਾਪੀਆਂ ਲਈ %1$@ ਚਾਹੀਦੀ ਹੈ ਅਤੇ Mac ’ਤੇ %2$@ ਥਾਂ ਖਾਲੀ ਹੈ (Vespertine %3$@ ਵਾਧੂ ਰੱਖਦਾ ਹੈ)। ਕੁਝ ਥਾਂ ਖਾਲੀ ਕਰੋ, ਜਾਂ ਸੰਗੀਤ ਨੂੰ ਉਸਦੀ ਮੌਜੂਦਾ ਥਾਂ ਤੋਂ ਚਲਾਉਣ ਲਈ ‘ਫ਼ੋਲਡਰ ਜੋੜੋ’ ਵਰਤੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic nie zaimportowano: kopie wymagają %@, a na Macu wolne jest %@ (Vespertine zachowuje %@ zapasu). Zwolnij trochę miejsca lub użyj polecenia Dodaj folder, aby odtwarzać muzykę z jej obecnego miejsca."
          }

        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این یک دیسک DVD-Audio است. Vespertine صدای DVD-Video LPCM را پخش می‌کند، نه DVD-Audio (MLP یا DVD-Audio PCM)."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä on DVD-Audio-levy. Vespertine toistaa DVD-Video LPCM:ää, ei DVD-Audiota (MLP tai DVD-Audio PCM)."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Isa itong DVD-Audio disc. Nagpe-play ang Vespertine ng DVD-Video LPCM, hindi DVD-Audio (MLP o DVD-Audio PCM)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceci est un disque DVD-Audio. Vespertine lit le DVD-Video LPCM, pas le DVD-Audio (MLP ou DVD-Audio PCM)."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ DVD-Audio ડિસ્ક છે. Vespertine DVD-Video LPCM વગાડે છે, DVD-Audio (MLP અથવા DVD-Audio PCM) નહીં."
          }

    "Move the microphone to the glowing spot, then continue.": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ማይክሮፎኑን ወደሚያበራው ቦታ ያንቀሳቅሱ፣ ከዚያ ይቀጥሉ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقل الميكروفون إلى النقطة المضيئة، ثم تابع."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মাইক্রোফোনটি জ্বলজ্বলে জায়গায় সরান, তারপর এগিয়ে যান।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přesuňte mikrofon na svítící bod a pokračujte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Flyt mikrofonen til det lysende punkt, og fortsæt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stell das Mikrofon an die leuchtende Stelle und fahre dann fort."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μετακινήστε το μικρόφωνο στο φωτεινό σημείο και συνεχίστε."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lleva el micrófono al punto iluminado y continúa."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "میکروفون را به نقطه درخشان ببرید و ادامه دهید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Siirrä mikrofoni hehkuvaan kohtaan ja jatka."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilipat ang mikropono sa kumikinang na puwesto, saka magpatuloy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Placez le micro sur le point lumineux, puis continuez."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "માઇક્રોફોનને ચમકતી જગ્યાએ લઈ જાઓ, પછી આગળ વધો."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Matsar da makirufo zuwa wurin da ke haskakawa, sannan ka ci gaba."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הזיזו את המיקרופון לנקודה הזוהרת ואז המשיכו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "माइक्रोफ़ोन को चमकती जगह पर ले जाएँ, फिर आगे बढ़ें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tedd a mikrofont a világító pontra, majd folytasd."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindahkan mikrofon ke titik yang menyala, lalu lanjutkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sposta il microfono sul punto illuminato, poi continua."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "光っている位置にマイクを動かしてから続けてください。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಮೈಕ್ರೊಫೋನ್ ಅನ್ನು ಹೊಳೆಯುವ ಜಾಗಕ್ಕೆ ಸರಿಸಿ, ನಂತರ ಮುಂದುವರಿಯಿರಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마이크를 빛나는 위치로 옮긴 다음 계속하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മൈക്രോഫോൺ തിളങ്ങുന്ന സ്ഥലത്തേക്ക് നീക്കി, തുടരുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "मायक्रोफोन चमकणाऱ्या जागी हलवा, मग पुढे चला."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Alihkan mikrofon ke titik yang bercahaya, kemudian teruskan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Flytt mikrofonen til det lysende punktet, og fortsett."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet de microfoon op de oplichtende plek en ga dan verder."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਮਾਈਕ੍ਰੋਫ਼ੋਨ ਨੂੰ ਚਮਕਦੀ ਥਾਂ 'ਤੇ ਲੈ ਜਾਓ, ਫਿਰ ਜਾਰੀ ਰੱਖੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przenieś mikrofon w świecący punkt i kontynuuj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Leve o microfone ao ponto iluminado e continue."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Leve o microfone ao ponto iluminado e continue."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mută microfonul pe punctul luminos, apoi continuă."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Flytta mikrofonen till den lysande platsen och fortsätt sedan."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hamisha maikrofoni hadi sehemu inayong'aa, kisha endelea."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மைக்ரோஃபோனை ஒளிரும் இடத்துக்கு நகர்த்தி, பிறகு தொடருங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మైక్రోఫోన్‌ను మెరుస్తున్న చోటుకు జరిపి, ఆపై కొనసాగండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ย้ายไมโครโฟนไปยังจุดที่เรืองแสง แล้วดำเนินการต่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofonu parlayan noktaya taşıyın, sonra devam edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перемістіть мікрофон у точку, що світиться, і продовжте."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مائیکروفون کو چمکتی جگہ پر رکھیں، پھر جاری رکھیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt micro vào điểm đang sáng rồi tiếp tục."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "把咪高峰移到發光的位置，然後繼續。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把麦克风移到发光的位置，然后继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {

    "Use “%@” only while nothing else is playing to or recording from it. A dedicated “%@” device avoids that.": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ሌላ ምንም ነገር ወደ «%@» እያጫወተ ወይም ከእሱ እየቀዳ በማይሆንበት ጊዜ ብቻ ይጠቀሙበት። ለዚህ የተወሰነ «%@» መሣሪያ ይህን ችግር ያስቀራል።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم “%@” فقط عندما لا يشغّل أي شيء آخر عليه ولا يسجّل منه. يتجنب جهاز “%@” مخصص ذلك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” কেবল তখনই ব্যবহার করুন যখন অন্য কিছু এতে চলছে না বা এখান থেকে রেকর্ড করছে না। একটি নির্দিষ্ট “%@” ডিভাইস এই সমস্যা এড়ায়।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Používejte „%@“ jen tehdy, když na něj nic jiného nepřehrává ani z něj nenahrává. Vyhrazené zařízení „%@“ tomu předejde."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug kun “%@”, mens intet andet afspiller til eller optager fra den. En dedikeret enhed “%@” undgår det."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende „%@“ nur, während nichts anderes darauf abspielt oder davon aufnimmt. Ein eigenes Gerät „%@“ vermeidet das."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χρησιμοποιήστε τη «%@» μόνο όσο τίποτε άλλο δεν αναπαράγει σε αυτήν ούτε ηχογραφεί από αυτήν. Μια ειδική συσκευή «%@» το αποφεύγει αυτό."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa “%@” solo mientras ninguna otra cosa reproduzca en él ni grabe desde él. Un dispositivo dedicado “%@” lo evita."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "از «%@» فقط زمانی استفاده کنید که هیچ چیز دیگری روی آن پخش یا از آن ضبط نمی‌کند. یک دستگاه اختصاصی «%@» از این مشکل جلوگیری می‌کند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käytä laitetta ”%@” vain, kun mikään muu ei toista siihen tai tallenna siitä. Erillinen ”%@”-laite välttää tämän."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Gamitin lang ang “%@” habang walang ibang nagpe-play dito o nagre-record mula rito. Naiiwasan iyon ng isang nakalaang “%@” na device."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "N’utilisez « %@ » que lorsque rien d’autre ne lit ou n’enregistre sur cet appareil. Un appareil dédié « %@ » évite cette contrainte."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” નો ઉપયોગ ફક્ત ત્યારે જ કરો જ્યારે બીજું કશું તેના પર વાગતું ન હોય કે તેમાંથી રેકોર્ડ કરતું ન હોય. સમર્પિત “%@” ડિવાઇસ આ ટાળે છે."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Yi amfani da “%@” kawai yayin da babu wani abu da ke kunnawa a kanta ko naɗa daga gare ta. Keɓaɓɓiyar na'urar “%@” tana guje wa hakan."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השתמש ב־“%@” רק כששום דבר אחר אינו מנגן אליו או מקליט ממנו. התקן “%@” ייעודי מונע זאת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” का उपयोग तभी करें जब कोई और चीज़ उस पर न चल रही हो और न ही उससे रिकॉर्ड कर रही हो। एक समर्पित “%@” डिवाइस इस समस्या से बचाता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak akkor használja a(z) „%@” eszközt, ha semmi más nem játszik le rá és nem rögzít róla. Egy külön „%@” eszközzel ez elkerülhető."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan “%@” hanya saat tidak ada hal lain yang memutar ke atau merekam dari perangkat tersebut. Perangkat khusus “%@” menghindari hal itu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa “%@” solo mentre nient’altro riproduce su di esso o registra da esso. Un dispositivo dedicato “%@” evita questo problema."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」は、ほかに何もそのデバイスで再生や録音をしていないときだけ使用してください。専用の「%@」デバイスを使えば、この制約はありません。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಬೇರೆ ಯಾವುದೂ “%@” ಗೆ ಪ್ಲೇ ಮಾಡುತ್ತಿಲ್ಲದಿರುವಾಗ ಮತ್ತು ಅದರಿಂದ ರೆಕಾರ್ಡ್ ಮಾಡುತ್ತಿಲ್ಲದಿರುವಾಗ ಮಾತ್ರ ಅದನ್ನು ಬಳಸಿ. ಮೀಸಲಾದ “%@” ಸಾಧನವು ಇದನ್ನು ತಪ್ಪಿಸುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%@’은(는) 다른 항목이 해당 기기로 재생하거나 해당 기기에서 녹음하지 않을 때만 사용하십시오. 전용 ‘%@’ 기기를 사용하면 이 문제를 피할 수 있습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മറ്റൊന്നും “%@”-ലേക്ക് പ്ലേ ചെയ്യുകയോ അതിൽ നിന്ന് റെക്കോർഡ് ചെയ്യുകയോ ചെയ്യാത്തപ്പോൾ മാത്രം അത് ഉപയോഗിക്കുക. ഒരു പ്രത്യേക “%@” ഉപകരണം ഇത് ഒഴിവാക്കുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” फक्त तेव्हाच वापरा जेव्हा इतर काहीही त्यावर वाजत नसेल किंवा त्यातून रेकॉर्ड करत नसेल. समर्पित “%@” डिव्हाइसमुळे हे टाळता येते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan “%@” hanya semasa tiada apa-apa lagi yang memainkan ke atau merakam daripadanya. Peranti khusus “%@” mengelakkan perkara itu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruk «%@» bare mens ingenting annet spiller til eller tar opp fra den. En egen enhet «%@» unngår det."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik ‘%@’ alleen terwijl niets anders erop afspeelt of ervan opneemt. Met een apart apparaat ‘%@’ voorkom je dat."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” ਨੂੰ ਸਿਰਫ਼ ਤਾਂ ਹੀ ਵਰਤੋ ਜਦੋਂ ਹੋਰ ਕੁਝ ਵੀ ਉਸ ’ਤੇ ਨਾ ਚੱਲ ਰਿਹਾ ਹੋਵੇ ਅਤੇ ਨਾ ਹੀ ਉਸ ਤੋਂ ਰਿਕਾਰਡ ਕਰ ਰਿਹਾ ਹੋਵੇ। ਇੱਕ ਸਮਰਪਿਤ “%@” ਡਿਵਾਈਸ ਇਸ ਤੋਂ ਬਚਾਉਂਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Używaj „%@” tylko wtedy, gdy nic innego na nim nie odtwarza ani z niego nie nagrywa. Dedykowane urządzenie „%@” eliminuje ten problem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use “%@” somente enquanto nada mais estiver reproduzindo nele ou gravando a partir dele. Um dispositivo dedicado “%@” evita isso."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Use “%@” apenas enquanto nada mais estiver a reproduzir nele ou a gravar a partir dele. Um dispositivo dedicado “%@” evita isso."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Folosiți „%@” doar cât timp nimic altceva nu redă pe el și nu înregistrează de pe el. Un dispozitiv dedicat „%@” evită acest lucru."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Använd ”%@” bara när inget annat spelar till eller spelar in från den. En särskild enhet ”%@” undviker det."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Tumia “%@” tu wakati hakuna kitu kingine kinachocheza kwake au kurekodi kutoka kwake. Kifaa maalum cha “%@” huepuka hilo."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வேறு எதுவும் “%@”-க்கு இயக்காதபோதும் அதிலிருந்து பதிவுசெய்யாதபோதும் மட்டுமே அதைப் பயன்படுத்தவும். பிரத்யேக “%@” சாதனம் இதைத் தவிர்க்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మరేదీ “%@”కు ప్లే చేయనప్పుడు, దాని నుండి రికార్డ్ చేయనప్పుడు మాత్రమే దాన్ని ఉపయోగించండి. ప్రత్యేక “%@” పరికరం దీన్ని నివారిస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ “%@” เฉพาะเมื่อไม่มีสิ่งอื่นเล่นเสียงไปยังหรือบันทึกเสียงจากอุปกรณ์นี้ อุปกรณ์ “%@” โดยเฉพาะจะช่วยหลีกเลี่ยงปัญหานี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” aygıtını yalnızca başka hiçbir şey ona çalmıyor veya ondan kayıt yapmıyorken kullanın. Özel bir “%@” aygıtı bunu önler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовуйте «%@», лише поки ніщо інше не відтворює на нього й не записує з нього. Окремий пристрій «%@» усуває це обмеження."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” صرف اس وقت استعمال کریں جب کوئی اور چیز نہ اس پر چل رہی ہو اور نہ اس سے ریکارڈ کر رہی ہو۔ ایک مخصوص “%@” ڈیوائس اس سے بچاتی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ dùng “%@” khi không có gì khác đang phát tới hoặc ghi âm từ thiết bị đó. Một thiết bị “%@” chuyên dụng sẽ tránh được điều này."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "只在沒有其他內容向「%@」播放或從中錄音時才使用它。使用專用的「%@」裝置可避免此問題。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在没有其他内容向“%@”播放或从中录音时使用它。使用专用的“%@”设备可避免此问题。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有在沒有其他內容向「%@」播放或從中錄音時才使用它。使用專用的「%@」裝置可避免此問題。"
          }
        }
      }

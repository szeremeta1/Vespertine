          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 파일에는 필터가 없습니다. AutoEQ의 ‘ParametricEQ.txt’ 또는 Equalizer APO 구성을 선택하십시오."
          }
        },
        "ml": {

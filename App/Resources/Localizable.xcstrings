    "AirPlay streams at 44.1 kHz; the receiver controls the final format.": {
      "extractionState": "manual",
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay በ44.1 kHz ያስተላልፋል፤ የመጨረሻውን ቅርጸት የሚቆጣጠረው ተቀባዩ ነው።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبث AirPlay بمعدل 44.1 kHz؛ ويتحكم جهاز الاستقبال في التنسيق النهائي."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay 44.1 kHz-এ স্ট্রিম করে; চূড়ান্ত ফরম্যাট রিসিভার ঠিক করে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay streamuje v 44,1 kHz; o konečném formátu rozhoduje přijímač."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay streamer ved 44,1 kHz; modtageren bestemmer det endelige format."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay überträgt mit 44,1 kHz; der Empfänger bestimmt das endgültige Format."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το AirPlay μεταδίδει στα 44,1 kHz· ο δέκτης ελέγχει την τελική μορφή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay streams at 44.1 kHz; the receiver controls the final format."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay transmite a 44,1 kHz; el receptor controla el formato final."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay با ۴۴٫۱ kHz پخش می‌کند؛ گیرنده قالب نهایی را تعیین می‌کند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay suoratoistaa 44,1 kHz:llä; vastaanotin määrää lopullisen muodon."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nag-i-stream ang AirPlay sa 44.1 kHz; ang receiver ang kumokontrol sa huling format."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay diffuse en 44,1 kHz ; le récepteur détermine le format final."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay 44.1 kHz પર સ્ટ્રીમ કરે છે; અંતિમ ફૉર્મેટ રિસીવર નક્કી કરે છે."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay yana yaɗa a 44.1 kHz; risiva ce ke sarrafa tsarin ƙarshe."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay משדר ב־44.1 kHz; המקלט קובע את הפורמט הסופי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay 44.1 kHz पर स्ट्रीम करता है; अंतिम फ़ॉर्मैट रिसीवर तय करता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az AirPlay 44,1 kHz-en streamel; a végső formátumot a vevő határozza meg."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay melakukan streaming pada 44,1 kHz; receiver menentukan format akhirnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay trasmette a 44,1 kHz; il ricevitore stabilisce il formato finale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlayは44.1 kHzでストリーミングされ、最終的なフォーマットはレシーバー側で決まります。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay 44.1 kHz ನಲ್ಲಿ ಸ್ಟ್ರೀಮ್ ಮಾಡುತ್ತದೆ; ಅಂತಿಮ ಫಾರ್ಮ್ಯಾಟ್ ಅನ್ನು ರಿಸೀವರ್ ನಿಯಂತ್ರಿಸುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay는 44.1 kHz로 스트리밍되며, 최종 포맷은 리시버가 결정합니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay 44.1 kHz-ൽ സ്ട്രീം ചെയ്യുന്നു; അന്തിമ ഫോർമാറ്റ് റിസീവർ നിയന്ത്രിക്കുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay 44.1 kHz वर स्ट्रीम करते; अंतिम फॉरमॅट रिसीव्हर ठरवतो."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay menstrim pada 44.1 kHz; penerima mengawal format akhir."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay strømmer ved 44,1 kHz; mottakeren bestemmer det endelige formatet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay streamt op 44,1 kHz; de ontvanger bepaalt het uiteindelijke formaat."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay 44.1 kHz ’ਤੇ ਸਟ੍ਰੀਮ ਕਰਦਾ ਹੈ; ਅੰਤਿਮ ਫ਼ਾਰਮੈਟ ਰਿਸੀਵਰ ਤੈਅ ਕਰਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay przesyła strumień w 44,1 kHz; ostateczny format określa odbiornik."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O AirPlay transmite em 44,1 kHz; o receptor controla o formato final."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O AirPlay transmite a 44,1 kHz; o recetor controla o formato final."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay transmite la 44,1 kHz; receptorul controlează formatul final."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay strömmar i 44,1 kHz; mottagaren bestämmer det slutliga formatet."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay hutiririsha kwa 44.1 kHz; resiva hudhibiti fomati ya mwisho."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay 44.1 kHz-இல் ஸ்ட்ரீம் செய்கிறது; இறுதி வடிவத்தை ரிசீவர் கட்டுப்படுத்தும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay 44.1 kHz వద్ద స్ట్రీమ్ చేస్తుంది; చివరి ఫార్మాట్‌ను రిసీవర్ నియంత్రిస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay สตรีมที่ 44.1 kHz เครื่องรับเป็นผู้ควบคุมรูปแบบสุดท้าย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay 44,1 kHz’de aktarır; son biçimi alıcı belirler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay передає потік на 44,1 kHz; остаточний формат визначає приймач."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay، 44.1 kHz پر اسٹریم کرتا ہے؛ حتمی فارمیٹ ریسیور طے کرتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay truyền ở 44,1 kHz; bộ thu quyết định định dạng cuối cùng."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay 以 44.1 kHz 串流；最終格式由接收裝置決定。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay 以 44.1 kHz 传输；最终格式由接收器决定。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay 以 44.1 kHz 串流；最終格式由接收端決定。"
          }
        }
      }
    },
    "AirPods Max take lossless 24-bit / 48 kHz over USB-C. Other rates are converted to 48 kHz; 48 kHz material plays bit-perfect. (macOS still lists them as Bluetooth; that's only the control link.)": {
      "extractionState": "manual",
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPods Max በUSB-C ኪሳራ አልባ 24-bit / 48 kHz ይቀበላሉ። ሌሎች ፍጥነቶች ወደ 48 kHz ይቀየራሉ፤ 48 kHz ይዘት ቢት-ፍጹም ሆኖ ይጫወታል። (macOS አሁንም እንደ Bluetooth ይዘረዝራቸዋል፤ ያ የመቆጣጠሪያ ግንኙነቱ ብቻ ነው።)"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تستقبل AirPods Max صوتًا بلا فقد بدقة 24 بت / 48 kHz عبر USB-C. تُحوَّل المعدلات الأخرى إلى 48 kHz؛ وتُشغَّل المواد بمعدل 48 kHz مطابقة للبتات. (لا يزال macOS يعرضها كجهاز Bluetooth؛ وهذا مجرد رابط التحكم.)"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPods Max USB-C-তে লসলেস 24-bit / 48 kHz নেয়। অন্য রেট 48 kHz-এ রূপান্তর করা হয়; 48 kHz-এর উপাদান বিট-পারফেক্ট চলে। (macOS এখনো এগুলোকে Bluetooth হিসেবে দেখায়; সেটি শুধু নিয়ন্ত্রণ লিংক।)"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPods Max přijímají přes USB-C bezeztrátový zvuk 24 bitů / 48 kHz. Ostatní frekvence se převádějí na 48 kHz; materiál 48 kHz hraje bit-perfect. (macOS je stále uvádí jako Bluetooth; to je jen řídicí spojení.)"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPods Max modtager tabsfri 24-bit / 48 kHz via USB-C. Andre frekvenser konverteres til 48 kHz; materiale i 48 kHz afspilles bitperfekt. (macOS viser dem stadig som Bluetooth; det er kun styreforbindelsen.)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPods Max empfangen verlustfrei 24 Bit / 48 kHz über USB-C. Andere Raten werden in 48 kHz konvertiert; 48-kHz-Material wird bit-perfekt abgespielt. (macOS führt sie weiterhin als Bluetooth; das ist nur die Steuerverbindung.)"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα AirPods Max δέχονται ήχο χωρίς απώλειες 24 bit / 48 kHz μέσω USB-C. Οι άλλοι ρυθμοί μετατρέπονται σε 48 kHz· το υλικό 48 kHz παίζει bit-perfect. (Το macOS εξακολουθεί να τα εμφανίζει ως Bluetooth· αυτή είναι μόνο η σύνδεση ελέγχου.)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPods Max take lossless 24-bit / 48 kHz over USB-C. Other rates are converted to 48 kHz; 48 kHz material plays bit-perfect. (macOS still lists them as Bluetooth; that's only the control link.)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los AirPods Max admiten audio sin pérdida de 24 bits / 48 kHz por USB-C. Las demás frecuencias se convierten a 48 kHz; el material a 48 kHz se reproduce bit-perfect. (macOS los sigue mostrando como Bluetooth; es solo el enlace de control.)"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPods Max از طریق USB-C صدای بی‌اتلاف ۲۴ بیتی / ۴۸ kHz دریافت می‌کند. نرخ‌های دیگر به ۴۸ kHz تبدیل می‌شوند؛ محتوای ۴۸ kHz بیت‌به‌بیت پخش می‌شود. (macOS همچنان آن را بلوتوث نشان می‌دهد؛ این فقط پیوند کنترلی است.)"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPods Max vastaanottaa häviötöntä 24-bit / 48 kHz -ääntä USB-C:n kautta. Muut taajuudet muunnetaan 48 kHz:iin; 48 kHz:n materiaali toistuu bittitarkasti. (macOS näyttää ne yhä Bluetooth-laitteina; se on vain ohjausyhteys.)"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Tumatanggap ang AirPods Max ng lossless na 24-bit / 48 kHz sa USB-C. Kino-convert sa 48 kHz ang ibang rate; nagpe-play nang bit-perfect ang 48 kHz na materyal. (Nakalista pa rin sila sa macOS bilang Bluetooth; iyon ay para lang sa control link.)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les AirPods Max acceptent le 24 bits / 48 kHz sans perte via USB-C. Les autres fréquences sont converties en 48 kHz ; les contenus en 48 kHz sont lus en bit-perfect. (macOS les affiche toujours comme Bluetooth ; il ne s’agit que du lien de commande.)"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPods Max USB-C પર લૉસલેસ 24-bit / 48 kHz લે છે. અન્ય રેટ 48 kHz માં રૂપાંતરિત થાય છે; 48 kHz સામગ્રી બિટ-પરફેક્ટ વાગે છે. (macOS હજી પણ તેમને Bluetooth તરીકે બતાવે છે; તે ફક્ત નિયંત્રણ લિંક છે.)"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPods Max suna karɓar bit 24 / 48 kHz marar asara ta USB-C. Ana canza sauran ƙimomi zuwa 48 kHz; kayan 48 kHz suna kunnawa bit-perfect. (macOS har yanzu yana jera su a matsayin Bluetooth; wannan hanyar sarrafawa ce kawai.)"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPods Max מקבלות שמע ללא איבוד נתונים ב־24 סיביות / 48 kHz דרך USB-C. קצבים אחרים מומרים ל־48 kHz; חומר ב־48 kHz מתנגן באופן מדויק לסיבית. (macOS עדיין מציג אותן כ־Bluetooth; זהו רק ערוץ הבקרה.)"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPods Max, USB-C पर लॉसलेस 24-bit / 48 kHz लेते हैं। दूसरे रेट 48 kHz में बदले जाते हैं; 48 kHz सामग्री बिट-परफ़ेक्ट चलती है। (macOS अब भी उन्हें Bluetooth के रूप में दिखाता है; वह केवल नियंत्रण लिंक है।)"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az AirPods Max USB-C-n keresztül veszteségmentes 24 bit / 48 kHz-es hangot fogad. A többi frekvencia 48 kHz-re alakul; a 48 kHz-es anyag bit-perfect módon szól. (A macOS továbbra is Bluetooth-eszközként listázza; ez csak a vezérlőkapcsolat.)"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPods Max menerima 24-bit / 48 kHz lossless melalui USB-C. Laju lain dikonversi ke 48 kHz; materi 48 kHz diputar secara bit-perfect. (macOS tetap mencantumkannya sebagai Bluetooth; itu hanya tautan kontrol.)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPods Max accettano audio lossless a 24 bit / 48 kHz tramite USB-C. Le altre frequenze vengono convertite a 48 kHz; il materiale a 48 kHz viene riprodotto in bit-perfect. (macOS li elenca comunque come Bluetooth; è solo il collegamento per i controlli.)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPods MaxはUSB-C経由でロスレスの24ビット / 48 kHzを受信します。ほかのレートは48 kHzに変換され、48 kHzの音源はビットパーフェクトで再生されます。（macOSでは引き続きBluetoothとして表示されますが、これは制御用の接続にすぎません。）"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPods Max USB-C ಮೂಲಕ ಲಾಸ್‌ಲೆಸ್ 24-bit / 48 kHz ಸ್ವೀಕರಿಸುತ್ತವೆ. ಇತರ ರೇಟ್‌ಗಳನ್ನು 48 kHz ಗೆ ಪರಿವರ್ತಿಸಲಾಗುತ್ತದೆ; 48 kHz ಸಾಮಗ್ರಿ ಬಿಟ್-ಪರ್ಫೆಕ್ಟ್ ಆಗಿ ಪ್ಲೇ ಆಗುತ್ತದೆ. (macOS ಈಗಲೂ ಅವುಗಳನ್ನು Bluetooth ಎಂದು ತೋರಿಸುತ್ತದೆ; ಅದು ಕೇವಲ ನಿಯಂತ್ರಣ ಲಿಂಕ್.)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPods Max는 USB-C를 통해 무손실 24비트 / 48 kHz를 수신합니다. 다른 레이트는 48 kHz로 변환되며, 48 kHz 음원은 비트 퍼펙트로 재생됩니다. (macOS에서는 여전히 Bluetooth로 표시되지만, 이는 제어용 연결일 뿐입니다.)"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPods Max USB-C വഴി ലോസ്‌ലെസ് 24-bit / 48 kHz സ്വീകരിക്കുന്നു. മറ്റ് റേറ്റുകൾ 48 kHz-ലേക്ക് പരിവർത്തനം ചെയ്യും; 48 kHz മെറ്റീരിയൽ ബിറ്റ്-പെർഫെക്റ്റായി പ്ലേ ചെയ്യും. (macOS ഇപ്പോഴും അവയെ Bluetooth ആയി കാണിക്കുന്നു; അത് നിയന്ത്രണ ലിങ്ക് മാത്രമാണ്.)"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPods Max USB-C वरून लॉसलेस 24-bit / 48 kHz घेतात. इतर रेट 48 kHz मध्ये रूपांतरित केले जातात; 48 kHz सामग्री बिट-परफेक्ट वाजते. (macOS तरीही त्यांना Bluetooth म्हणून दाखवते; ती फक्त नियंत्रण लिंक आहे.)"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPods Max menerima 24-bit / 48 kHz tanpa kehilangan melalui USB-C. Kadar lain ditukar kepada 48 kHz; bahan 48 kHz dimainkan secara bit-perfect. (macOS masih menyenaraikannya sebagai Bluetooth; itu hanya pautan kawalan.)"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPods Max tar imot tapsfri 24-bit / 48 kHz via USB-C. Andre frekvenser konverteres til 48 kHz; materiale i 48 kHz spilles bitperfekt. (macOS viser dem fortsatt som Bluetooth; det er bare kontrollforbindelsen.)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPods Max ontvangen lossless 24 bit / 48 kHz via USB-C. Andere frequenties worden omgezet naar 48 kHz; materiaal van 48 kHz speelt bitperfect af. (macOS toont ze nog steeds als Bluetooth; dat is alleen de bedieningsverbinding.)"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPods Max, USB-C ਰਾਹੀਂ ਲੌਸਲੈੱਸ 24-bit / 48 kHz ਲੈਂਦੇ ਹਨ। ਹੋਰ ਰੇਟ 48 kHz ਵਿੱਚ ਬਦਲੇ ਜਾਂਦੇ ਹਨ; 48 kHz ਸਮੱਗਰੀ ਬਿੱਟ-ਪਰਫ਼ੈਕਟ ਚੱਲਦੀ ਹੈ। (macOS ਹਾਲੇ ਵੀ ਇਹਨਾਂ ਨੂੰ Bluetooth ਵਜੋਂ ਦਿਖਾਉਂਦਾ ਹੈ; ਉਹ ਸਿਰਫ਼ ਕੰਟਰੋਲ ਲਿੰਕ ਹੈ।)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPods Max odbierają bezstratny dźwięk 24-bit / 48 kHz przez USB-C. Inne częstotliwości są konwertowane do 48 kHz; materiał 48 kHz gra bit-perfect. (macOS nadal pokazuje je jako Bluetooth; to tylko łącze sterujące)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os AirPods Max recebem áudio sem perdas de 24 bits / 48 kHz pelo USB-C. Outras taxas são convertidas para 48 kHz; material em 48 kHz toca em bit-perfect. (O macOS ainda os lista como Bluetooth; isso é só o link de controle.)"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os AirPods Max recebem áudio sem perdas a 24 bits / 48 kHz por USB-C. As outras taxas são convertidas para 48 kHz; o material a 48 kHz é reproduzido em bit-perfect. (O macOS continua a indicá-los como Bluetooth; é apenas a ligação de controlo.)"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPods Max primesc audio fără pierderi la 24 de biți / 48 kHz prin USB-C. Celelalte rate sunt convertite la 48 kHz; materialul la 48 kHz este redat bit-perfect. (macOS le afișează în continuare ca Bluetooth; aceasta este doar legătura de control.)"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPods Max tar emot förlustfritt 24 bitar/48 kHz via USB-C. Andra frekvenser konverteras till 48 kHz; material i 48 kHz spelas bitperfekt. (macOS listar dem fortfarande som Bluetooth; det är bara styrlänken.)"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPods Max hupokea biti 24 / 48 kHz bila upotevu kupitia USB-C. Viwango vingine hugeuzwa kuwa 48 kHz; nyenzo za 48 kHz hucheza bit-perfect. (macOS bado huziorodhesha kama Bluetooth; hiyo ni kiungo cha udhibiti tu.)"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPods Max, USB-C வழியாக இழப்பற்ற 24-bit / 48 kHz-ஐ ஏற்கும். பிற வீதங்கள் 48 kHz-க்கு மாற்றப்படும்; 48 kHz உள்ளடக்கம் பிட்-பெர்ஃபெக்டாக இயங்கும். (macOS இன்னும் அவற்றை Bluetooth எனக் காட்டும்; அது கட்டுப்பாட்டு இணைப்பு மட்டுமே.)"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPods Max USB-C ద్వారా లాస్‌లెస్ 24-bit / 48 kHzను తీసుకుంటాయి. ఇతర రేట్‌లు 48 kHzకి మార్చబడతాయి; 48 kHz మెటీరియల్ బిట్-పర్ఫెక్ట్‌గా ప్లే అవుతుంది. (macOS ఇప్పటికీ వాటిని Bluetoothగా చూపిస్తుంది; అది కేవలం కంట్రోల్ లింక్ మాత్రమే.)"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPods Max รับเสียงแบบไม่สูญเสียข้อมูล 24-bit / 48 kHz ผ่าน USB-C อัตราอื่นจะถูกแปลงเป็น 48 kHz ส่วนเนื้อหา 48 kHz จะเล่นแบบบิตเพอร์เฟกต์ (macOS ยังแสดงเป็น Bluetooth อยู่ แต่นั่นเป็นเพียงลิงก์ควบคุม)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPods Max, USB-C üzerinden kayıpsız 24 bit / 48 kHz alır. Diğer hızlar 48 kHz’e dönüştürülür; 48 kHz malzeme bit-perfect çalar. (macOS onları yine Bluetooth olarak listeler; bu yalnızca denetim bağlantısıdır.)"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPods Max приймають 24-бітний звук 48 kHz без втрат через USB-C. Інші частоти перетворюються на 48 kHz; матеріал 48 kHz відтворюється біт-у-біт. (macOS досі показує їх як Bluetooth — це лише канал керування.)"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPods Max، USB-C پر لاس لیس 24-bit / 48 kHz لیتے ہیں۔ دوسرے ریٹس 48 kHz میں تبدیل ہوتے ہیں؛ 48 kHz مواد بٹ پرفیکٹ چلتا ہے۔ (macOS انہیں اب بھی بلوٹوتھ دکھاتا ہے؛ یہ صرف کنٹرول لنک ہے۔)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPods Max nhận âm thanh không tổn hao 24 bit / 48 kHz qua USB-C. Các tần số khác được chuyển đổi sang 48 kHz; nội dung 48 kHz được phát bit-perfect. (macOS vẫn liệt kê chúng là Bluetooth; đó chỉ là liên kết điều khiển.)"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPods Max 經 USB-C 接收無損 24 位元／48 kHz 音訊。其他取樣率會轉換為 48 kHz；48 kHz 的內容以位元完美方式播放。（macOS 仍會將它們列為藍牙裝置；那只是控制連線。）"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPods Max 通过 USB-C 接收无损 24 位 / 48 kHz 音频。其他采样率会转换为 48 kHz；48 kHz 的内容以比特完美方式播放。（macOS 仍将其列为蓝牙设备，那只是控制连接。）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPods Max 透過 USB-C 接收無損 24 位元／48 kHz 音訊。其他取樣率會轉換為 48 kHz；48 kHz 的內容會以位元完美方式播放。（macOS 仍會將其列為藍牙裝置，那只是控制連線。）"
          }
        }
      }
    },

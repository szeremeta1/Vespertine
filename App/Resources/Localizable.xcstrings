            "state": "translated",
            "value": "ana aika Dolby da DTS bitstream ba tare da an taɓa su ba"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "זרמי ביטים של Dolby ו-DTS נשלחים ללא שינוי"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",

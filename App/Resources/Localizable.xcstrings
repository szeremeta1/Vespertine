          "stringUnit": {
            "state": "translated",
            "value": "A gravação perdeu %@ quadros, então não pode ser usada."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A gravação perdeu %@ tramas, por isso não pode ser usada."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Înregistrarea a pierdut %@ cadre, deci nu poate fi folosită."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspelningen tappade %@ ramar och kan därför inte användas."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekodi ilipoteza fremu %@, kwa hivyo haiwezi kutumika."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பதிவில் %@ ஃப்ரேம்கள் தவறிவிட்டன, எனவே அதைப் பயன்படுத்த முடியாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "రికార్డింగ్ %@ ఫ్రేమ్‌లను కోల్పోయింది, కాబట్టి దాన్ని ఉపయోగించలేము."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การบันทึกสูญเสีย %@ เฟรม จึงใช้ไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıtta %@ kare kayboldu, bu yüzden kullanılamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У записі втрачено кадрів: %@, тому його не можна використати."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ریکارڈنگ کے %@ فریم ضائع ہو گئے، اس لیے اسے استعمال نہیں کیا جا سکتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản ghi bị mất %@ khung nên không dùng được."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "錄音遺失了 %@ 幀，因此無法使用。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音丢失了 %@ 帧，因此无法使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "錄音遺失了 %@ 幀，因此無法使用。"
          }
        }
      }
    },
    "The recording name may only use letters, digits, dots, dashes and underscores.": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "የቀረጻው ስም ፊደላትን፣ አሃዞችን፣ ነጥቦችን፣ ሰረዞችን እና ከስር ምልክቶችን ብቻ ሊጠቀም ይችላል።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن أن يستخدم اسم التسجيل الأحرف والأرقام والنقاط والشرطات والشرطات السفلية فقط."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রেকর্ডিংয়ের নামে শুধু অক্ষর, সংখ্যা, ডট, ড্যাশ ও আন্ডারস্কোর ব্যবহার করা যাবে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Název nahrávky smí obsahovat jen písmena, číslice, tečky, pomlčky a podtržítka."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Optagelsens navn må kun bruge bogstaver, cifre, punktummer, bindestreger og understregninger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Aufnahmename darf nur Buchstaben, Ziffern, Punkte, Bindestriche und Unterstriche enthalten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το όνομα της εγγραφής μπορεί να χρησιμοποιεί μόνο γράμματα, ψηφία, τελείες, παύλες και κάτω παύλες."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nombre de la grabación solo puede usar letras, dígitos, puntos, guiones y guiones bajos."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نام ضبط فقط می‌تواند از حروف، ارقام، نقطه، خط تیره و زیرخط استفاده کند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallenteen nimessä saa käyttää vain kirjaimia, numeroita, pisteitä, yhdysviivoja ja alaviivoja."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Titik, digit, tuldok, gitling at underscore lang ang puwedeng gamitin sa pangalan ng recording."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nom de l'enregistrement ne peut contenir que des lettres, des chiffres, des points, des tirets et des tirets bas."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "રેકોર્ડિંગના નામમાં ફક્ત અક્ષરો, અંકો, ટપકાં, ડેશ અને અંડરસ્કોર વાપરી શકાય."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunan rikodin zai iya amfani da haruffa, lambobi, digo, ɗan layi da ƙasan layi kawai."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שם ההקלטה יכול להכיל רק אותיות, ספרות, נקודות, מקפים וקווים תחתונים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिकॉर्डिंग के नाम में केवल अक्षर, अंक, बिंदु, डैश और अंडरस्कोर हो सकते हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A felvétel neve csak betűket, számjegyeket, pontokat, kötőjeleket és aláhúzásokat tartalmazhat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nama rekaman hanya boleh berisi huruf, angka, titik, tanda hubung, dan garis bawah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il nome della registrazione può contenere solo lettere, cifre, punti, trattini e trattini bassi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音の名前には、英数字、ピリオド、ハイフン、アンダースコアのみ使えます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ರೆಕಾರ್ಡಿಂಗ್ ಹೆಸರಿನಲ್ಲಿ ಅಕ್ಷರಗಳು, ಅಂಕೆಗಳು, ಚುಕ್ಕೆಗಳು, ಡ್ಯಾಶ್‌ಗಳು ಮತ್ತು ಅಂಡರ್‌ಸ್ಕೋರ್‌ಗಳನ್ನು ಮಾತ್ರ ಬಳಸಬಹುದು."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음 이름에는 문자, 숫자, 마침표, 하이픈, 밑줄만 사용할 수 있습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "റെക്കോർഡിംഗ് പേരിൽ അക്ഷരങ്ങൾ, അക്കങ്ങൾ, ഡോട്ടുകൾ, ഡാഷുകൾ, അണ്ടർസ്കോറുകൾ എന്നിവ മാത്രമേ ഉപയോഗിക്കാവൂ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "रेकॉर्डिंगच्या नावात फक्त अक्षरे, अंक, ठिपके, डॅश आणि अंडरस्कोर वापरता येतात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nama rakaman hanya boleh menggunakan huruf, digit, titik, sengkang dan garis bawah."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Opptaksnavnet kan bare bruke bokstaver, sifre, punktum, bindestreker og understreker."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De opnaamnaam mag alleen letters, cijfers, punten, streepjes en underscores bevatten."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਰਿਕਾਰਡਿੰਗ ਦੇ ਨਾਮ ਵਿੱਚ ਸਿਰਫ਼ ਅੱਖਰ, ਅੰਕ, ਬਿੰਦੀਆਂ, ਡੈਸ਼ ਅਤੇ ਅੰਡਰਸਕੋਰ ਵਰਤੇ ਜਾ ਸਕਦੇ ਹਨ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nazwa nagrania może zawierać tylko litery, cyfry, kropki, myślniki i podkreślenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O nome da gravação só pode usar letras, dígitos, pontos, hífens e sublinhados."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O nome da gravação só pode usar letras, dígitos, pontos, hífenes e sublinhados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Numele înregistrării poate folosi doar litere, cifre, puncte, cratime și liniuțe de subliniere."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspelningens namn får bara innehålla bokstäver, siffror, punkter, bindestreck och understreck."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Jina la rekodi linaweza kutumia herufi, tarakimu, vitone, vistari na mistari chini pekee."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பதிவின் பெயரில் எழுத்துகள், இலக்கங்கள், புள்ளிகள், கோடுகள் மற்றும் அடிக்கோடுகள் மட்டுமே பயன்படுத்தலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "రికార్డింగ్ పేరులో అక్షరాలు, అంకెలు, చుక్కలు, డ్యాష్‌లు మరియు అండర్‌స్కోర్‌లు మాత్రమే ఉపయోగించవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชื่อการบันทึกใช้ได้เฉพาะตัวอักษร ตัวเลข จุด ขีดกลาง และขีดล่างเท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıt adında yalnızca harf, rakam, nokta, tire ve alt çizgi kullanılabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Назва запису може містити лише літери, цифри, крапки, дефіси та підкреслення."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ریکارڈنگ کے نام میں صرف حروف، ہندسے، نقطے، ڈیش اور انڈر اسکور استعمال ہو سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tên bản ghi chỉ được dùng chữ cái, chữ số, dấu chấm, dấu gạch ngang và dấu gạch dưới."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "錄音名稱只能使用字母、數字、點、連字號和底線。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音名称只能使用字母、数字、点、连字符和下划线。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "錄音名稱只能使用字母、數字、點、連字號和底線。"
          }
        }
      }
    },
    "The room was too noisy: the sweep stood only %@ dB over the noise.": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ክፍሉ በጣም ጫጫታ ነበረው፦ ጠረጋው ከጫጫታው በ%@ dB ብቻ ከፍ ብሎ ነበር።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كانت الغرفة صاخبة جدًا: ارتفع المسح بمقدار %@ dB فقط فوق الضوضاء."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ঘরটি খুব কোলাহলপূর্ণ ছিল: সুইপ গোলমালের চেয়ে মাত্র %@ dB বেশি ছিল।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Místnost byla příliš hlučná: sweep převyšoval hluk jen o %@ dB."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Rummet var for støjfyldt: sweepet lå kun %@ dB over støjen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Raum war zu laut: Der Sweep lag nur %@ dB über dem Rauschen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το δωμάτιο ήταν πολύ θορυβώδες: η σάρωση ξεπερνούσε τον θόρυβο μόλις κατά %@ dB."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sala tenía demasiado ruido: el barrido superaba el ruido en solo %@ dB."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اتاق بیش از حد پر سروصدا بود: سوییپ فقط %@ dB بالاتر از نویز بود."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Huone oli liian meluisa: pyyhkäisy oli vain %@ dB melun yläpuolella."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Masyadong maingay ang kuwarto: %@ dB lang ang taas ng sweep sa ingay."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La pièce était trop bruyante : le balayage ne dépassait le bruit que de %@ dB."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "રૂમ ખૂબ ઘોંઘાટવાળો હતો: સ્વીપ ઘોંઘાટ કરતાં માત્ર %@ dB ઊંચો હતો."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ɗakin ya yi hayaniya da yawa: sweep ya fi hayaniyar da %@ dB kawai."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החדר היה רועש מדי: הסוויפ עלה על הרעש ב-%@ dB בלבד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कमरे में बहुत शोर था: स्वीप शोर से केवल %@ dB ऊपर था।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szoba túl zajos volt: a sweep csak %@ dB-lel volt a zaj felett."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruangan terlalu bising: sweep hanya %@ dB di atas kebisingan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La stanza era troppo rumorosa: lo sweep superava il rumore di soli %@ dB."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "部屋の騒音が大きすぎました。スイープが騒音より %@ dB しか高くありませんでした。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಕೋಣೆ ತುಂಬಾ ಗದ್ದಲದಿಂದ ಕೂಡಿತ್ತು: ಸ್ವೀಪ್ ಶಬ್ದಕ್ಕಿಂತ ಕೇವಲ %@ dB ಮೇಲಿತ್ತು."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "방이 너무 시끄러웠습니다. 스윕이 소음보다 %@ dB밖에 높지 않았습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മുറി വളരെ ശബ്ദമയമായിരുന്നു: സ്വീപ്പ് ശബ്ദത്തിനേക്കാൾ %@ dB മാത്രമേ ഉയർന്നിരുന്നുള്ളൂ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "खोलीत खूप गोंगाट होता: स्वीप आवाजापेक्षा फक्त %@ dB वर होता."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilik terlalu bising: sapuan hanya %@ dB di atas hingar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Rommet var for støyende: sweepen lå bare %@ dB over støyen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De ruimte was te rumoerig: de sweep lag slechts %@ dB boven het geluid."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕਮਰੇ ਵਿੱਚ ਬਹੁਤ ਸ਼ੋਰ ਸੀ: ਸਵੀਪ ਸ਼ੋਰ ਨਾਲੋਂ ਸਿਰਫ਼ %@ dB ਉੱਪਰ ਸੀ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W pomieszczeniu było zbyt głośno: sweep przewyższał szum tylko o %@ dB."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A sala estava barulhenta demais: a varredura ficou só %@ dB acima do ruído."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A sala estava demasiado ruidosa: o varrimento ficou apenas %@ dB acima do ruído."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera a fost prea zgomotoasă: baleiajul a depășit zgomotul doar cu %@ dB."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rummet var för bullrigt: sweepen låg bara %@ dB över bruset."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Chumba kilikuwa na kelele nyingi: sweep ilizidi kelele kwa %@ dB tu."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அறையில் அதிக இரைச்சல் இருந்தது: ஸ்வீப் இரைச்சலை விட %@ dB மட்டுமே அதிகமாக இருந்தது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "గదిలో చాలా శబ్దం ఉంది: స్వీప్ శబ్దం కంటే కేవలం %@ dB పైన ఉంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ห้องมีเสียงรบกวนมากเกินไป สวีปสูงกว่าเสียงรบกวนเพียง %@ dB"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oda çok gürültülüydü: tarama gürültünün yalnızca %@ dB üzerindeydi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У кімнаті було надто шумно: свіп перевищував шум лише на %@ дБ."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کمرے میں بہت شور تھا: سویپ شور سے صرف %@ dB اوپر تھا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phòng quá ồn: tiếng quét chỉ cao hơn tiếng ồn %@ dB."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "房間噪音太大：掃頻訊號僅比噪音高 %@ dB。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "房间噪声太大：扫频信号仅比噪声高 %@ dB。"

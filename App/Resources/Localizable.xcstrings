        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "DoP માટે અનન્ય, બિટ-ટ્રાન્સપરન્ટ આઉટપુટ જરૂરી છે"
          }
        },
        "ha": {
          "stringUnit": {

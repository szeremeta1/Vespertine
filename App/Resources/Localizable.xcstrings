        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বিনামূল্যে ও ওপেন সোর্স। এক মিনিটের সেটআপ, তারপরই শোনা শুরু।"
          }
        },
        "cs": {

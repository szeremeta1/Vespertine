            }
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld-bit फाइल, पण फक्त %lld बिटमध्ये ऑडिओ आहे (शून्य-पॅड केलेले)."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Fail %lld-bit, tetapi hanya %lld bit membawa audio (dipad sifar)."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld-bit-fil, men bare %lld bit inneholder lyd (nullutfylt)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld-bits bestand, maar slechts %lld bits bevatten audio (met nullen opgevuld)."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld-bit ਫ਼ਾਈਲ, ਪਰ ਸਿਰਫ਼ %2$lld ਬਿੱਟਾਂ ਵਿੱਚ ਆਡੀਓ ਹੈ (ਜ਼ੀਰੋ-ਪੈਡ ਕੀਤਾ)।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",

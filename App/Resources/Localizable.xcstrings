    "Between ~%@ and ~%@ kHz, a narrow band of quieter content that follows the music, as a lossy encoder's low-pass transition leaves.": {
      "extractionState": "manual",
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "በ~%1$@ እና በ~%2$@ kHz መካከል፣ ሙዚቃውን የሚከተል ጠባብ የዝቅተኛ ድምፅ ይዘት ባንድ፣ የኪሳራ ያለው ኢንኮደር low-pass ሽግግር እንደሚተወው።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بين ~%1$@ و ~%2$@ kHz، نطاق ضيق من محتوى أهدأ يتبع الموسيقى، كما تتركه منطقة انتقال مرشح التمرير المنخفض في المرمّز مع فقد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "~%1$@ ও ~%2$@ kHz-এর মধ্যে মৃদু বিষয়বস্তুর একটি সরু ব্যান্ড যা মিউজিককে অনুসরণ করে, যেমনটা লসি এনকোডারের লো-পাস ট্রানজিশন রেখে যায়।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mezi ~%@ a ~%@ kHz úzké pásmo tiššího obsahu, které sleduje hudbu, jaké zanechává přechodové pásmo dolní propusti ztrátového kodéru."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mellem ~%@ og ~%@ kHz et smalt bånd af svagere indhold, der følger musikken, som en tabsgivende koders lavpasovergang efterlader."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwischen ~%@ und ~%@ kHz ein schmales Band leiseren Inhalts, der der Musik folgt, wie ihn der Tiefpassübergang eines verlustbehafteten Encoders hinterlässt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μεταξύ ~%1$@ και ~%2$@ kHz, μια στενή ζώνη πιο ήσυχου περιεχομένου που ακολουθεί τη μουσική, όπως αφήνει η μετάβαση low-pass ενός κωδικοποιητή με απώλειες."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Between ~%@ and ~%@ kHz, a narrow band of quieter content that follows the music, as a lossy encoder's low-pass transition leaves."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entre ~%@ y ~%@ kHz, una banda estrecha de contenido más débil que sigue a la música, como la que deja la transición del filtro paso bajo de un codificador con pérdida."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بین حدود %@ و %@ kHz، باریکه‌ای از محتوای آرام‌تر که از موسیقی پیروی می‌کند، همان ردی که گذار پایین‌گذر یک رمزگذار بااتلاف به جا می‌گذارد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Noin %@–%@ kHz:n välillä kapea kaista hiljaisempaa sisältöä, joka seuraa musiikkia, kuten häviöllisen kooderin alipäästösiirtymä jättää."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa pagitan ng ~%@ at ~%@ kHz, isang makitid na band ng mas mahinang content na sumusunod sa musika, gaya ng iniiwan ng low-pass transition ng lossy na encoder."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Entre ~%@ et ~%@ kHz, une bande étroite de contenu plus faible qui suit la musique, comme celle que laisse la transition passe-bas d’un encodeur avec perte."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "~%@ અને ~%@ kHz વચ્ચે, સંગીતને અનુસરતી ધીમી સામગ્રીનો એક સાંકડો બૅન્ડ, જેવો લૉસી એન્કોડરનું લો-પાસ ટ્રાન્ઝિશન છોડી જાય છે."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Tsakanin ~%@ da ~%@ kHz, ƙunƙuntaccen zango na abun ciki mafi shiru wanda ke bin waƙar, kamar yadda sauyin low-pass na encoder mai asara ke barin."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בין כ־%1$@ לכ־%2$@ kHz, פס צר של תוכן שקט יותר העוקב אחר המוזיקה, כפי שמשאיר אזור המעבר של מסנן מעביר־נמוכים במקודד מאבד נתונים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "~%1$@ और ~%2$@ kHz के बीच, धीमी सामग्री का एक संकरा बैंड जो संगीत का अनुसरण करता है, जैसा लॉसी एन्कोडर का लो-पास ट्रांज़िशन छोड़ता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "~%@ és ~%@ kHz között a zenét követő halkabb tartalom keskeny sávja, amilyet egy veszteséges kódoló aluláteresztő átmenete hagy."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Antara ~%@ dan ~%@ kHz, pita sempit berisi konten lebih pelan yang mengikuti musik, seperti jejak transisi low-pass encoder lossy."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tra ~%@ e ~%@ kHz, una banda stretta di contenuto più debole che segue la musica, come quella lasciata dalla transizione passa-basso di un encoder lossy."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "約%@〜約%@ kHzの間に、音楽に追従する小さめの成分の狭い帯域があります。ロッシーエンコーダのローパスの遷移帯域がこうした跡を残します。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "~%1$@ ಮತ್ತು ~%2$@ kHz ನಡುವೆ, ಸಂಗೀತವನ್ನು ಅನುಸರಿಸುವ ಮಂದವಾದ ವಿಷಯದ ಕಿರಿದಾದ ಬ್ಯಾಂಡ್, ಲಾಸಿ ಎನ್‌ಕೋಡರ್‌ನ ಲೋ-ಪಾಸ್ ಪರಿವರ್ತನೆ ಬಿಡುವಂತೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "약 %@ kHz에서 약 %@ kHz 사이에 음악을 따르는 더 작은 성분의 좁은 대역이 있습니다. 손실 인코더의 로우패스 전이 구간이 이런 흔적을 남깁니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "~%1$@ മുതൽ ~%2$@ kHz വരെ, സംഗീതത്തെ പിന്തുടരുന്ന താരതമ്യേന നിശ്ശബ്ദമായ ഉള്ളടക്കത്തിന്റെ ഇടുങ്ങിയ ബാൻഡ്, ഒരു ലോസി എൻകോഡറിന്റെ ലോ-പാസ് ട്രാൻസിഷൻ അവശേഷിപ്പിക്കുന്നതുപോലെ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "~%@ आणि ~%@ kHz दरम्यान, संगीताचे अनुसरण करणारा कमी आवाजाच्या सामग्रीचा एक अरुंद बँड, जसा लॉसी एन्कोडरचे लो-पास संक्रमण मागे सोडते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Antara ~%@ dan ~%@ kHz, jalur sempit kandungan yang lebih perlahan yang mengikut muzik, seperti kesan peralihan laluan rendah pengekod berkehilangan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Mellom ~%@ og ~%@ kHz et smalt bånd med svakere innhold som følger musikken, slik lavpassovergangen til en tapsbasert koder etterlater."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tussen ~%@ en ~%@ kHz een smalle band met zachtere inhoud die de muziek volgt, zoals de laagdoorlaatovergang van een lossy encoder achterlaat."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "~%1$@ ਅਤੇ ~%2$@ kHz ਦੇ ਵਿਚਕਾਰ, ਧੀਮੀ ਸਮੱਗਰੀ ਦਾ ਇੱਕ ਤੰਗ ਬੈਂਡ ਜੋ ਸੰਗੀਤ ਦੇ ਨਾਲ ਬਦਲਦਾ ਹੈ, ਜਿਵੇਂ ਲੌਸੀ ਐਨਕੋਡਰ ਦਾ ਲੋ-ਪਾਸ ਬਦਲਾਅ ਛੱਡ ਜਾਂਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Między ~%@ a ~%@ kHz wąskie pasmo cichszej treści, która podąża za muzyką, jak pozostawia przejście filtra dolnoprzepustowego kodera stratnego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Entre ~%@ e ~%@ kHz, uma faixa estreita de conteúdo mais baixo que acompanha a música, como a que deixa a transição do filtro passa-baixa de um codificador com perdas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Entre ~%@ e ~%@ kHz, uma banda estreita de conteúdo mais baixo que acompanha a música, como deixa a transição do filtro passa-baixo de um codificador com perdas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Între ~%@ și ~%@ kHz, o bandă îngustă de conținut mai încet care urmează muzica, așa cum lasă tranziția filtrului trece-jos al unui codificator cu pierderi."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mellan ~%@ och ~%@ kHz finns ett smalt band av svagare innehåll som följer musiken, som en förlustkodares lågpassövergång lämnar efter sig."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kati ya ~%@ na ~%@ kHz, bendi finyu ya maudhui ya sauti ndogo zaidi inayofuata muziki, kama mpito wa low-pass wa kisimbaji chenye upotevu unavyoacha."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "~%1$@ மற்றும் ~%2$@ kHz இடையே, இசையைப் பின்தொடரும் அமைதியான உள்ளடக்கத்தின் குறுகிய பேண்ட், இழப்புள்ள என்கோடரின் லோ-பாஸ் மாற்றம் விட்டுச்செல்வதுபோல."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "~%1$@ మరియు ~%2$@ kHz మధ్య, సంగీతాన్ని అనుసరించే నిశ్శబ్దమైన కంటెంట్ యొక్క ఇరుకైన బ్యాండ్, లాసీ ఎన్‌కోడర్ లో-పాస్ ట్రాన్సిషన్ వదిలే విధంగా."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระหว่างประมาณ %@ ถึง %@ kHz มีแถบแคบของเนื้อหาที่เบากว่าซึ่งเปลี่ยนตามเพลง ดังที่ช่วงเปลี่ยนผ่านโลว์พาสของตัวเข้ารหัสแบบสูญเสียข้อมูลทิ้งไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "~%1$@ ile ~%2$@ kHz arasında, müziği izleyen dar bir sessiz içerik bandı; kayıplı bir kodlayıcının alçak geçiren geçişi böyle bir iz bırakır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Між ~%@ і ~%@ kHz — вузька смуга тихішого вмісту, що змінюється разом із музикою: такий слід залишає перехідна смуга фільтра низьких частот у кодері із втратами."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تقریباً %@ اور %@ kHz کے درمیان، دھیمے مواد کی ایک تنگ پٹی جو موسیقی کی پیروی کرتی ہے، جیسا کہ لاسی انکوڈر کے لو پاس ٹرانزیشن سے بنتی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Từ ~%@ đến ~%@ kHz, một dải hẹp nội dung nhỏ hơn theo nhạc, như dấu vết vùng chuyển tiếp thông thấp của bộ mã hóa có tổn hao."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "在約 %@ 至約 %@ kHz 之間，有一條跟隨音樂的較安靜窄頻帶，這是有損編碼器低通過渡區留下的痕跡。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在约 %@ 到约 %@ kHz 之间，有一段随音乐变化的较安静的窄频带内容，这是有损编码器的低通过渡带留下的特征。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在約 %@ 到約 %@ kHz 之間，有一段隨音樂變化、較安靜的窄頻帶內容，這是有損編碼器的低通過渡帶留下的特徵。"
          }
        }
      }
    },

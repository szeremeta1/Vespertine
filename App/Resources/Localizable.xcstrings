    "Correct tags and fetch cover art from the open music database": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "መለያዎችን አስተካክልና የሽፋን ምስሎችን ከክፍት የሙዚቃ ውሂብ ጎታ አምጣ"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تصحيح العلامات وجلب صور الغلاف من قاعدة بيانات الموسيقى المفتوحة"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "উন্মুক্ত মিউজিক ডেটাবেস থেকে ট্যাগ সংশোধন করুন ও কভার আর্ট আনুন"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Opravte tagy a stáhněte obaly z otevřené hudební databáze"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ret mærker, og hent omslag fra den åbne musikdatabase"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tags korrigieren und Cover aus der offenen Musikdatenbank laden"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διόρθωση ετικετών και λήψη εξωφύλλων από την ανοιχτή βάση δεδομένων μουσικής"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Corregir etiquetas y obtener portadas de la base de datos musical abierta"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اصلاح برچسب‌ها و دریافت تصویر جلد از پایگاه دادهٔ آزاد موسیقی"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Korjaa tagit ja hae kansikuvat avoimesta musiikkitietokannasta"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Itama ang mga tag at kumuha ng cover art mula sa bukas na music database"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Corriger les tags et récupérer la pochette depuis la base de données musicale ouverte"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "મુક્ત સંગીત ડેટાબેસમાંથી ટૅગ સુધારો અને કવર આર્ટ મેળવો"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Gyara alamomi kuma samo hotunan bango daga buɗaɗɗen rumbun bayanan waƙoƙi"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תקן תגיות והבא תמונות עטיפה ממסד נתוני המוזיקה הפתוח"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ओपन म्यूज़िक डेटाबेस से टैग सुधारें और कवर आर्ट प्राप्त करें"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Címkék javítása és borítók letöltése a nyílt zenei adatbázisból"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Koreksi tag dan ambil sampul dari database musik terbuka"
          }
        },

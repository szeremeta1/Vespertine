    "%@, through %@ on %@. Checks Vespertine's software, not this device.": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "%@፣ በ%@ በኩል (%@)። የሚፈትሸው የVespertineን ሶፍትዌር ነው እንጂ ይህን መሣሪያ አይደለም።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@، عبر %@ في %@. يفحص برنامج Vespertine، لا هذا الجهاز."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, %@-এর মাধ্যমে (%@)। এটি Vespertine-এর সফটওয়্যার পরীক্ষা করে, এই ডিভাইস নয়।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, přes %@ (%@). Kontroluje software Vespertine, ne toto zařízení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, gennem %@ den %@. Kontrollerer Vespertines software, ikke denne enhed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, über %@ am %@. Prüft die Software von Vespertine, nicht dieses Gerät."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, μέσω %@ στις %@. Ελέγχει το λογισμικό του Vespertine, όχι αυτή τη συσκευή."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, a través de %@ el %@. Comprueba el software de Vespertine, no este dispositivo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@، از طریق %@ در %@. نرم‌افزار Vespertine را بررسی می‌کند، نه این دستگاه را."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, laitteen %@ kautta (%@). Tarkistaa Vespertinen ohjelmiston, ei tätä laitetta."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, sa pamamagitan ng %@ noong %@. Sinusuri ang software ng Vespertine, hindi ang device na ito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, via %@ le %@. Vérifie le logiciel de Vespertine, pas cet appareil."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, %@ દ્વારા (%@). આ Vespertine ના સૉફ્ટવેરને તપાસે છે, આ ડિવાઇસને નહીં."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, ta %@ a ranar %@. Yana duba manhajar Vespertine, ba wannan na'urar ba."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, דרך %@ ב־%@. בודק את התוכנה של Vespertine, לא את ההתקן הזה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, %@ के ज़रिए (%@)। यह Vespertine के सॉफ़्टवेयर की जाँच करता है, इस डिवाइस की नहीं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, ezen keresztül: %@ (%@). A Vespertine szoftverét ellenőrzi, nem ezt az eszközt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, melalui %@ pada %@. Memeriksa perangkat lunak Vespertine, bukan perangkat ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, attraverso %@ il %@. Verifica il software di Vespertine, non questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@（%@経由、%@）。このデバイスではなく、Vespertineのソフトウェアをチェックしています。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, %@ ಮೂಲಕ (%@). ಇದು ಈ ಸಾಧನವನ್ನಲ್ಲ, Vespertine ನ ಸಾಫ್ಟ್‌ವೇರ್ ಅನ್ನು ಪರಿಶೀಲಿಸುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, %@ 경유(%@). 이 기기가 아닌 Vespertine 소프트웨어를 검사합니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, %@ വഴി (%@). ഇത് ഈ ഉപകരണമല്ല, Vespertine-ന്റെ സോഫ്റ്റ്‌വെയറാണ് പരിശോധിക്കുന്നത്."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, %@ द्वारे (%@). हे Vespertine चे सॉफ्टवेअर तपासते, हे डिव्हाइस नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, melalui %@ pada %@. Menyemak perisian Vespertine, bukan peranti ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, gjennom %@ den %@. Kontrollerer Vespertines programvare, ikke denne enheten."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, via %@ op %@. Controleert de software van Vespertine, niet dit apparaat."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, %@ ਰਾਹੀਂ (%@)। ਇਹ Vespertine ਦੇ ਸਾਫ਼ਟਵੇਅਰ ਦੀ ਜਾਂਚ ਕਰਦਾ ਹੈ, ਇਸ ਡਿਵਾਈਸ ਦੀ ਨਹੀਂ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, przez %@ (%@). Sprawdza oprogramowanie Vespertine, nie to urządzenie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, por %@ em %@. Verifica o software do Vespertine, não este dispositivo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, através de %@ em %@. Verifica o software do Vespertine, não este dispositivo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, prin %@ pe %@. Verifică software-ul Vespertine, nu acest dispozitiv."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, via %@ den %@. Kontrollerar Vespertines programvara, inte den här enheten."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, kupitia %@ tarehe %@. Hukagua programu ya Vespertine, si kifaa hiki."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, %@ வழியாக (%@). இது இந்தச் சாதனத்தை அல்ல, Vespertine-இன் மென்பொருளைச் சரிபார்க்கிறது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, %@ ద్వారా (%@). ఇది ఈ పరికరాన్ని కాదు, Vespertine సాఫ్ట్‌వేర్‌ను తనిఖీ చేస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ผ่าน %@ (%@) เป็นการตรวจสอบซอฟต์แวร์ของ Vespertine ไม่ใช่อุปกรณ์นี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %3$@ tarihinde %2$@ üzerinden. Vespertine’in yazılımını denetler, bu aygıtı değil."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, через %@ (%@). Перевіряє програмне забезпечення Vespertine, а не цей пристрій."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%@، %@ کے ذریعے، %@ کو۔ Vespertine کے سافٹ ویئر کی جانچ کرتا ہے، اس ڈیوائس کی نہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, qua %@ vào %@. Kiểm tra phần mềm của Vespertine, không phải thiết bị này."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@，經 %2$@，%3$@。檢查的是 Vespertine 的軟件，而非此裝置。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@，经由 %2$@，%3$@。检查的是 Vespertine 的软件，而非此设备。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@，經由 %2$@，%3$@。檢查的是 Vespertine 的軟體，而非此裝置。"
          }
        }
      }
    },

          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta imagem SACD não tem nenhuma área de áudio que o Vespertine possa reproduzir."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta imagem SACD não tem nenhuma área de áudio que o Vespertine possa reproduzir."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Această imagine SACD nu are nicio zonă audio pe care Vespertine să o poată reda."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "SACD-avbilden har inget ljudområde som Vespertine kan spela."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Nakala hii ya SACD haina eneo la sauti ambalo Vespertine inaweza kucheza."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த SACD இமேஜில் Vespertine இயக்கக்கூடிய ஆடியோ பகுதி இல்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ SACD ఇమేజ్‌లో Vespertine ప్లే చేయగల ఆడియో ఏరియా లేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อิมเมจ SACD นี้ไม่มีพื้นที่เสียงที่ Vespertine เล่นได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu SACD görüntüsünde Vespertine’in çalabileceği bir ses alanı yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей образ SACD не має аудіообласті, яку може відтворити Vespertine."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس SACD امیج میں کوئی ایسا آڈیو حصہ نہیں جسے Vespertine چلا سکے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ảnh đĩa SACD này không có vùng âm thanh nào mà Vespertine có thể phát."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "此 SACD 映像沒有 Vespertine 可播放的音訊區。"
          }
        },
        "zh-Hans": {
          "stringUnit": {

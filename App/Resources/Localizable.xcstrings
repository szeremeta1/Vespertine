    "Tag edits are written to the files on the server.": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "የመለያ ማስተካከያዎች በአገልጋዩ ላይ ባሉ ፋይሎች ላይ ይጻፋሉ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُكتب تعديلات العلامات في الملفات على الخادم."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ট্যাগ সম্পাদনা সার্ভারের ফাইলগুলোতে লেখা হয়।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Úpravy tagů se zapisují do souborů na serveru."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mærkeændringer skrives til filerne på serveren."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tag-Änderungen werden in die Dateien auf dem Server geschrieben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι αλλαγές ετικετών γράφονται στα αρχεία στον διακομιστή."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las ediciones de etiquetas se escriben en los archivos del servidor."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ویرایش‌های برچسب در فایل‌های روی سرور نوشته می‌شوند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tagien muutokset kirjoitetaan palvelimen tiedostoihin."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Isinusulat sa mga file sa server ang mga pag-edit ng tag."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modifications de tags sont écrites dans les fichiers du serveur."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ટૅગ સંપાદનો સર્વર પરની ફાઇલોમાં લખાય છે."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ana rubuta gyaran alamomi a cikin fayilolin da ke kan sabar."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עריכות תגיות נכתבות לקבצים בשרת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टैग संपादन सर्वर पर मौजूद फ़ाइलों में लिखे जाते हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A címkeszerkesztések a szerveren lévő fájlokba íródnak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengeditan tag ditulis ke file di server."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modifiche ai tag vengono scritte nei file sul server."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タグの編集はサーバ上のファイルに書き込まれます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಟ್ಯಾಗ್ ಎಡಿಟ್‌ಗಳನ್ನು ಸರ್ವರ್‌ನಲ್ಲಿನ ಫೈಲ್‌ಗಳಿಗೆ ಬರೆಯಲಾಗುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "태그 편집 내용은 서버의 파일에 기록됩니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ടാഗ് എഡിറ്റുകൾ സെർവറിലെ ഫയലുകളിലേക്ക് എഴുതും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "टॅग संपादने सर्व्हरवरील फाइल्समध्ये लिहिली जातात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Suntingan tag ditulis ke fail pada pelayan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Taggendringer skrives til filene på tjeneren."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tagwijzigingen worden naar de bestanden op de server geschreven."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਟੈਗ ਸੋਧਾਂ ਸਰਵਰ ’ਤੇ ਮੌਜੂਦ ਫ਼ਾਈਲਾਂ ਵਿੱਚ ਲਿਖੀਆਂ ਜਾਂਦੀਆਂ ਹਨ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Edycje tagów są zapisywane w plikach na serwerze."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As edições de etiquetas são gravadas nos arquivos do servidor."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As edições de etiquetas são gravadas nos ficheiros do servidor."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Editările etichetelor sunt scrise în fișierele de pe server."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Taggredigeringar skrivs till filerna på servern."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Uhariri wa tagi huandikwa kwenye faili zilizo kwenye seva."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "டேக் திருத்தங்கள் சர்வரிலுள்ள கோப்புகளில் எழுதப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ట్యాగ్ సవరణలు సర్వర్‌లోని ఫైల్‌లలో రాయబడతాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การแก้ไขแท็กจะถูกเขียนลงในไฟล์บนเซิร์ฟเวอร์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etiket düzenlemeleri sunucudaki dosyalara yazılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зміни тегів записуються у файли на сервері."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ٹیگ ترامیم سرور پر موجود فائلوں میں لکھی جاتی ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các chỉnh sửa thẻ được ghi vào tệp trên máy chủ."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "標籤編輯會寫入伺服器上的檔案。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标签编辑会写入服务器上的文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標籤編輯會寫入伺服器上的檔案。"
          }
        }
      }

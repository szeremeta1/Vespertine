            "value": "கோப்புறைகளில் மாற்றங்களைக் கண்காணி"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మార్పుల కోసం ఫోల్డర్‌లను గమనించు"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เฝ้าดูการเปลี่ยนแปลงในโฟลเดอร์"
          }
        },
        "tr": {

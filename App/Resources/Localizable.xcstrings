        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@スピーカーの音がマイクに届くか確認中"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ಸ್ಪೀಕರ್ ಮೈಕ್ರೊಫೋನ್ ತಲುಪುತ್ತಿದೆಯೇ ಎಂದು ಪರಿಶೀಲಿಸಲಾಗುತ್ತಿದೆ"

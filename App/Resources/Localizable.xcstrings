    "CUE track is outside %@: start %lld, length %lld, file length %lld frames": {
      "comment": "Positions and lengths in audio frames.",
      "extractionState": "manual",
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "የCUE ትራኩ ከ%@ ውጭ ነው፦ መጀመሪያ %lld፣ ርዝመት %lld፣ የፋይል ርዝመት %lld ፍሬሞች"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مقطوعة CUE خارج %1$@: البداية %2$lld، الطول %3$lld، طول الملف %4$lld إطار"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "CUE ট্র্যাক %1$@-এর বাইরে: শুরু %2$lld, দৈর্ঘ্য %3$lld, ফাইলের দৈর্ঘ্য %4$lld ফ্রেম"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Skladba CUE je mimo %@: začátek %lld, délka %lld, délka souboru %lld rámců"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "CUE-nummeret ligger uden for %@: start %lld, længde %lld, fillængde %lld frames"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "CUE-Titel liegt außerhalb von %@: Start %lld, Länge %lld, Dateilänge %lld Frames"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το κομμάτι CUE βρίσκεται εκτός του %@: αρχή %lld, μήκος %lld, μήκος αρχείου %lld πλαίσια"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CUE track is outside %1$@: start %2$lld, length %3$lld, file length %#@frames@"
          },
          "substitutions": {
            "frames": {
              "argNum": 4,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg frame"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg frames"
                    }
                  }
                }
              }
            }
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La pista CUE está fuera de %@: inicio %lld, duración %lld, longitud del archivo %lld tramas"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "قطعهٔ CUE خارج از %@ است: شروع %lld، طول %lld، طول فایل %lld فریم"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "CUE-raita on tiedoston %@ ulkopuolella: alku %lld, pituus %lld, tiedoston pituus %lld kehystä"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nasa labas ng %@ ang CUE track: simula %lld, haba %lld, haba ng file %lld frame"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La piste CUE dépasse %@ : début %lld, durée %lld, longueur du fichier %lld trames"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "CUE ટ્રૅક %@ ની બહાર છે: શરૂઆત %lld, લંબાઈ %lld, ફાઇલની લંબાઈ %lld ફ્રેમ"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Waƙar CUE tana wajen %@: farawa %lld, tsawo %lld, tsawon fayil firam %lld"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רצועת CUE מחוץ ל־%1$@: התחלה %2$lld, אורך %3$lld, אורך הקובץ %4$lld פריימים"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "CUE ट्रैक %1$@ के बाहर है: शुरुआत %2$lld, लंबाई %3$lld, फ़ाइल की लंबाई %4$lld फ़्रेम"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A CUE-szám kívül esik a fájlon (%@): kezdet %lld, hossz %lld, fájlhossz %lld keret"

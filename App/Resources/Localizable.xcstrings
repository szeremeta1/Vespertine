        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "đúng"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "為「是」"
          }
        },
        "zh-Hans": {
          "stringUnit": {

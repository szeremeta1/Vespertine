    "Digital volume (64-bit, dithered). Not bit-perfect below 100%.": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ዲጂታል የድምፅ መጠን (64-bit፣ ዲዘር የተደረገ)። ከ100% በታች ቢት-ፍጹም አይደለም።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مستوى الصوت الرقمي (64 بت، مع التمويه). غير مطابق للبتات تحت 100%."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ডিজিটাল ভলিউম (64-bit, ডিদারসহ)। 100%-এর নিচে বিট-পারফেক্ট নয়।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",

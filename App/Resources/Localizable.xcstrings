    "That measurement is already recorded and can't be replaced.": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ያ መለኪያ አስቀድሞ ተመዝግቧል እና ሊተካ አይችልም።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا القياس مسجَّل بالفعل ولا يمكن استبداله."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সেই পরিমাপ ইতিমধ্যে রেকর্ড করা আছে এবং বদলানো যাবে না।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto měření je už zaznamenáno a nelze ho nahradit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den måling er allerede registreret og kan ikke erstattes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Messung ist bereits aufgezeichnet und kann nicht ersetzt werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτή η μέτρηση έχει ήδη καταγραφεί και δεν μπορεί να αντικατασταθεί."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esa medición ya está registrada y no se puede reemplazar."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "آن اندازه‌گیری از قبل ثبت شده و قابل جایگزینی نیست."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Se mittaus on jo tallennettu, eikä sitä voi korvata."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naitala na ang pagsukat na iyon at hindi ito maaaring palitan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette mesure est déjà enregistrée et ne peut pas être remplacée."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તે માપન પહેલેથી નોંધાયેલું છે અને બદલી શકાતું નથી."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "An riga an yi rikodin wannan aunawa kuma ba za a iya maye gurbinsa ba."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המדידה הזו כבר נרשמה ואי אפשר להחליף אותה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वह माप पहले से दर्ज है और बदला नहीं जा सकता।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a mérés már rögzítve van, és nem cserélhető le."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengukuran itu sudah tercatat dan tidak dapat diganti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quella misurazione è già registrata e non può essere sostituita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その測定はすでに記録されており、置き換えることはできません。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಆ ಅಳತೆ ಈಗಾಗಲೇ ದಾಖಲಾಗಿದೆ ಮತ್ತು ಬದಲಾಯಿಸಲಾಗುವುದಿಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해당 측정은 이미 기록되어 있으며 바꿀 수 없습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ആ അളവ് ഇതിനകം രേഖപ്പെടുത്തിയിട്ടുണ്ട്, മാറ്റിസ്ഥാപിക്കാനാവില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ते मापन आधीच नोंदवले आहे आणि बदलता येत नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukuran itu sudah direkodkan dan tidak boleh diganti."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den målingen er allerede registrert og kan ikke erstattes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Die meting is al vastgelegd en kan niet worden vervangen."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਉਹ ਮਾਪ ਪਹਿਲਾਂ ਹੀ ਦਰਜ ਹੈ ਅਤੇ ਬਦਲਿਆ ਨਹੀਂ ਜਾ ਸਕਦਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten pomiar jest już zapisany i nie można go zastąpić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Essa medição já está registrada e não pode ser substituída."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Essa medição já está registada e não pode ser substituída."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acea măsurare este deja înregistrată și nu poate fi înlocuită."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den mätningen är redan registrerad och kan inte ersättas."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kipimo hicho tayari kimerekodiwa na hakiwezi kubadilishwa."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அந்த அளவீடு ஏற்கனவே பதிவாகிவிட்டது; மாற்ற முடியாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఆ కొలత ఇప్పటికే నమోదైంది మరియు మార్చలేము."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การวัดนั้นถูกบันทึกไว้แล้วและแทนที่ไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ölçüm zaten kaydedildi ve değiştirilemez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це вимірювання вже записано, і його не можна замінити."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "وہ پیمائش پہلے ہی درج ہو چکی ہے اور بدلی نہیں جا سکتی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phép đo đó đã được ghi và không thể thay thế."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "該量度已被記錄，無法取代。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该测量已被记录，无法替换。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該量測已被記錄，無法取代。"
          }
        }
      }
    },
    "That needs %@, but only %@ is free on this Mac, and Vespertine keeps 2 GB spare. Choose fewer files, or switch to Reference in Place.": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ይህ %@ ያስፈልገዋል፣ ግን በዚህ Mac ላይ ነፃ የሆነው %@ ብቻ ነው፣ Vespertine ደግሞ 2 GB ትርፍ ያስቀራል። ጥቂት ፋይሎችን ይምረጡ፣ ወይም ወደ «ባሉበት አገናኝ» ይቀይሩ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتطلب ذلك %@، لكن المساحة المتاحة على هذا الـ Mac هي %@ فقط، ويحتفظ Vespertine بمساحة احتياطية قدرها 2 غ.ب. اختر ملفات أقل، أو انتقل إلى “إحالة في المكان”."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এর জন্য %@ প্রয়োজন, কিন্তু এই Mac-এ মাত্র %@ খালি আছে, এবং Vespertine 2 GB জায়গা বাড়তি রাখে। কম ফাইল বেছে নিন, অথবা “মূল স্থানে রেফারেন্স”-এ যান।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Je potřeba %@, ale v tomto Macu je volných jen %@ a Vespertine si ponechává rezervu 2 GB. Vyberte méně souborů, nebo přepněte na Odkazovat na místě."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det kræver %@, men der er kun %@ ledig plads på denne Mac, og Vespertine holder 2 GB i reserve. Vælg færre filer, eller skift til Henvis på stedet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dafür werden %@ benötigt, auf diesem Mac sind aber nur %@ frei, und Vespertine hält 2 GB frei. Wähle weniger Dateien aus oder wechsle zu „Am Speicherort referenzieren“."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Απαιτούνται %@, αλλά σε αυτό το Mac είναι ελεύθερα μόνο %@ και το Vespertine κρατά 2 GB ως απόθεμα. Επιλέξτε λιγότερα αρχεία ή αλλάξτε σε «Αναφορά στη θέση τους»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se necesitan %@, pero solo hay %@ libres en este Mac, y Vespertine reserva 2 GB. Elige menos archivos o cambia a Referenciar en su ubicación."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این کار به %@ نیاز دارد، اما فقط %@ فضای آزاد در این Mac هست و Vespertine ۲ گیگابایت را خالی نگه می‌دارد. فایل‌های کمتری انتخاب کنید یا به «ارجاع در محل» بروید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tähän tarvitaan %@, mutta tällä Macilla on vapaana vain %@, ja Vespertine pitää 2 Gt varalla. Valitse vähemmän tiedostoja tai vaihda tapaan Viittaa paikallaan."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kailangan nito ng %@, pero %@ lang ang libre sa Mac na ito, at nagtatabi ang Vespertine ng 2 GB na reserba. Pumili ng mas kaunting file, o lumipat sa I-reference sa Kinalalagyan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela nécessite %@, mais seulement %@ sont disponibles sur ce Mac, et Vespertine garde 2 Go de réserve. Choisissez moins de fichiers, ou passez à Référencer sur place."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ માટે %@ જોઈએ, પણ આ Mac પર ફક્ત %@ જગ્યા ખાલી છે, અને Vespertine 2 GB અનામત રાખે છે. ઓછી ફાઇલો પસંદ કરો, અથવા “મૂળ જગ્યાએ રાખો” પર સ્વિચ કરો."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Wannan yana buƙatar %@, amma sarari %@ kawai ne a wannan Mac, kuma Vespertine yana barin GB 2 a ajiye. Zaɓi ƙananan fayiloli, ko ku koma Nuni a Inda Yake."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פעולה זו דורשת %@, אך ב־Mac זה פנויים רק %@, ו־Vespertine שומר 2 GB כרזרבה. בחר פחות קבצים, או עבור ל״הפנה במקום״."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसके लिए %@ चाहिए, लेकिन इस Mac पर केवल %@ खाली है, और Vespertine 2 GB जगह बचाकर रखता है। कम फ़ाइलें चुनें, या “मूल स्थान पर रेफ़रेंस करें” पर स्विच करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ehhez %@ kell, de ezen a Macen csak %@ szabad, és a Vespertine 2 GB tartalékot hagy. Válasszon kevesebb fájlt, vagy váltson a Hivatkozás a helyén módra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini membutuhkan %@, tetapi hanya %@ yang tersedia di Mac ini, dan Vespertine menyisakan cadangan 2 GB. Pilih lebih sedikit file, atau beralih ke Rujuk di Tempat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Servono %@, ma su questo Mac sono liberi solo %@, e Vespertine tiene 2 GB di riserva. Scegli meno file o passa a Riferimento sul posto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@必要ですが、このMacの空き容量は%@しかなく、Vespertineは2 GBの余裕を残します。ファイルを減らすか、「その場で参照」に切り替えてください。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇದಕ್ಕೆ %@ ಬೇಕು, ಆದರೆ ಈ Mac ನಲ್ಲಿ %@ ಮಾತ್ರ ಖಾಲಿ ಇದೆ, ಮತ್ತು Vespertine 2 GB ಹೆಚ್ಚುವರಿಯಾಗಿ ಇಡುತ್ತದೆ. ಕಡಿಮೆ ಫೈಲ್‌ಗಳನ್ನು ಆರಿಸಿ, ಅಥವಾ “ಇರುವಲ್ಲೇ ಉಲ್ಲೇಖಿಸಿ” ಗೆ ಬದಲಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) 필요하지만 이 Mac의 여유 공간은 %@뿐이며, Vespertine은 2 GB를 여유 공간으로 남겨둡니다. 파일을 더 적게 선택하거나 제자리에서 참조로 전환하십시오."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇതിന് %@ വേണം, പക്ഷേ ഈ Mac-ൽ %@ മാത്രമേ ഒഴിവുള്ളൂ, Vespertine 2 GB കരുതിവയ്ക്കുന്നു. കുറച്ച് ഫയലുകൾ തിരഞ്ഞെടുക്കുക, അല്ലെങ്കിൽ സ്ഥലത്തുതന്നെ റഫറൻസ് ചെയ്യുക എന്നതിലേക്ക് മാറുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "यासाठी %@ लागेल, पण या Mac वर फक्त %@ जागा मोकळी आहे, आणि Vespertine 2 GB राखीव ठेवते. कमी फाइल्स निवडा, किंवा “मूळ जागी ठेवा” वर स्विच करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini memerlukan %@, tetapi hanya %@ kosong pada Mac ini, dan Vespertine mengekalkan 2 GB sebagai simpanan. Pilih lebih sedikit fail, atau tukar kepada Rujuk di Tempat."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det krever %@, men bare %@ er ledig på denne Macen, og Vespertine holder av 2 GB i reserve. Velg færre filer, eller bytt til Referer på stedet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Daarvoor is %@ nodig, maar er is maar %@ vrij op deze Mac en Vespertine houdt 2 GB vrij. Kies minder bestanden of schakel over naar ‘Verwijs op locatie’."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ ਲਈ %@ ਚਾਹੀਦੀ ਹੈ, ਪਰ ਇਸ Mac ’ਤੇ ਸਿਰਫ਼ %@ ਥਾਂ ਖਾਲੀ ਹੈ, ਅਤੇ Vespertine 2 GB ਵਾਧੂ ਰੱਖਦਾ ਹੈ। ਘੱਟ ਫ਼ਾਈਲਾਂ ਚੁਣੋ, ਜਾਂ ‘ਮੌਜੂਦਾ ਥਾਂ ਤੋਂ ਵਰਤੋ’ ਚੁਣੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Potrzeba %@, ale na tym Macu wolne jest tylko %@, a Vespertine zachowuje 2 GB zapasu. Wybierz mniej plików lub przełącz na Pozostaw na miejscu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "São necessários %@, mas há apenas %@ livres neste Mac, e o Vespertine mantém 2 GB de reserva. Escolha menos arquivos ou mude para Referenciar no Local."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",

    "Multichannel music goes to each speaker by position.": {
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ባለብዙ ቻናል ሙዚቃ በአቀማመጡ ወደ እያንዳንዱ ድምፅ ማጉያ ይሄዳል።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تذهب الموسيقى متعددة القنوات إلى كل سماعة حسب موضعها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মাল্টিচ্যানেল মিউজিক অবস্থান অনুযায়ী প্রতিটি স্পিকারে যায়।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vícekanálová hudba jde do jednotlivých reproduktorů podle polohy."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Flerkanalsmusik sendes til hver højttaler efter position."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mehrkanalmusik geht nach Position an jeden Lautsprecher."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η πολυκαναλική μουσική πηγαίνει σε κάθε ηχείο βάσει θέσης."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La música multicanal llega a cada altavoz según su posición."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "موسیقی چندکاناله بر اساس موقعیت به هر بلندگو می‌رود."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Monikanavainen musiikki ohjataan kuhunkin kaiuttimeen sijainnin mukaan."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pumupunta sa bawat speaker ayon sa posisyon ang multichannel na musika."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La musique multicanal est envoyée à chaque haut-parleur selon sa position."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "મલ્ટિચૅનલ સંગીત સ્થાન મુજબ દરેક સ્પીકર પર જાય છે."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Waƙoƙi masu tashoshi da yawa suna zuwa kowace lasifika bisa matsayi."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מוזיקה רב־ערוצית נשלחת לכל רמקול לפי מיקומו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मल्टीचैनल संगीत स्थिति के अनुसार हर स्पीकर पर जाता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A többcsatornás zene helyzet szerint jut az egyes hangszórókra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Musik multisaluran dikirim ke setiap speaker berdasarkan posisi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La musica multicanale va a ogni altoparlante in base alla sua posizione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マルチチャンネルの音楽は、位置に従って各スピーカーに送られます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಮಲ್ಟಿಚಾನೆಲ್ ಸಂಗೀತವು ಸ್ಥಾನದ ಪ್ರಕಾರ ಪ್ರತಿ ಸ್ಪೀಕರ್‌ಗೆ ಹೋಗುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "멀티채널 음악은 위치에 따라 각 스피커로 보내집니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മൾട്ടിചാനൽ സംഗീതം സ്ഥാനമനുസരിച്ച് ഓരോ സ്പീക്കറിലേക്കും പോകുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "मल्टिचॅनेल संगीत स्थानानुसार प्रत्येक स्पीकरकडे जाते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Muzik berbilang saluran dihantar ke setiap pembesar suara mengikut kedudukan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Flerkanalsmusikk sendes til hver høyttaler etter posisjon."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meerkanaalsmuziek gaat op positie naar elke luidspreker."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਮਲਟੀਚੈਨਲ ਸੰਗੀਤ ਸਥਿਤੀ ਮੁਤਾਬਕ ਹਰ ਸਪੀਕਰ ਨੂੰ ਜਾਂਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Muzyka wielokanałowa trafia do każdego głośnika według położenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As músicas multicanal vão para cada alto-falante conforme a posição."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A música multicanal vai para cada altifalante conforme a posição."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Muzica multicanal ajunge la fiecare difuzor după poziție."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Flerkanalsmusik går till varje högtalare efter position."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Muziki wa chaneli nyingi huenda kwa kila spika kulingana na nafasi."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மல்டிசேனல் இசை நிலையின்படி ஒவ்வொரு ஸ்பீக்கருக்கும் செல்லும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మల్టీఛానెల్ సంగీతం స్థానం ప్రకారం ప్రతి స్పీకర్‌కు వెళ్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพลงหลายช่องสัญญาณไปยังลำโพงแต่ละตัวตามตำแหน่ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çok kanallı müzik her hoparlöre konumuna göre gider."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Багатоканальна музика надходить на кожен динамік відповідно до його положення."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ملٹی چینل موسیقی پوزیشن کے لحاظ سے ہر اسپیکر پر جاتی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhạc đa kênh được gửi đến từng loa theo vị trí."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "多聲道音樂會按位置送至各揚聲器。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "多声道音乐会按位置送往每个扬声器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "多聲道音樂會依位置送往每個揚聲器。"
          }
        }

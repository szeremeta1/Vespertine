        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ SACD ಇಮೇಜ್‌ನಲ್ಲಿ Vespertine ಪ್ಲೇ ಮಾಡಬಹುದಾದ ಆಡಿಯೋ ಏರಿಯಾ ಇಲ್ಲ."

    "%lld-bit file, but only %lld bits carry audio (zero-padded).": {
      "extractionState": "manual",
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld-bit ፋይል፣ ግን ድምፅ የሚይዙት %2$lld ቢቶች ብቻ ናቸው (በዜሮ የተሞሉ)።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ملف %1$lld بت، لكن %2$lld بت فقط تحمل الصوت (مبطّن بالأصفار)."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld-bit ফাইল, কিন্তু মাত্র %2$lld বিটে অডিও আছে (জিরো-প্যাডেড)।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Soubor má %lld bitů, ale zvuk nese jen %lld (doplněno nulami)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld-bit-fil, men kun %lld bit indeholder lyd (nulpolstret)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld-Bit-Datei, aber nur %lld Bits enthalten Audio (mit Nullen aufgefüllt)."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αρχείο %1$lld bit, αλλά μόνο τα %2$lld bit περιέχουν ήχο (συμπλήρωση με μηδενικά)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld-bit file, but only %#@bits@ audio (zero-padded)."
          },
          "substitutions": {
            "bits": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg bit carries"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg bits carry"
                    }
                  }
                }
              }
            }
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivo de %lld bits, pero solo %lld bits contienen audio (rellenado con ceros)."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فایل %lld بیتی، اما فقط %lld بیت صدا دارند (صفرپرشده)."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld-bittinen tiedosto, mutta vain %lld bittiä sisältää ääntä (täytetty nollilla)."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld-bit na file, pero %lld bit lang ang may audio (zero-padded)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fichier %lld bits, mais seuls %lld bits contiennent de l’audio (complétés par des zéros)."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld-bit ફાઇલ, પણ ફક્ત %lld બિટમાં ઑડિયો છે (શૂન્ય-પૅડ કરેલું)."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Fayil na bit %lld, amma bit %lld kawai ne ke ɗauke da sauti (an cike da sifili)."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קובץ של %1$lld סיביות, אך רק %2$lld סיביות נושאות שמע (מרופד באפסים)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld-bit फ़ाइल, लेकिन केवल %2$lld बिट में ऑडियो है (ज़ीरो-पैडेड)।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",

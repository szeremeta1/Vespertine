        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα ρολόγια μικροφώνου και ηχείου διαφέρουν κατά %@ ppm, περισσότερο από όσο μπορεί να διορθώσει μια μέτρηση."
          }

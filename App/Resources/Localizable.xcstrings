    "No codec-like cutoff, synthetic-looking shelf or upsampling wall found.": {
      "extractionState": "manual",
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ምንም የኮዴክ የሚመስል መቁረጫ፣ የተሠራ የሚመስል ሼልፍ ወይም የአፕሳምፕሊንግ ግድግዳ አልተገኘም።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُعثر على قطع يشبه الترميز، أو رف يبدو مُصطنعًا، أو جدار رفع معدل العينة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোডেক-সদৃশ কাটঅফ, কৃত্রিম-দেখতে শেলফ বা আপস্যাম্পলিং দেয়াল পাওয়া যায়নি।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nebyl nalezen žádný ořez typický pro kodek, syntetický šelf ani stěna po převzorkování."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der blev ikke fundet nogen codec-lignende afskæring, syntetisk udseende shelf eller opsamplingsmur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein codecartiger Abfall, kein synthetisch wirkendes Plateau und keine Upsampling-Kante gefunden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν βρέθηκε αποκοπή τύπου codec, πλατό που μοιάζει συνθετικό ή τείχος υπερδειγματοληψίας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No codec-like cutoff, synthetic-looking shelf or upsampling wall found."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha encontrado ningún corte propio de un códec, ninguna meseta de aspecto sintético ni ningún muro de sobremuestreo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هیچ برش شبیه کدک، قفسهٔ ساختگی یا دیوار افزایش نرخی پیدا نشد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Koodekin kaltaista rajausta, synteettiseltä näyttävää hyllyä tai ylösnäytteistyksen seinämää ei löytynyt."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang nahanap na cutoff na parang codec, shelf na mukhang synthetic o pader ng upsampling."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune coupure de type codec, aucun plateau d’apparence synthétique ni mur de suréchantillonnage détecté."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કોડેક જેવો કટઑફ, કૃત્રિમ દેખાતો શેલ્ફ અથવા અપસેમ્પલિંગની દીવાલ મળી નથી."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ba a sami yankewa irin na codec, shelf mai kama da na ƙirƙira ko bangon upsampling ba."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא נמצאו חיתוך דמוי קודק, מדף שנראה מלאכותי או קיר של דגימת־על."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई कोडेक जैसा कटऑफ़, कृत्रिम दिखने वाला शेल्फ़ या अपसैंपलिंग दीवार नहीं मिली।"

    "NSLocalNetworkUsageDescription": {
      "comment": "Privacy - Local Network Usage Description",
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "Vespertine እርስዎ ካከሏቸው የሙዚቃ አገልጋዮች እና የአውታረ መረብ ማጋሪያዎች ጋር በአውታረ መረብዎ ላይ ወይም በVPN በኩል ይገናኛል።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتصل Vespertine بخوادم الموسيقى ومشاركات الشبكة التي تضيفها، على شبكتك أو عبر VPN."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার যোগ করা মিউজিক সার্ভার ও নেটওয়ার্ক শেয়ারের সাথে Vespertine সংযোগ করে, আপনার নেটওয়ার্কে বা VPN-এর মাধ্যমে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vespertine se připojuje k hudebním serverům a síťovým sdílením, která přidáte, ve vaší síti nebo přes VPN."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vespertine opretter forbindelse til de musikservere og netværksdelinger, du tilføjer, på dit netværk eller via VPN."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vespertine verbindet sich mit den Musikservern und Netzwerkfreigaben, die du hinzufügst – in deinem Netzwerk oder über ein VPN."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Vespertine συνδέεται στους διακομιστές μουσικής και τους κοινόχρηστους φακέλους δικτύου που προσθέτετε, στο δίκτυό σας ή μέσω VPN."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vespertine connects to the music servers and network shares you add, on your network or over a VPN."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vespertine se conecta a los servidores de música y recursos compartidos de red que añadas, en tu red o a través de una VPN."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Vespertine به سرورهای موسیقی و اشتراک‌های شبکه‌ای که اضافه می‌کنید وصل می‌شود، در شبکهٔ شما یا از طریق VPN."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vespertine muodostaa yhteyden lisäämiisi musiikkipalvelimiin ja verkkojakoihin omassa verkossasi tai VPN:n kautta."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kumokonekta ang Vespertine sa mga music server at network share na idinagdag mo, sa network mo o sa pamamagitan ng VPN."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vespertine se connecte aux serveurs de musique et aux partages réseau que vous ajoutez, sur votre réseau ou via un VPN."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "Vespertine તમે ઉમેરેલા મ્યુઝિક સર્વર અને નેટવર્ક શેર સાથે તમારા નેટવર્ક પર અથવા VPN દ્વારા કનેક્ટ થાય છે."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Vespertine yana haɗuwa da sabobin kiɗa da foldojin cibiyar sadarwa da kuka ƙara, a kan cibiyar sadarwarku ko ta VPN."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Vespertine מתחבר לשרתי המוזיקה ולשיתופי הרשת שהוספת, ברשת שלך או דרך VPN."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vespertine आपके द्वारा जोड़े गए म्यूज़िक सर्वर और नेटवर्क शेयर से आपके नेटवर्क पर या VPN के ज़रिए कनेक्ट होता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Vespertine csatlakozik az Ön által hozzáadott zeneszerverekhez és hálózati megosztásokhoz, a hálózatán vagy VPN-en keresztül."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Vespertine terhubung ke server musik dan share jaringan yang Anda tambahkan, di jaringan Anda atau melalui VPN."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vespertine si connette ai server musicali e alle condivisioni di rete che aggiungi, sulla tua rete o tramite VPN."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Vespertineは、追加した音楽サーバやネットワーク共有に、ネットワーク上で、またはVPN経由で接続します。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ಸೇರಿಸುವ ಮ್ಯೂಸಿಕ್ ಸರ್ವರ್‌ಗಳು ಮತ್ತು ನೆಟ್‌ವರ್ಕ್ ಶೇರ್‌ಗಳಿಗೆ Vespertine ನಿಮ್ಮ ನೆಟ್‌ವರ್ಕ್‌ನಲ್ಲಿ ಅಥವಾ VPN ಮೂಲಕ ಸಂಪರ್ಕಿಸುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Vespertine은 사용자가 추가한 음악 서버 및 네트워크 공유에 사용자의 네트워크 또는 VPN을 통해 연결합니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ ചേർക്കുന്ന മ്യൂസിക് സെർവറുകളിലേക്കും നെറ്റ്‌വർക്ക് ഷെയറുകളിലേക്കും നിങ്ങളുടെ നെറ്റ്‌വർക്കിലോ VPN വഴിയോ Vespertine കണക്റ്റ് ചെയ്യുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही जोडलेल्या म्युझिक सर्व्हर आणि नेटवर्क शेअरशी Vespertine तुमच्या नेटवर्कवर किंवा VPN द्वारे कनेक्ट होते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Vespertine menyambung ke pelayan muzik dan perkongsian rangkaian yang anda tambah, pada rangkaian anda atau melalui VPN."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vespertine kobler til musikktjenerne og nettverksdelingene du legger til, på nettverket ditt eller via VPN."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vespertine maakt verbinding met de muziekservers en netwerkshares die je toevoegt, op je netwerk of via een VPN."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "Vespertine ਤੁਹਾਡੇ ਵੱਲੋਂ ਸ਼ਾਮਲ ਕੀਤੇ ਮਿਊਜ਼ਿਕ ਸਰਵਰਾਂ ਅਤੇ ਨੈੱਟਵਰਕ ਸ਼ੇਅਰਾਂ ਨਾਲ ਤੁਹਾਡੇ ਨੈੱਟਵਰਕ ’ਤੇ ਜਾਂ VPN ਰਾਹੀਂ ਕਨੈਕਟ ਕਰਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vespertine łączy się z dodanymi przez Ciebie serwerami muzyki i zasobami sieciowymi, w Twojej sieci lub przez VPN."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Vespertine se conecta aos servidores de música e compartilhamentos de rede que você adicionar, na sua rede ou por VPN."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Vespertine liga-se aos servidores de música e às partilhas de rede que adicionar, na sua rede ou através de uma VPN."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Vespertine se conectează la serverele de muzică și partajările de rețea pe care le adăugați, în rețeaua dvs. sau prin VPN."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vespertine ansluter till de musikservrar och nätverksresurser du lägger till, i ditt nätverk eller via VPN."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Vespertine huunganisha kwenye seva za muziki na folda za mtandao unazoongeza, kwenye mtandao wako au kupitia VPN."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் சேர்க்கும் இசை சர்வர்கள் மற்றும் நெட்வொர்க் பகிர்வுகளுடன் உங்கள் நெட்வொர்க்கில் அல்லது VPN மூலம் Vespertine இணைகிறது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు జోడించే మ్యూజిక్ సర్వర్‌లు, నెట్‌వర్క్ షేర్‌లకు Vespertine మీ నెట్‌వర్క్‌లో లేదా VPN ద్వారా కనెక్ట్ అవుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Vespertine เชื่อมต่อกับเซิร์ฟเวอร์เพลงและแชร์เครือข่ายที่คุณเพิ่ม บนเครือข่ายของคุณหรือผ่าน VPN"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vespertine, eklediğiniz müzik sunucularına ve ağ paylaşımlarına ağınızda veya bir VPN üzerinden bağlanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vespertine під’єднується до доданих вами музичних серверів і мережевих ресурсів у вашій мережі або через VPN."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Vespertine آپ کے شامل کردہ میوزک سرورز اور نیٹ ورک شیئرز سے آپ کے نیٹ ورک پر یا VPN کے ذریعے منسلک ہوتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vespertine kết nối với các máy chủ nhạc và chia sẻ mạng mà bạn thêm vào, trên mạng của bạn hoặc qua VPN."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "Vespertine 會連接至你加入的音樂伺服器和網絡共享，無論是在你的網絡上或透過 VPN。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Vespertine 会连接到你添加的音乐服务器和网络共享，无论是在你的网络中还是通过 VPN。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Vespertine 會連線至你加入的音樂伺服器和網路分享，無論是在你的網路上或透過 VPN。"
          }
        }
      }
    }
  },
  "version": "1.0"
